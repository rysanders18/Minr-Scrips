@if multiplierStage[player] >= multiplierMultipliers.length()
    @player &#d4d4d4--------------------------------------
    @player &cYou have reached the maximum upgrade for this button!
    @player &#d4d4d4--------------------------------------
    @bypass playsound minecraft:block.note_block.didgeridoo master @s ~ ~ ~ 0.5 1
    @return
@fi

@if cookieCount[player] < multiplierPrices[multiplierStage[player]]
    @player &#d4d4d4--------------------------------------
    @player &9&lCookie Multiplier Button
    @player &#d4d4d4● Current Multiplier: &9{{Harha::formatNumber(String(Int(cookieMultiplier[player])))}}x
    @player &#d4d4d4● Next Multiplier: &9{{Harha::formatNumber(String(multiplierMultipliers[multiplierStage[player]]))}}x
    @player
    @player &#d4d4d4● Price: &#ff9523&l{{Harha::formatNumber(String(multiplierPrices[multiplierStage[player]]))}} Cookies
    @player &#d4d4d4--------------------------------------
    @player &cYou need &l{{Harha::formatNumber(String(multiplierPrices[multiplierStage[player]] - cookieCount[player]))}}&c more Cookies to purchase this!
    @bypass playsound minecraft:block.note_block.didgeridoo master @s ~ ~ ~ 0.5 1
@else
    @player &#d4d4d4--------------------------------------
    @player &9&lCookie Multiplier Button
    @player &#d4d4d4● New Multiplier: &9{{Harha::formatNumber(String(Int(cookieMultiplier[player])))}}x → {{Harha::formatNumber(String(multiplierMultipliers[multiplierStage[player]]))}}x
    @player
    @player &#d4d4d4● Cookies Remaining: &#ff9523&l{{Harha::formatNumber(String(cookieCount[player]))}} → {{Harha::formatNumber(String(cookieCount[player] - Long(multiplierPrices[multiplierStage[player]])))}} Cookies
    @player &#d4d4d4--------------------------------------
    @player &aUpgrade Purchased Successfully!
    @bypass playsound minecraft:block.note_block.pling master @s ~ ~ ~ 0.5 1.0
    @var cookieMultiplier[player] = Float(multiplierMultipliers[multiplierStage[player]])
    @var cookieCount[player] -= Long(multiplierPrices[multiplierStage[player]])
    @for Int i in list::range(0, 99)
        @var cookieLog[player][i] -= Long(multiplierPrices[multiplierStage[player]])
    @done
    @var multiplierStage[player] += 1
@fi

@var upgradeTextUpdate(player, roomNumber[player])
@var cookieTextUpdate(player, roomNumber[player])