@fast
@using cookie

@if player.getGameMode().toLowerCase() != "adventure"
    @return 
@fi

@if Region("harhacookie0", "Theta").getPlayersInside().length() == 0
    @var cookieRoomSetup(0, player)
@elseif Region("harhacookie1", "Theta").getPlayersInside().length() == 0
    @var cookieRoomSetup(1, player)
@elseif Region("harhacookie2", "Theta").getPlayersInside().length() == 0
    @var cookieRoomSetup(2, player)
@elseif Region("harhacookie3", "Theta").getPlayersInside().length() == 0
    @var cookieRoomSetup(3, player)
@elseif Region("harhacookie4", "Theta").getPlayersInside().length() == 0
    @var cookieRoomSetup(4, player)
@else
    @player &cAll 5 cookie rooms are currently occupied. Please wait for a room to become available.
    @var player.teleport(Position(-9105.5, 97.0, 9533.5, 180.0, 10.0, "Theta"))
    @bypass playsound minecraft:block.note_block.didgeridoo master @s ~ ~ ~ 0.75 0.5
@fi


