@fi

@if milkMultiplierStage[player] >= milkMultiplierPrices.length()
    @var string15 = "Current: x{{Int(milkMultiplier[player])}} → MAXED OUT!"
    @var string16 = "Price: MAXED OUT!"
@else
    @var string15 = "Current: x{{Int(milkMultiplier[player])}} → x{{milkMultiplierMultipliers[milkMultiplierStage[player]]}}"
    @var string16 = "Price: {{Harha::formatNumber(String(milkMultiplierPrices[milkMultiplierStage[player]]))}} Cookies"
@fi

@if milkUnlocked[player] == false
    @var string17 = "Click to unlock Milk"
    @var string18 = "Price: 15,000 Cookies"
@else
    @var string17 = "Milk Unlocked!"
    # @player DEBUG: {{system::currentTimeMillis() - lastMilkActivationTime[player]}} < {{45000}}
    @if milkActivated[player] == true || (system::currentTimeMillis() - lastMilkActivationTime[player]) < (milkDuration[player] * 1000)
        # @player DEBUG: milk is on cooldown bc {{system::currentTimeMillis() - lastMilkActivationTime[player]}} < {{45000}}
        @var string18 = "Ability on cooldown"
    @else
        # @player DEBUG: milk is active because {{system::currentTimeMillis() - lastMilkActivationTime[player]}} > {{45000}}
        @var string18 = "Click the Bucket to activate!"
    @fi
@fi

# Unlock Milk
@if milkUnlocked[player] == false
    @var string19 = "Unlock Milk"
@else
    @var string19 = "Activate Milk"
@fi




