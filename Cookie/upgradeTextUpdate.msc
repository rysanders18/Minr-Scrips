@if cooldownStage[player] >= cooldownPrices.length()
    @var string9 = "Current: {{cookieCooldown[player]}} ms → MAXED OUT!"
    @var string10 = "Price: MAXED OUT!"
@else
    @var string9 = "Current: {{cookieCooldown[player]}} ms → {{cooldownCooldowns[cooldownStage[player]]}} ms"
    @var string10 = "Price: {{Harha::formatNumber(String(cooldownPrices[cooldownStage[player]]))}} Cookies"
@fi

# Right Side
# Right Side
# Right Side

# @if diamondCookieChanceStage[player] >= diamondChances.length()
