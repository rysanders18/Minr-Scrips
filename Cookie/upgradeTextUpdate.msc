# @player DEBUG: {{diamondCookieChanceStage[player]}}, {{diamondChances.length()}}
@if diamondCookieChanceStage[player] >= diamondChances.length()
    @var string3 = "Current: 1/{{diamondCookieChance[player]}} → MAXED OUT!"
    @var string4 = "Price: MAXED OUT!"
@else
    @var string3 = "Current: 1/{{diamondCookieChance[player]}} → 1/{{diamondChances[diamondCookieChanceStage[player]]}}"
    @var string4 = "Price: {{Harha::formatNumber(String(diamondPrices[diamondCookieChanceStage[player]]))}} Cookies"
@fi

# @player DEBUG: {{goldenCookieChanceStage[player]}}, {{goldenChances.length()}}
@if goldenCookieChanceStage[player] >= goldenChances.length()
    @var string5 = "Current: 1/{{goldenCookieChance[player]}} → MAXED OUT!"
    @var string6 = "Price: MAXED OUT!"
@else
    @var string5 = "Current: 1/{{goldenCookieChance[player]}} → 1/{{goldenChances[goldenCookieChanceStage[player]]}}"
    @var string6 = "Price: {{Harha::formatNumber(String(goldenPrices[goldenCookieChanceStage[player]]))}} Cookies"
@fi

# @player DEBUG: {{multiplierStage[player]}}, {{multiplierMultipliers.length()}}
@if multiplierStage[player] >= multiplierMultipliers.length()
    @var string7 = "Current: x{{Int(cookieMultiplier[player])}} → MAXED OUT!"
    @var string8 = "Price: MAXED OUT!"
@else
    @var string7 = "Current: x{{Int(cookieMultiplier[player])}} → x{{multiplierMultipliers[multiplierStage[player]]}}"
    @var string8 = "Price: {{Harha::formatNumber(String(multiplierPrices[multiplierStage[player]]))}} Cookies"
@fi

