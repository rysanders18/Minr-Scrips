# milkAnimation(Int roomNumber, Boolean milkTrue) https://paste.minr.org/boxevonate

@using cookie
@fast

@if milkTrue == false
@bypass execute in minecraft:theta run setblock {{-9150 - roomNumber * 20}} 100 9300 minecraft:brown_concrete_powder strict
@bypass playsound minecraft:entity.goat.milk master @s ~ ~ ~ 0.85 1.9
@delay 1
@bypass execute in minecraft:theta run setblock {{-9149 - roomNumber * 20}} 100 9300 minecraft:brown_wool strict
