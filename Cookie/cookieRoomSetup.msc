# cookieRoomSetup(Int room, Player player) https://paste.minr.org/ekojexoroy

@fast
@using cookie

@var player.teleport(Position((-9149.5 -  20 * room), 99.0, 9310.5, 180.0, 0.0, "Theta"))

@delay 5

@var roomNumber[player] = room

@var goldenCookieLocations[player] = Boolean[false, false, false, false, false, false, false, false, false, false, false, false, false, false]
@var diamondCookieLocations[player] = Boolean[false, false, false, false, false, false, false, false, false, false, false, false, false, false]

@for Int i in list::range(0, 15)
    @bypass minecraft:kill @e[tag=goldenCookie{{i}}{{room}},type=minecraft:item_display]
@done

@if milkUnlocked[player] == true
    @bypass setblock {{-9147 - room * 20}} 99 9302 minecraft:air
    @bypass data merge entity @e[type=item_display,tag=harhaCookieMilkItem{{room}},limit=1] {item:{id:"minecraft:milk_bucket",count:1}}
@else
    @bypass setblock {{-9147 - room * 20}} 99 9302 minecraft:stone_button[face=wall,facing=south,powered=false]
    @bypass data merge entity @e[type=item_display,tag=harhaCookieMilkItem{{room}},limit=1] {item:{id:"minecraft:air",count:1}}
@fi

@var cookieTextUpdate(player, room)
@var upgradeTextUpdate(player, roomNumber[player])
 
@delay 1

@bypass playsound minecraft:entity.enderman.teleport master @s
@bypass execute at @s run particle minecraft:witch ~ ~ ~ 0 1 0 1 20 normal
@bypass attribute @s minecraft:entity_interaction_range base set 10