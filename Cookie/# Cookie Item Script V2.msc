# Cookie Item Script V2
@fast
@using cookie

@define Int roomNumber = 4
@define Long cookieCountPrevious = cookieCount[player]

# DEBUG: {{timeSinceLastCookie[player] + cookieCooldown[player]}} >= {{system::currentTimeMillis()}}
@if timeSinceLastCookie[player] + cookieCooldown[player] >= system::currentTimeMillis()
    # Particles for cooldown
    @define Int particleCount = Int(math::random(2D, 4D))
    @for Int i in list::range(0, particleCount + 2)
        @bypass /execute at @e[tag=harhaCookieItem{{roomNumber}},limit=1] run particle dust_color_transition{from_color:[1.000,0.000,0.000],scale:1,to_color:[1.000,0.322,0.031]} ~{{math::random(-0.35D, 0.35D)}} ~{{math::random(-0.25D, 0.25D)}} ~0.1 0 0.1 0.05 1 0 normal
    @done
    # Cooldown Sound
    @bypass /playsound minecraft:block.netherite_block.hit master @s ~ ~ ~ 0.5 2
    @return
@fi

# Sound Effect
@if milkActivated[player] == true
    @bypass playsound minecraft:entity.wandering_trader.drink_milk master @s ~ ~ ~ 0.6 {{math::random(0.8D, 1.2D)}}
    @bypass playsound minecraft:entity.chicken.egg master @s ~ ~ ~ 0.3 {{math::random(0.8D, 1.2D)}}
@else
    @bypass playsound minecraft:entity.generic.eat master @s ~ ~ ~ 0.5 {{math::random(0.8D, 1.2D)}}
    @bypass playsound minecraft:entity.chicken.egg master @s ~ ~ ~ 0.2 {{math::random(0.8D, 1.2D)}}
@fi

# Increase Cookie Count
@if milkActivated[player] == true
    @var cookieCount[player] += Long(milkMultiplier[player] * cookieMultiplier[player])
    @var totalCookiesEarned[player] += Long(milkMultiplier[player] * cookieMultiplier[player])
@else
    @var cookieCount[player] += Long(cookieMultiplier[player])
    @var totalCookiesEarned[player] += Long(cookieMultiplier[player])
@fi
@var timeSinceLastCookie[player] = system::currentTimeMillis()

# Update Text Display
@var cookieTextUpdate(player, roomNumber)

# Increase Cookie Clicks
@var cookiesClicked[player] += 1

# Log cookie count
@var cookieLog[Int(cookiesClicked) % 100] = cookieCount[player]
@var cookieLogTimes[Int(cookiesClicked) % 100] = system::currentTimeMillis()

# display Cookie Number
@if milkActivated[player] == true
    @bypass title {{player}} actionbar ["",{"text":"Total ","bold":true,"color":"#e7edff"},{"text":"Cookies: ","bold":true,"color":"#d8efff"},{"text":"{{Harha::formatNumber(String(cookieCount[player]))}}","bold":true,"color":"#c6f2ff"},{"text":"  + ({{Harha::formatNumber(String(Int(cookieMultiplier[player])))}} x {{milkMultiplier[player]}})","bold":true,"color":"#adf6ff"}]
@else
    @bypass title {{player}} actionbar ["",{"text":"Total ","bold":true,"color":"#ff6b48"},{"text":"Cookies: ","bold":true,"color":"#ff7f37"},{"text":"{{Harha::formatNumber(String(cookieCount[player]))}}","bold":true,"color":"#ff9523"},{"text":"  + ({{Harha::formatNumber(String(Int(cookieMultiplier[player])))}})","bold":true,"color":"#d4d4d4"}] 
@fi

# Particles
@define Int particleCount = 4
@if milkActivated[player] == true
    @for Int i in list::range(0, particleCount + 4)
        # @bypass /execute at @e[tag=goldenCookie{{cookieLocation}}{{roomNumber}},limit=1] run particle effect{color:[1.000,0.969,0.931]} ~{{math::random(-0.35D, 0.35D)}} ~{{math::random(-0.3D, 0.3D)}} ~0.1 {{math::random(-0.05D, 0.05D)}} {{0.1 + math::random(-0.05D, 0.02D)}} {{0.05 + math::random(-0.025D, 0.025D)}} 1.5 0 normal 
        @bypass /execute at @e[tag=harhaCookieItem{{roomNumber}},limit=1] run particle item{item:"milk_bucket"} ~{{math::random(-0.35D, 0.35D)}} ~{{math::random(-0.3D, 0.3D)}} ~0.1 {{math::random(-0.05D, 0.05D)}} {{0.1 + math::random(-0.05D, 0.02D)}} {{0.05 + math::random(-0.025D, 0.025D)}} 1 0 normal 
    @done
@else
    @var particleCount = 4
    @for Int i in list::range(0, particleCount)
        @bypass /execute at @e[tag=harhaCookieItem{{roomNumber}},limit=1] run particle item{item:"cookie"} ~{{math::random(-0.35D, 0.35D)}} ~{{math::random(-0.3D, 0.3D)}} ~0.1 {{math::random(-0.05D, 0.05D)}} {{0.1 + math::random(-0.05D, 0.02D)}} {{0.05 + math::random(-0.025D, 0.025D)}} 1 0 normal 
    @done
@fi

# Golden Cookies
@if Int(math::random(0D, Double(goldenCookieChance[player]))) == 1

    # Define coords around the cookie
    @define Float[] goldenCoordsList = Float[-9148.5F, 101.5F, -9149.5F, 101.5F, -9150.5F, 101.5F, -9148.5F, 100.5F, -9150.5F, 100.5F, -9148.5F, 99.5F, -9149.5F, 99.5F, -9150.5F, 99.5F, -9147.5F, 101.5F, -9151.5F, 101.5F, -9147.5F, 100.5F, -9151.5F, 100.5F, -9147.5F, 99.5F, -9151.5F, 99.5F]
    @define Int randIndex = Int(math::random(0D, 14D))
    # If the location is not taken, spawn a golden cookie
    @if goldenCookieLocations[player][randIndex] == false

        # Diamond Cookie Chance
        @define Int randIndex2 = Int(math::random(0D, Double(diamondCookieChance[player])))
        @if randIndex2 == 1
            @var goldenCookieLocations[player][randIndex] = true
            @var diamondCookieLocations[player][randIndex] = true
            @bypass /summon item_display {{goldenCoordsList[randIndex * 2] - 20 * roomNumber}} {{goldenCoordsList[randIndex * 2 + 1]}} 9301.0 {item:{id:"minecraft:diamond",count:1,components:{"minecraft:enchantment_glint_override":true}},Tags:["goldenCookie{{randIndex}}{{roomNumber}}"]}
            # @bypass title {{player}} actionbar ["",{"text":"Diamond Cookie! ","bold":true,"color":"#00ffff"},{"text":"+50 Cookies","bold":true,"color":"#00d4ff"}]
            @bypass playsound minecraft:entity.player.levelup master @s ~ ~ ~ 0.6 2
            @bypass playsound minecraft:entity.cat.ambient master @s ~ ~ ~ 0.5 2

            # Golden Cookie Particles
            @for Int i in list::range(0, particleCount + 12)
                @bypass /execute at @e[tag=goldenCookie{{randIndex}}{{roomNumber}},limit=1] run particle minecraft:block{block_state:"diamond_block"} ~{{math::random(-0.35D, 0.35D)}} ~{{math::random(-0.3D, 0.3D)}} ~0.1 {{math::random(-0.05D, 0.05D)}} {{0.1 + math::random(-0.05D, 0.02D)}} {{0.05 + math::random(-0.025D, 0.025D)}} 1 0 normal 
            @done
        @else
            @var goldenCookieLocations[player][randIndex] = true
            @bypass /summon item_display {{goldenCoordsList[randIndex * 2] - 20 * roomNumber}} {{goldenCoordsList[randIndex * 2 + 1]}} 9301.0 {item:{id:"minecraft:enchanted_golden_apple",count:1},Tags:["goldenCookie{{randIndex}}{{roomNumber}}"]}
            # @bypass title {{player}} actionbar ["",{"text":"Golden Cookie! ","bold":true,"color":"#ffd700"},{"text":"+10 Cookies","bold":true,"color":"#ffea00"}]
            @bypass playsound minecraft:entity.player.levelup master @s ~ ~ ~ 0.4 1

            # Golden Cookie Particles
            @for Int i in list::range(0, particleCount + 4)
                @bypass /execute at @e[tag=goldenCookie{{randIndex}}{{roomNumber}},limit=1] run particle minecraft:block{block_state:"gold_block"} ~{{math::random(-0.35D, 0.35D)}} ~{{math::random(-0.3D, 0.3D)}} ~0.1 {{math::random(-0.05D, 0.05D)}} {{0.1 + math::random(-0.05D, 0.02D)}} {{0.05 + math::random(-0.025D, 0.025D)}} 1 0 normal 
            @done
        @fi
    @fi
@fi

@var checkIfNewUpgrade(player, roomNumber, cookieCountPrevious)

# Animation
@bypass /data merge entity @e[type=item_display,tag=harhaCookieItem{{roomNumber}},limit=1] {transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1.3f,1.3f,1.3f]}}
@delay 2
@bypass /data merge entity @e[type=item_display,tag=harhaCookieItem{{roomNumber}},limit=1] {interpolation_duration:10,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1f,1f,1f]}}