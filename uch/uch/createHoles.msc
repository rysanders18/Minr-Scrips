# createHoles()

@using uch
@fast

@bypass /execute in minecraft:theta run fill -9152 141 9776 -9143 141 9767 minecraft:white_concrete strict
@bypass /execute in minecraft:theta run fill -9152 135 9776 -9143 135 9767 minecraft:white_concrete strict
@bypass /execute in minecraft:theta run fill -9152 129 9776 -9143 129 9767 minecraft:white_concrete strict
@bypass /execute in minecraft:theta run fill -9152 123 9776 -9143 123 9767 minecraft:white_concrete strict
# @bypass /execute in minecraft:theta run fill -9152 117 9776 -9143 117 9767 minecraft:white_concrete strict

@define Vector3 holePos
@define Int randomInt

@for Int floor in list::range(1, 5)
    @var floor = 117 + (6 * floor)
    @var randomInt = Int(math::random(0D, 29D))
    # @player DEBUG: "Random Int: {{randomInt}}"
    @if randomInt == 25D
        @var holePos = Vector3(-9147, floor, 9774)
    @elseif randomInt == 26D
        @var holePos = Vector3(-9144, floor, 9771)
    @elseif randomInt == 27D
        @var holePos = Vector3(-9150, floor, 9771)
    @elseif randomInt == 28D
        @var holePos = Vector3(-9147, floor, 9768)
    @else
        @var holePos = Vector3(-9149 + Int(randomInt % 5), floor, 9773 - Int(randomInt / 5))
    @fi

    @bypass /execute in minecraft:theta run fill {{Int(holePos.getX() - 2)}} {{Int(holePos.getY())}} {{Int(holePos.getZ() - 2)}} {{Int(holePos.getX() + 2)}} {{Int(holePos.getY())}} {{Int(holePos.getZ() + 2)}} minecraft:light_gray_concrete
    @bypass /execute in minecraft:theta run fill {{Int(holePos.getX() - 1)}} {{Int(holePos.getY())}} {{Int(holePos.getZ() - 1)}} {{Int(holePos.getX() + 1)}} {{Int(holePos.getY())}} {{Int(holePos.getZ() + 1)}} minecraft:light[level=15]
    # @bypass /execute in minecraft:theta run /fill {{String(holePos.getX()).substring(0, String(holePos.getX()).indexOf("."))}} {{String(holePos.getY()).substring(0, String(holePos.getY()).indexOf("."))}} {{String(holePos.getZ()).substring(0, String(holePos.getZ()).indexOf("."))}} minecraft:light[level=15]
@done