# theCubeAnimation
@using endmap
@fast
@global_cooldown 2s

# TODO: Check if player in region first
@if Region("endmapcutscene", "Theta_the_end").getPlayersInside().length() > 0
    @player &cPlease try again in a few seconds...
    @bypass /playsound minecraft:block.noteblock.didgeridoo master {{player}} ~ ~ ~ 0.4 1
    @return
@fi



# Reset cp number
@var cpnumber[player] = 0

# Attribute
@bypass attribute {{player}} minecraft:safe_fall_distance base set 50

# Reset the cube
@for Int x in list::range(0, 10)
    @for Int z in list::range(0, 10)
        @for Int y in list::range(0, 10)
            @bypass /data merge entity @e[limit=1,tag=rycube_x{{x}}_y{{y}}_z{{z}}] {interpolation_duration:0,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[{{-7.324 + math::random(0D, 1D)}}f, 0f, 0.324f, 0.889f],translation:[{{-4 + math::random(-1D, 1D)}}f,4f,{{4 + math::random(-1D, 1D)}}f],scale:[0f,0f,0f]}}         
        @done 
    @done 
@done

# Kill pig
@bypass /minecraft:tp @e[tag=endmappig,distance=..200] -4600 131 5499 
@bypass /minecraft:kill @e[tag=endmappig,distance=..200] 

# Summon pig to ride
@bypass /summon pig -4613.0 232.0 5508.98 {NoGravity:1b,Silent:1b,Invulnerable:1b,Tags:["endmappig"],CustomName:[{"bold":true,"color":"#AC30FF","text":"T"},{"color":"#C433FB","text":"H"},{"color":"#DB36F8","text":"E "},{"color":"#F339F4","text":"C"},{"color":"#F339F4","text":"U"},{"color":"#DB36F8","text":"B"},{"color":"#AC30FF","text":"E"}],active_effects:[{id:"minecraft:invisibility",amplifier:1,duration:200000,show_particles:0b,show_icon:0b}]}
@bypass /effect give {{player}} minecraft:darkness 2 0 true
@bypass /playsound minecraft:block.beacon.deactivate master {{player}} ~ ~ ~ 0.5 0.5 1

@delay 20

@bypass /minecraft:tp {{player}} ~ ~ ~ 245 15
@bypass /ride {{player}} mount @e[tag=endmappig,limit=1,sort=nearest]
@bypass /playsound minecraft:block.beacon.activate master {{player}} ~ ~ ~ 0.5 0.75
# @bypass /data merge entity @e[tag=endmappig,limit=1] {Motion:[0.0,0.0,-0.1]}


@for Int i in list::range(0, 85)
    @bypass /rotate {{player}} facing -4599.5 233.00 5499.5
    @bypass /data merge entity @e[tag=endmappig,limit=1] {Motion:[0.0,0.0,-0.1]}
    @bypass /ride @s mount @e[tag=endmappig,limit=1,sort=nearest]
    @delay 1

    @if i == 10
        @console /function execute endmap::theCubeShellAnimation()
    @elseif i == 36
        @console /function execute endmap::theCubeShellParticles(Player("{{player.getName()}}"))
    @fi
@done

@for Int i in list::range(0, 52)
    @bypass /rotate {{player}} facing -4599.5 233.00 5499.5
    @bypass /ride @s mount @e[tag=endmappig,limit=1,sort=nearest]
    # @bypass /data merge entity @e[tag=endmappig,limit=1] {Motion:[0.0,0.0,-0.1]}
    @delay 1
@done

@delay 1
# @bypass /data merge entity @e[tag=endmappig,limit=1] {Motion:[0.0,0.0,0.0]}
# @player {{system::currentTimeMillis()}}
@bypass /playsound minecraft:entity.evoker.prepare_summon master {{player}} ~ ~ ~ 0.5 1
@bypass /playsound minecraft:entity.warden.sonic_boom master {{player}} ~ ~ ~ 0.5 0.5
@bypass /playsound minecraft:block.portal.trigger master {{player}} ~ ~ ~ 0.5 0.9
@bypass /particle minecraft:enchant -4603.5 233.5 5499.5 4.0 4.0 4.0 1 1000

@bypass /execute in minecraft:theta_the_end run particle flash{color:[0.412,0.000,0.824,0.000],scale:5} -4613.00 232.27 5499.50 .3 .3 .3 0 100

@bypass /effect give {{player}} minecraft:darkness 5 0 true

@bypass /data merge entity @e[tag=endmappig,limit=1] {Motion:[-0.3,0.0,0.0]}
# @bypass /attribute {{player}} minecraft:movement_speed base set 0.05

