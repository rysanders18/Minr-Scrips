# spread apart
# Reset the cube
@for Int x in list::range(0, 10)
    @for Int z in list::range(0, 10)
        @for Int y in list::range(0, 10)
            @bypass /data merge entity @e[limit=1,tag=rycube_x{{x}}_y{{y}}_z{{z}}] {interpolation_duration:200,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[{{math::random(-10D, 10D)}}f, {{math::random(1-0D, 10D)}}f, {{math::random(-10D, 10D)}}f, {{math::random(-10D, 10D)}}f],translation:[{{x - 4 + math::random(-1D, 1D)}}f,{{y + math::random(-1D, 1D)}}f,{{z - 4 + math::random(0D, 1D)}}f],scale:[1f,1f,1f]}}         
        @done 
    @done 
@done



@for Int i in list::range(0, 41)
    @bypass particle minecraft:portal -4598.50 234.0 5499.50 0 0 0 5 100
    @delay 1
@done

@delay 5

@for Int i in list::range(0, 15)
    @bypass /data merge entity @e[tag=endmappig,limit=1] {Motion:[{{i / 10}}.{{i}},0.0,0.0]}
    @delay 2
@done

# @bypass /effect give {{player}} blindness 1 0 true
@delay 0


@bypass /attribute {{player}} minecraft:movement_speed base reset

@bypass minecraft:teleport {{player}} -4599.52 61.00 5527.5 180.00 -40.0
@bypass /playsound minecraft:entity.creaking.death master {{player}} ~ ~ ~ 0.25 0
@bypass /playsound minecraft:item.totem.use master {{player}} ~ ~ ~ 0.25 {{math::random(1.1D, 1.4D)}}
@bypass /playsound minecraft:block.beacon.ambient master {{player}} ~ ~ ~ 0.25 {{math::random(0.5D, 0.6D)}}
@bypass /playsound minecraft:entity.lightning_bolt.thunder master {{player}} ~ ~ ~ 1 0.5
@delay 1
@bypass /particle minecraft:witch -4599.52 62.20 5527.50 0 0.1 0 1 30
@bypass /particle minecraft:end_rod -4599.52 62.50 5527.50 0 0 0 0.5 100
@bypass /execute as @s at @s anchored eyes run particle flash{color:[0.412,0.000,0.824,0.000],scale:5} ^ ^ ^1 0 0 0 0 2 force @s
@bypass /effect clear {{player}}

# Kill pig
@bypass /minecraft:tp @e[tag=endmappig,distance=..200] -4600 131 5499 
@bypass /minecraft:kill @e[tag=endmappig,distance=..200] 


