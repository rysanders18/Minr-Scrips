# headTrack(Player player)
# Rotates an armor stand's HEAD to face the player every tick.
@fast
@using Harha

@define String uuid = "caf9e342-47f5-47d2-ba68-e7152a892b19"

@for Int i in list::range(0, 1000)

    @if !player.isOnline()
        @return
    @fi

    # Get the armor stand's position (adjust Y to head height ~1.8 above base)
    @define Location standPos = Location(-9239.59, 95.00, 9713.10, "Theta")
    @define Position playerPos = Position(player.getX(), player.getY(), player.getZ(), player.getYaw(), player.getPitch(), player.getWorld())

    # Look up the actual armor stand entity so we can read its live body yaw.
    # Entity(x, y, z, world) pattern is used in lendfishing/summonInteraction.msc.
    @define Entity stand = Entity(standPos.getX(), standPos.getY(), standPos.getZ(), standPos.getWorld())

    # Calculate deltas
    @define Double deltaX = playerPos.getX() - standPos.getX()
    @define Double deltaY = playerPos.getY() - standPos.getY()
    @define Double deltaZ = playerPos.getZ() - standPos.getZ()

    # Horizontal distance for pitch calculation
    @define Double dist = math::sqrt(deltaX * deltaX + deltaZ * deltaZ)

    # Yaw = atan2(-deltaX, deltaZ). MSC only has single-arg math::arctan (in degrees),
    # so we apply quadrant correction manually.
    # Minecraft yaw: 0=south, 90=west, -90=east, 180=north
    @define Double yaw = 0.0D
    @if deltaZ > 0.0D
        @var yaw = math::arctan(-deltaX / deltaZ)
    @elseif deltaZ < 0.0D
        @if deltaX <= 0.0D
            @var yaw = math::arctan(-deltaX / deltaZ) + 180.0D
        @else
            @var yaw = math::arctan(-deltaX / deltaZ) - 180.0D
        @fi
    @else
        @if deltaX < 0.0D
            @var yaw = 90.0D
        @elseif deltaX > 0.0D
            @var yaw = -90.0D
        @fi
    @fi

    # Pitch = -atan2(deltaY, dist). dist is always >= 0, so the full quadrant
    # split isn't needed - only the dist == 0 (directly above/below) edge case.
    @define Double pitch = 0.0D
    @if dist > 0.0D
        @var pitch = -math::arctan(deltaY / dist)
    @elseif deltaY > 0.0D
        @var pitch = -90.0D
    @elseif deltaY < 0.0D
        @var pitch = 90.0D
    @fi

    # Head pose yaw is RELATIVE to body rotation, so subtract the stand's actual
    # body yaw - read live from the entity every tick in case it rotates.
    @define Double bodyYaw = Double(stand.getYaw())
    @define Double relativeYaw = yaw - bodyYaw

    # Normalize to -180..180
    @define Double headYaw = ((relativeYaw + 180.0D) % 360.0D) - 180.0D

    # Clamp pitch to armor stand head range (no math::min/max in MSC)
    @define Double headPitch = pitch
    @if headPitch < -40.0D
        @var headPitch = -40.0D
    @fi
    @if headPitch > 40.0D
        @var headPitch = 40.0D
    @fi

    @bypass /data merge entity caf9e342-47f5-47d2-ba68-e7152a892b19 {Pose:{Head:[{{headPitch}}f,{{headYaw}}f,0f]}}

    @delay 1

@done