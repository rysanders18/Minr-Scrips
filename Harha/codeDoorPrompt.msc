@using Harha
@fast

@cooldown 10s

@player &#32B773&lEnter Access Code (case sensitive)
@bypass playsound minecraft:ui.button.click master {{player}} ~ ~ ~ 1 1
        @define String answer 
        @prompt 20s answer &cYou took too long!
        @if answer == totalCode
            @player &a&lAccess granted!
            @bypass playsound minecraft:block.note_block.bell master {{player}} ~ ~ ~ 1 1
            @bypass playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 1
            @bypass minecraft:playsound minecraft:block.iron_door.open master {{player}} ~ ~ ~ 1 1
            @bypass minecraft:tp {{player}} -9061.5 96.0 9584.5 180 10
            @return
        @else
            @player &4&lInvalid code, access denied
            @bypass playsound minecraft:block.note_block.didgeridoo master {{player}} ~ ~ ~ 1 1
            @return
        @fi