        # @player DEBUG: {{text.substring(0, i)}} {{text.substring(i, i+1)}} {{text.substring(i+1, i + 2 - ((i + 2) / text.length()))}} {{text.substring(i + 2 - ((i + 2) / text.length()), text.length())}}
        @bypass /title {{player}} title ["",{"text":"{{text.substring(0, i)}}","bold":true,"color":"{{color1}}"},{"text":"{{text.substring(i, i+1)}}","bold":true,"color":"{{color3}}"},{"text":"{{text.substring(i+1, i + 2 - ((i + 2) / text.length()))}}","bold":true,"color":"{{color2}}"},{"text":"{{text.substring(i + 2 - ((i + 2) / text.length()), text.length())}}","bold":true,"color":"{{color1}}"}]
            # @define Int j = i % subtext.length()

        @if i <= subtext.length() - 2
            @bypass /title {{player}} subtitle ["",{"text":"{{subtext.substring(0, i)}}","bold":true,"color":"{{color4}}"},{"text":"{{subtext.substring(i, i+1)}}","bold":true,"color":"{{color6}}"},{"text":"{{subtext.substring(i+1, i + 2 - ((i + 2) / subtext.length()))}}","bold":true,"color":"{{color5}}"},{"text":"{{subtext.substring(i + 2 - ((i + 2) / subtext.length()), subtext.length())}}","bold":true,"color":"{{color4}}"}]
            @var j += 1
        @else
            @bypass /title {{player}} subtitle ["",{"text":"                    {{subtext}}                    ","bold":true,"color":"{{color4}}"}]
        @fi



        @bypass execute at {{player}} run particle minecraft:trial_spawner_detection ~ ~ ~ 0.5 0 0.5 00.01 5 normal
        @bypass execute at {{player}} run particle minecraft:trial_spawner_detection_ominous ~ ~ ~ 0.5 0 0.5 00.01 5 normal
        @delay 1
    @fi
@done

