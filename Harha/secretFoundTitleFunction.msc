@define String text = "Secret Found!"
@define String subtext = ""
@if secretNumber < 9
    @var subtext = "Secret 0{{secretNumber + 1}}"
@else
    @var subtext = "Secret {{secretNumber + 1}}"
@fi

@define String color1 = "#ffc71d"
@define String color2 = "aqua"
@define String color3 = "yellow"
@define String color4 = "gold"

