# @player &#ffff57&lS&#fff34b&le&#ffe73e&lc&#ffdb32&lr&#ffce25&le&#ffc219&lt &#ffb60c&l{{ij + 1}}&#ffaa00&l:
# @player &#ffff57&lB&#fff34b&lu&#ffe73e&li&#ffdb32&ll&#ffce25&lt &#ffc219&lb&#ffb60c&ly&#ffaa00&l: &e&l{{secretBuilders[ij]}}
