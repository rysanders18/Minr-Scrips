# secretFoundTitleFunction(Player player, Int secretNumber)

@fast
@using Harha

@define String[] secretBuilders = String["RYgamer1 & Crowenza", "leo_lazuli", "Crowenza", "Jasmine476", "masts", "Bin200", "Dalox02", "ItsPoekie", "RYgamer1 & Crowenza", "Jakube_", "johnplumber", "RYgamer1", "BoggledToggo", "Lennerd07", "JM4s", "Swifph & Tetration", "Vermilion_Stone", "TunaSuprise", "rmanimal", "Alienout", "RYgamer1", "Brickbolo", "ZombieKiler", "RYgamer1", "LendKaru"]
@define String[] secretDifficulties = String["&8&lExpert", "&a&lNovice", "&c&lVery Hard", "&6&lHard", "&b&lEasy", "&7&lNot Rated Yet", "&6&lHard", "&e&lModerate", "&7&lNot Rated Yet", "&6&lHard", "&6&lHard", "&6&lHard", "&c&lVery Hard", "&c&lVery Hard", "&c&lVery Hard", "&#e6e6e6&lUnassessed", "&8&lExpert", "&r&lVery Easy", "&7&lNot rated yet", "&c&lModerate", "&c&lVery Hard", "&c&lVery Hard", "&c&lVery Hard", "&e&lModerate", "&e&lModerate"]
