# Brick button

@fast
@using Harha
@cooldown 1d

@bypass /title {{player}} times 0 1000 100
@bypass /title {{player}} subtitle ["",{"text":" ","color":"#d4d4d4"}]
@bypass /title {{player}} title [{"sprite":"item/brick","atlas":"minecraft:items"},{"sprite":"item/brick","atlas":"minecraft:items"},{"sprite":"item/brick","atlas":"minecraft:items"}]

@for Int i in list::range(0, 10)
    @bypass /playsound minecraft:block.anvil.land master @s ~ ~ ~ 2 {{0.5 + (i * 0.001)}}
@done

@define String rank = player.getRank().toLowerCase()
@define String color
@if rank == "admins"
    @var color = "gold"
@elseif rank == "mods"
    @var color = "dark_green"
@elseif rank == "greenies"
    @var color = "green"
@elseif rank == "blues"
    @var color = "aqua"
@else
    @var color = "white"
@fi

@bypass /playsound minecraft:entity.chicken.egg master @s ~ ~ ~ 1 1.0
@bypass /tellraw @a [{"text":"{{player}}","color":"{{color}}"},{"text":": ","color":"white"},{"sprite":"item/brick","atlas":"minecraft:items","color":"white"}]
