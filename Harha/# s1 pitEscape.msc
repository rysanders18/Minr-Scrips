# Pit Escape Script
@cooldown 16s

@fast
@using Harha

# If timer has started, check if 24 hours have passed
@if pitEscapeStarted[player] == true
    @if ((system::currentTimeMillis() - pitEscapeTime[player]) >= 86400000)
        # 24 hours have passed - teleport the player out
        @player &a&lYour time is up! Good luck with your 2nd chance!
        @bypass /playsound minecraft:block.note_block.pling master @s ~ ~ ~ 1 1
        @delay 1s
        @var player.teleport(Position(-9343.5, 73.0, 9835.5, 0.0, 10.0, "Theta"))
        @bypass /playsound minecraft:entity.enderman.teleport master @s ~ ~ ~ 1 1

        @var pitEscapeStarted[player] = false
        @var pitEscapeTime[player] = 0L
        @return
    @else
        # Still waiting - show remaining time
        @bypass /playsound minecraft:ui.button.click master @s ~ ~ ~ 1 1
        @player &#d4d4d4&o(Time remaining: &l{{timer::formatTime(86400000 - (system::currentTimeMillis() - pitEscapeTime[player]))}}&#d4d4d4&o)
        @return
    @fi
@fi

# First click - start the 24 hour timer
@var pitEscapeStarted[player] = true
@var pitEscapeTime[player] = system::currentTimeMillis()

@player &cCongratulations! You failed a 3 block jump!
@bypass /playsound minecraft:block.note_block.bass master @s ~ ~ ~ 1 1.0

@delay 3s

@player &cYou are lucky I have decided to give you a second chance.
@bypass /playsound minecraft:block.note_block.bass master @s ~ ~ ~ 1 0.9

@delay 3s

@player &cThank the board, for forcing my grace upon you.
@bypass /playsound minecraft:block.note_block.bass master @s ~ ~ ~ 1 0.8

@delay 3s

@player &cFor failing this jump, you will be trapped in this pit for...
@bypass /playsound minecraft:block.note_block.bass master @s ~ ~ ~ 1 0.7

@delay 5s

@player &c&l24 hours! LOL!
@bypass /playsound minecraft:block.note_block.bass master @s ~ ~ ~ 1 0.6
@bypass /playsound minecraft:entity.ender_dragon.growl master @s ~ ~ ~ 1 1

@delay 2s
@player &#d4d4d4&o(Time remaining: &l{{timer::formatTime(86400000 - (system::currentTimeMillis() - pitEscapeTime[player]))}}&#d4d4d4&o)

