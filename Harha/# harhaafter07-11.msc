@var gradient = String[]
@var subtextGradient = String["#FFFFFF", "#FFFFFF"]
@var fadedGradient = String[]
@var flashColors = String["#FFFFFF", "#C0C0C0"]

# @var rainbowGradient2 = String["#ff0000", "#ff9900", "#ccff00", "#33ff00", "#00ff66", "#00ffff", "#0066ff", "#3300ff", "#cc00ff", "#ff0099"]
