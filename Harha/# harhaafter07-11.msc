# @var rainbowGradient2 = String["#ff0000", "#ff3500", "#ff6a00", "#ff9e00", "#ffd300", "#f6ff00", "#c1ff00", "#8dff00", "#58ff00", "#23ff00", "#00ff12", "#00ff46", "#00ff7b", "#00ffb0", "#00ffe5", "#00e5ff", "#00b0ff", "#007bff", "#0046ff", "#0012ff", "#2300ff", "#5800ff", "#8d00ff", "#c100ff", "#f600ff", "#ff00d3", "#ff009e", "#ff006a", "#ff0035", "#ff0000"]
# @var rainbowGradient = String["#ff9500", "#ff9a00", "#ffa000", "#ffa500", "#ffab00", "#ffb000", "#ffb500", "#ffbb00", "#ffc000", "#ffc600", "#ffcb00", "#ffd000", "#ffd600", "#ffdb00", "#ffe100", "#ffe600", "#ffec00", "#fff100", "#fff700", "#fffc00", "#fff700", "#fff100", "#ffec00", "#ffe600", "#ffe100", "#ffdb00", "#ffd600", "#ffd000", "#ffcb00", "#ffc600", "#ffc000", "#ffbb00", "#ffb500", "#ffb000", "#ffab00", "#ffa500", "#ffa000", "#ff9a00"]
# @var rainbowGradient = String["#ff6565", "#ff8565", "#ffa565", "#ffc565", "#ffe465", "#faff65", "#daff65", "#baff65", "#9aff65", "#7bff65", "#65ff70", "#65ff90", "#65ffb0", "#65ffcf", "#65ffef", "#66efff", "#66cfff", "#66b0ff", "#6690ff", "#6670ff", "#7b66ff", "#9b66ff", "#ba66ff", "#da66ff", "#fa66ff", "#ff66e5", "#ff66c5", "#ff66a5", "#ff6686", "#ff6666"]

