@var rainbowGradient = String["#57ffff", "#76faf0", "#8cf4e2", "#9defd3", "#aceac5", "#b8e4b6", "#c3dfa8", "#cdd999", "#d5d48b", "#ddce7c", "#e4c86d", "#eac25e", "#f0bc4e", "#f6b63c", "#fab027", "#ffaa00", "#fab027", "#f6b63c", "#f0bc4e", "#eac25e", "#e4c86d", "#ddce7c", "#d5d48b", "#cdd999", "#c3dfa8", "#b8e4b6", "#aceac5", "#9defd3", "#8cf4e2", "#76faf0"]
@var rainbowGradient2 = String["#57ffff", "#9defd3", "#c3dfa8", "#ddce7c", "#f0bc4e", "#ffaa00", "#f0bc4e", "#ddce7c", "#c3dfa8", "#9defd3", "#57ffff", "#9defd3", "#c3dfa8", "#ddce7c", "#f0bc4e", "#ffaa00", "#f0bc4e", "#ddce7c", "#c3dfa8", "#9defd3", "#57ffff", "#9defd3", "#c3dfa8", "#ddce7c", "#f0bc4e", "#ffaa00", "#f0bc4e", "#ddce7c", "#c3dfa8", "#9defd3"]










@var text = ""
@var subtext = ""

@var title1text = "Secrets Found: {{secretsFoundList[player].sum()}}"
@var title1subtext = "Secrets Completed: {{secretsCompletedList[player].sum()}}"

# # TODO: Change == to <
# @if sessionFalls[player] == pbFalls[player] && numberCompletions[player] > 1
#     @var title1subtext = "NEW PERSONAL BEST!"
# @fi

@var subtextGradient = rainbowGradient2
@var gradient = rainbowGradient


@var maxLength1 = 0

@if title1text.length() > title1subtext.length()
    @var maxLength1 = title1text.length()
@else
    @var maxLength1 = title1subtext.length()
@fi

# @player DEBUG: appearing

# Text appears 1 char at a time
@var gradientOffset = 0
@for Int i in list::range(2, maxLength1 + 2)
# @var gradient = lchGradient(rainbowGradient[((-i * 2) + 100 + gradientOffset) % rainbowGradient.length()], rainbowGradient2[(i + gradientOffset + 3) % rainbowGradient2.length()], maxLength1 + 2, "shorter") 
    @var text = ""
    @var subtext = ""
    @for Int j in list::range(0, i - 1)
        @if title1text.length() >= j + 1
            @var text += String("&" + gradient[(j + i + 100) % gradient.length()] + "&l" + title1text.substring(j, j + 1))

            # @if j == 0
            #     @player DEBUG: {{i % rainbowGradient.length()}}
            # @fi

        @fi
        @if title1subtext.length() >= j + 1
            @var subtext += String("&" + subtextGradient[(j + i + 100) % subtextGradient.length()] + "&l" + title1subtext.substring(j, j + 1))

        @fi
    @done
    @delay 1
    @if Region("hh2", "Theta_the_end").containsPlayer(player) == false
        @bypass /title @s subtitle [""]
        @bypass /title @s title [""]
        @return
    @fi
    @bypass /title @s subtitle {{slytools::convertTextToTellraw(subtext)}}
    @bypass /title @s title {{slytools::convertTextToTellraw(text)}}
    # @if musicEnabled[player] == false
        @bypass /playsound minecraft:entity.item.pickup master @s ~ ~ ~ 0.5 {{Float(i + 1) / Float(maxLength1) * 1.5 + 0.5}}
    # @fi


@done

@var gradientOffset += maxLength1 + 2

# @player DEBUG: flashing

# Text flash code
@for Int i in list::range(0, maxLength1 + 4)
@define Int flashPos = i * 2
# @var gradient = lchGradient(rainbowGradient[((-i * 2) + 100 + gradientOffset) % rainbowGradient.length()], rainbowGradient2[(i + gradientOffset + 3) % rainbowGradient.length()], maxLength1 + 2, "shorter")
@var text = ""
@var subtext = ""
    @for Int j in list::range(0, maxLength1)
        @if title1text.length() >= j + 1
            @if j == flashPos
                @var text += String("&" + flashColors[0] + "&l&n" + title1text.substring(j, j + 1))
            @elseif j == flashPos - 1
                @var text += String("&" + flashColors[0] + "&l&n" + title1text.substring(j, j + 1))
            @else
                @var text += String("&" + gradient[(j + i + gradientOffset) % gradient.length()] + "&l" + title1text.substring(j, j + 1))
            @fi
        @fi

            # @if j == 0
            #     @player DEBUG: {{(i + gradientOffset) % rainbowGradient.length()}}
            # @fi



        # Subtext flashing on normal

        @if title1subtext.length() >= j + 1
            @if j == flashPos
            @var subtext += String("&" + flashColors[0] + "&l&n" + title1subtext.substring(j, j + 1))
            @elseif j == flashPos - 1
            @var subtext += String("&" + "#EEEEEE" + "&l&n" + title1subtext.substring(j, j + 1))
            @else
            @var subtext += String("&" + subtextGradient[(j + i + gradientOffset) % subtextGradient.length()] + "&l" + title1subtext.substring(j, j + 1))
            @fi
        @fi

    @done
    @delay 1
    @if Region("hh2", "Theta_the_end").containsPlayer(player) == false
        @bypass /title @s subtitle [""]
        @bypass /title @s title [""]
        @return
    @fi
    @bypass /title @s subtitle {{slytools::convertTextToTellraw(subtext)}}
    @bypass /title @s title {{slytools::convertTextToTellraw(text)}}
    # @bypass /playsound minecraft:block.note_block.pling master @s ~ ~ ~ 0.5 {{Float(i + 1) / Float(maxLength1) * 1.5 + 0.5}}
@done

@var gradientOffset += maxLength1 + 4

# @player DEBUG: holding

# Text stays for x cycles, cycling through rainbow
@var cyclesToStay = 25
@for Int i in list::range(0, cyclesToStay)
# @var gradient = lchGradient(rainbowGradient[((-i * 2) + 100 + gradientOffset) % rainbowGradient.length()], rainbowGradient2[(i + gradientOffset + 3) % rainbowGradient.length()], maxLength1 + 2, "shorter") 
    @var text = ""
    @var subtext = ""
    @for Int j in list::range(0, maxLength1)
        @if title1text.length() >= j + 1
            @var text += String("&" + gradient[(j + i + gradientOffset) % gradient.length()] + "&l" + title1text.substring(j, j + 1))

            # @if j == 0
            #     @player DEBUG: {{(i + maxLength1 * 2 + 6) % rainbowGradient.length()}}
            # @fi


        @fi
        @if title1subtext.length() >= j + 1
            @var subtext += String("&" + subtextGradient[(j + i + gradientOffset) % subtextGradient.length()] + "&l" + title1subtext.substring(j, j + 1))
        @fi
    @done
    @delay 1
    @if Region("hh2", "Theta_the_end").containsPlayer(player) == false
        @bypass /title @s subtitle [""]
        @bypass /title @s title [""]
        @return
    @fi
    @bypass /title @s subtitle {{slytools::convertTextToTellraw(subtext)}}
    @bypass /title @s title {{slytools::convertTextToTellraw(text)}}

@done

@var gradientOffset += cyclesToStay + 1

# @player DEBUG: disappearing

# Text disappear 1 char at a time
@for Int i in list::range(-1, maxLength1 - 1)
@define Int disappearLength = maxLength1 - i - 1
# @var gradient = lchGradient(rainbowGradient[((-i * 2) + 100 + gradientOffset) % rainbowGradient.length()], rainbowGradient2[(i + gradientOffset + 3) % rainbowGradient.length()], maxLength1 + 2, "shorter") 
    @var text = ""
    @var subtext = ""
    @for Int j in list::range(0, disappearLength)
        @if title1text.length() >= j + 1
            @var text += String("&" + gradient[(j + i + gradientOffset) % gradient.length()] + "&l" + title1text.substring(j, j + 1))

            # @if j == 0
            #     @player DEBUG: {{(i + gradientOffset) % rainbowGradient.length()}}
            # @fi


        @fi
        @if title1subtext.length() >= j + 1
            @var subtext += String("&" + subtextGradient[(j + disappearLength) % subtextGradient.length()] + "&l" + title1subtext.substring(j, j + 1))
        @fi
    @done
    @delay 1
    @if Region("hh2", "Theta_the_end").containsPlayer(player) == false
        @bypass /title @s subtitle [""]
        @bypass /title @s title [""]
        @return
    @fi
    @bypass /title @s subtitle {{slytools::convertTextToTellraw(subtext)}}
    @bypass /title @s title {{slytools::convertTextToTellraw(text)}}
    # @if musicEnabled[player] == false
        @bypass /playsound minecraft:entity.item.pickup master @s ~ ~ ~ 0.5 {{2.0 - (Float(maxLength1 - disappearLength) / Float(maxLength1) * 1.5)}}
    # @fi

@done

@bypass /title @s subtitle [""]
@bypass /title @s title [""]

@delay 3

















