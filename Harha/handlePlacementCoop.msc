# handlePlacement(Block block, Int height, Player player)


@fast
@using Harha

# define variables for less typing
@define Int x = block.getX()
@define Int y = block.getY()
@define Int z = block.getZ()
@define String temporaryBlockSelection = block.getBlockType().toLowerCase()

@if temporaryBlockSelection == "wet_sponge"
    @bypass /particle minecraft:splash {{x}} {{y + 0.6}} {{z}} 0.3 0.6 0.3 1 15
@elseif temporaryBlockSelection == "crying_obsidian"
    @bypass /particle minecraft:dragon_breath {{x}} {{y + 0.6}} {{z}} 0.3 0.3 0.3 .01 10
@elseif temporaryBlockSelection == "sculk_catalyst"
    @if (totalFalls / 1000) < 101
        @bypass /particle minecraft:scrape {{x}} {{y + 1.0}} {{z}} 0.3 0 0.3 0.3 {{totalFalls / 1000}}
    @else
        @bypass /particle minecraft:scrape {{x}} {{y + 1.0}} {{z}} 0.3 0 0.3 0.3 100
    @fi
@elseif coolGlass == true && temporaryBlockSelection == "orange_stained_glass"
    @bypass /particle minecraft:trial_spawner_detection {{x}} {{y + 1.0}} {{z}} 0.3 0.3 0.3 00.01 15
    @bypass /particle dust{color:[1.000,0.533,0.220],scale:1} {{x}} {{y + 1.0}} {{z}} .3 .1 .3 1 10 normal
@elseif coolGlass == true && temporaryBlockSelection == "light_blue_stained_glass"
    @bypass /particle minecraft:trial_spawner_detection_ominous {{x}} {{y + 1.0}} {{z}} 0.3 0.3 0.3 00.01 15
    @bypass /particle dust{color:[0.471,0.965,1.000],scale:1} {{x}} {{y + 1.0}} {{z}} .3 .1 .3 1 10 normal
@elseif woolList.contains(temporaryBlockSelection)
    @define String[] woolParticleList = String["0.824,0.000,0.000", "1.000,0.569,0.000", "1.000,1.000,0.000", "0.035,1.000,0.000", "0.000,0.969,1.000", "0.122,0.741,0.824", "0.000,0.055,0.824", "0.412,0.000,0.824", "0.741,0.000,0.824", "0.824,0.380,0.780"] 
    @bypass /particle dust{color:[{{woolParticleList[woolList.find(String(temporaryBlockSelection))]}}],scale:1} {{x}} {{y + 1.0}} {{z}} .3 .1 .3 1 10 normal
@fi
    


# time block stays + 1 from target script
@if blockSelection[player] == "blue_ice"
    @delay 6
@else
    @delay 4
@fi

@define String axis = ""
@define String facing = ""
@define String half = ""
@define String type = ""
@define String north = ""
@define String east = ""
@define String south = ""
@define String west = ""
# handles orientation
@if String(block).contains("axis=x")
    @var axis = "x"
@elseif String(block).contains("axis=z")
    @var axis = "z"
@elseif String(block).contains("axis=y")
    @var axis = "y"
@fi

@if String(block).contains("facing=north")
    @var facing = "north"
@elseif String(block).contains("facing=east")
    @var facing = "east"
@elseif String(block).contains("facing=south")
    @var facing = "south"
@elseif String(block).contains("facing=west")
    @var facing = "west"
@fi

@if String(block).contains("half=top")
    @var half = "top"
@elseif String(block).contains("half=bottom")
    @var half = "bottom"
@fi

@if String(block).contains("type=top")
    @var type = "top"
@elseif String(block).contains("type=bottom")
    @var type = "bottom"
@fi

@if String(block).contains("north=true")
    @var north = "true"
@fi
@if String(block).contains("east=true")
    @var east = "true"
@fi
@if String(block).contains("south=true")
    @var south = "true"
@fi
@if String(block).contains("west=true")
    @var west = "true"
@fi

@if player.getWorld() == "Theta"
    @bypass /execute in minecraft:theta run setblock {{x}} {{y}} {{z}} air
    @bypass /execute in minecraft:theta run summon falling_block {{x}} {{y}} {{z}} {BlockState:{Name:"{{temporaryBlockSelection}}",Properties:{bloom:"true",axis:"{{axis}}",facing:"{{facing}}",half:"{{half}}",type:"{{type}}",north:"{{north}}",east:"{{east}}",south:"{{south}}",west:"{{west}}"}},Time:1,DropItem:0b,CancelDrop:1b}

    @var delay(delayTimes[height - 1])

    @if (grateList.contains(temporaryBlockSelection))
        @bypass /playsound minecraft:block.copper_grate.break master @a[distance=..20] {{x}} {{y - height}} {{z}} 1 1
    @elseif (woolList.contains(temporaryBlockSelection))
        @bypass /playsound minecraft:block.wool.break master @a[distance=..20] {{x}} {{y - height}} {{z}} 1 0.8
    @elseif temporaryBlockSelection == "flowering_azalea_leaves"
        @bypass /playsound minecraft:block.azalea_leaves.break master @a[distance=..20] {{x}} {{y - height}} {{z}} 1 0.8
    @elseif (glassList.contains(temporaryBlockSelection)) || temporaryBlockSelection == "blue_ice"
        @bypass /playsound minecraft:block.glass.break master @a[distance=..20] {{x}} {{y - height}} {{z}} 0.3 0.8
    @elseif (blocksSound.contains(temporaryBlockSelection))
        @bypass /playsound minecraft:block.stone.break master @a[distance=..20] {{x}} {{y - height}} {{z}} 1 0.8
    @elseif (blocksSoundOres.contains(temporaryBlockSelection)) && temporaryBlockSelection != "iron_block"
        @bypass /playsound minecraft:block.stone.break master @a[distance=..20] {{x}} {{y - height}} {{z}} 1 1.2
    @elseif temporaryBlockSelection == "iron_block"
        @bypass /playsound minecraft:block.iron.break master @a[distance=..20] {{x}} {{y - height}} {{z}} 1 1
    @elseif (pumpkinList.contains(temporaryBlockSelection))
        @bypass /playsound minecraft:block.wood.break master @a[distance=..20] {{x}} {{y - height}} {{z}} 0.5 0.8
    @elseif (coralList.contains(temporaryBlockSelection))
        @if temporaryBlockSelection.contains("dead")
            @bypass /playsound minecraft:block.stone.break master @s {{x}} {{y - height}} {{z}} 1 0.8
        @else
            @bypass /playsound minecraft:block.coral_block.break master @s {{x}} {{y - height}} {{z}} 1 0.8
        @fi
    @else
        @bypass /playsound minecraft:block.{{temporaryBlockSelection}}.break master @a[distance=..20] {{x}} {{y - height}} {{z}} 1 0.8
    @fi

    # Particle of block breaking
    @bypass /execute in minecraft:theta run particle block{block_state:{Name:{{temporaryBlockSelection}}}} {{x}} {{y - height}} {{z}} 0.3 0.3 0.3 1 40

@else
    @bypass /execute in minecraft:theta_the_end run setblock {{x}} {{y}} {{z}} air
    @bypass /execute in minecraft:theta_the_end run summon falling_block {{x}} {{y}} {{z}} {BlockState:{Name:"{{temporaryBlockSelection}}",Properties:{bloom:"true",axis:"{{axis}}",facing:"{{facing}}",half:"{{half}}",type:"{{type}}",north:"{{north}}",east:"{{east}}",south:"{{south}}",west:"{{west}}"}},Time:1,DropItem:0b,CancelDrop:1b}
@fi

@return

