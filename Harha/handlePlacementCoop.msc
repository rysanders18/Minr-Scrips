# handlePlacementCoop(Block block, Int height, Player player)


@fast
@using Harha

# define variables for less typing
@define Int x = block.getX()
@define Int y = block.getY()
@define Int z = block.getZ()
@define String temporaryBlockSelection = block.getBlockType().toLowerCase()

# time block stays + 1 from target script
@delay 7

@bypass /execute in minecraft:theta run setblock {{x}} {{y}} {{z}} air
@bypass /execute in minecraft:theta run summon falling_block {{x}} {{y}} {{z}} {BlockState:{Name:"{{temporaryBlockSelection}}",Properties:{bloom:"true"}},Time:1,DropItem:0b,CancelDrop:1b}

@var delay(delayTimes[height - 1])

@bypass /playsound minecraft:block.wool.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
@bypass /execute in minecraft:theta run particle block{block_state:{Name:{{temporaryBlockSelection}}}} {{x}} {{y - height}} {{z}} 0.3 0.3 0.3 1 40


@return

