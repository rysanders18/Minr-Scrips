@for Int i in list::range(0, 399)
    @if volume86[i] == 0.0F
        @var Harha::delay(instrument86[i])
    @else
        @if panning86[i] == 0.0D
            @bypass /execute as {{player}} at @s run playsound block.note_block.{{instrumentNames[instrument86[i]]}} master @p ~ ~ ~ {{volume86[i]}} {{pitch86[i]}}
        @else
            @bypass /execute as {{player}} at @s run playsound block.note_block.{{instrumentNames[instrument86[i]]}} master @p ~{{ panning86[i] * math::cos(Double(player.getYaw() + 180)) }} ~ ~{{ panning86[i] * math::sin(Double(player.getYaw() + 180)) }} {{volume86[i]}} {{pitch86[i]}}
        @fi
    @fi
@done
