            @bypass /execute as {{player}} at @s run playsound block.note_block.{{instrumentNames[instrument1[i]]}} master @p ~ ~ ~ {{volume1[i]}} {{pitch1[i]}}
        @else
            @bypass /execute as {{player}} at @s run playsound block.note_block.{{instrumentNames[instrument1[i]]}} master @p ~{{ panning1[i] * math::cos(Double(player.getYaw() + 180)) }} ~ ~{{ panning1[i] * math::sin(Double(player.getYaw() + 180)) }} {{volume1[i]}} {{pitch1[i]}}
        @fi
    @fi
@done

