        @else
            @bypass /execute as {{player}} at @s run playsound block.note_block.{{instrumentNames[instrument16[i]]}} master @p ~{{ panning16[i] * math::cos(Double(player.getYaw() + 180)) }} ~ ~{{ panning16[i] * math::sin(Double(player.getYaw() + 180)) }} {{volume16[i]}} {{pitch16[i]}}
