@for Int i in list::range(0, 1000)
    @if volume75[i] == 0.0F
        @var Harha::delay(instrument75[i])
    @else
        @if panning75[i] == 0.0D
            @bypass /execute as {{player}} at @s run playsound block.note_block.{{instrumentNames[instrument75[i]]}} master @p ~ ~ ~ {{volume75[i]}} {{pitch75[i]}}
        @else
            @bypass /execute as {{player}} at @s run playsound block.note_block.{{instrumentNames[instrument75[i]]}} master @p ~{{ panning75[i] * math::cos(Double(player.getYaw() + 180)) }} ~ ~{{ panning75[i] * math::sin(Double(player.getYaw() + 180)) }} {{volume75[i]}} {{pitch75[i]}}
        @fi
    @fi
@done

