        @else
            @bypass /execute as {{player}} at @s run playsound block.note_block.{{instrumentNames[instrument3[i]]}} master @p ~{{ panning3[i] * math::cos(Double(player.getYaw() + 180)) }} ~ ~{{ panning3[i] * math::sin(Double(player.getYaw() + 180)) }} {{volume3[i]}} {{pitch3[i]}}
