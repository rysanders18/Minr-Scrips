        @else
            @bypass /execute as {{player}} at @s run playsound block.note_block.{{instrumentNames[instrument4[i]]}} master @p ~{{ panning4[i] * math::cos(Double(player.getYaw() + 180)) }} ~ ~{{ panning4[i] * math::sin(Double(player.getYaw() + 180)) }} {{volume4[i]}} {{pitch4[i]}}
