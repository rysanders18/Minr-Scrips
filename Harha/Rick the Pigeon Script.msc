# Rick the Pigeon Script
@cooldown 30s

@fast
@using Harha

@if rickDone

    @bypass /playsound minecraft:block.note_block.pling master @s ~ ~ ~ 1 1

    @player &#d4d4d4--------------------------------------
    @player &7&lRick the Pigeon&7: &#d4d4d4&o(Sup. Already counted with me. Go touch grass.)
    @player &#d4d4d4--------------------------------------

    # TODO: PLACEHOLDER - re-grant reward here if needed

    @return
@fi

# Hourly cooldown after failure
@if rickTalk[player] == true
    @if ((system::currentTimeMillis() - rickcd) < 3600000)
        @player &7&lRick&7: *coo...*
        @bypass /playsound minecraft:entity.parrot.ambient master @s ~ ~ ~ 1.0 0.5
        @delay 3s
        @player &#d4d4d4&o(Rick is still sulking. He'll be back in &l{{timer::formatTime(3600000 - (system::currentTimeMillis() - rickcd))}}&#d4d4d4&o.)
        @return
    @fi
@fi

# Variable sets
@define String rickprompt

# Set rickcd
@var rickcd = system::currentTimeMillis()

# First time speaking
@if !rickTalk
    @var rickTalk = true
@fi

# Pigeon arrives
@bypass /playsound minecraft:entity.parrot.ambient master @s ~ ~ ~ 1.3 0.7
@player &7&lRick the Pigeon&7: *COO!*
@delay 2s
@player &#d4d4d4&oA grimy pigeon waddles up. One eye twitches. He's clutching a tiny briefcase.
@delay 3s

# Translation Device
@player &7&l&kR &#d4d4d4&lActivating Pigeon Translation Device . . . &7&l&kR

@bypass /particle minecraft:poof ~ ~ ~ 1 1 1 0.1 40 normal @s
@bypass /playsound minecraft:item.armor.equip_leather master @s ~ ~ ~ 1.0 1.0
@bypass /playsound minecraft:block.note_block.bass master @s ~ ~ ~ 1.0 0.8
@delay 4
@bypass /playsound minecraft:block.note_block.bass master @s ~ ~ ~ 1.0 1.2
@delay 4
@bypass /playsound minecraft:block.note_block.bass master @s ~ ~ ~ 1.0 1.6

@delay 2s

# Dialogue
@bypass /playsound minecraft:entity.parrot.ambient master @s ~ ~ ~ 1.0 0.7
@player &7&lRick&7: Coo. &#d4d4d4&o(Name's Rick. I count. That's the whole bit.)
@delay 3s

@bypass /playsound minecraft:entity.parrot.ambient master @s ~ ~ ~ 1.0 0.8
@player &7&lRick&7: Coo coo. &#d4d4d4&o(Got a test. Hope your typing fingers are warmed up.)
@delay 3s

@bypass /playsound minecraft:entity.parrot.ambient master @s ~ ~ ~ 1.0 0.9
@player &7&lRick&7: COO! &#d4d4d4&o(Count. &6&l1 to 1,000&#d4d4d4&o. One at a time. No skipping. No typos.)
@delay 3s

@bypass /playsound minecraft:entity.parrot.ambient master @s ~ ~ ~ 1.0 0.7
@player &7&lRick&7: Coo. &#d4d4d4&o(&l20 seconds per number&#d4d4d4&o. Slip once and I'm out.)
@delay 3s

@bypass /playsound minecraft:entity.parrot.imitate.ender_dragon master @s ~ ~ ~ 2 1.5
@bypass /particle minecraft:poof ~ ~1 ~ 1 1 1 0.5 50 normal @s
@player &7&lRick&7: COO COO?! &#d4d4d4&l(START.)
@player &#d4d4d4[Type each number in chat]

# Counting loop 1 -> 1000
@for Int counter in list::range(1, 1001)

    @prompt 20s rickprompt Rick got distracted by a breadcrumb...

    # Wrong / timeout
    @if rickprompt != String(counter)

        @bypass /playsound minecraft:entity.parrot.hurt master @s ~ ~ ~ 1.0 0.8
        @delay 2
        @bypass /playsound minecraft:entity.parrot.death master @s ~ ~ ~ 1.0 0.8

        @player &7&lRick&7: *disappointed coo* &#d4d4d4&o(Expected &l{{counter}}&#d4d4d4&o. Got &l{{rickprompt}}&#d4d4d4&o. That's an L.)
        @delay 2s

        @player &#d4d4d4&oRick shakes his head and flaps away, muttering.
        @bypass /playsound minecraft:entity.parrot.fly master @s ~ ~ ~ 1.0 1.0

        @return
    @fi

    # Milestone hype
    @if counter == 100
        @bypass /playsound minecraft:entity.parrot.ambient master @s ~ ~ ~ 1.0 1.5
        @player &7&lRick&7: &#d4d4d4&o(&l100&#d4d4d4&o. Lock in.)
    @fi
    @if counter == 250
        @bypass /playsound minecraft:entity.parrot.ambient master @s ~ ~ ~ 1.0 1.5
        @player &7&lRick&7: &#d4d4d4&o(Quarter way. Don't choke.)
    @fi
    @if counter == 500
        @bypass /playsound minecraft:entity.parrot.ambient master @s ~ ~ ~ 1.0 1.5
        @player &7&lRick&7: &#d4d4d4&o(&l500&#d4d4d4&o. Halfway. I'm kinda impressed ngl.)
    @fi
    @if counter == 750
        @bypass /playsound minecraft:entity.parrot.ambient master @s ~ ~ ~ 1.0 1.5
        @player &7&lRick&7: &#d4d4d4&o(Three quarters. This is unreal.)
    @fi
    @if counter == 999
        @bypass /playsound minecraft:entity.parrot.ambient master @s ~ ~ ~ 1.0 1.8
        @player &7&lRick&7: &#d4d4d4&o(One more. Don't fumble.)
    @fi

@done

# SUCCESS
@bypass /playsound minecraft:entity.parrot.imitate.ender_dragon master @s ~ ~ ~ 2 1.0
@bypass /particle minecraft:firework ~ ~ ~ 0 0 0 1 100 normal @s
@bypass /particle minecraft:poof ~ ~ ~ 2 2 2 0.5 150 normal @s

@player &7&lRick the Pigeon&7: COOOOO?!?! &#d4d4d4&o(ALL ONE THOUSAND?! You actually counted all of it??)
@delay 3s

@bypass /playsound minecraft:entity.parrot.ambient master @s ~ ~ ~ 1.0 1.2
@player &7&lRick&7: Coo... &#d4d4d4&o(I've been asking pigeons for YEARS. None of them could count past 7. You ate.)
@delay 3s

@bypass /playsound minecraft:entity.parrot.ambient master @s ~ ~ ~ 1.0 1.0
@player &7&lRick&7: Coo coo. &#d4d4d4&o(Respect. Take this — you earned it.)
@delay 3s

@bypass /particle minecraft:firework ~ ~ ~ 0 0 0 1 150 normal @s
@bypass /playsound minecraft:block.note_block.pling master @s ~ ~ ~ 1 1
@bypass /playsound minecraft:entity.firework_rocket.launch master @s ~ ~ ~ 1.0 1.0

@player &#d4d4d4--------------------------------------
@player &7&lR&8&li&7&lc&8&lk&7&l's &7&lR&8&le&7&lw&8&la&7&lr&8&ld
@player
@player &#d4d4d4● PLACEHOLDER: reward goes here
@player
@player &#d4d4d4● For counting higher than any pigeon ever has.
@player
@player &6Reward unlocked!
@player &#d4d4d4--------------------------------------

# TODO: PLACEHOLDER - reward implementation goes here
# Example patterns (mirror Donna Blavo script for reference):
#   @bypass /item replace entity @s armor.head with ...
#   @var someCosmeticUnlock[player] = true

@var rickDone = true

# Note for RY - reward here