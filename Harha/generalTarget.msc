# generalTarget(Block block, Int[] directions, Int level, Int height, Player player) https://paste.minr.org/noquxenude
@using Harha
@fast

# if block not in main hand (i.e. player did not place block), do nothing
@if (player.getItemInMainHand().getItemType().toLowerCase() == "air" && player.getItemInOffHand().getItemType().toLowerCase() == "air")
    @return
@fi

# Necessary 1t delay because dumb stupid complicated minecraft mechanics
@delay 1

@define Int[] directionsX = Int[]
@define Int[] directionsY = Int[]
@define Int[] directionsZ = Int[]

@if directions[0] == 1
    @var directionsX.append(0)
    @var directionsY.append(0)
    @var directionsZ.append(-1)
@fi
@if directions[1] == 1
    @var directionsX.append(1)
    @var directionsY.append(0)
    @var directionsZ.append(0)
@fi
@if directions[2] == 1
    @var directionsX.append(0)
    @var directionsY.append(0)
    @var directionsZ.append(1)
@fi
@if directions[3] == 1
    @var directionsX.append(-1)
    @var directionsY.append(0)
    @var directionsZ.append(0)
@fi
@if directions[4] == 1
    @var directionsX.append(0)
    @var directionsY.append(1)
    @var directionsZ.append(0)
@fi
@if directions[5] == 1
    @var directionsX.append(0)
    @var directionsY.append(-1)
    @var directionsZ.append(0)
@fi

# Scan for adjacent blockSelection blocks
# Basically this sets offsetXYZ to (1, 0, 0) then (-1, 0, 0) then (0, 1, 0) then ... then (0, 0, -1) for all 6 directions
# In other words it checks each side of the target, and if that block is "YOUR_BLOCK_HERE" then it runs the setAir() function
@for Int i in list::range(0, directionsX.length())
    # get current offset positions
    @define Int offsetX = directionsX[i]
    @define Int offsetY = directionsY[i]
    @define Int offsetZ = directionsZ[i]
    
    # get current adjacent block
    @define Block adjacentBlock = Block(block.getX() + offsetX, block.getY() + offsetY, block.getZ() + offsetZ, block.getWorld())
    
    # if adjacentBlock = a block that can be selected
    @if adjacentBlock.getBlockType() != "AIR"
        
        @var totalBlocks[player] += 1
        @if sessionBlocks[player] % Int(math::random(5.0D, 8.0D)) == 0
            @var top100Function(player, 0)
        @fi
        @var sessionBlocks[player] += 1
        @var globalBlocks += 1
        @var blocksThisStage[player] += 1
        @var blocksThisStageGlobal[level] += 1
        
        # Handles cosmetics
        @if cosmeticSwap100[player] == true && blockSelection != "blue_ice" && blockSelection != "slime_block"
            @var cosmetic100(player)
        @elseif cosmeticSwap[player] == true
            @if (grateList.contains(blockSelection))
                @var cosmeticCopper(player)
            @elseif (coralList.contains(blockSelection))
                @var cosmeticCoral(player)
            @elseif coolGlass == true && (coolGlassList.contains(blockSelection))
                @var cosmeticCoolGlass(player)
            @elseif (woolList.contains(blockSelection))
                @var cosmeticWool(player)
            @elseif (glassList.contains(blockSelection)) && coolGlass == false
                @var cosmeticGlass(player)
            @elseif (spongeList.contains(blockSelection))
                @var cosmeticSponge(player)
            @elseif (leafList.contains(blockSelection))
                @var cosmeticLeaf(player)
            @elseif (obsidianList.contains(blockSelection))
                @var cosmeticObsidian(player)
            @elseif (oreList.contains(blockSelection))
                @var cosmeticOre(player)
            @elseif (pumpkinList.contains(blockSelection))
                @var cosmeticPumpkin(player)
            @elseif (paleGardenList.contains(blockSelection))
                @var cosmeticPaleGarden(player)
            @elseif (froglightList.contains(blockSelection))
                @var cosmeticFroglight(player)
            @fi
        @fi
        
        
        @if player.getCurrentChallenge() == "hahahaha" || difficultySelection[player] == "master"
            @if level >= 30 && level <= 39
                @if bootsObtained == true
                    @if level == 30
                        @var sectionBlocksPlacedMaster[player][39] += 1
                    @elseif level == 31
                        @var sectionBlocksPlacedMaster[player][38] += 1
                    @elseif level == 32
                        @var sectionBlocksPlacedMaster[player][37] += 1
                    @elseif level == 33
                        @var sectionBlocksPlacedMaster[player][36] += 1
                    @elseif level == 34
                        @var sectionBlocksPlacedMaster[player][35] += 1
                    @fi
                @else
                    @var sectionBlocksPlacedMaster[player][level] += 1
                @fi
            @else
                @var sectionBlocksPlacedMaster[player][level] += 1
            @fi
        @elseif player.getCurrentChallenge() == "hahahahaha" || difficultySelection[player] == "ultraMaster"
            @if level >= 30 && level <= 39
                @if bootsObtained == true
                    @if level == 30
                        @var sectionBlocksPlacedUMM[player][39] += 1
                    @elseif level == 31
                        @var sectionBlocksPlacedUMM[player][38] += 1
                    @elseif level == 32
                        @var sectionBlocksPlacedUMM[player][37] += 1
                    @elseif level == 33
                        @var sectionBlocksPlacedUMM[player][36] += 1
                    @elseif level == 34
                        @var sectionBlocksPlacedUMM[player][35] += 1
                    @fi
                @else
                    @var sectionBlocksPlacedUMM[player][level] += 1
                @fi
            @else
                @var sectionBlocksPlacedUMM[player][level] += 1
            @fi
        @elseif player.getCurrentChallenge() == "hahahas" || difficultySelection[player] == "soulLink"
            @if level >= 30 && level <= 39
                @if bootsObtained == true
                    @if level == 30
                        @var sectionBlocksPlacedSoulLink[player][39] += 1
                    @elseif level == 31
                        @var sectionBlocksPlacedSoulLink[player][38] += 1
                    @elseif level == 32
                        @var sectionBlocksPlacedSoulLink[player][37] += 1
                    @elseif level == 33
                        @var sectionBlocksPlacedSoulLink[player][36] += 1
                    @elseif level == 34
                        @var sectionBlocksPlacedSoulLink[player][35] += 1
                    @fi
                @else
                    @var sectionBlocksPlacedSoulLink[player][level] += 1
                @fi
            @else
                @var sectionBlocksPlacedSoulLink[player][level] += 1
            @fi
        @elseif player.getCurrentChallenge() == "hahahahas" || difficultySelection[player] == "masterSoulLink"
            @if level >= 30 && level <= 39
                @if bootsObtained == true
                    @if level == 30
                        @var sectionBlocksPlacedMasterSoulLink[player][39] += 1
                    @elseif level == 31
                        @var sectionBlocksPlacedMasterSoulLink[player][38] += 1
                    @elseif level == 32
                        @var sectionBlocksPlacedMasterSoulLink[player][37] += 1
                    @elseif level == 33
                        @var sectionBlocksPlacedMasterSoulLink[player][36] += 1
                    @elseif level == 34
                        @var sectionBlocksPlacedMasterSoulLink[player][35] += 1
                    @fi
                @else
                    @var sectionBlocksPlacedMasterSoulLink[player][level] += 1
                @fi
            @else
                @var sectionBlocksPlacedMasterSoulLink[player][level] += 1
            @fi
        @else
            @if level >= 30 && level <= 39
                @if bootsObtained == true
                    @if level == 30
                        @var sectionBlocksPlacedNormal[player][39] += 1
                    @elseif level == 31
                        @var sectionBlocksPlacedNormal[player][38] += 1
                    @elseif level == 32
                        @var sectionBlocksPlacedNormal[player][37] += 1
                    @elseif level == 33
                        @var sectionBlocksPlacedNormal[player][36] += 1
                    @elseif level == 34
                        @var sectionBlocksPlacedNormal[player][35] += 1
                    @fi
                @else
                    @var sectionBlocksPlacedNormal[player][level] += 1
                @fi
            @else
                @var sectionBlocksPlacedNormal[player][level] += 1
            @fi
        @fi
        
        @var handlePlacement(adjacentBlock, height, player)
    @fi
@done

# Run loop again for anticheat
@for Int i in list::range(0, directionsX.length())
    # get current offset positions
    @define Int offsetX = directionsX[i]
    @define Int offsetY = directionsY[i]
    @define Int offsetZ = directionsZ[i]
    
    # get current adjacent block
    @define Block adjacentBlock = Block(block.getX() + offsetX, block.getY() + offsetY, block.getZ() + offsetZ, block.getWorld())
    
    @var anticheat(adjacentBlock, player)
@done
