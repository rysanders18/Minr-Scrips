# fallTracker(Player player) https://paste.minr.org/okamoxejoc

@fast
@using Harha

@var calculate100(player)
@define String fallTrackerSoulLinkFalls = ""
@define String fallTrackerSoulLinkBlocks = ""

@if (difficultySelection[player] != "soulLink" || player.getCurrentChallenge() != "hahahas") && (difficultySelection[player] != "masterSoulLink" || player.getCurrentChallenge() == "hahahas" || player.getCurrentChallenge() == "masterSoulLink")
@if numberCompletions == 0
    @bypass /item replace entity {{player}} container.8 with nether_star[consumable={consume_seconds:1.6,animation:"eat",on_consume_effects:[{type:"minecraft:apply_effects",effects:[{id:"minecraft:slowness",amplifier:5,duration:200,show_particles:1b,show_icon:1b}],probability:0.01},{type:"minecraft:play_sound",sound:"entity.cat.ambient"}]},custom_name={"color":"green","text":"Your Harder Hat Statistics (hover)"},enchantment_glint_override=true,enchantments={"minecraft:vanishing_curse":1},tooltip_display={hidden_components:["enchantments"]},food={nutrition:1,saturation:1,can_always_eat:true},max_stack_size=99,custom_data={clear:true},lore=[{"color":"gray","text":"View your current stats, overall stats, and more!"}," ",[{"color":"light_purple","text":"● Current Level "},{"color":"white","text":"{{allLevels[level]}}"}],[{"color":"red","text":"● Session Falls "},{"color":"white","text":"{{formatNumber(String(sessionFalls))}}"}]," ",[{"color":"red","text":"● Total Falls "},{"color":"white","text":"{{formatNumber(String(totalFalls))}}"}],[{"color":"gold","text":"● Total Blocks "},{"color":"white","text":"{{formatNumber(String(totalBlocks))}}"}]," ",[{"color":"yellow","text":"● Map Completions "},{"color":"white","text":"{{formatNumber(String(numberCompletions))}}"}],[{"color":"gold","text":"● Style Points "},{"color":"white","text":"{{formatNumber(String(swagPoints))}}/4,000"}],[{"color":"yellow","text":"● 100% Progress "},{"color":"white","text":"{{Int(progress100[player] * 10) / 10}}.{{Int(progress100[player] * 10) % 10}}%"}]]] 1
@else
    @bypass /item replace entity {{player}} container.8 with nether_star[consumable={consume_seconds:1.6,animation:"eat",on_consume_effects:[{type:"minecraft:apply_effects",effects:[{id:"minecraft:slowness",amplifier:5,duration:200,show_particles:1b,show_icon:1b}],probability:0.01},{type:"minecraft:play_sound",sound:"entity.cat.ambient"}]},custom_name={"color":"green","text":"Your Harder Hat Statistics (hover)"},enchantment_glint_override=true,enchantments={"minecraft:vanishing_curse":1},tooltip_display={hidden_components:["enchantments"]},food={nutrition:1,saturation:1,can_always_eat:true},max_stack_size=99,custom_data={clear:true},lore=[{"color":"gray","text":"View your current stats, overall stats, and more!"}," ",[{"color":"light_purple","text":"● Current Level "},{"color":"white","text":"{{allLevels[level]}}"}],[{"color":"red","text":"● Session Falls "},{"color":"white","text":"{{formatNumber(String(sessionFalls))}}"}]," ",[{"color":"red","text":"● Total Falls "},{"color":"white","text":"{{formatNumber(String(totalFalls))}}"}],[{"color":"gold","text":"● Total Blocks "},{"color":"white","text":"{{formatNumber(String(totalBlocks))}}"}]," ",[{"color":"red","text":"● PB Falls "},{"color":"white","text":"{{formatNumber(String(pbFalls))}}"}],[{"color":"gold","text":"● PB Blocks "},{"color":"white","text":"{{formatNumber(String(pbBlocks))}}"}]," ",[{"color":"yellow","text":"● Map Completions "},{"color":"white","text":"{{formatNumber(String(numberCompletions))}}"}],[{"color":"gold","text":"● Style Points "},{"color":"white","text":"{{formatNumber(String(swagPoints))}}"}],[{"color":"yellow","text":"● 100% Progress "},{"color":"white","text":"{{Int(progress100[player] * 10) / 10}}.{{Int(progress100[player] * 10) % 10}}%"}]]] 1
@fi

# Soul Link / Master Soul Link
@else

@for Player partner in partners[player]
    # [{"color":"red","text":"● Session Falls "},{"color":"white","text":"{{formatNumber(String(sessionFalls))}}"}]
    @var fallTrackerSoulLinkFalls += "[{\"color\":\"{{colorList2[partners[player].find(partner) % colorList2.length()]}}\",\"text\":\"● {{partner}}'s Falls \"},{\"color\":\"white\",\"text\":\"{{formatNumber(String(sessionFalls[partner]))}}\"}], "
    @var fallTrackerSoulLinkBlocks += "[{\"color\":\"{{colorList2[partners[player].find(partner) % colorList2.length()]}}\",\"text\":\"● {{partner}}'s Blocks \"},{\"color\":\"white\",\"text\":\"{{formatNumber(String(sessionBlocks[partner]))}}\"}], "
@done
@if numberCompletions == 0
    @bypass /item replace entity {{player}} container.8 with nether_star[consumable={consume_seconds:1.6,animation:"eat",on_consume_effects:[{type:"minecraft:apply_effects",effects:[{id:"minecraft:slowness",amplifier:5,duration:200,show_particles:1b,show_icon:1b}],probability:0.01},{type:"minecraft:play_sound",sound:"entity.cat.ambient"}]},custom_name={"color":"green","text":"Your Harder Hat Statistics (hover)"},enchantment_glint_override=true,enchantments={"minecraft:vanishing_curse":1},tooltip_display={hidden_components:["enchantments"]},food={nutrition:1,saturation:1,can_always_eat:true},max_stack_size=99,custom_data={clear:true},lore=[{"color":"gray","text":"View your current stats, overall stats, and more!"}," ",[{"color":"light_purple","text":"● Current Level "},{"color":"white","text":"{{allLevels[level]}}"}]," ",{{fallTrackerSoulLinkFalls}}" ",{{fallTrackerSoulLinkBlocks}}" ",[{"color":"red","text":"● Total Falls "},{"color":"white","text":"{{formatNumber(String(totalFalls))}}"}],[{"color":"gold","text":"● Total Blocks "},{"color":"white","text":"{{formatNumber(String(totalBlocks))}}"}]," ",[{"color":"yellow","text":"● Map Completions "},{"color":"white","text":"{{formatNumber(String(numberCompletions))}}"}],[{"color":"gold","text":"● Style Points "},{"color":"white","text":"{{formatNumber(String(swagPoints))}}/4,000"}],[{"color":"yellow","text":"● 100% Progress "},{"color":"white","text":"{{Int(progress100[player] * 10) / 10}}.{{Int(progress100[player] * 10) % 10}}%"}]]] 1
@else
    @bypass /item replace entity {{player}} container.8 with nether_star[consumable={consume_seconds:1.6,animation:"eat",on_consume_effects:[{type:"minecraft:apply_effects",effects:[{id:"minecraft:slowness",amplifier:5,duration:200,show_particles:1b,show_icon:1b}],probability:0.01},{type:"minecraft:play_sound",sound:"entity.cat.ambient"}]},custom_name={"color":"green","text":"Your Harder Hat Statistics (hover)"},enchantment_glint_override=true,enchantments={"minecraft:vanishing_curse":1},tooltip_display={hidden_components:["enchantments"]},food={nutrition:1,saturation:1,can_always_eat:true},max_stack_size=99,custom_data={clear:true},lore=[{"color":"gray","text":"View your current stats, overall stats, and more!"}," ",[{"color":"light_purple","text":"● Current Level "},{"color":"white","text":"{{allLevels[level]}}"}]," ",{{fallTrackerSoulLinkFalls}}" ",{{fallTrackerSoulLinkBlocks}}" ",[{"color":"red","text":"● Total Falls "},{"color":"white","text":"{{formatNumber(String(totalFalls))}}"}],[{"color":"gold","text":"● Total Blocks "},{"color":"white","text":"{{formatNumber(String(totalBlocks))}}"}]," ",[{"color":"red","text":"● PB Falls "},{"color":"white","text":"{{formatNumber(String(pbFalls))}}"}],[{"color":"gold","text":"● PB Blocks "},{"color":"white","text":"{{formatNumber(String(pbBlocks))}}"}]," ",[{"color":"yellow","text":"● Map Completions "},{"color":"white","text":"{{formatNumber(String(numberCompletions))}}"}],[{"color":"gold","text":"● Style Points "},{"color":"white","text":"{{formatNumber(String(swagPoints))}}"}],[{"color":"yellow","text":"● 100% Progress "},{"color":"white","text":"{{Int(progress100[player] * 10) / 10}}.{{Int(progress100[player] * 10) % 10}}%"}]]] 1
@fi
@fi