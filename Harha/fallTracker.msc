# fallTracker(Player player)

@fast
@using Harha

@if numberCompletions == 0
    @bypass /item replace entity {{player}} container.8 with nether_star[consumable={consume_seconds:1.6,animation:"eat",on_consume_effects:[{type:"minecraft:apply_effects",effects:[{id:"minecraft:slowness",amplifier:5,duration:200,show_particles:1b,show_icon:1b}],probability:0.05},{type:"minecraft:play_sound",sound:"entity.cat.ambient"}]},custom_name={"color":"green","text":"Your Harder Hat Statistics"},enchantment_glint_override=true,enchantments={"minecraft:vanishing_curse":1},tooltip_display={hidden_components:["enchantments"]},food={nutrition:1,saturation:1,can_always_eat:true},max_stack_size=99,custom_data={clear:true},lore=[{"color":"gray","text":"View your current stats, overall stats, and more!"}," ",[{"color":"light_purple","text":"● Current Level "},{"color":"white","text":"{{allLevels[level]}}"}],[{"color":"red","text":"● Session Falls "},{"color":"white","text":"{{sessionFalls}}"}],[{"color":"gold","text":"● Session Blocks "},{"color":"white","text":"{{sessionBlocks}}"}]," ",[{"color":"red","text":"● Total Falls "},{"color":"white","text":"{{totalFalls}}"}],[{"color":"gold","text":"● Total Blocks "},{"color":"white","text":"{{totalBlocks}}"}]," ",[{"color":"yellow","text":"● Map Completions "},{"color":"white","text":"{{numberCompletions}}"}],[{"color":"gold","text":"● Style Points "},{"color":"white","text":"{{swagPoints}}"}]]] 1
@else
    @bypass /item replace entity {{player}} container.8 with nether_star[consumable={consume_seconds:1.6,animation:"eat",on_consume_effects:[{type:"minecraft:apply_effects",effects:[{id:"minecraft:slowness",amplifier:5,duration:200,show_particles:1b,show_icon:1b}],probability:0.05},{type:"minecraft:play_sound",sound:"entity.cat.ambient"}]},custom_name={"color":"green","text":"Your Harder Hat Statistics"},enchantment_glint_override=true,enchantments={"minecraft:vanishing_curse":1},tooltip_display={hidden_components:["enchantments"]},food={nutrition:1,saturation:1,can_always_eat:true},max_stack_size=99,custom_data={clear:true},lore=[{"color":"gray","text":"View your current stats, overall stats, and more!"}," ",[{"color":"light_purple","text":"● Current Level "},{"color":"white","text":"{{allLevels[level]}}"}],[{"color":"red","text":"● Session Falls "},{"color":"white","text":"{{sessionFalls}}"}],[{"color":"gold","text":"● Session Blocks "},{"color":"white","text":"{{sessionBlocks}}"}]," ",[{"color":"red","text":"● Total Falls "},{"color":"white","text":"{{totalFalls}}"}],[{"color":"gold","text":"● Total Blocks "},{"color":"white","text":"{{totalBlocks}}"}]," ",[{"color":"red","text":"● PB Falls "},{"color":"white","text":"{{pbFalls}}"}],[{"color":"gold","text":"● PB Blocks "},{"color":"white","text":"{{pbBlocks}}"}]," ",[{"color":"yellow","text":"● Map Completions "},{"color":"white","text":"{{numberCompletions}}"}],[{"color":"gold","text":"● Style Points "},{"color":"white","text":"{{swagPoints}}"}]]] 1
@fi