# swagTitle(Int points, Player player)
@using Harha
@fast

# Even Harder Hat 
@if player.getCurrentChallenge() == "hahahaha" || difficultySelection == "master"
    @bypass /title @s times 0 20 20
    @bypass /title {{player}} actionbar ["",{"text":"Total ","bold":true,"color":"#ff5b00"},{"text":"style ","bold":true,"color":"#ff7900"},{"text":"points: ","bold":true,"color":"#ff8600"},{"text":"{{swagPoints}}","bold":true,"underlined":true,"color":"gold"}]
    @bypass /title {{player}} subtitle ["",{"text":"+{{points}} Points","bold":true,"color":"#ff8600"}]
    @bypass /title {{player}} title ["",{"text":"Style Points!","bold":true,"color":"#ff5b00"}]


    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 0.707
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 0.891
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 1.059

    @delay 2

    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 0.707
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 0.891
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 1.059

    @delay 2

    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 0.707
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 0.891
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 1.059

    @delay 4

    @bypass /title {{player}} title ["",{"text":"S","bold":true,"color":"gold"},{"text":"t","bold":true,"color":"white"},{"text":"yle Points!","bold":true,"color":"#ff5b00"}]
    @delay 1
    @bypass /title {{player}} title ["",{"text":"St","bold":true,"color":"#ff5b00"},{"text":"y","bold":true,"color":"gold"},{"text":"l","bold":true,"color":"white"},{"text":"e Points!","bold":true,"color":"#ff5b00"}]
    @delay 1
    @bypass /title {{player}} title ["",{"text":"Styl","bold":true,"color":"#ff5b00"},{"text":"e ","bold":true,"color":"gold"},{"text":"P","bold":true,"color":"white"},{"text":"oints!","bold":true,"color":"#ff5b00"}]
    @delay 1
    @bypass /title {{player}} title ["",{"text":"Style P","bold":true,"color":"#ff5b00"},{"text":"o","bold":true,"color":"gold"},{"text":"i","bold":true,"color":"white"},{"text":"nts!","bold":true,"color":"#ff5b00"}]
    @delay 1
    @bypass /title {{player}} title ["",{"text":"S","bold":true,"color":"gold"},{"text":"t","bold":true,"color":"white"},{"text":"yle Poi","bold":true,"color":"#ff5b00"},{"text":"n","bold":true,"color":"gold"},{"text":"t","bold":true,"color":"white"},{"text":"s!","bold":true,"color":"#ff5b00"}]
    @delay 1
    @bypass /title {{player}} title ["",{"text":"St","bold":true,"color":"#ff5b00"},{"text":"y","bold":true,"color":"gold"},{"text":"l","bold":true,"color":"white"},{"text":"e Point","bold":true,"color":"#ff5b00"},{"text":"s","bold":true,"color":"gold"},{"text":"!","bold":true,"color":"white"}]
    @delay 1
    @bypass /title {{player}} title ["",{"text":"Styl","bold":true,"color":"#ff5b00"},{"text":"e ","bold":true,"color":"gold"},{"text":"P","bold":true,"color":"white"},{"text":"oints!","bold":true,"color":"#ff5b00"}]
    @delay 1
    @bypass /title {{player}} title ["",{"text":"Style P","bold":true,"color":"#ff5b00"},{"text":"o","bold":true,"color":"gold"},{"text":"i","bold":true,"color":"white"},{"text":"nts!","bold":true,"color":"#ff5b00"}]
    @delay 1
    @bypass /title {{player}} title ["",{"text":"Style Poi","bold":true,"color":"#ff5b00"},{"text":"n","bold":true,"color":"gold"},{"text":"t","bold":true,"color":"white"},{"text":"s!","bold":true,"color":"#ff5b00"}]
    @delay 1
    @bypass /title {{player}} title ["",{"text":"Style Point","bold":true,"color":"#ff5b00"},{"text":"s","bold":true,"color":"gold"},{"text":"!","bold":true,"color":"white"}]
    @delay 1
    @bypass /title @s times 0 30 20
    @bypass /title {{player}} title ["",{"text":"Style Points!","bold":true,"color":"#ff5b00"}]

# Hardest Hat
