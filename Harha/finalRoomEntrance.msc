# finalRoomEntrance.msc

@fast
@using Harha

@if Region("harhafinal1", "Theta").getPlayersInside().length() == 0
    @console /function execute Harha::finalAnimationWave()
    @for Int i in list::range(0, 24)
        @console /minecraft:kill @e[type=item_display,tag=harhaicosahedron{{i}}]
    @done
    @console /minecraft:kill @e[tag=secretHeadEntity25]
    @for Int i in list::range(1, 16)
        @console /minecraft:kill @e[tag=mrsDuck{{i}}]
    @done
    @bypass /minr restore harhaFinalDoor Theta
    @bypass /setblock -9056 79 9570 minecraft:iron_bars[east=false,north=false,south=false,waterlogged=false,west=false]
    @bypass /setblock -9056 79 9572 minecraft:iron_bars[east=false,north=false,south=false,waterlogged=false,west=false]
    @bypass /setblock -9061 77 9571 minecraft:player_head[powered=false,rotation=12]{components:{},profile:{id:[I;1744589087,-823246466,-1497957590,-1368413516],properties:[{name:"textures",value:"eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvYjRlOGQ4MDAzNmUwM2FmZTNmNDI1NGFhYjY1MWI0NmZlZmYxMDkxNzlhNmUxZmQzMzEzZDFhNDMwNGE2NzdkNCJ9fX0="}]}}
@else
    @var player.teleport(Position(-9081.0, 96.0, 9571.5, 90.0, 10.0, "Theta"))
    @bypass /playsound minecraft:block.note_block.didgeridoo master @s ~ ~ ~ 0.75 1
    @player &cYou can not enter this area while someone else is inside! Please wait until they leave.
@fi
