@define Int index
@define Int length
@define Int oldPosition
@if varSelected == 0
# top100BlocksTotal = 0               ========================================================== 

    @var length = top100BlocksTotal.length()
    @if !top100BlocksTotal.contains(player.getUniqueId())
        @var index = 1000
    @else
        @var index = top100BlocksTotal.find(player.getUniqueId())
    @fi

    # check if player should actually be on the list
    # @if totalBlocks[player] < totalBlocks[Player(top100BlocksTotal[length - 1])] && player.getUniqueId() != top100BlocksTotal[length - 1]
    #     @return
    # @fi


    # index = their current position in the list, if theyre in the list to start.
    @for Int insertIndex in list::range(0, length)
        # @var insertIndex = length - insertIndex

        # @player DEGUB: checking if {{totalBlocks[player]}} > {{totalBlocks[Player(top100BlocksTotal[insertIndex])]}}, result: {{totalBlocks[player] > totalBlocks[Player(top100BlocksTotal[insertIndex])]}}
        @if (totalBlocks[player] > totalBlocks[Player(top100BlocksTotal[insertIndex])])

            # insertIndex = index where the player should go

            #  @for Int j in list::range(0, length - i)
            #      @var j = (length - 1) - j
            #      @player j = {{j}}, insertIndex = {{i}}, length = {{length}}
            
            #      # @if (j + 1 == top100BlocksTotal.length() && (top100BlocksTotal.contains(player.getUniqueId()))) || j < top100BlocksTotal.length()
            #          # @player before: {{j+1}} = {{Player(top100BlocksTotal[j+1]).getName()}}, {{j}} = {{Player(top100BlocksTotal[j]).getName()}}
            #          @var top100BlocksTotal[j+1] = top100BlocksTotal[j]
            #          @player after: {{j+1}} = {{Player(top100BlocksTotal[j+1]).getName()}}, {{j}} = {{Player(top100BlocksTotal[j]).getName()}}
            #      # @fi
            #  @done


            
            @if top100BlocksTotal.contains(player.getUniqueId())
            
                # @player DEBUG: insertIndex = {{insertIndex}}, current position = {{top100BlocksTotal.find(player.getUniqueId()) + 1}}
            
            # if player is in the right spot, do nothing/return
                @if insertIndex == top100BlocksTotal.find(player.getUniqueId()) + 1
                    @return
                @fi

                # @player Leaderboard before removal:
                # @for Int i in list::range(0, top100BlocksTotal.length())
                #     @player #{{i}} {{Player(top100BlocksTotal[i]).getName()}} = {{totalBlocks[Player(top100BlocksTotal[i])]}}
                # @done

                @var oldPosition = top100BlocksTotal.find(player.getUniqueId())
                @var top100BlocksTotal.remove(oldPosition)

                # @player Leaderboard after removal:
                # @for Int i in list::range(0, top100BlocksTotal.length())
                #     @player #{{i}} {{Player(top100BlocksTotal[i]).getName()}} = {{totalBlocks[Player(top100BlocksTotal[i])]}}
                # @done

            @fi

            # @player insertIndex = {{insertIndex}}
            @var top100BlocksTotal.add(player.getUniqueId(), insertIndex)
            @return
        @fi
    @done

    # if the player has less than everyone else on the list, run this.
    @if !top100BlocksTotal.contains(player.getUniqueId())
        # @player Player had less than everyone on the list, adding them to the end
        @var top100BlocksTotal.add(player.getUniqueId(), top100BlocksTotal.length())
    @fi

