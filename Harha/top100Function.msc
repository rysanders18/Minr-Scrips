@elseif varSelected == 1
# top100FallsTotal = 1               ========================================================== 

    # index = their current position in the list, if theyre in the list to start.
    @var length = top100FallsTotal.length()
    @if !top100FallsTotal.contains(player.getUniqueId())
        @var index = 1000
    @else
        @var index = top100FallsTotal.find(player.getUniqueId())
    @fi

    # Scan every item in list from front to back
    @for Int insertIndex in list::range(0, length)
        # Checking if 
        @if (totalFalls[player] > totalFalls[Player(top100FallsTotal[insertIndex])])
            @if top100FallsTotal.contains(player.getUniqueId())
            # if player is in the right spot, do nothing/return
                @if insertIndex == top100FallsTotal.find(player.getUniqueId()) + 1
                    @return
                @fi
                @var oldPosition = top100FallsTotal.find(player.getUniqueId())
                @var top100FallsTotal.remove(oldPosition)
            @fi
            @var top100FallsTotal.add(player.getUniqueId(), insertIndex)
            @return
        @fi
    @done

    # if the player has less than everyone else on the list, run this.
    @if !top100FallsTotal.contains(player.getUniqueId())
        @var top100FallsTotal.add(player.getUniqueId(), top100FallsTotal.length())
    @fi

