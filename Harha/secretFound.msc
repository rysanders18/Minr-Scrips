# secretFound(Player player, Int secretNumber) https://paste.minr.org/egetuqewic
@fast
@using Harha

@define String[] secretBuilders = String["RY \& Crow", "leo_lazuli", "Crowenza", "jasmine476", "masts", "bin200", "Dalox02", "ItsPoekie", "RY \& Crow", "Jakube_", "johnplumber", "RYgamer1", "BoggledToggo", "Lennerd07", "JM4s", "Swifph \& Tet", "Vermilion_Stone", "2uba", "rmanimal", "Alienout", "RYgamer1", "Lagbolo", "ZombieKiler", "RYgamer1", "LendKaru"]
@define String[] secretDifficulties = String["&8&lExpert", "&a&lNovice", "&c&lVery Hard", "&6&lHard", "&b&lEasy", "&7&lNot Rated Yet", "&6&lHard", "&e&lModerate", "&8&lExpert", "&6&lHard", "&6&lHard", "&6&lHard", "&c&lVery Hard", "&c&lVery Hard", "&c&lVery Hard", "&a&lNovice", "&8&lExpert", "&7&lVery Easy", "&a&lNovice", "&6&lHard", "&c&lVery Hard", "&c&lVery Hard", "&c&lVery Hard", "&e&lModerate", "&e&lModerate"]
@define String[] secretMapTypes = String["Adventure with Parkour, Maze, Puzzle, Dropper, Search, Guess and Story", "Pure Maze", "Pure Parkour", "Pure Parkour", "Pure Guess", "Maze with Parkour, Puzzle, And Search", "Parkour with Search", "Pure Dropper", "Co-op Parkour with Puzzle", "Pure Search", "Parkour with Search", "Guess with Story", "Parkour with Puzzle and Maze", "Parkour with Search", "Search with Puzzle and Parkour", "Gambling", "Pure Parkour", "Pure Maze", "Pure Puzzle", "Puzzle with Maze, Search, and Parkour", "Search with Parkour", "Pure Parkour", "Pure Parkour", "Aim Trainer", "Fish..."]

@define String text = "Secret Found!"
@define String subtext = ""
@if secretNumber < 9
    @var subtext = "Secret 0{{secretNumber + 1}}"
@else
    @var subtext = "Secret {{secretNumber + 1}}"
@fi

@define String color1 = "#ffc71d"
@define String color2 = "aqua"
@define String color3 = "yellow"
@define String color4 = "gold"


@if secretsFoundList[player][secretNumber] == 0
@bypass /execute as @s at @s anchored eyes run particle minecraft:flash ^ ^ ^1 0 0 0 0 2 force @s

@bypass /playsound minecraft:block.end_portal.spawn master {{player}} ~ ~ ~ 1 1
@bypass /title {{player}} times 0 100 10
