# secretFound(Player player, Int secretNumber)
@fast
@using Harha


@if secretsFoundList[player][secretNumber] == 0
    @player &6&lSecret #{{secretNumber + 1}} found!
    @var secretsFoundList[player][secretNumber] = 1
    # end gateway sound effect

    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 0.707
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 0.891
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 1.059

    @delay 2

    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 0.707
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 0.891
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 1.059

    @delay 2

    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 0.707
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 0.891
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 1.059
@fi