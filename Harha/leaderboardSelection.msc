        @var topPlayersStat.append((String(timer::formatTime(stage7PB[player]))))
    @else
        @var topPlayersRank.append("N/A")
        @var topPlayersStat.append("N/A")
    @fi
    

    @define String color = player.getRank()
    @if color == "admins"
        @var topPlayersColor.append("gold")
    @elseif color == "mods"
        @var topPlayersColor.append("dark_green")
    @elseif color == "greenies"
        @var topPlayersColor.append("green")
    @elseif color == "blues"
        @var topPlayersColor.append("aqua")
    @else
        @var topPlayersColor.append("white")
    @fi

@elseif variation == 25

    # Lets handle topPlayers first
    @var length = top100Section8PB.length()
    @for Int i in list::range(page * 10, (page * 10) + 10)
        @var topPlayersRank.append(String(i + 1))
        @if i < length
            @var topPlayers.append(Player(top100Section8PB[i]).getName() + " ")
            @var topPlayersStat.append(String(timer::formatTime(stage8PB[Player(top100Section8PB[i])])))
            @define String color = Player(top100Section8PB[i]).getRank()
            @if color == "admins"
                @var topPlayersColor.append("gold")
            @elseif color == "mods"
                @var topPlayersColor.append("dark_green")
            @elseif color == "greenies"
                @var topPlayersColor.append("green")
            @elseif color == "blues"
                @var topPlayersColor.append("aqua")
            @else
                @var topPlayersColor.append("white")
            @fi
        @else
            @var topPlayers.append("--")
            @var topPlayersColor.append("gray")
            @var topPlayersStat.append("")
        @fi
    @done

    @var topPlayers.append(player.getName())
    @if top100Section8PB.contains(player.getUniqueId())
        @var topPlayersRank.append(String(top100Section8PB.find(player.getUniqueId()) + 1))
        @var topPlayersStat.append((String(timer::formatTime(stage8PB[player]))))
    @else
        @var topPlayersRank.append("N/A")
        @var topPlayersStat.append("N/A")
    @fi
    

    @define String color = player.getRank()
    @if color == "admins"
        @var topPlayersColor.append("gold")
    @elseif color == "mods"
        @var topPlayersColor.append("dark_green")
    @elseif color == "greenies"
        @var topPlayersColor.append("green")
    @elseif color == "blues"
        @var topPlayersColor.append("aqua")
    @else
        @var topPlayersColor.append("white")
    @fi

@elseif variation == 26

    # Lets handle topPlayers first
    @var length = top100Anomalies.length()
    @for Int i in list::range(page * 10, (page * 10) + 10)
        @var topPlayersRank.append(String(i + 1))
        @if i < length
            @var topPlayers.append(Player(top100Anomalies[i]).getName() + " ")
            @var topPlayersStat.append(String(anomaliesExperienced[Player(top100Anomalies[i])]))
            @define String color = Player(top100Anomalies[i]).getRank()
            @if color == "admins"
                @var topPlayersColor.append("gold")
            @elseif color == "mods"
                @var topPlayersColor.append("dark_green")
            @elseif color == "greenies"
                @var topPlayersColor.append("green")
            @elseif color == "blues"
                @var topPlayersColor.append("aqua")
            @else
                @var topPlayersColor.append("white")
            @fi
        @else
            @var topPlayers.append("--")
            @var topPlayersColor.append("gray")
            @var topPlayersStat.append("")
        @fi
    @done

    @var topPlayers.append(player.getName())
    @if top100Anomalies.contains(player.getUniqueId())
        @var topPlayersRank.append(String(top100Anomalies.find(player.getUniqueId()) + 1))
        @var topPlayersStat.append(formatNumber(String(anomaliesExperienced[player])))
    @else
        @var topPlayersRank.append("N/A")
        @var topPlayersStat.append("N/A")
    @fi
    

    @define String color = player.getRank()
    @if color == "admins"
        @var topPlayersColor.append("gold")
    @elseif color == "mods"
        @var topPlayersColor.append("dark_green")
    @elseif color == "greenies"
        @var topPlayersColor.append("green")
    @elseif color == "blues"
        @var topPlayersColor.append("aqua")
    @else
        @var topPlayersColor.append("white")
    @fi
@fi

