    @done
    @var topPlayers.append(player.getName())
    
    @if top100FallsTotal.contains(player.getUniqueId())
        @define Int i = (top100FallsTotal.find(player.getUniqueId()))
        @if i != 0 && i <= length
            @define Int rankToAdd = 0
            @for Int j in list::range(0, i)
                @if j + 1 < length
                    @if totalFalls[Player(top100FallsTotal[j])] == totalFalls[Player(top100FallsTotal[j + 1])]
                        @var rankToAdd += 1
                    @else
