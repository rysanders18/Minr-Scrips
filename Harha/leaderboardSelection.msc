            @define Int rankToAdd = 0
            @for Int j in list::range(0, i)
                @if j + 1 < length
                    @if harderSoulLinkPlayersPB[Player(top100HarderSoulLinkPlayers[j])] == harderSoulLinkPlayersPB[Player(top100HarderSoulLinkPlayers[j + 1])]
                        @var rankToAdd += 1
                    @else
                        @var rankToAdd = 0
                    @fi
                @fi
            @done
            @var topPlayersRank.append(String(i + 1 - rankToAdd))
        @else
            @var topPlayersRank.append(String(i + 1))
        @fi
        
    @done
    @var topPlayers.append(player.getName())
    
    @if top100HarderSoulLinkPlayers.contains(player.getUniqueId())
        @define Int i = (top100HarderSoulLinkPlayers.find(player.getUniqueId()))
        @if i != 0 && i <= length
            @define Int rankToAdd = 0
            @for Int j in list::range(0, i)
                @if j + 1 < length
                    @if harderSoulLinkPlayersPB[Player(top100HarderSoulLinkPlayers[j])] == harderSoulLinkPlayersPB[Player(top100HarderSoulLinkPlayers[j + 1])]
                        @var rankToAdd += 1
                    @else
                        @var rankToAdd = 0
                    @fi
                @fi
            @done
            @var topPlayersRank.append(String(i + 1 - rankToAdd))
        @else
            @var topPlayersRank.append(String(i + 1))
        @fi
        @var topPlayersStat.append(formatNumber(String(harderSoulLinkPlayersPB[player])))
    @else
        @var topPlayersRank.append("N/A")
        @var topPlayersStat.append("N/A")
    @fi
    
    @var topPlayersStat.append(formatNumber(String(harderSoulLinkPlayersPB[player])))
@elseif variation == 29
    @var length = top100StylePointPrestiges.length()
    @for Int i in list::range(page * 10, (page * 10) + 10)
        @if i < length
            @var topPlayers.append(Player(top100StylePointPrestiges[i]).getName() + " ")
            @var topPlayersStat.append(formatNumber(String(stylePointPrestiges[Player(top100StylePointPrestiges[i])])))
            @define String color = Player(top100StylePointPrestiges[i]).getRank()
            @if color == "admins"
                @var topPlayersColor.append("gold")
            @elseif color == "mods"
                @var topPlayersColor.append("dark_green")
            @elseif color == "greenies"
                @var topPlayersColor.append("green")
            @elseif color == "blues"
                @var topPlayersColor.append("aqua")
            @else
                @var topPlayersColor.append("white")
            @fi
        @else
            @var topPlayers.append("--")
            @var topPlayersColor.append("gray")
            @var topPlayersStat.append("")
        @fi
        
        @if i < length
            @define Int rankToAdd = 0
            @for Int j in list::range(0, i)
                @if j + 1 < length
                    @if stylePointPrestiges[Player(top100StylePointPrestiges[j])] == stylePointPrestiges[Player(top100StylePointPrestiges[j + 1])]
                        @var rankToAdd += 1
                    @else
                        @var rankToAdd = 0
                    @fi
                @fi
            @done
            @var topPlayersRank.append(String(i + 1 - rankToAdd))
        @else
            @var topPlayersRank.append(String(i + 1))
        @fi
        
    @done
    @var topPlayers.append(player.getName())
    
    @if top100StylePointPrestiges.contains(player.getUniqueId())
        @define Int i = (top100StylePointPrestiges.find(player.getUniqueId()))
        @if i != 0 && i <= length
            @define Int rankToAdd = 0
            @for Int j in list::range(0, i)
                @if j + 1 < length
                    @if stylePointPrestiges[Player(top100StylePointPrestiges[j])] == stylePointPrestiges[Player(top100StylePointPrestiges[j + 1])]
                        @var rankToAdd += 1
                    @else
                        @var rankToAdd = 0
                    @fi
                @fi
            @done
            @var topPlayersRank.append(String(i + 1 - rankToAdd))
        @else
            @var topPlayersRank.append(String(i + 1))
        @fi
        @var topPlayersStat.append(formatNumber(String(stylePointPrestiges[player])))
    @else
        @var topPlayersRank.append("N/A")
        @var topPlayersStat.append("N/A")
    @fi
    
    @var topPlayersStat.append(formatNumber(String(stylePointPrestiges[player])))
@fi

@define String color = player.getRank()
@if color == "admins"
    @var topPlayersColor.append("gold")
@elseif color == "mods"
    @var topPlayersColor.append("dark_green")
@elseif color == "greenies"
    @var topPlayersColor.append("green")
@elseif color == "blues"
    @var topPlayersColor.append("aqua")
@else
    @var topPlayersColor.append("white")
@fi


