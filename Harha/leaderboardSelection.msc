# leaderboardSelection(Int variation, Int page, Player player) https://paste.minr.org/ukugibiyal

@fast
@using Harha

# Variation ints list
# -=-=-=-=-=-=-=-=-=-
# top100BlocksTotal = 0
# @var totalBlocks
# top100FallsTotal = 1
# @var totalFalls

# top100FallsPBNormal = 2
# @var pbFalls
# top100FallsPBMaster = 3
# @var pbFallsMaster
# top100FallsPBUMM = 4
# @var pbFallsUMM
# top100FallsPBSoulLink = 5
# @var pbFallsSoulLink
# top100FallsPBMasterSoulLink = 6
# @var pbFallsMasterSoulLink

# top100BlocksPBNormal = 7
# @var pbBlocks
# top100BlocksPBMaster = 8
# @var pbBlocksMaster
# top100BlocksPBUMM = 9
# @var pbBlocksUMM
# top100BlocksPBSoulLink = 10
# @var pbBlocksSoulLink
# top100BlocksPBMasterSoulLink = 11
# @var pbBlocksMasterSoulLink

# top100MapCompletionsTotal = 12
# @var numberCompletions
# top100MapCompletionsNormal = 13
# @var numberCompletionsNormal
# top100MapCompletionsMaster = 14
# @var numberCompletionsMaster
# top100MapCompletionsUMM = 15
# @var numberCompletionsUMM
# top100MapCompletionsSoulLink = 16
# @var numberCompletionsSoulLink
# top100MapCompletionsMasterSoulLink = 17
# @var numberCompletionsMasterSoulLink

# top100Section1PB = 18
# @var stage1PB
# top100Section2PB = 19
# @var stage2PB
# top100Section3PB = 20
# @var stage3PB
# top100Section4PB = 21
# @var stage4PB
# top100Section5PB = 22
# @var stage5PB
# top100Section6PB = 23
# @var stage6PB
# top100Section7PB = 24
# @var stage8PB
# top100Section8PB = 25
# @var stage8PB

# top100Anomalies = 26
# @var anomaliesExperienced
# top100SoulLinkPlayers = 27
# @var soulLinkPlayersPB
# top100HarderSoulLinkPlayers = 28
# @var harderSoulLinkPlayersPB
# top100StylePointPrestiges = 29
# @var stylePointPrestiges
# blocksSinceResetPB = 30
# @var blocksSinceResetPB

@define String[] topPlayersRank = String[]
@define String[] topPlayers = String[]
@define String[] topPlayersStat = String[]
@define String[] topPlayersColor = String[]
@define Int playerColor
@define Int length

@if variation == 0
    # Lets handle topPlayers first
    @var length = top100BlocksTotal.length()
    @for Int i in list::range(page * 10, (page * 10) + 10)
        # @var topPlayersRank.append(String(i + 1))
        @if i < length
            @var topPlayers.append(Player(top100BlocksTotal[i]).getName() + " ")
            @var topPlayersStat.append(formatNumber(String(totalBlocks[Player(top100BlocksTotal[i])])))
            @define String color = Player(top100BlocksTotal[i]).getRank()
            @if color == "admins"
                @var topPlayersColor.append("gold")
            @elseif color == "mods"
                @var topPlayersColor.append("dark_green")
            @elseif color == "greenies"
                @var topPlayersColor.append("green")
            @elseif color == "blues"
                @var topPlayersColor.append("aqua")
            @else
                @var topPlayersColor.append("white")
            @fi
        @else
            @var topPlayers.append("--")
            @var topPlayersColor.append("gray")
            @var topPlayersStat.append("")
        @fi
        
        @if i < length
            @define Int rankToAdd = 0
            @for Int j in list::range(0, i)
                @if j + 1 < length
                    # DEBUG @player Checking Ahead, j = {{j}}, checking if {{totalBlocks[Player(top100BlocksTotal[j])]}} == {{totalBlocks[Player(top100BlocksTotal[j + 1])]}}
                    @if totalBlocks[Player(top100BlocksTotal[j])] == totalBlocks[Player(top100BlocksTotal[j + 1])]
                        @var rankToAdd += 1
                    @else
                        @var rankToAdd = 0
                    @fi
                @fi
            @done
            @var topPlayersRank.append(String(i + 1 - rankToAdd))
            # DEBUG @player i = {{i}} rankToAdd = {{rankToAdd}}
        @else
            @var topPlayersRank.append(String(i + 1))
        @fi
        
    @done
    
    @var topPlayers.append(player.getName())
    @if top100BlocksTotal.contains(player.getUniqueId())
        
        # Sets rank for the specific personalized player
        @define Int i = (top100BlocksTotal.find(player.getUniqueId()))
        @if i != 0 && i <= length
            @define Int rankToAdd = 0
            @for Int j in list::range(0, i)
                @if j + 1 < length
                    # DEBUG @player Checking Ahead, j = {{j}}, checking if {{totalBlocks[Player(top100BlocksTotal[j])]}} == {{totalBlocks[Player(top100BlocksTotal[j + 1])]}}
                    @if totalBlocks[Player(top100BlocksTotal[j])] == totalBlocks[Player(top100BlocksTotal[j + 1])]
                        @var rankToAdd += 1
                    @else
                        @var rankToAdd = 0
                    @fi
                @fi
            @done
            @var topPlayersRank.append(String(i + 1 - rankToAdd))
            # DEBUG @player i = {{i}} rankToAdd = {{rankToAdd}}
        @else
            @var topPlayersRank.append(String(i + 1))
        @fi
        @var topPlayersStat.append(formatNumber(String(totalBlocks[player])))
    @else
        @var topPlayersRank.append("N/A")
        @var topPlayersStat.append("N/A")
    @fi
    
    @var topPlayersStat.append(formatNumber(String(totalBlocks[player])))
    
@elseif variation == 1
    @var length = top100FallsTotal.length()
    @for Int i in list::range(page * 10, (page * 10) + 10)
