# @player topPlayersRank = {{topPlayersRank}}
# leaderboardExecute(String[] topPlayersRank, String[] topPlayers, String[] topPlayersStat, String[] topPlayersColor, Int variation)
@var leaderboardExecute(topPlayersRank, topPlayers, topPlayersStat, topPlayersColor, variation)
