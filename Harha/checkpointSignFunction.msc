@if harhaProgress[player] == (cpNumber - 1) && numberCompletions[player] == 0 && player.isPlayingMap()

    @var harhaProgress[player] = cpNumber
    @player &r&#A2FF38☆ &#9DFF3D&lP&#97FF42&lr&#92FF47&lo&#8CFF4C&lg&#87FF50&lr&#81FF55&le&#7CFF5A&ls&#76FF5F&ls &#71FF64&lS&#6BFF69&la&#66FF6E&lv&#60FF73&le&#5BFF77&ld&#55FF7C&l! &r&#4AFF86☆

    @bypass playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 0.5 {{musicNotes[cpNumber + 3]}}
    @bypass execute at {{player}} anchored feet run particle minecraft:egg_crack ~ ~2 ~ 1 1.5 1 0.05 50 force {{player}}
    @delay 1
    @bypass playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 0.5 {{musicNotes[cpNumber + 7]}}
    @bypass execute at {{player}} anchored feet run particle minecraft:egg_crack ~ ~2 ~ 1.5 1.5 1.5 0.05 50 force {{player}}
    @delay 1
    @bypass playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 0.5 {{musicNotes[cpNumber + 10]}}
    @bypass execute at {{player}} anchored feet run particle minecraft:egg_crack ~ ~2 ~ 2 1.5 2 0.05 50 force {{player}}
    @delay 1
    @bypass playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 0.5 {{musicNotes[cpNumber + 15]}}
    @bypass execute at {{player}} anchored feet run particle minecraft:end_rod ~ ~2 ~ 2.5 1.5 2.5 0.05 50 force {{player}}

@fi