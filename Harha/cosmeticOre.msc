# cosmeticOre (Player player)

@fast
@using Harha

@define Int randomBlockNumber = Int(math::random(1.0D, 11.0D))

@if randomBlockNumber < 3
    @var oreNumber[player] = 0
@elseif lastOreNumber[player] != 4
    @var oreNumber[player] = lastOreNumber[player] + 1
@fi

@var blockSelection[player] = oreList[oreNumber]

@if numberOfBlocksToGive[player] >= 1
    @var resetBlocks(player, numberOfBlocksToGive[player])
@fi
@var numberOfBlocksToGive[player] -= 1
@var lastOreNumber[player] = oreNumber[player]


# @bypass clear {{player}} {{blockSelection}}[can_place_on={predicates:[{blocks:"target"}]}] 640
