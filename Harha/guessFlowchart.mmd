%% ===============================
%% SKIP FIRST PERIOD
%% ===============================
subgraph SFP [Skip First Period]
  D[Skip first period] --> D1[Walk out of school]
  D1 --> D11[Walk home] --> D111[Mom kills you]:::death
  D1 --> D12[Walk to gas station]
  D12 --> D121[Buy 5 chips] --> D1211[Card declines → embarrassment]:::death
  D12 --> D122[Buy 1 water]
  D122 --> D1221[Go back to school] --> D12211[Transition → School Fire]:::loop
  D122 --> D1222[Just keep walking] --> D12221[Police encounter]

  %% Police encounter
  subgraph Police
    D12221 --> P1[Police pull you over]
    P1 --> P11[Run]
    P11 --> P111[Run faster]
    P111 --> P1111[Run even faster] --> P11111[Break sound barrier → die]:::death
    P111 --> P1112[Turn yourself in] --> P11121[Death penalty for speeding]:::death
    P1 --> P12[Turn yourself in] --> P121[Death penalty for fleeing police]:::death
    P1 --> P13[Stay and talk] --> P131[WIN: Jail for truancy]:::win
  end
end

