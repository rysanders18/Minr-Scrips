%% SCHOOL FIRE SEQUENCE
%% ===============================
subgraph SF [School Fire Sequence]

  %% Homeroom
  subgraph Homeroom
    H[Go to Homeroom]
    H --> H1[Follow teacher’s orders]
    H1 --> H11[Wait in line] --> H111[Roof collapses]:::death
