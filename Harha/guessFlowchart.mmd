    H --> H3[Hide under desk] --> H31[Fire finds you]:::death
  end

  %% Bathroom
  subgraph Bathroom
    BATH[Hide in bathroom]
    BATH --> B1[Call 911] --> B11[Phone dead → run] --> B111[Slip and die]:::death
    BATH --> B12[Stay in bathroom] --> B121[Fire cooks you]:::death
  end

