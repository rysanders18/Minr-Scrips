# Sushi the frog Script
@cooldown 30s

@fast
@using Harha

@if sushiDone
    
    @bypass /playsound minecraft:block.note_block.pling master @s ~ ~ ~ 1 1
    
    @player &#d4d4d4--------------------------------------
    @player &#FFFFA8&lF&#F8FFAB&lr&#F1FFAF&lo&#EBFFB2&lg&#E4FFB6&ll&#DDFFB9&li&#D6FFBD&lg&#CFFFC0&lh&#CFFBC6&lt &#D5F3CE&lB&#DBEBD6&ll&#E1E3DE&lo&#E7DCE7&lc&#EDD4EF&lk&#F9C4FF&ls
    @player
    @player &#d4d4d4● Cycles through all 3 Froglights! &l Credit: MaxLovesFrogs
    @player
    @player &#d4d4d4● Unlocked through sheer willpower.
    @player
    @player &aBlock selected!
    @player &#d4d4d4--------------------------------------
    
    @var blockSelection[player] = "verdant_froglight"
    @var blockSelectionStored[player] = "verdant_froglight"
    @var copperGrate[player] = false
    @var grateNumber[player] = 0
    @var woolNumber[player] = 0
    @var glassNumber[player] = 0
    @var pumpkinNumber[player] = 0
    @var lastPumpkinNumber[player] = 0
    @var spongeNumber[player] = 0
    @var lastSpongeNumber[player] = 0
    @var obsidianNumber[player] = 0
    @var lastObsidianNumber[player] = 0
    @var oreNumber[player] = 0
    @var lastOreNumber[player] = 0
    @var coolGlassNumber[player] = 0
    @var lastCoolGlassNumber[player] = 0
    @var coralNumber[player] = 0
    @var lastCoralNumber[player] = 0
    @var froglightNumber[player] = 0
    @var coolGlass = false
    
    @var cosmeticSwap[player] = true
    @var cosmeticSwap100[player] = false
    
    @var resetBlocks(player, 64)
    
    @return
@fi

# Daily cooldown
@if sushiTalk[player] == true
    # @player DEBUG: (({{system::currentTimeMillis()}} - {{frogcd}}) > 86400000) == {{(system::currentTimeMillis() - frogcd)}} < 86400000?
    @if ((system::currentTimeMillis() - frogcd) < 86400000)
        @player &a&lSushi&a: Ribbit!
        @bypass /playsound minecraft:entity.frog.ambient master @p ~ ~ ~ 10 1.3
        @delay 3s
        # @player DEBUG: 86400000 - {{system::currentTimeMillis()}} - {{frogcd}}
        @player &#d4d4d4&o(It will be &l{{timer::formatTime(86400000 - (system::currentTimeMillis() - frogcd))}}&#d4d4d4&o before &a&oSushi &#d4d4d4&oawakens.)
        @return
    @fi
@fi

# Variable sets
@define String frogprompt
@define Int frognum = math::floor(math::random(1D,21D))

# Set frogcd
@var frogcd = system::currentTimeMillis()

# First time speaking
@if !sushiTalk
    @var sushiTalk = true
@fi

# Frog Speak
@bypass /playsound minecraft:entity.frog.ambient master @p ~ ~ ~ 10 1.3

@player &a&lSushi&a: Ribbit!
@delay 3s
@player &#d4d4d4&oWhat a strange frog... it seems wisened in its years. I wonder if it has much to share.
@bypass /playsound minecraft:entity.allay.item_thrown master @s ~ ~ ~ 10 0.9
@delay 3s
# @fi

# Normal speaking
@player &5&l&kT &#d4d4d4&lActivating Frog Translation Device . . . &5&l&kT

# Frog Translation Device Effects
@bypass /particle minecraft:wax_off ~ ~ ~ 1 1 1 2 75 normal

@bypass /playsound minecraft:item.armor.equip_gold master @s ~ ~ ~ 5 1.2
@bypass /playsound minecraft:block.note_block.chime master @s ~ ~ ~ 5 0.5
@bypass /playsound minecraft:block.brewing_stand.brew master @s ~ ~ ~ 5 0.8
@delay 4
@bypass /playsound minecraft:block.note_block.chime master @s ~ ~ ~ 5 1.0
@delay 4
@bypass /playsound minecraft:block.note_block.chime master @s ~ ~ ~ 5 1.5
@delay 4
@bypass /playsound minecraft:block.note_block.chime master @s ~ ~ ~ 5 2.0

@bypass /particle minecraft:witch ~ ~ ~ 1 1 1 2 75 normal


@delay 2s

# Frog Speak
@bypass /playsound minecraft:item.bottle.fill_dragonbreath master @p ~ ~ ~ 5 2.0
@delay 2
@bypass /playsound minecraft:entity.frog.ambient master @p ~ ~ ~ 5 1.3


@player &a&lSushi&a: Ribbit. &#d4d4d4&o(Hello, traveler. You have wandered far to come here. I can see great wisdom behind your eyes.)
@delay 3s

# Frog Speak
@bypass /playsound minecraft:item.bottle.fill_dragonbreath master @p ~ ~ ~ 5 2.0
@delay 2
@bypass /playsound minecraft:entity.frog.ambient master @p ~ ~ ~ 5 1.3

@player &a&lSushi&a: Ribbit? &#d4d4d4&o(I would like to bestow upon you a gift, for the generosity of your presence. But first, I must verify your intelligence.)
@delay 3s

# Frog Speak
@bypass /playsound minecraft:item.bottle.fill_dragonbreath master @p ~ ~ ~ 5 2.0
@delay 2
@bypass /playsound minecraft:entity.frog.ambient master @p ~ ~ ~ 5 1.3

@player &a&lSushi&a: Ribbit. &#d4d4d4&o(This must be a test of wisdom to the utmost level. This must be the very definer of wit and will.)
@delay 3s

# Frog Speak
@bypass /playsound minecraft:item.bottle.fill_dragonbreath master @p ~ ~ ~ 5 2.0
@delay 2
@bypass /playsound minecraft:entity.frog.ambient master @p ~ ~ ~ 5 1.3

@player &a&lSushi&a: Ribbit! &#d4d4d4&o(I will test you now! Be warned, I tire fast, as I have used all of my energy explaining this to you. Should you fail to correctly answer within &#d4d4d4&o&l20 seconds&#d4d4d4&o, you must wait until the next day to try again!)
@delay 4s

# Frog Speak
@bypass /playsound minecraft:item.bottle.fill_dragonbreath master @p ~ ~ ~ 5 2.0
@delay 2
@bypass /playsound minecraft:entity.frog.ambient master @p ~ ~ ~ 5 1.3

@player &a&lSushi&a: Ribbit. &#d4d4d4&o(Alright. No more delay. I am thinking of a whole number from 1-20!)
@delay 3s

# Frog Speak
@bypass /playsound minecraft:item.bottle.fill_dragonbreath master @p ~ ~ ~ 5 2.0
@delay 2
@bypass /playsound minecraft:entity.frog.ambient master @p ~ ~ ~ 5 1.3

@player &a&lSushi&a: Ribbit?! &#d4d4d4&l(What number am I thinking of?!)
@player &#d4d4d4[Type your answer in chat]

# Prompt
@prompt 20s frogprompt Drat, I ran out of time...

# If wrong
@if frogprompt != String(frognum)
    
    @player &a&lSushi&a: Ribb..... szn&a&onnnn..... zzzz...... &l{{frognum}}&a...
    
    # Sleepy Froggy
    @bypass /playsound minecraft:entity.frog.death master @p ~ ~ ~ 5 0.5
    @delay 3
    @bypass /playsound minecraft:entity.fox.sleep master @s ~ ~ ~ 5 0.8
    
    @delay 2s
    @player &#d4d4d4&oShe's... asleep. I guess I didn't get it right.
    
    @return
@fi


# If right
# Frog Speak
@bypass /playsound minecraft:item.bottle.fill_dragonbreath master @p ~ ~ ~ 5 2.0
@delay 2
@bypass /playsound minecraft:entity.frog.ambient master @p ~ ~ ~ 5 1.3

@if !sushiDone
    @player &a&lSushi&a: Ribbit?! &#d4d4d4&o(Oh wise one who shall rule them all. You have achieved greatness. Let live your inner frog.)
    
    @player &a&lSushi&a: Ribbit. &#d4d4d4&o(May these lights guide your heart.)
    
    @delay 3s
    
    @bypass /playsound minecraft:block.note_block.pling master @s ~ ~ ~ 1 1
    
    @player &#d4d4d4--------------------------------------
    @player &#FFFFA8&lF&#F8FFAB&lr&#F1FFAF&lo&#EBFFB2&lg&#E4FFB6&ll&#DDFFB9&li&#D6FFBD&lg&#CFFFC0&lh&#CFFBC6&lt &#D5F3CE&lB&#DBEBD6&ll&#E1E3DE&lo&#E7DCE7&lc&#EDD4EF&lk&#F9C4FF&ls
    @player
    @player &#d4d4d4● Cycles through all 3 Froglights! &l Credit: MaxLovesFrogs
    @player
    @player &#d4d4d4● Unlocked through sheer willpower.
    @player
    @player &aBlock selected!
    @player &#d4d4d4--------------------------------------
    
    @var blockSelection[player] = "verdant_froglight"
    @var blockSelectionStored[player] = "verdant_froglight"
    @var copperGrate[player] = false
    @var grateNumber[player] = 0
    @var woolNumber[player] = 0
    @var glassNumber[player] = 0
    @var pumpkinNumber[player] = 0
    @var lastPumpkinNumber[player] = 0
    @var spongeNumber[player] = 0
    @var lastSpongeNumber[player] = 0
    @var obsidianNumber[player] = 0
    @var lastObsidianNumber[player] = 0
    @var oreNumber[player] = 0
    @var lastOreNumber[player] = 0
    @var coolGlassNumber[player] = 0
    @var lastCoolGlassNumber[player] = 0
    @var coralNumber[player] = 0
    @var lastCoralNumber[player] = 0
    @var froglightNumber[player] = 0
    @var coolGlass = false
    
    @var cosmeticSwap[player] = true
    @var cosmeticSwap100[player] = false
    
    @var resetBlocks(player, 64)
    
    @var sushiDone = true
@fi

# Note for RY - reward here
