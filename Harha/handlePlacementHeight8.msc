# handlePlacementHeight8 (Block block, Player player)
@define Int height = 8

@fast
@using Harha

# define variables for less typing
@define Int x = block.getX()
@define Int y = block.getY()
@define Int z = block.getZ()

@if totalBlocks % 4 == 0
    @if temporaryBlockSelection1 == "wet_sponge"
        @bypass /particle minecraft:splash {{x}} {{y + 0.6}} {{z}} 0.3 0.6 0.3 1 15
    @elseif temporaryBlockSelection1 == "crying_obsidian"
        @bypass /particle minecraft:dragon_breath {{x}} {{y + 0.6}} {{z}} 0.3 0.3 0.3 .01 10
    @elseif temporaryBlockSelection1 == "sculk_catalyst"
        @if (totalFalls / 1000) < 101
            @bypass /particle minecraft:scrape {{x}} {{y + 1.0}} {{z}} 0.3 0 0.3 0.3 {{totalFalls / 1000}}
        @else
            @bypass /particle minecraft:scrape {{x}} {{y + 1.0}} {{z}} 0.3 0 0.3 0.3 100
        @fi
    @elseif coolGlass == true && temporaryBlockSelection1 == "orange_stained_glass"
        @bypass /particle minecraft:trial_spawner_detection {{x}} {{y + 1.0}} {{z}} 0.3 0.3 0.3 00.01 15
        @bypass /particle dust{color:[1.000,0.533,0.220],scale:1} {{x}} {{y + 1.0}} {{z}} .3 .1 .3 1 10 normal
    @elseif coolGlass == true && temporaryBlockSelection1 == "light_blue_stained_glass"
        @bypass /particle minecraft:trial_spawner_detection_ominous {{x}} {{y + 1.0}} {{z}} 0.3 0.3 0.3 00.01 15
        @bypass /particle dust{color:[0.471,0.965,1.000],scale:1} {{x}} {{y + 1.0}} {{z}} .3 .1 .3 1 10 normal
    @fi
    
@elseif totalBlocks % 4 == 1
    @if temporaryBlockSelection2 == "wet_sponge"
        @bypass /particle minecraft:splash {{x}} {{y + 0.6}} {{z}} 0.3 0.6 0.3 1 15
    @elseif temporaryBlockSelection2 == "crying_obsidian"
        @bypass /particle minecraft:dragon_breath {{x}} {{y + 0.6}} {{z}} 0.3 0.3 0.3 .01 10
    @elseif temporaryBlockSelection2 == "sculk_catalyst"
        @if (totalFalls / 1000) < 101
            @bypass /particle minecraft:scrape {{x}} {{y + 1.0}} {{z}} 0.3 0 0.3 0.3 {{totalFalls / 1000}}
        @else
            @bypass /particle minecraft:scrape {{x}} {{y + 1.0}} {{z}} 0.3 0 0.3 0.3 100
        @fi
    @elseif coolGlass == true && temporaryBlockSelection2 == "orange_stained_glass"
        @bypass /particle minecraft:trial_spawner_detection {{x}} {{y + 1.0}} {{z}} 0.3 0.3 0.3 00.01 15
        @bypass /particle dust{color:[1.000,0.533,0.220],scale:1} {{x}} {{y + 1.0}} {{z}} .3 .1 .3 1 10 normal
    @elseif coolGlass == true && temporaryBlockSelection2 == "light_blue_stained_glass"
        @bypass /particle minecraft:trial_spawner_detection_ominous {{x}} {{y + 1.0}} {{z}} 0.3 0.3 0.3 00.01 15
        @bypass /particle dust{color:[0.471,0.965,1.000],scale:1} {{x}} {{y + 1.0}} {{z}} .3 .1 .3 1 10 normal
    @fi
    
@elseif totalBlocks % 4 == 2
    @if temporaryBlockSelection3 == "wet_sponge"
        @bypass /particle minecraft:splash {{x}} {{y + 0.6}} {{z}} 0.3 0.6 0.3 1 15
    @elseif temporaryBlockSelection3 == "crying_obsidian"
        @bypass /particle minecraft:dragon_breath {{x}} {{y + 0.6}} {{z}} 0.3 0.3 0.3 .01 10
    @elseif temporaryBlockSelection3 == "sculk_catalyst"
        @if (totalFalls / 1000) < 101
            @bypass /particle minecraft:scrape {{x}} {{y + 1.0}} {{z}} 0.3 0 0.3 0.3 {{totalFalls / 1000}}
        @else
            @bypass /particle minecraft:scrape {{x}} {{y + 1.0}} {{z}} 0.3 0 0.3 0.3 100
        @fi
    @elseif coolGlass == true && temporaryBlockSelection3 == "orange_stained_glass"
        @bypass /particle minecraft:trial_spawner_detection {{x}} {{y + 1.0}} {{z}} 0.3 0.3 0.3 00.01 15
        @bypass /particle dust{color:[1.000,0.533,0.220],scale:1} {{x}} {{y + 1.0}} {{z}} .3 .1 .3 1 10 normal
    @elseif coolGlass == true && temporaryBlockSelection3 == "light_blue_stained_glass"
        @bypass /particle minecraft:trial_spawner_detection_ominous {{x}} {{y + 1.0}} {{z}} 0.3 0.3 0.3 00.01 15
        @bypass /particle dust{color:[0.471,0.965,1.000],scale:1} {{x}} {{y + 1.0}} {{z}} .3 .1 .3 1 10 normal
    @fi
    
@elseif totalBlocks % 4 == 3
    @if temporaryBlockSelection4 == "wet_sponge"
        @bypass /particle minecraft:splash {{x}} {{y + 0.6}} {{z}} 0.3 0.6 0.3 1 15
    @elseif temporaryBlockSelection4 == "crying_obsidian"
        @bypass /particle minecraft:dragon_breath {{x}} {{y + 0.6}} {{z}} 0.3 0.3 0.3 .01 10
    @elseif temporaryBlockSelection4 == "sculk_catalyst"
        @if (totalFalls / 1000) < 101
            @bypass /particle minecraft:scrape {{x}} {{y + 1.0}} {{z}} 0.3 0 0.3 0.3 {{totalFalls / 1000}}
        @else
            @bypass /particle minecraft:scrape {{x}} {{y + 1.0}} {{z}} 0.3 0 0.3 0.3 100
        @fi
    @elseif coolGlass == true && temporaryBlockSelection4 == "orange_stained_glass"
        @bypass /particle minecraft:trial_spawner_detection {{x}} {{y + 1.0}} {{z}} 0.3 0.3 0.3 00.01 15
        @bypass /particle dust{color:[1.000,0.533,0.220],scale:1} {{x}} {{y + 1.0}} {{z}} .3 .1 .3 1 10 normal
    @elseif coolGlass == true && temporaryBlockSelection4 == "light_blue_stained_glass"
        @bypass /particle minecraft:trial_spawner_detection_ominous {{x}} {{y + 1.0}} {{z}} 0.3 0.3 0.3 00.01 15
        @bypass /particle dust{color:[0.471,0.965,1.000],scale:1} {{x}} {{y + 1.0}} {{z}} .3 .1 .3 1 10 normal
    @fi
@fi

@if totalBlocks % 4 == 0
    # time block stays + 1 from target script
    @delay 4
    
    @bypass /execute in minecraft:theta run setblock {{x}} {{y}} {{z}} air
    @bypass /execute in minecraft:theta run summon falling_block {{x}} {{y}} {{z}} {BlockState:{Name:{{temporaryBlockSelection1}}}, DropItem: 0, CancelDrop:1}
    
    @delay 19
    
    @if (grateList.contains(blockSelection))
        @bypass /playsound minecraft:block.copper_grate.break master @a[distance=..20] ~ {{y - height}} ~ 1 1
    @elseif (woolList.contains(blockSelection))
        @bypass /playsound minecraft:block.wool.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @elseif temporaryBlockSelection1 == "flowering_azalea_leaves"
        @bypass /playsound minecraft:block.azalea_leaves.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @elseif (glassList.contains(blockSelection)) || blockSelection == "blue_ice"
        @bypass /playsound minecraft:block.glass.break master @a[distance=..20] ~ {{y - height}} ~ 0.3 0.8
    @elseif (blocksSound.contains(blockSelection))
        @bypass /playsound minecraft:block.stone.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @elseif (blocksSoundOres.contains(blockSelection))
        @bypass /playsound minecraft:block.stone.break master @a[distance=..20] ~ {{y - height}} ~ 1 1.2
    @elseif (pumpkinList.contains(blockSelection))
        @bypass /playsound minecraft:block.wood.break master @a[distance=..20] ~ {{y - height}} ~ 0.5 0.8
    @elseif (coralList.contains(blockSelection))
        @bypass /playsound minecraft:block.coral_block.break master @s ~ {{y - height}} ~ 1 0.8
    @else
        @bypass /playsound minecraft:block.{{temporaryBlockSelection1}}.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @fi
    
    @bypass /execute in minecraft:theta run particle block{block_state:{Name:{{temporaryBlockSelection1}}}} {{x}} {{y - height}} {{z}} 0.3 0.3 0.3 1 40
    @return
    
    
    
@elseif totalBlocks % 4 == 1
    # time block stays + 1 from target script
    @delay 4
    
    @bypass /execute in minecraft:theta run setblock {{x}} {{y}} {{z}} air
    @bypass /execute in minecraft:theta run summon falling_block {{x}} {{y}} {{z}} {BlockState:{Name:{{temporaryBlockSelection2}}}, DropItem: 0, CancelDrop:1}
    
    @delay 19
    
    @if (grateList.contains(blockSelection))
        @bypass /playsound minecraft:block.copper_grate.break master @a[distance=..20] ~ {{y - height}} ~ 1 1
    @elseif (woolList.contains(blockSelection))
        @bypass /playsound minecraft:block.wool.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @elseif temporaryBlockSelection2 == "flowering_azalea_leaves"
        @bypass /playsound minecraft:block.azalea_leaves.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @elseif (glassList.contains(blockSelection)) || blockSelection == "blue_ice"
        @bypass /playsound minecraft:block.glass.break master @a[distance=..20] ~ {{y - height}} ~ 0.3 0.8
    @elseif (blocksSound.contains(blockSelection))
        @bypass /playsound minecraft:block.stone.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @elseif (blocksSoundOres.contains(blockSelection))
        @bypass /playsound minecraft:block.stone.break master @a[distance=..20] ~ {{y - height}} ~ 1 1.2
    @elseif (pumpkinList.contains(blockSelection))
        @bypass /playsound minecraft:block.wood.break master @a[distance=..20] ~ {{y - height}} ~ 0.5 0.8
    @elseif (coralList.contains(blockSelection))
        @bypass /playsound minecraft:block.coral_block.break master @s ~ {{y - height}} ~ 1 0.8
    @else
        @bypass /playsound minecraft:block.{{temporaryBlockSelection2}}.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @fi
    
    @bypass /execute in minecraft:theta run particle block{block_state:{Name:{{temporaryBlockSelection2}}}} {{x}} {{y - height}} {{z}} 0.3 0.3 0.3 1 40
    @return
    
    
    
@elseif totalBlocks % 4 == 2
    # time block stays + 1 from target script
    @delay 4
    
    @bypass /execute in minecraft:theta run setblock {{x}} {{y}} {{z}} air
    @bypass /execute in minecraft:theta run summon falling_block {{x}} {{y}} {{z}} {BlockState:{Name:{{temporaryBlockSelection3}}}, DropItem: 0, CancelDrop:1}
    
    @delay 19
    
    @if (grateList.contains(blockSelection))
        @bypass /playsound minecraft:block.copper_grate.break master @a[distance=..20] ~ {{y - height}} ~ 1 1
    @elseif (woolList.contains(blockSelection))
