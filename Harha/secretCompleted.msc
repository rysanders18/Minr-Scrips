# secretCompleted(Player player, Int secretNumber)
@fast
@using Harha


@if secretsCompletedList[player][secretNumber] == 0
    @player &6&lSecret #{{secretNumber + 1}} Completed!
    @var secretsCompletedList[player][secretNumber] = 1
    @bypass execute as @s at @s anchored feet run particle minecraft:totem_of_undying {{player.getX()}} {{player.getY() + 1}} {{player.getZ()}} 2 2 2 1 1000 normal @s

    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 0.707
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 0.891
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 1.059

    @delay 2
    @bypass execute as @s at @s anchored feet run particle minecraft:totem_of_undying {{player.getX()}} {{player.getY() + 1}} {{player.getZ()}} 2 2 2 1 1000 normal @s

    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 0.707
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 0.891
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 1.059

    @delay 2
    @bypass execute as @s at @s anchored feet run particle minecraft:totem_of_undying {{player.getX()}} {{player.getY() + 1}} {{player.getZ()}} 2 2 2 1 1000 normal @s

    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 0.707
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 0.891
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 1.059
@fi