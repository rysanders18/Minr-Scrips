    @bypass /data merge entity @e[tag=secretHeadEntity{{secretNumber}},limit=1] {start_interpolation:0,interpolation_duration:40,transformation:{left_rotation:[0f, 0f, 0f, 1f],right_rotation:[-0.324f, 0f, 0.324f, 0.889f],translation:[-0.145f, 1.3141f, -0.145f],scale:[1f, 1f, 1f]},item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor15}}"}]}}}}
    @delay 1
    @bypass /playsound minecraft:block.beacon.activate master {{player}} ~ ~ ~ 1 {{noteNumber}}
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 {{noteNumber}}
    @bypass particle minecraft:trial_spawner_detection_ominous {{secretBlock.getX()}} {{secretBlock.getY()}} {{secretBlock.getZ()}} 0.225 0 0.225 {{particleMovementNumber}} 3
    @bypass particle minecraft:trial_spawner_detection {{secretBlock.getX()}} {{secretBlock.getY()}} {{secretBlock.getZ()}} 0.125 0 0.125 0.01 5
    @var noteNumber += 0.01
    @var particleMovementNumber += 0.0006

    @if i == 4
        @bypass /effect give {{player}} minecraft:darkness 3.5 69 true
        # @bypass /effect give {{player}} minecraft:nausea infinite 69 true
    @fi
@done

@bypass /minecraft:kill @e[tag=secretHeadEntity{{secretNumber}}]
@bypass /setblock {{secretBlock.getX()}} {{secretBlock.getY()}} {{secretBlock.getZ()}} {{redGold}} strict
@var player.teleport(allPositions[allSecretReturnStages[secretNumber]])
@delay 1
@bypass /execute as @s at @s anchored eyes run particle minecraft:flash ^ ^ ^1 0 0 0 0 2 force @s
# @bypass /effect clear {{player}}
@bypass /playsound minecraft:entity.creaking.death master @a[distance=..20] ~ ~ ~ 2 0
@bypass /playsound minecraft:item.totem.use master @a[distance=..20] ~ ~ ~ 0.75 {{math::random(1.1D, 1.4D)}}
@bypass /particle minecraft:trial_spawner_detection_ominous ~ ~ ~ 0 0 0 00.25 50
@bypass /particle minecraft:trial_spawner_detection ~ ~ ~ 0 0 0 00.25 50

# cosmetic unlock message in chat
@if oldSecretsCompleted < 1 && secretsCompletedList[player].sum() >= 1
    @var cosmeticsUnlocked[player][6] = 1
    @player &#d4d4d4----------------------------
    @player &6&lCosmetic Unlocked!
    @player &#A8201F&lN&#9C1817&le&#8F1010&lt&#830808&lh&#760000&le&#5E1F21&lr &#463D41&lB&#2E5C62&ll&#167A82&lo&#158282&lc&#148982&lk&#119882&ls
    @player &#d4d4d4----------------------------
    @bypass /playsound minecraft:ui.toast.challenge_complete master @s ~ ~ ~ 1 1.5
    @bypass /execute at {{player}} anchored feet run particle minecraft:totem_of_undying ~ ~1 ~ 2 1 2 0.05 150 force @a[distance=..30]
@elseif oldSecretsCompleted < 3 && secretsCompletedList[player].sum() >= 3
    @var cosmeticsUnlocked[player][7] = 1
    @player &#d4d4d4----------------------------
    @player &6&lCosmetic Unlocked!
    @player &#E38627&lP&#D88A34&la&#CD8E41&lr&#C3924F&lt&#B8965C&li&#AD9A69&lc&#A29E76&ll&#98A384&le &#8DA791&lG&#82AB9E&ll&#77AFAB&la&#6CB3B8&ls&#62B7C6&ls&#4CBFE0&l
    @player &#d4d4d4----------------------------
    @bypass /playsound minecraft:ui.toast.challenge_complete master @s ~ ~ ~ 1 1.5
    @bypass /execute at {{player}} anchored feet run particle minecraft:totem_of_undying ~ ~1 ~ 2 1 2 0.05 150 force @a[distance=..30]
@elseif oldSecretsCompleted < 10 && secretsCompletedList[player].sum() >= 10
    @var cosmeticsUnlocked[player][8] = 1
    @player &#d4d4d4----------------------------
    @player &6&lCosmetic Unlocked!
    @player &#ED1C24&lR&#F64E26&la&#FF7F27&li&#FFB914&ln&#FFF200&lb&#91D226&lo&#22B14C&lw &#11AA9A&lW&#00A2E8&lo&#3E7ED9&lo&#7C5AC9&ll&#FA6EFF&l
    @player &#d4d4d4----------------------------
    @bypass /playsound minecraft:ui.toast.challenge_complete master @s ~ ~ ~ 1 1.5
    @bypass /execute at {{player}} anchored feet run particle minecraft:totem_of_undying ~ ~1 ~ 2 1 2 0.05 150 force @a[distance=..30]
@fi

@var secretCompletedTitle(player, secretNumber)
# @bypass /data merge entity @e[tag=secretHeadEntity{{secretNumber}},limit=1] {start_interpolation:0,interpolation_duration:400,transformation: {  left_rotation: [0f, 0f, 0f, 1f],  right_rotation: [-0.324f, 0f, 0.324f, 0.889f],  translation: [-0.145f, 1.3141f, -0.145f],  scale: [1f, 1f, 1f]},item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvYzJjOTRhNDM1OWY3NzYzNDM0NjFmNzZhNDM1NTE0M2ZhNWQ4MWMwOGE0MmU3ZDgyODJjMjIzMGRhODUwNGY4MCJ9fX0="}]}}}}
# @fi
