# Summon block entity inside lodestone to load all textures
@bypass /summon item_display {{secretBlock.getX()}} {{secretBlock.getY() - 0.5}} {{secretBlock.getZ()}} {Tags:["secretHeadEntityLoading{{secretNumber}}"],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0.25f,0f],scale:[1f,1f,1f]},item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor00}}"}]}}}}
@delay 11
@bypass /data merge entity @e[tag=secretHeadEntityLoading{{secretNumber}},limit=1] {item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor0}}"}]}}}}
@delay 1
@bypass /data merge entity @e[tag=secretHeadEntityLoading{{secretNumber}},limit=1] {item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor1}}"}]}}}}
@delay 1
@bypass /data merge entity @e[tag=secretHeadEntityLoading{{secretNumber}},limit=1] {item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor2}}"}]}}}}
@delay 1
@bypass /data merge entity @e[tag=secretHeadEntityLoading{{secretNumber}},limit=1] {item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor3}}"}]}}}}
@delay 1
@bypass /data merge entity @e[tag=secretHeadEntityLoading{{secretNumber}},limit=1] {item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor4}}"}]}}}}
@delay 1
@bypass /data merge entity @e[tag=secretHeadEntityLoading{{secretNumber}},limit=1] {item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor5}}"}]}}}}
@delay 1
@bypass /data merge entity @e[tag=secretHeadEntityLoading{{secretNumber}},limit=1] {item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor6}}"}]}}}}
@delay 1
@bypass /data merge entity @e[tag=secretHeadEntityLoading{{secretNumber}},limit=1] {item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor7}}"}]}}}}
@delay 1
@bypass /data merge entity @e[tag=secretHeadEntityLoading{{secretNumber}},limit=1] {item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor8}}"}]}}}}
@delay 1
@bypass /data merge entity @e[tag=secretHeadEntityLoading{{secretNumber}},limit=1] {item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor9}}"}]}}}}
@delay 1
@bypass /data merge entity @e[tag=secretHeadEntityLoading{{secretNumber}},limit=1] {item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor10}}"}]}}}}
@delay 1
@bypass /data merge entity @e[tag=secretHeadEntityLoading{{secretNumber}},limit=1] {item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor11}}"}]}}}}
@delay 1
@bypass /data merge entity @e[tag=secretHeadEntityLoading{{secretNumber}},limit=1] {item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor12}}"}]}}}}
@delay 1
@bypass /data merge entity @e[tag=secretHeadEntityLoading{{secretNumber}},limit=1] {item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor13}}"}]}}}}
@delay 1
@bypass /data merge entity @e[tag=secretHeadEntityLoading{{secretNumber}},limit=1] {item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor14}}"}]}}}}
@delay 1
@bypass /data merge entity @e[tag=secretHeadEntityLoading{{secretNumber}},limit=1] {item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor15}}"}]}}}}
@delay 1

@bypass /minecraft:kill @e[tag=secretHeadEntityLoading{{secretNumber}},limit=1]

@delay 3
# @define Block targetBlock = Block(block.getX(), block.getY(), block.getZ(), block.getWorld())

@bypass /setblock {{secretBlock.getX()}} {{secretBlock.getY()}} {{secretBlock.getZ()}} {{diamondBlock}} strict
@bypass /setblock {{secretBlock.getX()}} {{secretBlock.getY() - 1}} {{secretBlock.getZ()}} diamond_block strict
@bypass /playsound minecraft:block.note_block.hat master {{player}} ~ ~ ~ 2 0.5
@bypass particle minecraft:trial_spawner_detection_ominous {{secretBlock.getX()}} {{secretBlock.getY()}} {{secretBlock.getZ()}} 0.125 0 0.125 0.1 5
@bypass particle minecraft:trial_spawner_detection {{secretBlock.getX()}} {{secretBlock.getY()}} {{secretBlock.getZ()}} 0.125 0 0.125 0.1 5
@delay 1
@bypass /setblock {{secretBlock.getX()}} {{secretBlock.getY()}} {{secretBlock.getZ()}} {{redGold}} strict
@bypass /setblock {{secretBlock.getX()}} {{secretBlock.getY() - 1}} {{secretBlock.getZ()}} lodestone strict
@delay 10
@bypass /setblock {{secretBlock.getX()}} {{secretBlock.getY()}} {{secretBlock.getZ()}} {{diamondBlock}} strict
@bypass /setblock {{secretBlock.getX()}} {{secretBlock.getY() - 1}} {{secretBlock.getZ()}} diamond_block strict
