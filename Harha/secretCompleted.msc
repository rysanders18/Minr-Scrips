# secretCompleted(Player player, Int secretNumber, Block secretBlock)

@fast
@using Harha



# @if secretsCompletedList[player][secretNumber] == 0
# @player &6&lSecret #{{secretNumber + 1}} Completed!
@define Int oldSecretsCompleted = secretsCompletedList[player].sum()
@var secretsCompletedList[player][secretNumber] = 1

# @for Int j in list::range(0, 1)
@for Int i in list::range(0, 200)
    # @bypass /playsound minecraft:item.goat_horn.sound.1 master {{player}} ~ ~ ~ 0.5 {{(Float(i) / Float(200)) * 1.5 + 0.5}}
    @bypass /playsound minecraft:block.beacon.activate master {{player}} ~ ~ ~ 1 {{(Float(i) / Float(200)) * 1.5 + 0.5}}
@done
@bypass particle minecraft:trial_spawner_detection_ominous {{secretBlock.getX()}} {{secretBlock.getY()}} {{secretBlock.getZ()}} 0.125 0 0.125 0.1 50
@bypass particle minecraft:trial_spawner_detection {{secretBlock.getX()}} {{secretBlock.getY()}} {{secretBlock.getZ()}} 0.125 0 0.125 0.1 50
# @done

