# set blockSelection to 100% cosmetic
@using Harha
@fast

@cooldown 1s

# =======================================================
    

    @bypass /playsound minecraft:block.note_block.pling master @s ~ ~ ~ 1 1
    
    @player &#d4d4d4--------------------------------------
    @player &#7B42FF&l1&#794BFC&l0&#7755F9&l0&#755EF5&l% &#7368F2&lC&#7171EF&lo&#6F7BEC&lm&#6D84E9&lp&#6B8EE5&ll&#6997E2&le&#67A1DF&lt&#64AADC&li&#62B3D9&lo&#60BDD5&ln &#5EC6D2&lB&#5CD0CF&ll&#5AD9CC&lo&#58E3C9&lc&#56ECC5&lk&#52FFBF&ls
    @player
    @player &#d4d4d4● Type &lANY FULL BLOCKS&#d4d4d4 in &lANY ORDER&#d4d4d4 you want!
    @player
    @player &#d4d4d4● Unlocked by achieving 100% in Harder Hat! &lGG!
    @player
    @player &#d4d4d4● Type your &lcustom color order&#d4d4d4 in a comma-seperated list.
    @player &#d4d4d4&l &#d4d4d4&l &#d4d4d4Example: "dark_prismarine, bedrock, sand, spawner"
    @player
    @player &aBlock selected!
    @player &#d4d4d4--------------------------------------
    @player &eType your custom order:
    
    
    @define String customTotalList
    @prompt 40s customTotalList You took too long!
    
    # List of blocks that it checks
    @define String[] blocksAllowed = String["creaking_heart", "trial_spawner", "coarse_dirt", "grass_block", "rooted_dirt", "barrier", "cyan_wool", "light_blue_wool", "blue_wool", "lime_wool", "green_wool", "jungle_planks", "spruce_planks", "birch_planks", "oak_planks", "acacia_planks", "stripped_oak_wood", "stripped_spruce_wood", "stripped_birch_wood", "stripped_jungle_wood", "stripped_acacia_wood", "stripped_dark_oak_wood", "stripped_mangrove_wood", "stripped_cherry_wood", "stripped_pale_oak_wood", "stripped_crimson_hyphae", "stripped_warped_hyphae", "stripped_pale_oak_log", "stripped_pale_oak_wood", "purple_wool", "magenta_wool", "pink_wool", "cauldron", "gilded_blackstone", "red_wool", "light_gray_wool", "gray_wool", "oak_wood", "spruce_wood", "birch_wood", "jungle_wood", "acacia_wood", "dark_oak_wood", "mangrove_wood", "cherry_wood", "dirt", "mud", "clay", "sandstone", "red_sandstone", "sand", "red_sand", "suspicious_sand", "suspicious_gravel", "gravel", "snow_block", "moss_block", "stone", "deepslate", "granite", "diorite", "andesite", "calcite", "tuff", "dripstone_block", "prismarine", "magma_block", "crimson_nylium", "crimson_hyphae", "gold_ore", "deepslate_copper_ore", "copper_ore", "deepslate_iron_ore", "iron_ore", "deepslate_coal_ore", "coal_ore", "end_stone", "smooth_basalt", "basalt", "blackstone", "bone_block", "soul_soil", "netherrack", "crying_obsidian", "obsidian", "warped_nylium", "warped_hyphae", "deepslate_gold_ore", "redstone_ore", "deepslate_redstone_ore", "emerald_ore", "deepslate_emerald_ore", "lapis_ore", "deepslate_lapis_ore", "diamond_ore", "deepslate_diamond_ore", "nether_gold_ore", "nether_quartz_ore", "ancient_debris", "raw_iron_block", "raw_copper_block", "raw_gold_block", "glowstone", "amethyst_block", "muddy_mangrove_roots", "wet_sponge", "sponge", "dead_horn_coral_block", "dead_fire_coral_block", "dead_bubble_coral_block", "dead_brain_coral_block", "dead_tube_coral_block", "horn_coral_block", "fire_coral_block", "bubble_coral_block"