    @define String endOutput = ""
    
    @var customTotalList = customTotalList.toLowerCase()
    @var totalList[player] = customTotalList.split(", ")
    
    # Splits up the prompt into a string list and checks each value if its in the list of possible blocks
    @for Int i in list::range(0, totalList.length())
        # @var totalList[i] = "minecraft:" + totalList[i]
        @if blocksAllowed.contains(totalList[i]) == false
            @bypass playsound minecraft:block.note_block.didgeridoo master {{player}} ~ ~ ~ 1 1
            @player &cInvalid format! &l{{totalList[i].substring(0, totalList[i].length())}} &cis not an allowed block. Sorry :(
            @return
        @fi
    @done
    
    # removes the first comma and space, 4 because color code "&f, "
    # @var endOutput = endOutput.substring(0, endOutput.length() - 2)
    @player &#d4d4d4Custom order = &e{{customTotalList}}
    @player &#d4d4d4Have fun!
    @bypass /playsound minecraft:block.note_block.pling master @s ~ ~ ~ 1 1
    
    
    @var blockSelection[player] = totalList[0]
    @var blockSelectionStored[player] = totalList[0]
    @var copperGrate[player] = false
    @var grateNumber[player] = 0
    @var woolNumber[player] = 0
    @var glassNumber[player] = 0
    @var pumpkinNumber[player] = 0
    @var lastPumpkinNumber[player] = 0
    @var spongeNumber[player] = 0
    @var lastSpongeNumber[player] = 0
    @var obsidianNumber[player] = 0
    @var lastObsidianNumber[player] = 0
    @var oreNumber[player] = 0
    @var lastOreNumber[player] = 0
    @var coolGlassNumber[player] = 0
    @var lastCoolGlassNumber[player] = 0
    @var coolGlass[player] = false
    @var numberOfBlocksToGive[player] = 63
    @var totalNumber[player] = 0
    
    @var cosmeticSwap[player] = true
    @var cosmeticSwap100[player] = true
    
    @var resetBlocks(player, 64)
    

