
# styleViewer(Player player, Int level) https://paste.minr.org/owequqocub
@using Harha
@fast

@if speedrunMode[player] == 0 || difficultySelection != "normal"
    @define Int[] thresholds = Int[]
    @define Int[] rewards = Int[]
    @define Int startIndex = 0
    @define Int pointsToEarn = 0
    @define Int totalPoints = 0
    
    @bypass playsound minecraft:ui.button.click master @s
    
    @if level == 0
        @var thresholds = l101Thresholds
        @var rewards = l101Rewards
        @var startIndex = l101StartIndex
    @elseif level == 1
        @var thresholds = l102Thresholds
        @var rewards = l102Rewards
