    @fi
    
    @player &#d4d4d4-=-=-=-=-=-=-=-=-=-=-
    
    
    
@elseif speedrunMode[player] != 0
    @if difficultySelection == "normal"
        # TODO: uncomment this
        # @define timer::Timer timer = timer::getMapTimer(player, "harha")
        # @if timer != null
        #     @var timer.invalidate()
        #     @player &cTimer Invalidated!
        # @fi
        
        @var speedrunTeleportedRecently[player] = true
        @var hasTeleported[player] = true
        
        @if speedrunMode[player] == 1
            @var player.teleport(Position(-9199.5, 96.0, 9715.5, 180.0, 10.0, "Theta"))
            @var setLevel(0, player)
            @var stage[player] = 0
            @var ensureBlockSelection(0, player)
            @var resetBlocks(player, 64)
            @bypass clear {{player}} leather_boots
            @if bootsObtained[player] == true
                @var bootsObtained[player] = false
                @bypass /item replace entity {{player}} armor.head with air
                @delay 1
                @var hatFunction(player)
            @fi
        @elseif speedrunMode[player] == 2
            @var player.teleport(Position(-9160.5, 101.0, 9680.5, 270.0, 10.0, "Theta"))
            @var setLevel(10, player)
            @var stage[player] = 1
            @var ensureBlockSelection(10, player)
            @var resetBlocks(player, 64)
            @bypass clear {{player}} leather_boots
            @if bootsObtained[player] == true
                @var bootsObtained[player] = false
                @bypass /item replace entity {{player}} armor.head with air
                @delay 1
                @var hatFunction(player)
            @fi
        @elseif speedrunMode[player] == 3
            @var player.teleport(Position(-9132.5, 101.0, 9641.5, 180.0, 10.0, "Theta"))
            @var setLevel(20, player)
            @var stage[player] = 2
            @var ensureBlockSelection(20, player)
            @var resetBlocks(player, 64)
            @bypass clear {{player}} leather_boots
            @if bootsObtained[player] == true
                @var bootsObtained[player] = false
                @bypass /item replace entity {{player}} armor.head with air
                @delay 1
                @var hatFunction(player)
            @fi
        @elseif speedrunMode[player] == 4
            @var player.teleport(Position(-9189.5, 100.13, 9582.5, 287.0, 10.0, "Theta"))
            @var setLevel(30, player)
            @var stage[player] = 3
            @var ensureBlockSelection(30, player)
            @var resetBlocks(player, 64)
            @bypass clear {{player}} leather_boots
            @if bootsObtained[player] == true
                @var bootsObtained[player] = false
                @bypass /item replace entity {{player}} armor.head with air
                @delay 1
                @var hatFunction(player)
            @fi
        @elseif speedrunMode[player] == 5
            @var player.teleport(Position(-9182.5, 101.0, 9563.5, 180.0, 10.0, "Theta"))
            @var setLevel(40, player)
            @var stage[player] = 4
            @var ensureBlockSelection(40, player)
            @var resetBlocks(player, 64)
            @var bootsObtained = true
            @var bootsFunction(player)
        @elseif speedrunMode[player] == 6
            @var player.teleport(Position(-9067.5, 102.0, 9509.0, 0.0, 10.0, "Theta"))
            @var setLevel(50, player)
            @var stage[player] = 5
            @var ensureBlockSelection(50, player)
            @var resetBlocks(player, 64)
            @var bootsObtained = true
            @var bootsFunction(player)
        @elseif speedrunMode[player] == 7
            @var player.teleport(Position(-4600.5, 91.0, 5201.5, -180.0, 10.0, "Theta_the_end"))
            @var setLevel(60, player)
            @var stage[player] = 6
            @var ensureBlockSelection(60, player)
            @var resetBlocks(player, 64)
            @var bootsObtained = true
            @var bootsFunction(player)
        @elseif speedrunMode[player] == 8
            @var player.teleport(Position(-9199.5, 92.0, 9742.5, -180.0, 20.0, "Theta"))
            @var setLevel(0, player)
            @var stage[player] = 0
            @var ensureBlockSelection(0, player)
            @var bootsObtained = false
            @bypass clear {{player}}
        @fi
        
        @bypass playsound minecraft:ui.button.click master {{player}} ~ ~ ~ 0.5 1
        @bypass playsound minecraft:entity.enderman.teleport master {{player}} ~ ~ ~ 0.5 1
    @else
        @player &cYou can not use speedrun mode while in a challenge!
        @bypass /playsound minecraft:block.noteblock.didgeridoo master {{player}} ~ ~ ~ 0.5 1
    @fi
@fi
