    @elseif level == 69
        @var thresholds = l710Thresholds
        @var rewards = l710Rewards
        @var startIndex = l710StartIndex
    @fi
    
    @if startIndex == 0 && level != 0
        
        @player &#d4d4d4-=-=-=-= &n{{allLevels[level]}}&#d4d4d4 =-=-=-=-
        @player &#7e7e7e{{allLevels[level]}} has no style points.
        @player
        
    @else
        
        @player &#d4d4d4-=-=-=-= &n{{allLevels[level]}}&#d4d4d4 =-=-=-=-
        @for Int i in list::range(0, thresholds.length())
            # DEBUG @player i = {{i}}
            # DEBUG @player claimed style points? {{claimedStylePoints[startIndex + rewards.length() - i - 1]}} {{startIndex + rewards.length() - i - 1}}
            @if claimedStylePoints[startIndex + rewards.length() - i - 1] == true
                
                @var totalPoints += rewards[rewards.length() - 1 - i]
                @var pointsToEarn += rewards[rewards.length() - 1 - i]
                
                @if thresholds[thresholds.length() - 1 - i] == 1
                    @player &aBeat using {{thresholds[thresholds.length() - 1 - i]}} Block: {{totalPoints}} Points ✔
                @else
                    @player &aBeat using {{thresholds[thresholds.length() - 1 - i]}} Blocks: {{totalPoints}} Points ✔
                @fi
                
                
            @else
                @var totalPoints += rewards[rewards.length() - 1 - i]
                
                @if thresholds[thresholds.length() - 1 - i] == 1
                    @player &cBeat using {{thresholds[thresholds.length() - 1 - i]}} Block: {{totalPoints}} Points ✕
                @else
                    @player &cBeat using {{thresholds[thresholds.length() - 1 - i]}} Blocks: {{totalPoints}} Points ✕
                @fi
                
            @fi
            
        @done
        @player &#d4d4d4Style points this stage: ({{pointsToEarn}}/{{totalPoints}}), Total: ({{swagPoints[player]}}/3500)
        @player
        
    @fi
    
    @if level == 0
        @player &#d4d4d4&lAdvice:&7 These signs will give &#d4d4d4&ltips and advice &7for each level! If you’re stuck, these signs can help you out. It is good practice to try to &#d4d4d4&lplace right before you land.
    @elseif level == 1
        @player &#d4d4d4&lAdvice:&7 Here it helps to &#d4d4d4&lturn as soon as you place.&7 Try to stafe so you &#d4d4d4&ldon’t slam into the walls.
    @elseif level == 2
        @player &#d4d4d4&lAdvice:&7 If you’re running into the iron bar, &#d4d4d4&ltry landing further left &7on the first block. Turn immediately after you place and strafe left away from the wall. You can stand suprisingly far left on the block!
    @elseif level == 3
        @player &#d4d4d4&lAdvice:&7 Try to &#d4d4d4&lslow down &7so you &#d4d4d4&ldon't run into the corner. &7It's easier to &#d4d4d4&lonly place 2 blocks!
    @elseif level == 4
        @player &#d4d4d4&lAdvice:&7 Try to &#d4d4d4&lstrafe left &7away from the wall so you don’t hit the corner. &#d4d4d4&lYou can land very far left &7on the first block. Further than you think!
    @elseif level == 5
        @player &#d4d4d4&lAdvice:&7 Try to &#d4d4d4&lstrafe left &7away from the wall so you don’t hit the corner. &#d4d4d4&lYou can land very far left &7on the first block. Further than you think!
    @elseif level == 6
        @player &#d4d4d4&lAdvice:&7 Some players find this level &#d4d4d4&leasier without straffing. &7Flick your mouse down to the target, then flick it back fowards before you jump. Strafing away from the targets may help.
    @elseif level == 7
        @player &#d4d4d4&lAdvice:&7 You can carry your momentum and &#d4d4d4&lchain the jumps,&7 or you can stop and take each jump slow! The choice is yours.
    @elseif level == 8
        @player &#d4d4d4&lAdvice:&7 It might help if you &#d4d4d4&lslow down around the corners! &7You can slow down by letting go of W for a bit or by stopping your sprint. &#d4d4d4&lTry to avoid bonking against the corners. &7You can stand pretty far out on the blocks you place.
    @elseif level == 9
        @player &#d4d4d4&lAdvice:&7 Try to land &#d4d4d4&las far as possible &7on the first block, &#d4d4d4&lstrafe right, and turn in &7to pass the iron bars!
    @elseif level == 10
        @player &#d4d4d4&lAdvice:&7 Try to &#d4d4d4&lplace right before you land &7when stacking! Get as much speed as you can for the last 2+1. If you &#d4d4d4&lstart gaining momentum earlier &7and &#d4d4d4&lland on the edge &7you can make it! You can &#d4d4d4&lrun a bit &7on the last block if you &#d4d4d4&lplace it right before landing &7on it.
    @elseif level == 11
        @player &#d4d4d4&lAdvice:&7 If you stand in the middle, you &#d4d4d4&ldon’t have to strafe left and right! &7Just move your mouse, not your body. Make sure you gain enough speed to make the final jump.
    @elseif level == 12
        @player &#d4d4d4&lAdvice:&7 This level is much easier if you &#d4d4d4&ldon’t press against the walls. &7You have to move less distance and its easier to aim! Don't sprint until the jump to the end.
    @elseif level == 13
        @player &#d4d4d4&lAdvice:&7 This level is much easier if you &#d4d4d4&ldon’t press against the walls. &7You have to move less distance and its easier to aim! You also don’t have to strafe left and right.
    @elseif level == 14
        @player &#d4d4d4&lAdvice:&7 It helps if you try to &#d4d4d4&ljump halfway between the blocks &7so you &#d4d4d4&ldon’t have to move left and right. &7You can &#d4d4d4&lrun a bit on the last block &7to gain more speed if you &#d4d4d4&lplace it right before landing &7on it. It helps if you stand towards the closer edge of the blocks, so you don't have to move your mouse as much.
    @elseif level == 15
        @player &#d4d4d4&lAdvice:&7 This level is much easier if you &#d4d4d4&ldon’t press against the sides. &7You have to move less distance and its easier to aim!
    @elseif level == 16
        @player &#d4d4d4&lAdvice:&7 If you’re failing the last jump, try to &#d4d4d4&lrun a bit &7before you jump on the last block.
    @elseif level == 17
        @player &#d4d4d4&lAdvice:&7 If you’re failing the last jump, try to &#d4d4d4&lrun a bit &7before you jump on the last block.
    @elseif level == 18
        @player &#d4d4d4&lAdvice:&7 Try to &#d4d4d4&lstay as close to the middle &7as you can, and don’t press against any walls. This level is easier if you &#d4d4d4&ldon’t sprint.
    @elseif level == 19
        @player &#d4d4d4&lAdvice:&7 Try to &#d4d4d4&lrun as long as possible &7on each block. It will help your aim if you&#d4d4d4&l stand towards the closer edge &7of the block, because you have to move your mouse less. &#d4d4d4&lStrafe!
    @elseif level == 20
        @player &#d4d4d4&lAdvice:&7 &#d4d4d4&lHold space &7for most of the slimes in this section!
    @elseif level == 21
        @player &#d4d4d4&lAdvice:&7 Get as much momentum as you can and &#d4d4d4&lhold space &7on the slime. Flick fowards after placing.
    @elseif level == 22
        @player &#d4d4d4&lAdvice:&7
    @elseif level == 23
