# if theyve completed the map, just have teleport sign script
@else
@if difficultySelection == "normal" || difficultySelection == "master" 
@bypass playsound minecraft:ui.button.click master @s
@player 
@player &c&lWARNING: &cTeleporting will invalidate your timer.
@player &7Enter Stage and Level in chat:
@player &7Format: x-xx
@player
@define String destination
@define Boolean validFormat = false
@define String confirmation
@prompt 20s destination &cYou took too long!
@for Int i in list::range(0, 70)
    @if destination == allLevels[i]
        
