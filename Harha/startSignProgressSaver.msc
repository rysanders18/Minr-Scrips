# Start Sign Progress Saver
@fast
@using Harha
@cooldown 10s

@bypass playsound minecraft:ui.button.click master {{player}} ~ ~ ~ 0.5 1

# # four save points
# @if harhaProgress < 1
#     @var harhaProgress = 1
#     @player &5Maze progress saved!
# @fi

# @if harhaProgress < 2
#     @var harhaProgress = 2
#     @player &5Maze progress saved!
# @fi

# @if harhaProgress < 3
#     @var harhaProgress = 3
#     @player &5Maze progress saved!
# @fi

# @if harhaProgress < 4
#     @var harhaProgress = 4
#     @player &5Maze progress saved!
# @fi

# # reset at end
# @var harhaProgress = 0

@if difficultySelection == "normal" || difficultySelection == "master" 
@if numberCompletions[player] == 0

  @if harhaProgress == 0
      @player &cYou have not reached a checkpoint yet!
      @bypass playsound minecraft:block.note_block.didgeridoo master {{player}} ~ ~ ~ 0.5 0.5
      @return
  @fi

  @define String askPlayer
  @player &eAre you sure you want to continue your progress? You will get a completion, but your timer will be &linvalidated &e(Type "Yes")
  @prompt 15s askPlayer &cYou took too long!

  @if askPlayer.toLowerCase() != "yes"
    @bypass /playsound minecraft.ui.button.click master {{player}} ~ ~ ~ 0.5 1
    @return
  @fi

  @define timer::Timer timer = timer::getMapTimer(player, "harha")



  @if harhaProgress == 1
    @var player.teleport(Position(-9151.5, 98.0, 9680.5, -90.0, 10.0, "Theta"))
    @delay 1
    @bypass playsound minecraft:entity.enderman.teleport master {{player}} ~ ~ ~ 1 1
    @bypass execute at {{player}} run particle minecraft:witch ~ ~ ~ 0 1 0 1 100 normal
  @elseif harhaProgress == 2
    @var player.teleport(Position(-9131.5, 101.0, 9636.5, -90.0, 10.0, "Theta"))
    @delay 1
    @bypass playsound minecraft:entity.enderman.teleport master {{player}} ~ ~ ~ 1 1
    @bypass execute at {{player}} run particle minecraft:witch ~ ~ ~ 0 1 0 1 100 normal
  @elseif harhaProgress == 3
    @var player.teleport(Position(-9199.5, 99.0, 9604.5, 0.0, 10.0, "Theta"))
    @delay 1
    @bypass playsound minecraft:entity.enderman.teleport master {{player}} ~ ~ ~ 1 1
    @bypass execute at {{player}} run particle minecraft:witch ~ ~ ~ 0 1 0 1 100 normal
  @elseif harhaProgress == 4
    @var player.teleport(Position(-9168.5, 101.0, 9559.5, 244.0, 10.0, "Theta"))
    @delay 1
    @bypass playsound minecraft:entity.enderman.teleport master {{player}} ~ ~ ~ 1 1
    @bypass execute at {{player}} run particle minecraft:witch ~ ~ ~ 0 1 0 1 100 normal
  @elseif harhaProgress == 5
    @var player.teleport(Position(-9067.5, 95.0, 9527.5, 0.0, 10.0, "Theta"))
    @delay 1
    @bypass playsound minecraft:entity.enderman.teleport master {{player}} ~ ~ ~ 1 1
    @bypass execute at {{player}} run particle minecraft:witch ~ ~ ~ 0 1 0 1 100 normal
  @elseif harhaProgress == 6
    @var player.teleport(Position(-4600.5, 91.0, 5199.5, 180.0, 10.0, "Theta_the_end"))
    @delay 1
    @bypass playsound minecraft:entity.enderman.teleport master {{player}} ~ ~ ~ 1 1
    @bypass execute at {{player}} run particle minecraft:witch ~ ~ ~ 0 1 0 1 100 normal
  @fi

  @var setLevel(harhaProgress * 10, player)
  @var ensureBlockSelection(harhaProgress * 10, player)
  @var resetBlocks(player, 64)
  @var stage[player] = 0
  @var hatFunction(player)

  @if timer.isNullified() == false
      @var timer.nullify()
      @player &cTimer Invalidated!
  @fi

  @if harhaProgress >= 4
            @var bootsObtained[player] = true
            @bypass /item replace entity {{player}} armor.feet with leather_boots[dyed_color=4873853,tooltip_display={hidden_components:["dyed_color","trim","enchantments","unbreakable","attribute_modifiers"]},trim={material:"minecraft:lapis",pattern:"minecraft:wild"},custom_name=[{"bold":true,"color":"#37C3ED","italic":false,"text":"L"},{"bold":true,"color":"#36BBED","italic":false,"text":"e"},{"bold":true,"color":"#35B4ED","italic":false,"text":"a"},{"bold":true,"color":"#35ACED","italic":false,"text":"t"},{"bold":true,"color":"#34A4ED","italic":false,"text":"h"},{"bold":true,"color":"#339CED","italic":false,"text":"e"},{"bold":true,"color":"#3295ED","italic":false,"text":"r "},{"bold":true,"color":"#318DED","italic":false,"text":"B"},{"bold":true,"color":"#3085ED","italic":false,"text":"o"},{"bold":true,"color":"#307DED","italic":false,"text":"o"},{"bold":true,"color":"#2F76ED","italic":false,"text":"t"},{"bold":true,"color":"#2D66ED","italic":false,"text":"s"}],enchantment_glint_override=false,enchantments={"minecraft:binding_curse":1,"minecraft:vanishing_curse":1},lore=[[{"bold":false,"color":"#CCDFED","italic":false,"text":"Now I can walk on"},{"bold":true,"color":"#CCDFED","text":" Powdered Snow!"}],{"color":"#CCDFED","italic":false,"text":"Here is a picture of a cat:"}," ",[{"color":"#FFFDFC","italic":false,"text":"█"},{"color":"#FFFFFF","text":"██████████████████████████████"},{"color":"#F8FDFF","text":"█"},{"color":"#8C6C57","text":"█"},{"color":"#FFFFFF","text":"█"}],[{"color":"#796B62","italic":false,"text":"█"},{"color":"#9F928C","text":"█"},{"color":"#FFFFFF","text":"███████████████████████████"},{"color":"#FDFEFE","text":"█"},{"color":"#88736B","text":"█"},{"color":"#69594A","text":"█"},{"color":"#FAFDFF","text":"█"},{"color":"#FFFFFF","text":"█"}],[{"color":"#FFFEFB","italic":false,"text":"█"},{"color":"#705948","text":"█"},{"color":"#705540","text":"█"},{"color":"#F8F8FB","text":"█"},{"color":"#FFFFFB","text":"█"},{"color":"#FFFFFF","text":"████████