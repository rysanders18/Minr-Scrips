        @elseif i <= 34
            @var bootsObtained[player] = false
            @bypass clear {{player}} minecraft:leather_boots
        @fi

        @if i >= 40 && i <= 49
            @var iceSwapped[player] = true
            @var slimeSwapped[player] = false
        @elseif i >= 50 && i <= 59
            @var iceSwapped[player] = false
            @var slimeSwapped[player] = true
        @fi
        
        @var ensureBlockSelection(i, player)
        @var stage[player] = 0
        @var player.teleport(allPositions[i])
        @var setLevel(i, player)
        @var resetBlocks(player, 64)
        

        # TODO add xp and set level correctly
        

        # invalidates timer
        @define timer::Timer timer = timer::getMapTimer(player, "harha")
        @if timer.isNullified() == false
            @var timer.nullify()
            @player &cTimer Invalidated!
        @fi
        @bypass playsound minecraft:entity.enderman.teleport master @s 


        @var hasTeleported[player] = true
        @var validFormat = true
    @fi
@done

@if validFormat == false
    @player &cInvalid Format!
    @bypass playsound minecraft:block.note_block.didgeridoo master @s ~ ~ ~ 1 1
@fi
@else
    @player &cYou cannot use this feature while in this challenge!
    @bypass playsound minecraft:block.note_block.didgeridoo master @s ~ ~ ~ 1 1
@fi
@fi
@else
    @player &cYou cannot use this feature while in this challenge!
    @bypass playsound minecraft:block.note_block.didgeridoo master @s ~ ~ ~ 1 1
@fi