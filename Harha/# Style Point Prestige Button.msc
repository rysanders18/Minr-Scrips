        @bypass /execute at {{player}} run summon firework_rocket ~ ~ ~ {LifeTime:5,FireworksItem:{id:"minecraft:firework_rocket",count:1,components:{"minecraft:fireworks":{explosions:[{shape:"small_ball",has_twinkle:true,colors:[I;16711927,16711901,16711850],fade_colors:[I;15662848,16770560]}]}}}}
    @else
        @player &cStyle Point Reset cancelled.
        @bypass playsound minecraft:block.note_block.didgeridoo master @s ~ ~ ~ 0.5 0.5
    @fi
@else
    @player &#d4d4d4--------------------------------------
    @player &#ffaa00&l&nS&#ffb005&l&nt&#ffb609&l&ny&#ffbc0e&l&nl&#ffc213&l&ne &#ffc718&l&nP&#ffcd1c&l&no&#ffd221&l&ni&#ffd726&l&nn&#ffdc2a&l&nt &#ffe02f&l&nP&#ffe534&l&nr&#ffe939&l&ne&#ffed3d&l&ns&#fff142&l&nt&#fff547&l&ni&#fff84c&l&ng&#fffc50&l&ne&#ffff55&l:
    @player
    @player &#d4d4d4● Gain &#ffc71d&l+1 Style Point Prestige&#d4d4d4 and &nreset&#d4d4d4 your points!
    @player
    @player &#d4d4d4● Unlocked by reaching &#ffc71d&l4,000 Style Points. &#d4d4d4({{formatNumber(String(swagPoints[player]))}}/4,000)
    @player
    @player &cYou do not meet the requirements! &#d4d4d4(You will keep all cosmetics)
    @player &#d4d4d4--------------------------------------
