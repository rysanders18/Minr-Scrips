    @player &#D3D6E0Section 5: [&a{{sectionFallsNormal[user][40]}}, {{sectionFallsNormal[user][41]}}, {{sectionFallsNormal[user][42]}}, {{sectionFallsNormal[user][43]}}, {{sectionFallsNormal[user][44]}},   {{sectionFallsNormal[user][45]}}, {{sectionFallsNormal[user][46]}}, {{sectionFallsNormal[user][47]}}, {{sectionFallsNormal[user][48]}}, {{sectionFallsNormal[user][49]}}&#D3D6E0]
    @player &#D3D6E0Section 6: [&a{{sectionFallsNormal[user][50]}}, {{sectionFallsNormal[user][51]}}, {{sectionFallsNormal[user][52]}}, {{sectionFallsNormal[user][53]}}, {{sectionFallsNormal[user][54]}},   {{sectionFallsNormal[user][55]}}, {{sectionFallsNormal[user][56]}}, {{sectionFallsNormal[user][57]}}, {{sectionFallsNormal[user][58]}}, {{sectionFallsNormal[user][59]}}&#D3D6E0]
    @player &#D3D6E0Section 7: [&a{{sectionFallsNormal[user][60]}}, {{sectionFallsNormal[user][61]}}, {{sectionFallsNormal[user][62]}}, {{sectionFallsNormal[user][63]}}, {{sectionFallsNormal[user][64]}},   {{sectionFallsNormal[user][65]}}, {{sectionFallsNormal[user][66]}}, {{sectionFallsNormal[user][67]}}, {{sectionFallsNormal[user][68]}}, {{sectionFallsNormal[user][69]}}&#D3D6E0]
    @player
    @player &#D3D6E0Section X: [X-01, X-02, X-03, …, X-10]
    @player
    @chatscript 180s group11 pcStats(4, user, player)
    @player &#D3D6E0<<< &nClick&#D3D6E0 to go back
    
@elseif pcSelect == 7
    @var noteInt = math::random(0.0D, 20.0D)
    @bypass /playsound minecraft:block.note_block.bit master @s ~ ~ ~ 1 {{musicNotes[Int(noteInt)]}}
    @bypass /playsound minecraft:block.note_block.bit master @s ~ ~ ~ 1 {{musicNotes[Int(noteInt + 4)]}}
    @player
    @player &#8596A6&l-&#8694A5&l-&#8792A4&l-&#8890A4&l-&#898EA3&l-&#8A8CA2&l-&#8B8AA1&l[&#8C88A0&lS&#8D869F&lt&#8E849F&la&#8F829E&lt&#90809D&li&#917E9C&ls&#90809D&lt&#8F829E&li&#8E849F&lc&#8D869F&ls&#8C88A0&l]&#8B8AA1&l-&#8A8CA2&l-&#898EA3&l-&#8890A4&l-&#8792A4&l-&#8596A6&l-
    @player &#D3D6E0Displaying stats for &#917E9C&l{{user}}
    @if certifiedTrackpad[user] == true
        @player &#ffc71d✯ Certified Trackpad Victor!
    @fi
    @player
    @if progress100[user] >= 100.0
        @player &#D3D6E0Progress to 100% completion: &a&l100.0%
    @else
        @player &#D3D6E0Progress to 100% completion: &#8596A6&l{{Int(progress100[user] * 10) / 10}}.{{Int(progress100[user] * 10) % 10}}%
    @fi
    @player
    # (20%) Even Harder Hat Completion: Not Completed
    # (20%) Cosmetics Unlocked: xx/12
    # (20%) Secrets Found: xx/24
    # (20%) Secrets Completed: xx/24
    # (20%) Style Points Unlocked: xxx/4000
    
    @if numberCompletionsMaster[user] >= 1
        @player &#D3D6E010/10% Even Harder Hat: &a&lCompleted ✔
    @else
        @player &#D3D6E00.0/10% Even Harder Hat: &cNot Completed ✕
    @fi
    
    @if numberCompletionsSoulLink[user] >= 1
        @player &#D3D6E010/10% Harder Hats: &a&lCompleted ✔
    @else
        @player &#D3D6E00.0/10% Harder Hats: &cNot Completed ✕
    @fi
    
    @if cosmeticsUnlocked[user].sum() == 12
        @player &#D3D6E020/20% Cosmetics Unlocked: &a&l12/12 ✔
    @else
        @player &#D3D6E0{{Int(((Float(cosmeticsUnlocked[user].sum()) / Float(12)) * 20) * 10) / 10}}.{{Int(((Float(cosmeticsUnlocked[user].sum()) / Float(12)) * 20) * 10) % 10}}/20% Cosmetics Unlocked: &{{colorList[Int(cosmeticsUnlocked[user].sum())]}}{{cosmeticsUnlocked[user].sum()}}/12  ✕
    @fi
    
    @if secretsFound == 25
        @player &#D3D6E020/20% Secrets Found: &a&l25/25 ✔
    @else
        @player &#D3D6E0{{Int(((Float(secretsFound) / Float(25)) * 20) * 10) / 10}}.{{Int(((Float(secretsFound) / Float(25)) * 20) * 10) % 10}}/20% Secrets Found: &{{colorList[math::floor(Double(Float(secretsFound * 11) / 25))]}}{{secretsFound}}/25  ✕
    @fi
    
    @if secretsCompleted == 25
        @player &#D3D6E020/20% Secrets Completed: &a&l25/25 ✔
    @else
        @player &#D3D6E0{{Int(((Float(secretsCompleted) / Float(25)) * 20) * 10) / 10}}.{{Int(((Float(secretsCompleted) / Float(25)) * 20) * 10) % 10}}/20% Secrets Completed: &{{colorList[math::floor(Double(Float(secretsCompleted * 11) / 25))]}}{{secretsCompleted}}/25  ✕
    @fi
    
    @if swagPoints[user] == 4000
        @player &#D3D6E020/20% Style Points: &a&l4,000/4,000 ✔
    @elseif stylePointPrestiges[user] == 1
        @player &#D3D6E020/20% Style Points: &a&l{{stylePointPrestiges[user]}} Prestige ✔
    @elseif stylePointPrestiges[user] > 1
        @player &#D3D6E020/20% Style Points: &a&l{{stylePointPrestiges[user]}} Prestiges ✔
    @else
        @player &#D3D6E0{{Int(((Float(swagPoints[user]) / Float(4000)) * 20) * 10) / 10}}.{{Int(((Float(swagPoints[user]) / Float(4000)) * 20) * 10) % 10}}/20% Style Points: &{{colorList[Int((Float(swagPoints[user]) / Float(4000)) * 12)]}}{{formatNumber(String(swagPoints[user]))}}/4,000  ✕
    @fi
    @player
    @chatscript 180s group110 pcStats(0, user, player)
    @player &#D3D6E0<<< &nClick&#D3D6E0 to go back
    
    
@fi
