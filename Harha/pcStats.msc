@using Harha
@fast
# pcStats(Int pcSelect, Player user, Player player) https://paste.minr.org/erukuhuhol
# .      .
@define Int secretsFound
@define Int secretsCompleted
@define Double noteInt
@var secretsFound = secretsFoundList[user].sum()
@var secretsCompleted = secretsCompletedList[user].sum()

@if secretsCompleted < pbSecretsCompleted[user]
    @var secretsCompleted = pbSecretsCompleted[user]
@fi

@if secretsFound < pbSecretsFound[user]
    @var secretsFound = pbSecretsFound[user]
@fi

@bypass /particle minecraft:scrape -9224 96.5 9713 0 0 0 10 10

@define Int bestHardestHatRun = 0
@for Int i in list::range(0, 69)
    @if sectionFallsUMM[user][i] > 0
        @var bestHardestHatRun = i
    @fi
@done

@if numberCompletions[user] >= 1
    @var cosmeticsUnlocked[user][0] = 1
@else
    @var cosmeticsUnlocked[user][0] = 0
@fi
@if numberCompletions[user] >= 3
    @var cosmeticsUnlocked[user][1] = 1
@else
    @var cosmeticsUnlocked[user][1] = 0
@fi
@if numberCompletions[user] >= 10
    @var cosmeticsUnlocked[user][2] = 1
@else
    @var cosmeticsUnlocked[user][2] = 0
@fi
@if swagPoints[user] >= 500 || stylePointPrestiges[user] >= 1
    @var cosmeticsUnlocked[user][3] = 1
@else
    @var cosmeticsUnlocked[user][3] = 0
@fi
@if swagPoints[user] >= 1000 || stylePointPrestiges[user] >= 1
    @var cosmeticsUnlocked[user][4] = 1
@else
    @var cosmeticsUnlocked[user][4] = 0
@fi
@if swagPoints[user] >= 2000 || stylePointPrestiges[user] >= 1
    @var cosmeticsUnlocked[user][5] = 1
@else
    @var cosmeticsUnlocked[user][5] = 0
@fi
@if secretsCompleted >= 1
    @var cosmeticsUnlocked[user][6] = 1
@else
    @var cosmeticsUnlocked[user][6] = 0
@fi
@if secretsCompleted >= 3
    @var cosmeticsUnlocked[user][7] = 1
@else
    @var cosmeticsUnlocked[user][7] = 0
@fi
@if secretsCompleted >= 10
    @var cosmeticsUnlocked[user][8] = 1
@else
    @var cosmeticsUnlocked[user][8] = 0
@fi
@if numberCompletionsSoulLink[user] >= 1
    @var cosmeticsUnlocked[user][9] = 1
@else
    @var cosmeticsUnlocked[user][9] = 0
@fi
@if numberCompletionsMaster[user] >= 1
    @var cosmeticsUnlocked[user][10] = 1
@else
    @var cosmeticsUnlocked[user][10] = 0
@fi
@if pbFalls[user] <= 100
    @var cosmeticsUnlocked[user][11] = 1
@else
    @var cosmeticsUnlocked[user][11] = 0
@fi
@var calculate100(user)

# 0 = Main Screen
@if pcSelect == 0
    @var noteInt = math::random(0.0D, 20.0D)
    @bypass /playsound minecraft:block.note_block.bit master @s ~ ~ ~ 1 {{musicNotes[Int(noteInt)]}}
    @bypass /playsound minecraft:block.note_block.bit master @s ~ ~ ~ 1 {{musicNotes[Int(noteInt + 4)]}}
    @player
    @player &#8596A6&l-&#8694A5&l-&#8792A4&l-&#8890A4&l-&#898EA3&l-&#8A8CA2&l-&#8B8AA1&l[&#8C88A0&lS&#8D869F&lt&#8E849F&la&#8F829E&lt&#90809D&li&#917E9C&ls&#90809D&lt&#8F829E&li&#8E849F&lc&#8D869F&ls&#8C88A0&l]&#8B8AA1&l-&#8A8CA2&l-&#898EA3&l-&#8890A4&l-&#8792A4&l-&#8596A6&l-
    @player &#D3D6E0Displaying stats for &#917E9C&l{{user}}
    @if certifiedTrackpad[user] == true
        @player &#ffc71d✯ Certified Trackpad Victor!
    @fi
    @player
    
    
    
    @chatscript 180s group12 pcStats(7, user, player)
    @if progress100[user] >= 100.0
        @player &#917E9C*&#D3D6E0 Progress to 100% completion: &#ffd700&l100.0%
    @else
        @player &#917E9C*&#D3D6E0 Progress to 100% completion: &#8596A6&l{{Int(progress100[user] * 10) / 10}}.{{Int(progress100[user] * 10) % 10}}%
    @fi
    @chatscript 180s group1 pcStats(1, user, player)
    @if numberCompletions[user] >= 10
        @player &#917E9C*&#D3D6E0 Times completed map: &#ffd700&l{{formatNumber(String(numberCompletions[user]))}}
    @else
        @player &#917E9C*&#D3D6E0 Times completed map: &#8596A6&l{{formatNumber(String(numberCompletions[user]))}}
    @fi
    @chatscript 180s group2 pcStats(2, user, player)
    @if cosmeticsUnlocked[user].sum() == 12
        @player &#917E9C*&#D3D6E0 Cosmetics unlocked: &#ffd700&l12/12
    @else
        @player &#917E9C*&#D3D6E0 Cosmetics unlocked: &#8596A6&l{{cosmeticsUnlocked[user].sum()}}/12
    @fi
    @chatscript 180s group3 pcStats(3, user, player)
    @if stylePointPrestiges[user] >= 1
        @player &#917E9C*&#D3D6E0 Style Prestiges: &#ffd700&l{{stylePointPrestiges[user]}}
    @else
        @player &#917E9C*&#D3D6E0 Style Points: &#8596A6&l{{formatNumber(String(swagPoints[user]))}}/4,000
    @fi
    @if secretsCompleted >= 25
        @player &#D3D6E0 &#D3D6E0 Secrets completed: &#ffd700&l25/25
    @else
        @player &#D3D6E0 &#D3D6E0 Secrets completed: &#8596A6&l{{secretsCompleted}}/25
    @fi
    @player
    @chatscript 180s group4 pcStats(4, user, player)
    @player &#917E9C*&#D3D6E0 Total Falls: &#8596A6&l{{formatNumber(String(totalFalls[user]))}}
    
    
    @if pbFalls[user] != 1000000000
        @chatscript 180s group1238 pcStats(8, user, player)
        @player &#D3D6E0 &#D3D6E0 PB Falls: &#8596A6&l{{formatNumber(String(pbFalls[user]))}}
    @fi
    
    @chatscript 180s group1012332 pcStats(9, user, player)
    @player &#917E9C*&#D3D6E0 Total Blocks placed: &#8596A6&l{{formatNumber(String(totalBlocks[user]))}}
    @if pbBlocks[user] != 1000000000
        @player &#D3D6E0 &#D3D6E0 PB Blocks placed: &#8596A6&l{{formatNumber(String(pbBlocks[user]))}}
    @fi
    
    @player
    @chatscript 180s group5 pcStats(5, user, player)
    @player &#917E9C*&#D3D6E0 Fastest Times:
    @if numberCompletionsUMM[user] >= 1
        @player &#D3D6E0 &#D3D6E0 Furthest Hardest Hat Run: &#ffd700&lCompleted!
    @else
        @player &#D3D6E0 &#D3D6E0 Furthest Hardest Hat Run: {{allLevels[bestHardestHatRun]}}
    @fi
    @player
    @player &d&l!!! &#D3D6E0&nClick&#D3D6E0 on * items to see more
    
    # @player &#8596A6&l-&#8694A5&l-&#8792A4&l-&#8890A4&l-&#898EA3&l-&#8A8CA2&l-&#8B8AA1&l[&#8C88A0&lS&#8D869F&lt&#8E849F&la&#8F829E&lt&#90809D&li&#917E9C&ls&#90809D&lt&#8F829E&li&#8E849F&lc&#8D869F&ls&#8C88A0&l]&#8B8AA1&l-&#8A8CA2&l-&#898EA3&l-&#8890A4&l-&#8792A4&l-&#8596A6&l-
    
    # Times Completed Map
