    @else
        @player &#96B345&lA&#99AD50&lz&#9CA75B&la&#9FA165&ll&#A29A70&le&#A5947B&la &#A88E86&lL&#AB8890&le&#AE829B&la&#B17CA6&lv&#B475B1&le&#B76FBB&ls&#BD63D1&l: &a{{numberCompletions[user]}}/3 Map completions. ✔
