@elseif pcSelect == 3
    
    @var noteInt = math::random(0.0D, 20.0D)
    @bypass /playsound minecraft:block.note_block.bit master @s ~ ~ ~ 1 {{musicNotes[Int(noteInt)]}}
    @bypass /playsound minecraft:block.note_block.bit master @s ~ ~ ~ 1 {{musicNotes[Int(noteInt + 4)]}}
    @player
    @player &#8596A6&l-&#8694A5&l-&#8792A4&l-&#8890A4&l-&#898EA3&l-&#8A8CA2&l-&#8B8AA1&l[&#8C88A0&lS&#8D869F&lt&#8E849F&la&#8F829E&lt&#90809D&li&#917E9C&ls&#90809D&lt&#8F829E&li&#8E849F&lc&#8D869F&ls&#8C88A0&l]&#8B8AA1&l-&#8A8CA2&l-&#898EA3&l-&#8890A4&l-&#8792A4&l-&#8596A6&l-
    @player &#D3D6E0Displaying stats for &#917E9C&l{{user}}
    @if certifiedTrackpad[user] == true
        @player &#ffc71d✯ Certified Trackpad Victor!
    @fi
    @player
    
    @define Int[] tempEarned = Int[]
    @define Int[] tempTotal = Int[]
    
    @for Int level in list::range(0,70)
        
        @define Int[] thresholds = Int[]
        @define Int[] rewards = Int[]
        @define Int startIndex = 0
        @define Int pointsToEarn = 0
        @define Int totalPoints = 0
        
        @if level == 0
            @var thresholds = l101Thresholds
            @var rewards = l101Rewards
            @var startIndex = l101StartIndex
        @elseif level == 1
            @var thresholds = l102Thresholds
            @var rewards = l102Rewards
            @var startIndex = l102StartIndex
        @elseif level == 2
            @var thresholds = l103Thresholds
            @var rewards = l103Rewards
            @var startIndex = l103StartIndex
        @elseif level == 3
            @var thresholds = l104Thresholds
            @var rewards = l104Rewards
            @var startIndex = l104StartIndex
        @elseif level == 4
            @var thresholds = l105Thresholds
            @var rewards = l105Rewards
            @var startIndex = l105StartIndex
        @elseif level == 5
            @var thresholds = l106Thresholds
            @var rewards = l106Rewards
            @var startIndex = l106StartIndex
        @elseif level == 6
