    @fi
    
    @if swagPoints[user] <= 999 && stylePointPrestiges[user] < 1
        @player &#304CD6&lC&#613CD0&lo&#932DCA&lr&#C41DC4&la&#CB34B9&ll &#D24AAE&lB&#D961A3&ll&#DC567F&lo&#E04A5A&lc&#E33F36&lk&#E0733B&ls&#DBDB46&l: &c{{formatNumber(String(swagPoints[user]))}}/1,000 Style Points. ✕
    @elseif stylePointPrestiges[user] >= 1
