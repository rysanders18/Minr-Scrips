    @else
        @player &#7C5AC9&lA&#8A5CCF&lm&#985ED5&le&#A661DB&lt&#B463E1&lh&#C265E7&ly&#D067ED&ls&#DE6AF3&lt&#FA6EFF&l: &a{{numberCompletions[user]}}/1 Map completions. ✔
    @fi
    
    @if numberCompletions[user] <= 2
