# DUCK
@using Harha
@fast

@define String[] meowList = String["meow", "meoww", "mew", "maw", "meeeooow", "meoooow", "meeeeow", "purr", "^-^", "meows", "miaow", "miau", "meaow", "mewl", "mrrrow", "mrow", "mreow", "mrrrr", "meaw", "miaou", "meo", "miao", "meww", "meowww", "mewmew", "mrrp", "mrrrroww", "meowy", "mrowr", "mree", "mrr", "nya", "nyan", "nyaa", "nyah", "mlem", "meow?", "meow!", "MEOW", "mew?", "mew!", "MEW", "mrow?", "mrow!", "MROW", "nyan?", "nyan!", "NYAN", "meow meow", "mew mew", "mrow mrow", "nya nya", "purrr", "prrr", "purrrr", "purrrrrr", "hisss", "hiss", "purrs", "hisses", "mroww", "mreeow", "mrrreow", "meeow", "meeoo", "meoo", "mweo", "mweow", "myao", "myaow", "myow", "myaw", "m'ow", "me.ow", "meeaow", "meeyow", "meeyaw", "mraow", "mraoww", "mrrrrooow", "meown", "meowsy", "miaoww", "miawww", "miew", "maow", "maoww", "meeaaw", "myaou", "myaown", "mow", "m'yow", "m'yaw", "ngya", "ngyan", "meowwwwww", "mmmmeow", "mmmrrrr", "mmmmew", "meowoo", "meowu", "meeau", "meeaou", "meeyo", "meeoww", "miiiaaaooow", "myaaa", "myaa", "myan", "maau", "maauw", "myauw", "mrawr", "mrour", "miu", "meeu", "meouw", "meew", "meoow", "meau", "mrrew", "mraawr", "maauh", "meough", "냐옹", "ニャー", "м'яу", "мяу", "mjau", "meo-meo", "miaŭ", "ngiyaw", "miáú", "miar", "miao-miao", "mau", "miauw", "mauw", "mjav", "miyav", "nau", "mews", "caterwauls", "yowls", ":3", "=＾• ⋏ •＾=", "/ᐠ｡ꞈ｡ᐟ\ ", "ᓚᘏᗢ", "(=^･ω･^=)", "(=^･ｪ･^=)", "( =ω=)", "(=｀ω´=)", "(ΦωΦ)", "(^=˃ᆺ˂=^)", "(=TㅅT=)", "＼(=^‥^=)／", "（=´∇｀=）", "(=^-ω-^=)", "(^・x・^)", "ฅ(⌯͒• ɪ •⌯͒)ฅ", ">^..^<", "(=①ω①=)", "(=^･^=)", "ଲ( ⓛ ‸ ⓛ )ଲ", "(=⌒‿⌒=)", "(=ಠᆽಠ=)", "(=^･o･^=)", "(=^･ω･^=)ﾉ", "(ﾐⓛᆽⓛﾐ)", "(^._.^)ﾉ", "~ ( =’ェ’= ) ~", "(=;ェ;=)", "((≡^⚲͜^≡))", "/(^•ω•^)\ ", "(=•ω•=)", "ฅ/ᐠ｡ᆽ｡ᐟ \ฅ", "( ⓛ ω ⓛ )", "( ^..^ )", "(=x.x=)"]
@define String[] wisdomList = String["True enlightenment is realizing the tastiest bread is always the piece someone else is about to eat.", "Never trust a goose; they are just tall ducks with anger management issues and no sense of irony.", "The secret to eternal happiness is a perfectly still pond and the absence of dogs.", "A confident quack can solve approximately 47% of life's problems.", "To understand the universe, you must first understand why soggy bread is superior to dry bread.", "The most powerful spell is looking pathetic in the rain until a giant gives you a sandwich.", "A wizard's staff is impressive, but have you ever tried whacking someone with a wet cattail?", "Do not waste your energy on revenge; simply poop on your enemy's newly cleaned chariot.", "The two most powerful forces in the world are love and a stale baguette.", "A ripple in the water may seem small, but it can successfully annoy a very large fish.", "Before you judge a man, walk a mile in his shoes; then you're a mile away, and you have his shoes.", "The best magic is convincing everyone you're wise when you're mostly just thinking about worms.", "If you cannot be clever, be loud; the effect is often the same.", "Gravity is a suggestion, especially when you have wings and a bit of a tailwind.", "A well-timed nap in a sunbeam is the cornerstone of any good magical practice.", "Never enter a staring contest with a frog; they have no eyelids and no honor.", "True courage is eating the snail that everyone else thought was a little too slimy.", "One must preen their feathers not for vanity, but to be aerodynamically prepared for a sudden escape.", "The person who says it cannot be done should not interrupt the duck who is doing it.", "A premonition is just your stomach rumbling before you've seen the bread.", "Patience is a virtue, unless there's only one piece of cracker left.", "The difference between a hero and a villain is who has the better public relations goose.", "If you listen closely, the wind doesn't whisper secrets; it mostly just messes up your feathers.", "To achieve inner peace, one must learn to ignore the incessant chirping of smaller, less important birds.", "A full belly leads to a sleepy mind, which is the best kind of mind.", "The greatest mystery of the cosmos is where the humans go after they leave the park.", "Always carry a spare lily pad, for you never know when you'll need a dramatic place to sit.", "They say the early bird gets the worm, but the second duck gets the bread thrown by the early bird's human.", "A potion is just a beverage that you've stared at with magical intent.", "Never underestimate the tactical advantage of being slightly too low to the ground to be noticed.", "The only thing more unpredictable than magic is a toddler with a bag of oats.", "A proper hat can make even the most absurd statement sound like ancient wisdom.", "A journey of a thousand miles begins with a single, awkward waddle.", "If at first you don't succeed, quack, quack again.", "The path to power is paved with the discarded crusts of the unambitious.", "Why build a bridge when you can just get your feet a little wet?", "An opinion is like a tail feather; everyone has one, but it's rude to wave it in someone's face.", "True wealth is not measured in gold, but in the number of ponds you can call your own.", "Never ask a fish for directions; their worldview is fundamentally skewed.", "The most complex magical rune is still less confusing than a human's tax forms.", "A dramatic pause is only effective if you don't fall asleep during it.", "To be truly wise is to know that you know nothing, except for the location of the best mud.", "The best way to defeat an enemy is to invite them for a swim and then forget to mention the leeches.", "A day without being chased by a small child is a day well spent.", "One should always float with the current, unless the current is heading towards a waterfall.", "The sound of one hand clapping is not nearly as interesting as the sound of one beak chomping.", "A good plan is to have no plan and see what happens; it's more fun that way.", "You cannot change the direction of the wind, but you can adjust your tail feathers.", "The meaning of life is to float, to eat, and to occasionally bother a swan.", "It is better to have quacked and been ignored than to have never quacked at all.", "A sceptre is just a fancy stick for a wizard who is afraid to get his hands dirty.", "The wise duck does not store all his bread in one pond.", "If you love something, set it free; unless it's a particularly juicy beetle.", "The future is unwritten, but it probably involves rain.", "Never trust a spell with more than three ingredients, especially if one of them is 'a hint of cosmic dread'.", "The art of diplomacy is letting the other guy have your way.", "A comfortable silence is more valuable than a clever conversation.", "Don't count your ducklings before they've hatched, as they are very difficult to count.", "He who hesitates has probably spotted a hidden net.", "A problem is simply an opportunity to take a nap and hope it goes away.", "The best hiding place is right behind the thing everyone is looking at.", "To be a sorcerer is to be a master of convincing yourself that you know what you're doing.", "A clean feather is a sign of a productive day.", "Never try to reason with a squirrel; their logic is based on hoarding and frantic energy.", "The secret ingredient to every great adventure is a complete lack of foresight.", "A pond without algae is like a life without challenges: clean, but boring.", "The grass is always greener on the other side, probably because it has better drainage.", "If you're not a little bit scared, you're not waddling fast enough.", "Always look a gift horse in the mouth, and then check for bread.", "A moment of patience in a moment of anger saves you a hundred moments of regret, or so I'm told.", "A prophecy is just a guess made with a very deep voice.", "The tide of history is vast, but it can be briefly redirected with a well-constructed dam of twigs.", "True focus is the ability to preen a single feather while the world descends into chaos.", "A nest is not a home; it's just a suggestion for where to sleep.", "The mighty oak was once a nut that stood its ground, which is a terrible strategy for a duck.", "Do not fear the darkness, for it is where the most delicious slugs hide.", "An echo is the universe's way of agreeing with you, so always quack wisely.", "A rival is just a friend who is trying to eat your food.", "It is a fool who argues with a raincloud.", "The two greatest inventions are the wheel and the concept of a free lunch.", "Time is a great healer, but a good mud bath is faster.", "The first rule of magic is to never tell anyone all your rules.", "A memory is just a story you tell yourself to explain why your feathers are wet.", "The easiest way to find something lost is to buy a replacement.", "If you want to seem wise, nod slowly and occasionally say 'Indeed'.", "A crown is just a hat that lets in the rain.", "Never gamble with a raccoon; they have too many hands and no morals.", "The difference between magic and science is just a matter of presentation.", "A map is a fine thing, but it will not protect you from a grumpy badger.", "The smallest act of kindness is to not eat the last watercress.", "To fly is divine, but to float is to truly live.", "The universe is full of magical things, patiently waiting for our wits to grow sharper, or for us to just trip over them.", "Fame is fleeting, but a good pond is forever.", "The only stupid question is the one you ask a turtle.", "In the end, all we have are our stories and the faint taste of algae.", "Wisdom is knowing the right path to take; integrity is taking it, and magic is making a shortcut appear."]
