@if canTalkToDuck[player] == true
@if duckCount[player] == 0
    @player &e&lDuck&r: meow
    @bypass /playsound minecraft:entity.cat.ambient master @s -9171.50 96.00 9676.50 1 {{math::random(0.5D, 2.0D)}}
    @var duckCount[player] += 1
    @var canTalkToDuck[player] = false
    @delay 30
    @player &7It seems like this duck has a lot to say!
    @player &7Maybe I should talk to it more...
    @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 1
    @delay 10
    @var canTalkToDuck[player] = true
@elseif duckCount[player] > 0
@if duckCount[player] == 172
    @bypass /rocket {{player}} -10 0.5 -0.2
    @player &e&lDuck&r: &lGET AWAY FROM ME!!! &r&7({{duckCount[player]}}/1000)
    @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 {{Float(duckCount[player]) / Float(1000) * 1.5 + 0.5}}
    @bypass playsound minecraft:entity.generic.explode master @s ~ ~ ~ 2 1
    @var duckCount[player] += 1
    @var canTalkToDuck[player] = false
    @bypass /execute as @s at @s anchored eyes run particle minecraft:flash ^ ^ ^1 0 0 0 0 2 force @s
    @bypass /particle minecraft:explosion -9172 97 9676 1 1 1 0 10 normal @s
    @delay 2s
    @player &7What the heck?? Why did he do that :(
    @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 1
    @var canTalkToDuck[player] = true
@elseif duckCount[player] == 173
    @var canTalkToDuck[player] = false
    @player &7I'm sorry I clicked on you so much!
    @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 1
    @delay 15
    @player &7Will you forgive me &e&lDuck&7?
    @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 1
    @delay 25
    @player &e&lDuck&r: hmmm...
    @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 0.5
    @delay 40
    @player &e&lDuck&r: hmmmmm...
    @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 0.75
    @delay 55
    @player &e&lDuck&r: hmmmmmmmm...
    @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 1.25
    @delay 4s
    @player &e&lDuck&r: &dmeow
    @bypass /playsound minecraft:entity.cat.ambient master @s -9171.50 96.00 9676.50 1 {{math::random(0.5D, 2.0D)}}
    @delay 20
    @player &7bruh okay...
    @delay 10
    @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 0.75
    @var duckCount[player] += 1
    @var canTalkToDuck[player] = true

# Earthquake
@elseif duckCount[player] == 326
    @var canTalkToDuck[player] = false
    @bypass /playsound minecraft:block.gravel.break master @s ~ ~ ~ 1 {{math::random(0.5D, 2.0D)}}
    @bypass /playsound minecraft:block.gravel.break master @s ~ ~ ~ 1 {{math::random(0.5D, 2.0D)}}
    @bypass /execute as @s at @s anchored eyes run minecraft:tp ~{{math::random(0.0D, 0.1D) - 0.05}} ~ ~{{math::random(0.0D, 0.1D) - 0.05}}
    @bypass execute in minecraft:theta run particle block{block_state:"minecraft:dirt"} -9173 96 9675 1 0.25 1 .01 4 normal @s
    @bypass execute in minecraft:theta run particle block{block_state:"minecraft:gravel"} -9173 96 9675 1 0.25 1 .01 4 normal @s
    @delay 1s
    @player &7What was that?
    @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 1
    @delay 30
    @for Int i in list::range(0, 120)
        @bypass /playsound minecraft:block.gravel.break master @s ~ ~ ~ 1 {{math::random(0.5D, 2.0D)}}
        @bypass /playsound minecraft:block.gravel.break master @s ~ ~ ~ 1 {{math::random(0.5D, 2.0D)}}
        @bypass /execute as @s at @s anchored eyes run minecraft:tp ~{{math::random(0.0D, 0.1D) - 0.05}} ~ ~{{math::random(0.0D, 0.1D) - 0.05}}
        @bypass execute in minecraft:theta run particle block{block_state:"minecraft:dirt"} -9173 96 9675 1 0.25 1 .01 4 normal @s
        @delay 1
        @bypass execute in minecraft:theta run particle block{block_state:"minecraft:gravel"} -9173 96 9675 1 0.25 1 .01 4 normal @s
        @if i < 25
            @delay 2
            @if i == 15
                @player &7Is this an earthquake?!?!
                @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 1
            @fi
        @elseif i >= 25 && i < 60
            @delay 1
        @elseif i >=60 && i < 115
            @delay 0
            @if i == 90
                @player &7WHAT IS HAPPENING?!?!?!
                @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 1
            @fi
        @else
            @delay 4
        @fi
    
    @done
    @delay 1s
    @player &7Uhhh that was scary...
    @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 0.7
    @delay 15
    @player &7This duck must be very powerful.
    @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 0.8
    @delay 45
    @player &7Uh oh.
    @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 0.9
    @delay 10
    @var duckCount[player] += 1
    @var canTalkToDuck[player] = true
@elseif duckCount[player] == 512
    @var canTalkToDuck[player] = false
    @player &e&lDuck&r: &#FF54EE&l&kI &#FC55EF&l&ka&#FA57EF&l&km &#F758F0&l&kg&#F559F1&l&ko&#F25AF2&l&ki&#F05CF2&l&kn&#ED5DF3&l&kg &#EB5EF4&l&kt&#E860F4&l&ko &#E661F5&l&kt&#E362F6&l&ke&#E164F7&l&kl&#DE65F7&l&kl &#DB66F8&l&ky&#D967F9&l&ko&#D669F9&l&ku &#D46AFA&l&ks&#D16BFB&l&ke&#CF6DFB&l&kc&#CC6EFC&l&kr&#CA6FFD&l&ke&#C770FE&l&kt&#C273FF&l&ks
    @bypass /playsound minecraft:entity.enderman.scream master @s ~ ~ ~ 1 0.7
    @bypass /playsound minecraft:block.portal.travel master @s ~ ~ ~ 1 0
    @delay 20
    @for Int i in list::range(0, 140)
        @if i < 70
            @bypass execute as @s at @s anchored eyes run minecraft:tp {{player}} ~ ~ ~ ~{{i / 2}} ~
            @delay 1
            @bypass execute as @s at @s anchored feet run particle minecraft:reverse_portal {{player.getX()}} {{player.getY() + 0.2}} {{player.getZ()}} 1 0 1 1 10 normal @s
            
            @if i == 20
                @player &7Ok what now bruh
                @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 1
            @elseif i == 60
                @player &7Nah this is crazy.
                @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 1
            @fi

            # @player DEBUG: {{player.getX()}} {{player.getY() + 0.2}} {{player.getZ()}}
        @else
            @bypass execute as @s at @s anchored eyes run minecraft:tp {{player}} ~ ~ ~ ~{{70 - (i / 2)}} ~
            @delay 1
            @bypass execute as @s at @s anchored feet run particle minecraft:reverse_portal {{player.getX()}} {{player.getY() + 0.2}} {{player.getZ()}} 1 0 1 1 10 normal @s
            
            @if i == 110
                @player &7No way bro just cast a spell on me.
                @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 1
            @fi
        @fi
    @done
    @delay 50
    @player &7...
    @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 0.7 0.7
    @delay 10
    @player &7Alright then.
    @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 0.7
    @delay 10
    # @player {{player.getX()}} {{player.getY() + 0.2}} {{player.getZ()}}

    @var duckCount[player] += 1
    @var canTalkToDuck[player] = true
@elseif duckCount[player] == 970
    @var canTalkToDuck[player] = false
    @player &e&lDuck&r: I have enjoyed our conversation so far &l{{player}}.
    @bypass /playsound minecraft:entity.panda.hurt master @s -9171.50 96.00 9676.50 1 {{math::random(0.5D, 0.7D)}}
    @delay 40
    @player &7Sure man, me too.
    @bypass /playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 1
    @delay 10
    @player &e&lDuck&r: BEHOLD! My final transformation.
    @bypass /playsound minecraft:entity.panda.hurt master @s -9171.50 96.00 9676.50 1 {{math::random(0.5D, 0.7D)}}
    @delay 30
    @bypass playsound minecraft:entity.generic.explode master @s ~ ~ ~ 2 1
    @bypass /particle minecraft:explosion -9172 97 9676 1 1 1 0 10 normal @s
    @bypass /playsound minecraft:block.end_portal.spawn master @s ~ ~ ~ 1 1.25

    @for Int i in list::range(0, 90)
        @bypass particle minecraft:trial_spawner_detection -9172 96 9676 0.3 0 0.3 00.00 8 normal @s
        @bypass particle minecraft:trial_spawner_detection_ominous -9172 96 9676 0.3 0 0.3 00.00 8 normal @s
        @delay 4
        @if i == 20
            @player &e&lDuck&r: I am now...
            @bypass /playsound minecraft:entity.panda.hurt master @s -9171.50 96.00 9676.50 1 {{math::random(0.5D, 0.7D)}}
        @elseif i == 30
            @bypass /title @s times 86 0 0 
            @bypass /title @s title [{"bold":true,"color":"#F0FF1F","text":"M"},{"color":"#E7E24D","text":"r"},{"color":"#DDC67A","text":". "},{"color":"#D4A9A8","text":"D"},{"color":"#CD95C8","text":"u"},{"color":"#C98ADA","text":"c"},{"color":"#C273FF","text":"k"}]
            @player &#F0FF1F&lM&#E7E24D&lr&#DDC67A&l. &#D4A9A8&lD&#CD95C8&lu&#C98ADA&lc&#C273FF&lk: &#CD95C8MR DUCK!!!!!!!!!!!!!!!
            @bypass /playsound minecraft:entity.ender_dragon.death master @s ~ ~ ~ 2 0
            @bypass /playsound minecraft:entity.ender_dragon.death master @s ~ ~ ~ 2 2
            @bypass /playsound minecraft:entity.ender_dragon.death master @s ~ ~ ~ 2 1
        @elseif i == 50
            @bypass /stopsound {{player}}
        @elseif i == 51
            @player &#F0FF1F&lM&#E7E24D&lr&#DDC67A&l. &#D4A9A8&lD&#CD95C8&lu&#C98ADA&lc&#C273FF&lk: &#CD95C8Ok cut that out.
            @bypass playsound minecraft:entity.cat.ambient master @s -9171.50 96.00 9676.50 1 {{math::random(0.5D, 2.0D)}}
            @bypass /playsound minecraft:block.enchantment_table.use master @s -9171.50 96.00 9676.50 1 {{math::random(1.0D, 1.7D)}}
        @elseif i == 66
            @player &7I'm so confused.
            @bypass playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 1
        @elseif i == 70
            @player &#F0FF1F&lM&#E7E24D&lr&#DDC67A&l. &#D4A9A8&lD&#CD95C8&lu&#C98ADA&lc&#C273FF&lk: &#CD95C8I will now begin to share my wise knowledge I have gathered over the years. Please pay attention.
            @bypass playsound minecraft:entity.cat.ambient master @s -9171.50 96.00 9676.50 1 {{math::random(0.5D, 2.0D)}}
            @bypass /playsound minecraft:block.enchantment_table.use master @s -9171.50 96.00 9676.50 1 {{math::random(1.0D, 1.7D)}}
        @elseif i == 80
            @player &7ok
            @bypass playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 1
        @fi
    @done
    @var duckCount[player] += 1
    @var canTalkToDuck[player] = true
@elseif duckCount[player] > 970 && duckCount <= 999
    @var canTalkToDuck[player] = false
    @player &#F0FF1F&lM&#E7E24D&lr&#DDC67A&l. &#D4A9A8&lD&#CD95C8&lu&#C98ADA&lc&#C273FF&lk: &#CD95C8{{wisdomList[Int(math::random(0.0D, 95.0D))]}} &7({{duckCount[player]}}/1000) 
    @bypass /playsound minecraft:block.enchantment_table.use master @s -9171.50 96.00 9676.50 1 {{math::random(1.0D, 1.7D)}}
    @bypass /playsound minecraft:entity.cat.ambient master @s -9171.50 96.00 9676.50 1 {{math::random(0.5D, 2.0D)}}
    @for Int i in list::range(0, 15)
        @bypass particle minecraft:trial_spawner_detection -9172 96 9676 0.3 0 0.3 00.00 8 normal @s
        @bypass particle minecraft:trial_spawner_detection_ominous -9172 96 9676 0.3 0 0.3 00.00 8 normal @s
        @delay 4
    @done

    @var duckCount[player] += 1
    @var canTalkToDuck[player] = true
@elseif duckCount[player] == 1000
    @var canTalkToDuck[player] = false
    @player &#F0FF1F&lM&#E7E24D&lr&#DDC67A&l. &#D4A9A8&lD&#CD95C8&lu&#C98ADA&lc&#C273FF&lk: &#E7E24DThank you for keeping me company &l{{player}}.
    @bypass /playsound minecraft:block.enchantment_table.use master @s -9171.50 96.00 9676.50 1 {{math::random(1.0D, 1.7D)}}
    @bypass /playsound minecraft:entity.cat.ambient master @s -9171.50 96.00 9676.50 1 {{math::random(0.5D, 2.0D)}}
    @delay 60
    @player &7That was the best advice I have ever heard in my entire life.
    @bypass playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 1.3
    @delay 50
    @player &#F0FF1F&lM&#E7E24D&lr&#DDC67A&l. &#D4A9A8&lD&#CD95C8&lu&#C98ADA&lc&#C273FF&lk: &#E7E24DPerhaps I was too harsh on you {{player}}.
    @bypass /playsound minecraft:block.enchantment_table.use master @s -9171.50 96.00 9676.50 1 {{math::random(1.0D, 1.7D)}}
    @bypass /playsound minecraft:entity.cat.ambient master @s -9171.50 96.00 9676.50 1 {{math::random(0.5D, 2.0D)}}
    @delay 40
    @player &7Yeah bro you actually exploded me.
    @bypass playsound minecraft:entity.chicken.egg master @s -9171.50 96.00 9676.50 1 1.3
    @delay 30
    @player &#F0FF1F&lM&#E7E24D&lr&#DDC67A&l. &#D4A9A8&lD&#CD95C8&lu&#C98ADA&lc&#C273FF&lk: &#E7E24DNonetheless, there is something I would like to share with you.
