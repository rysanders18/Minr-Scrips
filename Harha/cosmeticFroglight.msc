# cosmeticFroglight(Player player)

@fast
@using Harha

@if froglightNumber[player] >= 2
    @var froglightNumber[player] = 0
@else
    @var froglightNumber[player] += 1
@fi

@var blockSelection[player] = froglightList[froglightNumber]
@if numberOfBlocksToGive[player] >= 1
    @var resetBlocks(player, numberOfBlocksToGive[player])
@fi
@var numberOfBlocksToGive[player] -= 1
