@for Int i in list::range(0, 1000)
    @if volume3[i] == 0.0F
        @var Harha::delay(instrument3[i])
    @else
        @if panning3[i] == 0.0D
            @bypass /playsound block.note_block.{{instrumentNames[instrument3[i]]}} master @p ~ ~ ~ {{volume3[i]}} {{pitch3[i]}}
        @else
            @bypass /playsound block.note_block.{{instrumentNames[instrument3[i]]}} master @p ~{{ panning3[i] * math::cos(Double(player.getYaw() + 180)) }} ~ ~{{ panning3[i] * math::sin(Double(player.getYaw() + 180)) }} {{volume3[i]}} {{pitch3[i]}}
            @bypass /particle minecraft:flame ~{{ panning3[i] * math::cos(Double(player.getYaw() + 180)) }} ~ ~{{ panning3[i] * math::sin(Double(player.getYaw() + 180)) }} 0 0 0 0 1
        @fi
    @fi
@done

