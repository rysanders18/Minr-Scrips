        @if panning1[i] == 0.0D
            @bypass /playsound block.note_block.{{instrumentNames[instrument1[i]]}} master @p ~ ~ ~ {{volume1[i]}} {{pitch1[i]}}
        @else
            @bypass /playsound block.note_block.{{instrumentNames[instrument1[i]]}} master @p ~{{ panning1[i] * math::cos(Double(player.getYaw() + 180)) }} ~ ~{{ panning1[i] * math::sin(Double(player.getYaw() + 180)) }} {{volume1[i]}} {{pitch1[i]}}
            @bypass /particle minecraft:flame ~{{ panning1[i] * math::cos(Double(player.getYaw() + 180)) }} ~ ~{{ panning1[i] * math::sin(Double(player.getYaw() + 180)) }} 0 0 0 0 1
        @fi
    @fi
@done

