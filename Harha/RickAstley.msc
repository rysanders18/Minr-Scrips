@for Int i in list::range(0, 662)
    @if volume8[i] == 0.0F
        @var Harha::delay(instrument8[i])
    @else
        @if panning8[i] == 0.0D
            @bypass /playsound block.note_block.{{instrumentNames[instrument8[i]]}} master @p ~ ~ ~ {{volume8[i]}} {{pitch8[i]}}
        @else
            @bypass /playsound block.note_block.{{instrumentNames[instrument8[i]]}} master @p ~{{ panning8[i] * math::cos(Double(player.getYaw() + 180)) }} ~ ~{{ panning8[i] * math::sin(Double(player.getYaw() + 180)) }} {{volume8[i]}} {{pitch8[i]}}
            @bypass /particle minecraft:flame ~{{ panning8[i] * math::cos(Double(player.getYaw() + 180)) }} ~ ~{{ panning8[i] * math::sin(Double(player.getYaw() + 180)) }} 0 0 0 0 1
        @fi
    @fi
@done

