# handlePlacementHeight5Slow (Block block, Player player)
@define Int height = 5

@fast
@using Harha

# define variables for less typing
@define Int x = block.getX()
@define Int y = block.getY()
@define Int z = block.getZ()


@if totalBlocks % 4 == 0
    # time block stays + 1 from target script
    @delay 8
    
    @bypass /execute in minecraft:theta_the_end run setblock {{x}} {{y}} {{z}} air
    @bypass /execute in minecraft:theta_the_end run summon falling_block {{x}} {{y}} {{z}} {BlockState:{Name:{{temporaryBlockSelection1}}}, DropItem: 0, CancelDrop:1}
    
    @delay 13
    
    @if (grateList.contains(blockSelection))
        @bypass /playsound minecraft:block.copper_grate.break master @a[distance=..20] ~ {{y - height}} ~ 1 1
    @elseif (woolList.contains(blockSelection))
        @bypass /playsound minecraft:block.wool.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @elseif temporaryBlockSelection1 == "flowering_azalea_leaves"
        @bypass /playsound minecraft:block.azalea_leaves.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @elseif (glassList.contains(blockSelection)) || blockSelection == "blue_ice"
        @bypass /playsound minecraft:block.glass.break master @a[distance=..20] ~ {{y - height}} ~ 0.3 0.8
    @elseif (blocksSound.contains(blockSelection))
        @bypass /playsound minecraft:block.stone.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @elseif (blocksSoundOres.contains(blockSelection))
        @bypass /playsound minecraft:block.stone.break master @a[distance=..20] ~ {{y - height}} ~ 1 1.2
    @elseif (pumpkinList.contains(blockSelection))
        @bypass /playsound minecraft:block.wood.break master @a[distance=..20] ~ {{y - height}} ~ 0.5 0.8
    @elseif (coralList.contains(blockSelection))
        @bypass /playsound minecraft:block.coral_block.break master @s ~ {{y - height}} ~ 1 0.8
    @else
        @bypass /playsound minecraft:block.{{temporaryBlockSelection1}}.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @fi
    
    @bypass /execute in minecraft:theta_the_end run particle block{block_state:{Name:{{temporaryBlockSelection1}}}} {{x}} {{y - height}} {{z}} 0.3 0.3 0.3 1 40
    @return
    
    
    
@elseif totalBlocks % 4 == 1
    # time block stays + 1 from target script
    @delay 8
    
    @bypass /execute in minecraft:theta_the_end run setblock {{x}} {{y}} {{z}} air
    @bypass /execute in minecraft:theta_the_end run summon falling_block {{x}} {{y}} {{z}} {BlockState:{Name:{{temporaryBlockSelection2}}}, DropItem: 0, CancelDrop:1}
    
    @delay 13
    
    @if (grateList.contains(blockSelection))
        @bypass /playsound minecraft:block.copper_grate.break master @a[distance=..20] ~ {{y - height}} ~ 1 1
    @elseif (woolList.contains(blockSelection))
        @bypass /playsound minecraft:block.wool.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @elseif temporaryBlockSelection2 == "flowering_azalea_leaves"
        @bypass /playsound minecraft:block.azalea_leaves.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @elseif (glassList.contains(blockSelection)) || blockSelection == "blue_ice"
        @bypass /playsound minecraft:block.glass.break master @a[distance=..20] ~ {{y - height}} ~ 0.3 0.8
    @elseif (blocksSound.contains(blockSelection))
        @bypass /playsound minecraft:block.stone.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @elseif (blocksSoundOres.contains(blockSelection))
        @bypass /playsound minecraft:block.stone.break master @a[distance=..20] ~ {{y - height}} ~ 1 1.2
    @elseif (pumpkinList.contains(blockSelection))
        @bypass /playsound minecraft:block.wood.break master @a[distance=..20] ~ {{y - height}} ~ 0.5 0.8
    @elseif (coralList.contains(blockSelection))
        @bypass /playsound minecraft:block.coral_block.break master @s ~ {{y - height}} ~ 1 0.8
    @else
        @bypass /playsound minecraft:block.{{temporaryBlockSelection2}}.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @fi
    
    @bypass /execute in minecraft:theta_the_end run particle block{block_state:{Name:{{temporaryBlockSelection2}}}} {{x}} {{y - height}} {{z}} 0.3 0.3 0.3 1 40
    @return
    
    
    
@elseif totalBlocks % 4 == 2
    # time block stays + 1 from target script
    @delay 8
    
    @bypass /execute in minecraft:theta_the_end run setblock {{x}} {{y}} {{z}} air
    @bypass /execute in minecraft:theta_the_end run summon falling_block {{x}} {{y}} {{z}} {BlockState:{Name:{{temporaryBlockSelection3}}}, DropItem: 0, CancelDrop:1}
    
    @delay 13
    
    @if (grateList.contains(blockSelection))
        @bypass /playsound minecraft:block.copper_grate.break master @a[distance=..20] ~ {{y - height}} ~ 1 1
    @elseif (woolList.contains(blockSelection))
        @bypass /playsound minecraft:block.wool.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @elseif temporaryBlockSelection3 == "flowering_azalea_leaves"
        @bypass /playsound minecraft:block.azalea_leaves.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @elseif (glassList.contains(blockSelection)) || blockSelection == "blue_ice"
        @bypass /playsound minecraft:block.glass.break master @a[distance=..20] ~ {{y - height}} ~ 0.3 0.8
    @elseif (blocksSound.contains(blockSelection))
        @bypass /playsound minecraft:block.stone.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @elseif (blocksSoundOres.contains(blockSelection))
        @bypass /playsound minecraft:block.stone.break master @a[distance=..20] ~ {{y - height}} ~ 1 1.2
    @elseif (pumpkinList.contains(blockSelection))
        @bypass /playsound minecraft:block.wood.break master @a[distance=..20] ~ {{y - height}} ~ 0.5 0.8
    @elseif (coralList.contains(blockSelection))
        @bypass /playsound minecraft:block.coral_block.break master @s ~ {{y - height}} ~ 1 0.8
    @else
        @bypass /playsound minecraft:block.{{temporaryBlockSelection3}}.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @fi
    
    @bypass /execute in minecraft:theta_the_end run particle block{block_state:{Name:{{temporaryBlockSelection3}}}} {{x}} {{y - height}} {{z}} 0.3 0.3 0.3 1 40
    @return
    
    
    
@elseif totalBlocks % 4 == 3
    # time block stays + 1 from target script
    @delay 8
    
    @bypass /execute in minecraft:theta_the_end run setblock {{x}} {{y}} {{z}} air
    @bypass /execute in minecraft:theta_the_end run summon falling_block {{x}} {{y}} {{z}} {BlockState:{Name:{{temporaryBlockSelection4}}}, DropItem: 0, CancelDrop:1}
    
    @delay 13
    
    @if (grateList.contains(blockSelection))
        @bypass /playsound minecraft:block.copper_grate.break master @a[distance=..20] ~ {{y - height}} ~ 1 1
    @elseif (woolList.contains(blockSelection))
        @bypass /playsound minecraft:block.wool.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @elseif temporaryBlockSelection4 == "flowering_azalea_leaves"
        @bypass /playsound minecraft:block.azalea_leaves.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @elseif (glassList.contains(blockSelection)) || blockSelection == "blue_ice"
        @bypass /playsound minecraft:block.glass.break master @a[distance=..20] ~ {{y - height}} ~ 0.3 0.8
    @elseif (blocksSound.contains(blockSelection))
        @bypass /playsound minecraft:block.stone.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @elseif (blocksSoundOres.contains(blockSelection))
        @bypass /playsound minecraft:block.stone.break master @a[distance=..20] ~ {{y - height}} ~ 1 1.2
    @elseif (pumpkinList.contains(blockSelection))
        @bypass /playsound minecraft:block.wood.break master @a[distance=..20] ~ {{y - height}} ~ 0.5 0.8
    @elseif (coralList.contains(blockSelection))
        @bypass /playsound minecraft:block.coral_block.break master @s ~ {{y - height}} ~ 1 0.8
    @else
        @bypass /playsound minecraft:block.{{temporaryBlockSelection4}}.break master @a[distance=..20] ~ {{y - height}} ~ 1 0.8
    @fi
    
    @bypass /execute in minecraft:theta_the_end run particle block{block_state:{Name:{{temporaryBlockSelection4}}}} {{x}} {{y - height}} {{z}} 0.3 0.3 0.3 1 40
    @return
    
    
    
    
@fi