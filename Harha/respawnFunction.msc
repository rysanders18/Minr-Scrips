@elseif numberCompletions == 2
    @bypass item replace entity @s armor.head with iron_helmet[custom_name=[{"bold":true,"color":"#47D4D4","italic":false,"shadow_color":-14534341,"text":"H"},{"color":"#50D8D9","shadow_color":-14534341,"text":"a"},{"color":"#58DCDE","shadow_color":-14534341,"text":"r"},{"color":"#61E0E2","shadow_color":-14534341,"text":"d"},{"color":"#69E4E7","shadow_color":-14534341,"text":"e"},{"color":"#72E8EC","shadow_color":-14534341,"text":"r "},{"color":"#7AECF1","shadow_color":-14534341,"text":"H"},{"color":"#83F0F5","shadow_color":-14534341,"text":"a"},{"color":"#94F8FF","shadow_color":-14534341,"text":"t"}],enchantment_glint_override=true,enchantments={"minecraft:respiration":3,"minecraft:binding_curse":1,"minecraft:vanishing_curse":1},tooltip_display={hidden_components:["enchantments","attribute_modifiers"]},attribute_modifiers=[{id:"armor",type:"armor",amount:{{numberCompletions[player] + 1}},operation:"add_value"}],lore=[{"color":"gray","italic":false,"text":"Unbreaking {{numberCompletions[player]}}"}," ",[{"color":"gray","text":"Each "},{"bold":false,"text":"map completion "},"will upgrade the"],[{"color":"gray","text":"hardness "},"of this hat! Good luck!"]]] 1
@elseif numberCompletions == 3
    @bypass item replace entity @s armor.head with golden_helmet[custom_name=[{"bold":true,"color":"#47D4D4","italic":false,"shadow_color":-14534341,"text":"H"},{"color":"#50D8D9","shadow_color":-14534341,"text":"a"},{"color":"#58DCDE","shadow_color":-14534341,"text":"r"},{"color":"#61E0E2","shadow_color":-14534341,"text":"d"},{"color":"#69E4E7","shadow_color":-14534341,"text":"e"},{"color":"#72E8EC","shadow_color":-14534341,"text":"r "},{"color":"#7AECF1","shadow_color":-14534341,"text":"H"},{"color":"#83F0F5","shadow_color":-14534341,"text":"a"},{"color":"#94F8FF","shadow_color":-14534341,"text":"t"}],enchantment_glint_override=true,enchantments={"minecraft:respiration":3,"minecraft:binding_curse":1,"minecraft:vanishing_curse":1},tooltip_display={hidden_components:["enchantments","attribute_modifiers"]},attribute_modifiers=[{id:"armor",type:"armor",amount:{{numberCompletions[player] + 1}},operation:"add_value"}],lore=[{"color":"gray","italic":false,"text":"Unbreaking {{numberCompletions[player]}}"}," ",[{"color":"gray","text":"Each "},{"bold":false,"text":"map completion "},"will upgrade the"],[{"color":"gray","text":"hardness "},"of this hat! Good luck!"]]] 1
@elseif numberCompletions >= 4 && numberCompletions <= 9
    @bypass item replace entity @s armor.head with diamond_helmet[custom_name=[{"bold":true,"color":"#47D4D4","italic":false,"shadow_color":-14534341,"text":"H"},{"color":"#50D8D9","shadow_color":-14534341,"text":"a"},{"color":"#58DCDE","shadow_color":-14534341,"text":"r"},{"color":"#61E0E2","shadow_color":-14534341,"text":"d"},{"color":"#69E4E7","shadow_color":-14534341,"text":"e"},{"color":"#72E8EC","shadow_color":-14534341,"text":"r "},{"color":"#7AECF1","shadow_color":-14534341,"text":"H"},{"color":"#83F0F5","shadow_color":-14534341,"text":"a"},{"color":"#94F8FF","shadow_color":-14534341,"text":"t"}],enchantment_glint_override=true,enchantments={"minecraft:respiration":3,"minecraft:binding_curse":1,"minecraft:vanishing_curse":1},tooltip_display={hidden_components:["enchantments","attribute_modifiers"]},attribute_modifiers=[{id:"armor",type:"armor",amount:{{numberCompletions[player] + 1}},operation:"add_value"}],lore=[{"color":"gray","italic":false,"text":"Unbreaking {{numberCompletions[player]}}"}," ",[{"color":"gray","text":"Each "},{"bold":false,"text":"map completion "},"will upgrade the"],[{"color":"gray","text":"hardness "},"of this hat! Good luck!"]]] 1
@elseif numberCompletions >= 10 && numberCompletions <= 99
    @bypass item replace entity @s armor.head with netherite_helmet[custom_name=[{"bold":true,"color":"#47D4D4","italic":false,"shadow_color":-14534341,"text":"H"},{"color":"#50D8D9","shadow_color":-14534341,"text":"a"},{"color":"#58DCDE","shadow_color":-14534341,"text":"r"},{"color":"#61E0E2","shadow_color":-14534341,"text":"d"},{"color":"#69E4E7","shadow_color":-14534341,"text":"e"},{"color":"#72E8EC","shadow_color":-14534341,"text":"r "},{"color":"#7AECF1","shadow_color":-14534341,"text":"H"},{"color":"#83F0F5","shadow_color":-14534341,"text":"a"},{"color":"#94F8FF","shadow_color":-14534341,"text":"t"}],enchantment_glint_override=true,enchantments={"minecraft:respiration":3,"minecraft:binding_curse":1,"minecraft:vanishing_curse":1},tooltip_display={hidden_components:["enchantments","attribute_modifiers"]},attribute_modifiers=[{id:"armor",type:"armor",amount:{{numberCompletions[player] + 1}},operation:"add_value"}],lore=[{"color":"gray","italic":false,"text":"Unbreaking {{numberCompletions[player]}}"}," ",[{"color":"gray","text":"Each "},{"bold":false,"text":"map completion "},"will upgrade the"],[{"color":"gray","text":"hardness "},"of this hat! Good luck!"]," ",[{"color":"gray","text":"Perhaps "},{"bold":false,"text":"something special "},"is unlocked at 100 completions..."]]] 1
@elseif numberCompletions >= 100 && numberCompletions <= 499
    @if glassList[player].concat() == "red_stained_glassorange_stained_glassyellow_stained_glasslime_stained_glasslight_blue_stained_glasscyan_stained_glassblue_stained_glasspurple_stained_glassmagenta_stained_glasspink_stained_glassred_stained_glassorange_stained_glassyellow_stained_glasslime_stained_glass"
        @bypass item replace entity @s armor.head with white_stained_glass[custom_name=[{"bold":true,"color":"#47D4D4","italic":false,"shadow_color":-14534341,"text":"H"},{"color":"#50D8D9","shadow_color":-14534341,"text":"a"},{"color":"#58DCDE","shadow_color":-14534341,"text":"r"},{"color":"#61E0E2","shadow_color":-14534341,"text":"d"},{"color":"#69E4E7","shadow_color":-14534341,"text":"e"},{"color":"#72E8EC","shadow_color":-14534341,"text":"r "},{"color":"#7AECF1","shadow_color":-14534341,"text":"H"},{"color":"#83F0F5","shadow_color":-14534341,"text":"a"},{"color":"#94F8FF","shadow_color":-14534341,"text":"t"}],enchantment_glint_override=true,enchantments={"minecraft:respiration":3,"minecraft:binding_curse":1,"minecraft:vanishing_curse":1},tooltip_display={hidden_components:["enchantments","attribute_modifiers"]},attribute_modifiers=[{id:"armor",type:"armor",amount:{{numberCompletions[player] + 1}},operation:"add_value"}],lore=[{"color":"gray","italic":false,"text":"Unbreaking {{numberCompletions[player]}}"}," ",[{"color":"gray","text":"Each "},{"bold":false,"text":"map completion "},"will upgrade the"],[{"color":"gray","text":"hardness "},"of this hat! Good luck!"]," ",[{"color":"gray","text":"Good job unlocking the "},{"bold":true,"text":"Space Helmet! "}],{"color":"gray","text":"You can change the color of this glass!"},{"color":"gray","text":"It's equal to the first color you input in the Custom Glass cosmetic."}," ",[{"color":"gray","text":"Perhaps "},{"bold":true,"text":"something remarkable "},"is unlocked at 500 completions..."]]] 1
    @else
        @bypass item replace entity @s armor.head with {{glassList[player][0]}}[custom_name=[{"bold":true,"color":"#47D4D4","italic":false,"shadow_color":-14534341,"text":"H"},{"color":"#50D8D9","shadow_color":-14534341,"text":"a"},{"color":"#58DCDE","shadow_color":-14534341,"text":"r"},{"color":"#61E0E2","shadow_color":-14534341,"text":"d"},{"color":"#69E4E7","shadow_color":-14534341,"text":"e"},{"color":"#72E8EC","shadow_color":-14534341,"text":"r "},{"color":"#7AECF1","shadow_color":-14534341,"text":"H"},{"color":"#83F0F5","shadow_color":-14534341,"text":"a"},{"color":"#94F8FF","shadow_color":-14534341,"text":"t"}],enchantment_glint_override=true,enchantments={"minecraft:respiration":3,"minecraft:binding_curse":1,"minecraft:vanishing_curse":1},tooltip_display={hidden_components:["enchantments","attribute_modifiers"]},attribute_modifiers=[{id:"armor",type:"armor",amount:{{numberCompletions[player] + 1}},operation:"add_value"}],lore=[{"color":"gray","italic":false,"text":"Unbreaking {{numberCompletions[player]}}"}," ",[{"color":"gray","text":"Each "},{"bold":false,"text":"map completion "},"will upgrade the"],[{"color":"gray","text":"hardness "},"of this hat! Good luck!"]," ",[{"color":"gray","text":"Good job unlocking the "},{"bold":true,"text":"Space Helmet! "}],{"color":"gray","text":"You can change the color of this glass!"},{"color":"gray","text":"It's equal to the first color you input in the Custom Glass cosmetic."}," ",[{"color":"gray","text":"Perhaps "},{"bold":true,"text":"something remarkable "},"is unlocked at 500 completions..."]]] 1
    @fi
@elseif numberCompletions >= 500
    @bypass /item replace entity @s armor.head with end_rod[custom_name=[{"bold":true,"color":"#55FFFF","italic":false,"text":"Even H"},{"color":"#5AFEFF","text":"a"},{"color":"#60FDFF","text":"r"},{"color":"#65FCFF","text":"d"},{"color":"#6AFBFF","text":"e"},{"color":"#70FBFF","text":"rest "},{"color":"#75FAFF","text":"H"},{"color":"#7AF9FF","text":"a"},{"color":"#85F7FF","text":"t"}],enchantment_glint_override=true,enchantments={"minecraft:respiration":3,"minecraft:binding_curse":1,"minecraft:vanishing_curse":1},tooltip_display={hidden_components:["enchantments","attribute_modifiers"]},attribute_modifiers=[{id:"armor",type:"armor",amount:{{numberCompletions[player] + 1}},operation:"add_value"}],lore=[{"color":"gray","italic":false,"text":"Unbreaking {{numberCompletions[player]}}"}," ",[{"color":"gray","text":"Each "},{"bold":false,"text":"map completion "},"will upgrade the"],[{"color":"gray","text":"hardness "},"of this hat! Good luck!"]," ",[{"bold":true,"color":"light_purple","text":"Congratulations! You are now a "},{"bold":true,"text":"Unicorn!"},{"bold":true,"color":"light_purple","text":" Good job!"}]]] 1
@fi