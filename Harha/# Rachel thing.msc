# Rachel thing

@cooldown 1000s

@fast
@using Harha

@player
@player &#CCDFED&k&lRachel&#CCDFED: &#F09A2B&lTed?!? &#CCDFEDIs that really you??
@bypass /playsound minecraft:entity.villager.celebrate master {{player}} ~ ~ ~ 1 2

@delay 50

@player
@player &#F09A2B&lTed&#CCDFED: I'm here to rescue you!! Are you oka-
@bypass /playsound minecraft:entity.chicken.egg master {{player}} ~ ~ ~ 1 1.2

@delay 35

@player
@player &#CCDFED&k&lRachel&#CCDFED: &#CCDFEDSTAY BACK!!! I've been through so much &#F09A2B&lTed...
@bypass /playsound minecraft:entity.villager.trade master {{player}} ~ ~ ~ 1 1.8

@delay 50

@player &#CCDFED&k&lRachel&#CCDFED: How do I know it's really you?
@bypass /playsound minecraft:entity.villager.celebrate master {{player}} ~ ~ ~ 1 1.7

@delay 35

@player 
@player &#F09A2B&lTed&#CCDFED: Of course it's me!!
@bypass /playsound minecraft:entity.chicken.egg master {{player}} ~ ~ ~ 1 1.1

@delay 50

@player 
@player &#CCDFED&k&lRachel&#CCDFED: &lIf you really are who you say you are...
@bypass /playsound minecraft:entity.villager.trade master {{player}} ~ ~ ~ 1 0.8

@delay 70

@player
@player &#CCDFED&k&lRachel&#CCDFED:&l WHAT  IS  MY  &nNAME?

# @var RachelName(Player("{{player}}"))

@for Int i in list::range(0, 75)
    # @bypass /playsound minecraft:item.goat_horn.sound.1 master {{player}} ~ ~ ~ 0.5 {{(Float(i) / Float(200)) * 1.5 + 0.5}}
    @bypass /playsound minecraft:block.dried_ghast.transition master {{player}} ~ ~ ~ 1 {{(Float(i) / Float(150)) * 1.5 + 0.5}}
    @delay 1
@done

@for Int i in list::range(0, 75)
    @var i = 75 - i
    # @bypass /playsound minecraft:item.goat_horn.sound.1 master {{player}} ~ ~ ~ 0.5 {{(Float(i) / Float(200)) * 1.5 + 0.5}}
    @bypass /playsound minecraft:block.dried_ghast.transition master {{player}} ~ ~ ~ 1 {{(Float(i) / Float(150)) * 1.5 + 0.5}}
    @delay 1
@done

@for Int i in list::range(0, 75)
    # @bypass /playsound minecraft:item.goat_horn.sound.1 master {{player}} ~ ~ ~ 0.5 {{(Float(i) / Float(200)) * 1.5 + 0.5}}
    @bypass /playsound minecraft:block.dried_ghast.transition master {{player}} ~ ~ ~ 1 {{(Float(i) / Float(150)) * 1.5 + 0.5}}
    @delay 1
@done

@for Int i in list::range(0, 75)
    @var i = 75 - i
    # @bypass /playsound minecraft:item.goat_horn.sound.1 master {{player}} ~ ~ ~ 0.5 {{(Float(i) / Float(200)) * 1.5 + 0.5}}
    @bypass /playsound minecraft:block.dried_ghast.transition master {{player}} ~ ~ ~ 1 {{(Float(i) / Float(150)) * 1.5 + 0.5}}
    @delay 1
@done

@delay 5

# @player DEBUG: Rachelname = {{Rachelname[player]}}
@if rachelname[player].toLowerCase() != "rachel"

    # @bypass /stopsound {{player}}
    @bypass /playsound minecraft:block.note_block.didgeridoo master @s ~ ~ ~ 1 0.5

    @player
    @player &#CCDFED&k&lRachel&#CCDFED: &l{{rachelname[player]}}??? I knew it couldn't be true...

    @delay 3s

    @bypass /playsound minecraft:block.note_block.didgeridoo master @s ~ ~ ~ 1 0.5
    @player &#CCDFED&k&lRachel&#CCDFED: &lYOU'RE JUST ANOTHER BANDIT!!!

    @delay 2s

    @player
    @player &#F09A2B&lTed&#CCDFED: NO!!! PLEASE I PROMISE-
    @bypass /playsound minecraft:entity.chicken.egg master {{player}} ~ ~ ~ 1 0.7

    @delay 10 
    @bypass /playsound minecraft:item.armor.equip_wolf master {{player}} ~ ~ ~ 1 0.5
    @delay 10

    @bypass /effect give {{player}} minecraft:darkness 100 1 true
    @bypass /playsound minecraft:ui.toast.in master @s ~ ~ ~ 1 0.5

    @delay 30

    @bypass /effect give {{player}} minecraft:blindness 100 1 true
    @bypass /title {{player}} times 40 100 40
    @bypass /title {{player}} title {"color":"dark_red","shadow_color":-12910592,"text":"You were then stabbed..."}
    @bypass /title {{player}} subtitle {"color":"dark_red","shadow_color":-12910592,"text":"57 times in the chest."}

    @for Int i in list::range(0, 58)
        @var i = 58 - i
        @bypass /playsound minecraft:entity.player.hurt master {{player}} ~ ~ ~ 1 {{(Float(i) / Float(58)) * 1.5 + 0.5}}
        @bypass execute at {{player}} run particle block{block_state:"minecraft:redstone_block"} ~ ~ ~ 0 1 0 1 100 normal
        @bypass /minecraft:damage {{player}} 0.1
        @delay 2
    @done

    @delay 16
    @bypass /playsound minecraft:entity.player.hurt master {{player}} ~ ~ ~ 1 0.5
    @bypass execute at {{player}} run particle block{block_state:"minecraft:redstone_block"} ~ ~ ~ 0 1 0 1 100 normal
    @delay 1
    @bypass /kill

@else
    @bypass /stopsound {{player}}
    @bypass /playsound minecraft:block.note_block.bell master @s ~ ~ ~ 1 1
    @bypass /playsound minecraft:block.note_block.pling master @s ~ ~ ~ 1 1
    @bypass /playsound minecraft:entity.villager.celebrate master {{player}} ~ ~ ~ 1 2

    @player
    @player &e&lRachel&#CCDFED: &#CCDFEDOMG!!
    
    @delay 30
    @player &e&lRachel&#CCDFED: It really is you &#F09A2B&lTed! &#CCDFEDYou're here to save me!!
    @bypass /playsound minecraft:entity.villager.celebrate master {{player}} ~ ~ ~ 1 2

    @delay 40
    @player 
    @player &#F09A2B&lTed&#CCDFED: Yes!!! I've come so far...
    @bypass /playsound minecraft:entity.chicken.egg master {{player}} ~ ~ ~ 1 1.5

    @delay 40
    @player
    @player &e&lRachel&#CCDFED: Thank you &#F09A2B&lTed! &#CCDFEDI knew I could count on you!
    @bypass /playsound minecraft:entity.villager.celebrate master {{player}} ~ ~ ~ 1 2

    @delay 50
    @player &e&lRachel&#CCDFED: Before we go back home...
    @bypass /playsound minecraft:entity.villager.celebrate master {{player}} ~ ~ ~ 1 2

    @delay 60
    @player &e&lRachel&#CCDFED: Lets take some treasure from the bandit's hidden stash!!
    @bypass /playsound minecraft:entity.villager.celebrate master {{player}} ~ ~ ~ 1 2

    @delay 20
    @bypass /setblock -9386 163 9860 minecraft:air
    @bypass /playsound minecraft:entity.chicken.egg master {{player}} ~ ~ ~ 1 0.5
    @delay 1
    @bypass /setblock -9387 163 9860 minecraft:air
    @bypass /playsound minecraft:entity.chicken.egg master {{player}} ~ ~ ~ 1 0.6
    @delay 1
    @bypass /setblock -9388 163 9860 minecraft:air
    @bypass /playsound minecraft:entity.chicken.egg master {{player}} ~ ~ ~ 1 0.7
    @delay 1
    @bypass /setblock -9386 162 9860 minecraft:air
    @bypass /playsound minecraft:entity.chicken.egg master {{player}} ~ ~ ~ 1 0.8
    @delay 1
    @bypass /setblock -9387 162 9860 minecraft:air
    @bypass /playsound minecraft:entity.chicken.egg master {{player}} ~ ~ ~ 1 0.9
    @delay 1
    @bypass /setblock -9388 162 9860 minecraft:air
    @bypass /playsound minecraft:entity.chicken.egg master {{player}} ~ ~ ~ 1 1.0
    @delay 1
    @bypass /setblock -9386 161 9860 minecraft:air
    @bypass /playsound minecraft:entity.chicken.egg master {{player}} ~ ~ ~ 1 1.1
    @delay 1
    @bypass /setblock -9387 161 9860 minecraft:air
    @bypass /playsound minecraft:entity.chicken.egg master {{player}} ~ ~ ~ 1 1.2
    @delay 1
    @bypass /setblock -9388 161 9860 minecraft:air
    @bypass /playsound minecraft:entity.chicken.egg master {{player}} ~ ~ ~ 1 1.3
    @delay 1
@fi
