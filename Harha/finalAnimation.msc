@define Float[] icoCoordsR3X
@define Float[] icoCoordsR3Y
@define Float[] icoCoordsR3Z


@var icoCoordsR3Z = Float[0.840000F, -1.050692F, 0.157366F, 1.266722F, -2.269887F, 2.097135F, -0.683228F, -1.267285F, 2.669788F, -2.691989F, 1.255157F, 0.894974F, -2.595634F, 2.920636F, -1.703160F, -0.374264F, 2.173326F, -2.747197F, 1.865501F, -0.114808F, -1.476914F, 2.063329F, -1.477545F, 0.312744F, 0.417632F]
@var icoCoordsR3Y = Float[0.000000F, 0.962520F, -1.793108F, 1.652215F, -0.401511F, -1.334026F, 2.541574F, -2.440080F, 0.975002F, 1.111214F, -2.682197F, 2.853318F, -1.504223F, -0.642094F, 2.422570F, -2.888170F, 1.831681F, 0.113605F, -1.856423F, 2.482825F, -1.769837F, 0.277618F, 1.028037F, -1.390177F, 0.728823F]
@var icoCoordsR3X = Float[2.880000F, 2.640000F, 2.400000F, 2.160000F, 1.920000F, 1.680000F, 1.440000F, 1.200000F, 0.960000F, 0.720000F, 0.480000F, 0.240000F, 0.000000F, -0.240000F, -0.480000F, -0.720000F, -0.960000F, -1.200000F, -1.440000F, -1.680000F, -1.920000F, -2.160000F, -2.400000F, -2.640000F, -2.880000F]

# Particles First
@define Int[] coolKValues = Int[3, 5, 8, 13, 17, 20, 22]
@define Int numberParticles = 30

@console /function execute Harha::finalAnimationParticles(Player("{{player}}"))

@define Float noteNumber = 0.5
@define Float particleMovementNumber = 0.01

@bypass /setblock {{secretBlock.getX()}} {{secretBlock.getY()}} {{secretBlock.getZ()}} air strict

@var height = 0.5
@var multiplier = 1.0F

@delay 1

@for Int i in list::range(0, 16)
    @delay 1
    @bypass /playsound minecraft:block.beacon.activate master {{player}} ~ ~ ~ 1 {{noteNumber}}
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 {{noteNumber}}
    @bypass particle minecraft:trial_spawner_detection_ominous {{secretBlock.getX()}} {{secretBlock.getY()}} {{secretBlock.getZ()}} 0.225 0 0.225 {{particleMovementNumber}} 3
    @bypass particle minecraft:trial_spawner_detection {{secretBlock.getX()}} {{secretBlock.getY()}} {{secretBlock.getZ()}} 0.225 0 0.225 {{particleMovementNumber}} 3
    @var noteNumber += 0.005
    @if i <= 7
        @var multiplier += 0.01
    @else
        @var multiplier -= 0.017353625
    @fi
    @var height += 0.01
    @bypass particle minecraft:trial_spawner_detection_ominous -9061 76 9571 2.125 0 2.125 0.1 10
    @bypass particle minecraft:trial_spawner_detection -9061 76 9571 2.125 0 2.125 0.1 10
    @var particleMovementNumber += 0.0006
    @bypass /data merge entity @e[tag=secretHeadEntity{{secretNumber}},limit=1] {start_interpolation:0,interpolation_duration:40,transformation:{left_rotation:[0f, 0f, 0f, 1f],right_rotation:[-0.324f, 0f, 0.324f, 0.889f],translation:[{{-0.145 * multiplier}}f, {{height}}f, {{-0.145 * multiplier}}f],scale:[{{multiplier}}f, {{multiplier}}f, {{multiplier}}f]},item:{id:"minecraft:player_head",count:1,components:{"minecraft:profile":{properties:[{name:"textures",value:"{{entityColor0}}"}]}}}}
    @delay 1
    @bypass /playsound minecraft:block.beacon.activate master {{player}} ~ ~ ~ 1 {{noteNumber}}
    @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 {{noteNumber}}
    @bypass particle minecraft:trial_spawner_detection_ominous {{secretBlock.getX()}} {{secretBlock.getY()}} {{secretBlock.getZ()}} 0.225 0 0.225 {{particleMovementNumber}} 3
