@for Int i in list::range(1, 16)
    @bypass /data merge entity @e[tag=mrsDuck{{i}},limit=1] {start_interpolation:0,interpolation_duration:150,transformation:{translation:[{{duckTranslationsX[i - 1]}}, {{duckTranslationsY[i - 1] + 8.5}}, {{duckTranslationsZ[i - 1]}}]}}
    @delay 3
    @bypass /playsound minecraft:block.beacon.power_select master @s ~ ~ ~ 1 {{((Float(i) / 16) * 1.5 + 0.5)}}
    @bypass /playsound minecraft:entity.bat.takeoff master @s -9061 77 9571 1 {{((Float(i) / 16) * 1.5 + 0.5)}}
    @bypass /particle minecraft:firework -9061 79 9571 0.5 2.5 0.5 0.01 15
@done

@for Int i in list::range(1, 16)
