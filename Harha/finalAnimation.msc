@bypass /minecraft:kill @e[tag=secretHeadEntity25]

# beacon sounds
@for Int k in list::range(1, 100)
    @bypass playsound minecraft:block.beacon.ambient master {{player}} ~ ~ ~ 1 {{(Float(k) / 100.0) * 1.5 + 0.5}}
@done


