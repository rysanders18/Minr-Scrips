@using Harha
@fast

@var stopAnimation = false
@define Int secretNumber = 25

@define Block secretBlock = Block(-9061, 77, 9571, "Theta")

@define String[] colorList4 = String["#c375ff", "#ae80ff", "#9789ff", "#8091ff", "#6798ff", "#4d9eff", "#30a3ff", "#00a7fa"]

@bypass particle minecraft:trial_spawner_detection_ominous {{secretBlock.getX()}} {{secretBlock.getY()}} {{secretBlock.getZ()}} 2.125 0 2.125 0.1 100
@bypass particle minecraft:trial_spawner_detection {{secretBlock.getX()}} {{secretBlock.getY()}} {{secretBlock.getZ()}} 2.125 0 2.125 0.1 100
@bypass particle minecraft:trial_spawner_detection_ominous -9061 77.3 9571 0 0 0 0.75 100
@bypass particle minecraft:trial_spawner_detection -9061 77.3 9571 0 0 0 0.75 100

# @for Int j in list::range(0, 1)
@for Int i in list::range(0, 200)
    # @bypass /playsound minecraft:item.goat_horn.sound.1 master {{player}} ~ ~ ~ 0.5 {{(Float(i) / Float(200)) * 1.5 + 0.5}}
    @bypass /playsound minecraft:block.beacon.activate master {{player}} ~ ~ ~ 1 {{(Float(i) / Float(200)) * 1.5 + 0.5}}
@done

@for Int i in list::range(0, 50)
    @bypass /playsound minecraft:item.totem.use master {{player}} ~ ~ ~ 0.5 {{(Float(i) / Float(50)) * 1.5 + 0.5}}
    # @bypass /playsound minecraft:entity.warden.sonic_boom master {{player}} ~ ~ ~ 1 {{(Float(i) / Float(200)) * 1.5 + 0.5}}
@done

@console /function execute Harha::finalAnimationWave2()
@delay 5
@console /function execute Harha::finalAnimationWave()

@define Float height = Float(-2.0)
@define Float multiplier = Float(0.1)
@define Int kOld = 0

@define Float centerX = -9060.5
@define Float centerY = 79.5
@define Float centerZ = 9571.5

@define Location[] coordinateList = Location[]
@define Int headNumber = 0

