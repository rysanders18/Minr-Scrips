@delay 2
@for Int i in list::range(1, 16)
    @bypass /data merge entity @e[tag=mrsDuck{{i}},limit=1] {start_interpolation:0,interpolation_duration:150,transformation:{translation:[{{duckTranslationsX[i - 1]}}, {{duckTranslationsY[i - 1] - 9.9}}, {{duckTranslationsZ[i - 1]}}]}}
@done

@for Int i in list::range(0, 150)
    @bypass /execute in minecraft:theta run particle minecraft:totem_of_undying {{(-2.40 * math::cos(Double(i * 10 + 180)) - 9060.5)}} {{87.0 - ((Float(i) / 15))}} {{(-2.40 * math::sin(Double(i * 10 + 180))) + 9571.5}} 0 0 0 0 1
    @bypass /execute in minecraft:theta run particle minecraft:totem_of_undying {{(-2.40 * math::cos(Double(i * 10)) - 9060.5)}} {{87.0 - ((Float(i) / 15))}} {{(-2.40 * math::sin(Double(i * 10))) + 9571.5}} 0 0 0 0 1
    @bypass /execute in minecraft:theta run particle minecraft:firework {{((-2.40 * math::cos(Double(i * 3))) * math::cos(Double(i * 10 + 180)) - 9060.5)}} {{87.0 - ((Float(i) / 15))}} {{((-2.40 * math::sin(Double(i * 3))) * math::sin(Double(i * 10 + 180))) + 9571.5}} 0 0 0 0 1
    @bypass /execute in minecraft:theta run particle minecraft:firework {{((-2.40 * math::cos(Double(i * 3))) * math::cos(Double(i * 10)) - 9060.5)}} {{87.0 - ((Float(i) / 15))}} {{((-2.40 * math::sin(Double(i * 3))) * math::sin(Double(i * 10))) + 9571.5}} 0 0 0 0 1
    @bypass /playsound minecraft:block.amethyst_block.resonate master {{player}} ~ ~ ~ 0.4 {{(1 - Float(i) / 150.0) * 1.5 + 0.5}}
    @delay 1
@done

@bypass /particle minecraft:firework -9061 77.2 9571 0 0 0 0.6 100
@bypass /particle minecraft:egg_crack -9061 78 9571 2 2 2 1 150
@bypass /playsound minecraft:entity.zombie_villager.cure master {{player}} ~ ~ ~ 1.0 1.0
@console /function execute Harha::finalAnimationWave3()

@bypass /particle minecraft:firework -9061 77.2 9571 0 0 0 0.6 100
@bypass /particle minecraft:egg_crack -9061 78 9571 2 2 2 1 150
@bypass /playsound minecraft:entity.zombie_villager.cure master {{player}} ~ ~ ~ 1.0 1.0
@console /function execute Harha::finalAnimationWave3()

@for Int i in list::range(0, 250)
    @bypass particle minecraft:trial_spawner_detection -9061 77 9571 0.3 0 0.3 00.00 8 
    @bypass particle minecraft:trial_spawner_detection_ominous -9061 77 9571 0.3 0 0.3 00.00 8
    @delay 4

