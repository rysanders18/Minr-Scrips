# JM4s secret reset button
@using Harha
@fast

@cooldown 10s

@define String confirmation
@player &7Type &#D3D6E0"Yes"&7 in chat to confirm teleport.
@prompt 20s confirmation &cYou took too long!
@var confirmation = confirmation.toLowerCase()

@if confirmation == "yes"
    @if (emeraldsFound[player][0] == 0 && emeraldsFound[player][1] == 0 && emeraldsFound[player][2] == 0 && emeraldsFound[player][3] == 0 && emeraldsFound[player][4] == 0 && emeraldsFound[player][5] == 0 && emeraldsFound[player][6] == 0 && emeraldsFound[player][7] == 0 && emeraldsFound[player][8] == 0 && emeraldsFound[player][9] == 0) && (diamondsFound[player][0] == 0 && diamondsFound[player][1] == 0 && diamondsFound[player][2] == 0 && diamondsFound[player][3] == 0 && diamondsFound[player][4] == 0 && diamondsFound[player][5] == 0 && diamondsFound[player][6] == 0 && diamondsFound[player][7] == 0 && diamondsFound[player][8] == 0 && diamondsFound[player][9] == 0)
        @player &cYou have no &a&lEmeralds &cor &b&lDiamonds &cto reset!
        @bypass playsound minecraft:block.note_block.bass master {{player}} ~ ~ ~ 0.75 1.0
        @return
    @fi

    @for Int i in list::range(0, 9)
        @var emeraldsFound[player][i] = 0
    @done
    @for Int i in list::range(0, 9)
        @var diamondsFound[player][i] = 0
    @done
    @player &#d4d4d4● Reset all &b&lDiamonds&#d4d4d4 and &a&lEmeralds!
    @bypass playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 0.75 1.0
@fi

