# handleFalling(Int levelNormal, Player player, Int[] cheatList) https://paste.minr.org/runaloqewe
@using Harha
@fast

@cooldown 1




@if difficultySelection == "normal"
    @var ensureBlockSelection(levelNormal, player)
    @var player.teleport(allPositions[levelNormal])
    @if levelNormal <= 70
        @var sectionFallsNormal[levelNormal] += 1
        @var setLevel(levelNormal, player)
    @fi
    @var resetBlocks(player, 64)
    
    @if sectionFallsNormal[levelNormal] == 100 && numberCompletions <= 1 && ifYoureStuckOnAStage[player] == false
        @var ifYoureStuckOnAStage[player] = true
        @player
        @player &#d4d4d4&lIf you are stuck on a stage...
        @bypass /playsound minecraft:entity.chicken.egg master @s ~ ~ ~ 0.75 0.9
        @delay 30
        @player &#d4d4d4&lClick on a level sign for helpful advice!
        @bypass /playsound minecraft:entity.chicken.egg master @s ~ ~ ~ 0.75 1.1
        @player
    @fi
    
    
    # Anomaly
    @if Int(math::random(1.0D, 100000.0D)) == 69
        @var player.teleport(allPositions[levelNormal + 1])
        @bypass playsound minecraft:entity.enderman.teleport master @s
        @for Int i in list::range(0, 100)
            @bypass playsound minecraft:entity.ender_dragon.death master @s ~ ~ ~ 1 {(Float(i) / 100.0) * 1.5 + 0.5}
        @done
        @player
        @player &#ff76bbTeleported to the next stage...
        @player &6This had a &#ff966e&l1/100,000 chance &#ff8996of happening! &d&lWOW!
        @player &#ff76bbThis has happened &d&l{{globalAnomaly}} &#ff76bbtimes since the map released!
        @player
        @bypass /execute at @s anchored feet run particle minecraft:scrape ~ ~1 ~ 2 1 2 0.5 500 force @a[distance=..30]
        @bypass /execute at @s anchored feet run particle minecraft:wax_on ~ ~1 ~ 2 1 2 0.5 500 force @a[distance=..30]
        @var globalAnomaly += 1
        @var anomaliesExperienced[player] += 1
        @var top100Function(player, 26)
        @var sessionBlocks[player] += 10
        @bypass /mail send RYgamer1 {{player}} ecountered the anomaly at {{totalFalls[player]}} falls on stage {{levelNormal}}. globalAnomaly now = {{globalAnomaly}}
    @fi
    
    # ============================================================================================================
    
@elseif difficultySelection == "master" || player.getCurrentChallenge() == "hahahaha"
    @define Int levelMaster2 = math::floor(Double(levelNormal) / 5) * 5
    @var ensureBlockSelection(levelMaster2, player)
    
    @var player.teleport(allPositions[levelMaster2])
    
    
    @var sectionFallsMaster[levelNormal] += 1
    @var setLevel(levelMaster2, player)
    @var resetBlocks(player, 64)
    
    # ===============================================================================
    
@elseif difficultySelection == "ultraMaster" || player.getCurrentChallenge() == "hahahahaha"
    # if out of lives
    @if ummFalls[player] == 1
        # umm teleport
        @bypass attribute @s minecraft:max_health base set 10
        @bypass effect give @s minecraft:instant_health 1 10 true
        @var ummFalls[player] = 5
        @bypass clear {{player}} *[custom_data~{clear:true}]
        @bypass clear {{player}} leather_boots
        @var bootsObtained[player] = false
        @var blockSelection[player] = blockSelectionStored[player]
        @bypass item replace entity {{player}} container.0 with {{blockSelection[player]}}[custom_name={"italic":false,"text":"‌"},can_place_on=[{blocks:"target"}],enchantments={"minecraft:vanishing_curse":1},tooltip_display={hide_tooltip:false,hidden_components:["enchantments","can_place_on"]},enchantment_glint_override=false,custom_data={clear:true},lore=[[{"bold":true,"color":"#58B4B8","italic":false,"text":"C"},{"color":"#5FBABE","text":"u"},{"color":"#65C1C4","text":"s"},{"color":"#6CC7CA","text":"t"},{"color":"#72CDD0","text":"o"},{"color":"#79D3D6","text":"m "},{"color":"#7FDADC","text":"B"},{"color":"#86E0E1","text":"l"},{"color":"#8CE6E7","text":"o"},{"color":"#93ECED","text":"c"},{"color":"#99F3F3","text":"k"},{"color":"#A6FFFF","text":"s"}],{"bold":false,"color":"gray","italic":false,"text":"You can choose your block selection"},{"bold":false,"color":"gray","italic":false,"text":"at the start of the map! Enjoy!"}," ",{"bold":true,"color":"gray","italic":false,"text":"{{cosmeticsUnlocked[player].sum()}}/12 Cosmetics unlocked."}," "],block_state={bloom:"true"}] 64
        @var player.teleport(Position(-9199.5, 96.0, 9704.5, 180.0, 10.0, "Theta"))
        
        @var sectionFallsUMM[levelNormal] += 1
        @var level[player] = 0
        @bypass /xp set {{player}} 0 points
        @bypass /xp set {{player}} 1 levels
        @bypass /playsound minecraft:block.respawn_anchor.deplete master @s
        @bypass /playsound minecraft:block.note_block.didgeridoo master @s ~ ~ ~ 2 0.5
    @else
        # else remove life and normal tp
        @var ummFalls[player] -= 1
        @bypass attribute @s minecraft:max_health base set {{ummFalls[player] * 2}}
        @if ummFalls[player] > 1
            @bypass title @s actionbar [{"color":"#FF5555","text":"❤ "},{"bold":true,"color":"#FA5050","text":"L"},{"bold":true,"color":"#F64C4C","text":"i"},{"bold":true,"color":"#F14747","text":"v"},{"bold":true,"color":"#EC4242","text":"e"},{"bold":true,"color":"#E73D3D","text":"s "},{"bold":true,"color":"#E33939","text":"R"},{"bold":true,"color":"#DE3434","text":"e"},{"bold":true,"color":"#D92F2F","text":"m"},{"bold":true,"color":"#D52B2B","text":"a"},{"bold":true,"color":"#D02626","text":"i"},{"bold":true,"color":"#CB2121","text":"n"},{"bold":true,"color":"#C61C1C","text":"i"},{"bold":true,"color":"#C21818","text":"n"},{"bold":true,"color":"#BD1313","text":"g"},{"bold":true,"color":"#B80E0E","text":": "},{"bold":true,"color":"#B30909","text":"{{ummFalls[player]}} "},{"color":"#AA0000","text":"❤"}]
        @else
            @bypass title @s actionbar [{"color":"#FF5555","text":"❤ "},{"bold":true,"color":"#F84E4E","text":"F"},{"bold":true,"color":"#F14747","text":"i"},{"bold":true,"color":"#EA4040","text":"n"},{"bold":true,"color":"#E33939","text":"a"},{"bold":true,"color":"#DC3232","text":"l "},{"bold":true,"color":"#D52B2B","text":"L"},{"bold":true,"color":"#CD2323","text":"i"},{"bold":true,"color":"#C61C1C","text":"f"},{"bold":true,"color":"#BF1515","text":"e"},{"bold":true,"color":"#B80E0E","text":"! "},{"color":"#AA0000","text":"❤"}]
        @fi
        @var resetBlocks(player, 64)
        @var player.teleport(allPositions[levelNormal])
        
        @var sectionFallsUMM[level] += 1
        @var setLevel(levelNormal, player)
        @bypass /playsound minecraft:block.note_block.didgeridoo master @s ~ ~ ~ 1 {{(ummFalls[player] * 0.135) + 0.46}}
    @fi
    
    # =============================================================================================================
    
@elseif difficultySelection == "soulLink" || player.getCurrentChallenge() == "hahahas" || difficultySelection == "masterSoulLink" || player.getCurrentChallenge() == "hahahahas"
    @define String playerFallen = player.getName()
    @define Int lowestLevel = 10000
    @define Boolean allOnline = true
    
    @for Player partner in partners[player]
        @if partner.isOnline() == false
            @player &{{colorList2[partners[partner].find(player)]}}&l{{partner}} &cis not online!
            @var allOnline = false
        @fi
        
        # Get players in the map
        @define Player[] playersInMap = Region("hh", "Theta").getPlayersInside()
        @define Player[] playersInMap2 = Player[]
        @if Region("hh2", "Theta_the_end").getPlayersInside().length() != 0
            @var playersInMap2 = Region("hh2", "Theta_the_end").getPlayersInside()
        @fi
        
        # Handle if a partner has left the map
        @if playersInMap.contains(partner) == false && playersInMap2.contains(partner) == false && partner.isOnline() == true
            @player &{{colorList2[partners[partner].find(player)]}}&l{{partner}} &chas left the challenge!
            # Teleport each player still in the map to the start, then return
            @for Player partnerTemp in partners[player]
                @if !(playersInMap.contains(partnerTemp) == false && playersInMap2.contains(partnerTemp) == false) && partnerTemp.isOnline() == true
                    @var partnerTemp.teleport(Position(-9199.5, 92.0, 9742.5, -180.0, 20.0, "Theta"))
                    @var setLevel(0, partnerTemp)
                    @var stage[partnerTemp] = 0
                    @var ensureBlockSelection(0, partnerTemp)
                    @var bootsObtained = false
                    @bypass clear {{partnerTemp}}
                    @bypass /playsound minecraft:block.respawn_anchor.deplete master {{partnerTemp}}
                    @bypass /playsound minecraft:block.note_block.didgeridoo master {{partnerTemp}} ~ ~ ~ 2 0.5
                @fi
                @var partners[partnerTemp] = Player[]
            @done
            @return
        @fi
    @done
    
    
    
    # 2-5, 7-01, 7-4
    # @for Player partner in partners[player]
    # @if allPositions[levelNormal].getYaw() == 180.0
    #     @player {{partner}} Position
    #     @player {{Position((allPositions[levelNormal].getX() - 1) + ((Float(partners[player].find(partner))) / (Float(partners[player].length()) - 1 ) * 2), allPositions[levelNormal].getY(), allPositions[levelNormal].getZ(), allPositions[levelNormal].getYaw(), allPositions[levelNormal].getPitch(), allPositions[levelNormal].getWorld())}}
    #     @player Float(partners[player].find(partner)) = {{Float(partners[player].find(partner))}}
    #     @player Float(partners[player].length()) - 1 = {{Float(partners[player].length()) - 1}}
    #     @player ((Float(partners[player].find(partner))) / (Float(partners[player].length()) - 1 ) * 2) = {{((Float(partners[player].find(partner))) / (Float(partners[player].length()) - 1 )* 2)}}
    # @fi
    # @done
    
    
    # @if allOnline == false
    #     # ...
    # @else
    
    @if difficultySelection == "soulLink" || player.getCurrentChallenge() == "hahahas"
        @for Player partner in partners[player]
            @if level[partner] < lowestLevel
                @var lowestLevel = level[partner]
            @fi
        @done
    @else
        @for Player partner in partners[player]
            @if level[partner] < lowestLevel
                @var lowestLevel = level[partner]
                @var lowestLevel = math::floor(Double(lowestLevel) / 5) * 5
            @fi
        @done
    @fi
    
    # @player DEBUG: levelNormal = {{levelNormal}}, lowestLevel among partners = {{lowestLevel}}
    # if the player is at the lowest level, tp everyone
    @if levelNormal <= lowestLevel || ((difficultySelection == "masterSoulLink" || player.getCurrentChallenge() == "hahahahas"))
        @if player.getCurrentChallenge() == "hahahahas" || difficultySelection == "masterSoulLink"
            @var lowestLevel = math::floor(Double(lowestLevel) / 5) * 5
        @else
            @var lowestLevel = levelNormal
        @fi
        
        # TODO: CLEAR BOOTS
        
        # @player DEBUG: Player at lowest level - teleporting all partners
        @for Player partner in partners[player]
            
            # If player is in the map
            @define Player[] playersInMap = Region("hh", "Theta").getPlayersInside()
            @define Player[] playersInMap2 = Player[]
            @if Region("hh2", "Theta_the_end").getPlayersInside().length() != 0
                @var playersInMap2 = Region("hh2", "Theta_the_end").getPlayersInside()
            @fi
            @if playersInMap.contains(partner) == true || playersInMap2.contains(partner) == true
                # @player DEBUG: Teleporting partner {{partner}} to lowest level
                
                # Bulk of script below ====================
                @if sessionFalls[partner] == 0
                    @bypass /title {{partner}} actionbar [{"bold":true,"color":"{{colorList2[partners[partner].find(player)]}}","text":"{{player}} "}, {"bold":false,"color":"#FF5555","text":"has fallen {{sessionFalls[player] + 1}} time!"}]
                @else
                    @bypass /title {{partner}} actionbar [{"bold":true,"color":"{{colorList2[partners[partner].find(player)]}}","text":"{{player}} "}, {"bold":false,"color":"#FF5555","text":"has fallen {{sessionFalls[player] + 1}} times!"}]
                @fi
                
                # Teleport all players in an evenly spaced line
                # @if
                # @player DEBUG: Positioning partner based on yaw {{allPositions[lowestLevel].getYaw()}}
                @if allPositions[lowestLevel].getYaw() == 180.0
                    @if lowestLevel == 14 || lowestLevel == 60 || lowestLevel == 63
                        @if partner.getZ() < allPositions[lowestLevel].getZ() || (math::abs(partner.getX() - allPositions[lowestLevel].getX()) > 5.0 || math::abs(partner.getY() - allPositions[lowestLevel].getY()) > 4.5 || math::abs(partner.getZ() - allPositions[lowestLevel].getZ()) > 5.0)
                            @var partner.teleport(Position((allPositions[lowestLevel].getX() - 0.7) + ((Float(partners[player].find(partner))) / (Float(partners[player].length()) - 1 ) * 1.4), allPositions[lowestLevel].getY(), allPositions[lowestLevel].getZ(), allPositions[lowestLevel].getYaw(), allPositions[lowestLevel].getPitch(), allPositions[lowestLevel].getWorld()))
                        @fi
                    @else
                        # @player DEBUG: {{partner}} {{math::abs(partner.getX() - allPositions[lowestLevel].getX())}} , {{math::abs(partner.getZ() - allPositions[lowestLevel].getZ())}} {{(math::abs(partner.getX() - allPositions[lowestLevel].getX()) > 5.0 || math::abs(partner.getY() - allPositions[lowestLevel].getY()) > 4.5 || math::abs(partner.getZ() - allPositions[lowestLevel].getZ()) > 5.0)}}
                        @if partner.getZ() < allPositions[lowestLevel].getZ() || (math::abs(partner.getX() - allPositions[lowestLevel].getX()) > 5.0 || math::abs(partner.getY() - allPositions[lowestLevel].getY()) > 4.5 || math::abs(partner.getZ() - allPositions[lowestLevel].getZ()) > 5.0)
                            @var partner.teleport(Position((allPositions[lowestLevel].getX() - 1) + ((Float(partners[player].find(partner))) / (Float(partners[player].length()) - 1 ) * 2), allPositions[lowestLevel].getY(), allPositions[lowestLevel].getZ(), allPositions[lowestLevel].getYaw(), allPositions[lowestLevel].getPitch(), allPositions[lowestLevel].getWorld()))
                        @fi
                    @fi
                @elseif allPositions[lowestLevel].getYaw() == 0.0
                    @if lowestLevel == 14 || lowestLevel == 60 || lowestLevel == 63
                        @if partner.getZ() > allPositions[lowestLevel].getZ() || (math::abs(partner.getX() - allPositions[lowestLevel].getX()) > 5.0 || math::abs(partner.getY() - allPositions[lowestLevel].getY()) > 4.5 || math::abs(partner.getZ() - allPositions[lowestLevel].getZ()) > 5.0)
                            @var partner.teleport(Position((allPositions[lowestLevel].getX() - 0.7) + ((Float(partners[player].find(partner))) / (Float(partners[player].length()) - 1 ) * 1.4), allPositions[lowestLevel].getY(), allPositions[lowestLevel].getZ(), allPositions[lowestLevel].getYaw(), allPositions[lowestLevel].getPitch(), allPositions[lowestLevel].getWorld()))
                        @fi
                    @else
                        # @player DEBUG: {{partner}} {{math::abs(partner.getX() - allPositions[lowestLevel].getX())}} , {{math::abs(partner.getZ() - allPositions[lowestLevel].getZ())}} {{(math::abs(partner.getX() - allPositions[lowestLevel].getX()) > 5.0 || math::abs(partner.getY() - allPositions[lowestLevel].getY()) > 4.5 || math::abs(partner.getZ() - allPositions[lowestLevel].getZ()) > 5.0)}}
                        @if partner.getZ() > allPositions[lowestLevel].getZ() || (math::abs(partner.getX() - allPositions[lowestLevel].getX()) > 5.0 || math::abs(partner.getY() - allPositions[lowestLevel].getY()) > 4.5 || math::abs(partner.getZ() - allPositions[lowestLevel].getZ()) > 5.0)
                            @var partner.teleport(Position((allPositions[lowestLevel].getX() - 1) + ((Float(partners[player].find(partner))) / (Float(partners[player].length()) - 1 ) * 2), allPositions[lowestLevel].getY(), allPositions[lowestLevel].getZ(), allPositions[lowestLevel].getYaw(), allPositions[lowestLevel].getPitch(), allPositions[lowestLevel].getWorld()))
                        @fi
                    @fi
                @elseif allPositions[lowestLevel].getYaw() == 90.0
                    @if lowestLevel == 14 || lowestLevel == 60 || lowestLevel == 63
                        @if partner.getX() < allPositions[lowestLevel].getX() || (math::abs(partner.getX() - allPositions[lowestLevel].getX()) > 5.0 || math::abs(partner.getY() - allPositions[lowestLevel].getY()) > 4.5 || math::abs(partner.getZ() - allPositions[lowestLevel].getZ()) > 5.0)
                            @var partner.teleport(Position(allPositions[lowestLevel].getX(), allPositions[lowestLevel].getY(), (allPositions[lowestLevel].getZ() - 0.7) + ((Float(partners[player].find(partner))) / (Float(partners[player].length()) - 1 ) * 1.4), allPositions[lowestLevel].getYaw(), allPositions[lowestLevel].getPitch(), allPositions[lowestLevel].getWorld()))
                        @fi
                    @else
                        # @player DEBUG: {{partner}} {{math::abs(partner.getX() - allPositions[lowestLevel].getX())}} , {{math::abs(partner.getZ() - allPositions[lowestLevel].getZ())}} {{(math::abs(partner.getX() - allPositions[lowestLevel].getX()) > 5.0 || math::abs(partner.getY() - allPositions[lowestLevel].getY()) > 4.5 || math::abs(partner.getZ() - allPositions[lowestLevel].getZ()) > 5.0)}}
                        @if partner.getX() < allPositions[lowestLevel].getX() || (math::abs(partner.getX() - allPositions[lowestLevel].getX()) > 5.0 || math::abs(partner.getY() - allPositions[lowestLevel].getY()) > 4.5 || math::abs(partner.getZ() - allPositions[lowestLevel].getZ()) > 5.0)
                            @var partner.teleport(Position(allPositions[lowestLevel].getX(), allPositions[lowestLevel].getY(), (allPositions[lowestLevel].getZ() - 1) + ((Float(partners[player].find(partner))) / (Float(partners[player].length()) - 1 ) * 2), allPositions[lowestLevel].getYaw(), allPositions[lowestLevel].getPitch(), allPositions[lowestLevel].getWorld()))
                        @fi
                    @fi
                @else
                    @if lowestLevel == 14 || lowestLevel == 60 || lowestLevel == 63
                        @if partner.getX() > allPositions[lowestLevel].getX() || (math::abs(partner.getX() - allPositions[lowestLevel].getX()) > 5.0 || math::abs(partner.getY() - allPositions[lowestLevel].getY()) > 4.5 || math::abs(partner.getZ() - allPositions[lowestLevel].getZ()) > 5.0)
                            @var partner.teleport(Position(allPositions[lowestLevel].getX(), allPositions[lowestLevel].getY(), (allPositions[lowestLevel].getZ() - 0.7) + ((Float(partners[player].find(partner))) / (Float(partners[player].length()) - 1 ) * 1.4), allPositions[lowestLevel].getYaw(), allPositions[lowestLevel].getPitch(), allPositions[lowestLevel].getWorld()))
                        @fi
                    @else
                        # @player DEBUG: {{partner}} {{math::abs(partner.getX() - allPositions[lowestLevel].getX())}} , {{math::abs(partner.getZ() - allPositions[lowestLevel].getZ())}} {{(math::abs(partner.getX() - allPositions[lowestLevel].getX()) > 5.0 || math::abs(partner.getY() - allPositions[lowestLevel].getY()) > 4.5 || math::abs(partner.getZ() - allPositions[lowestLevel].getZ()) > 5.0)}}
                        @if partner.getX() > allPositions[lowestLevel].getX() || (math::abs(partner.getX() - allPositions[lowestLevel].getX()) > 5.0 || math::abs(partner.getY() - allPositions[lowestLevel].getY()) > 4.5 || math::abs(partner.getZ() - allPositions[lowestLevel].getZ()) > 5.0)
                            @var partner.teleport(Position(allPositions[lowestLevel].getX(), allPositions[lowestLevel].getY(), (allPositions[lowestLevel].getZ() - 1) + ((Float(partners[player].find(partner))) / (Float(partners[player].length()) - 1 ) * 2), allPositions[lowestLevel].getYaw(), allPositions[lowestLevel].getPitch(), allPositions[lowestLevel].getWorld()))
                        @fi
                    @fi
                @fi
                
                # Plays different note block pitch based on the person, if >= 10 split it evenly
                @if partners[player].length() < 10
                    @bypass /playsound minecraft:block.note_block.didgeridoo record {{partner}} ~ ~ ~ 0.5 {{musicNotes[partners[partner].find(player) * 3]}}
                @else
                    @bypass /playsound minecraft:block.note_block.didgeridoo record {{partner}} ~ ~ ~ 0.5 {{(Float(partners[partner].find(player)) / Float(partners[partner].length() - 1)) * 1.5 + 0.5}}
                @fi
                @var ensureBlockSelection(lowestLevel, partner)
                
                @if lowestLevel <= 70
                    @if difficultySelection == "soulLink" || player.getCurrentChallenge() == "hahahas"
                        @var sectionFallsSoulLink[levelNormal] += 1
                    @else
                        @var sectionFallsMasterSoulLink[levelNormal] += 1
                    @fi
                    @var setLevel(lowestLevel, partner)
                @fi
                @var resetBlocks(partner, 64)
            @fi
        @done
        
        # if the player is ahead, only tp them
    @else
        # @player DEBUG: Player ahead of lowest level - teleporting only this player
        @var ensureBlockSelection(lowestLevel, player)
        @var player.teleport(allPositions[lowestLevel])
        @if lowestLevel <= 70
            @if difficultySelection == "soulLink" || player.getCurrentChallenge() == "hahahas"
                @var sectionFallsSoulLink[levelNormal] += 1
            @else
                @var sectionFallsMasterSoulLink[levelNormal] += 1
            @fi
            @var setLevel(lowestLevel, player)
        @fi
        @bypass /playsound minecraft:block.note_block.didgeridoo record {{player}} {{allPositions[lowestLevel].getX()}} {{allPositions[lowestLevel].getY()}} {{allPositions[lowestLevel].getZ()}} 0.5 {{musicNotes[partners[player].find(player) * 3]}}
        
        @var resetBlocks(player, 64)
    @fi
    # @fi
@fi

@var hatFunction(player)
@var sessionFalls[player] += 1
@var globalFalls += 1
@var numberOfBlocksToGive[player] = 63
@var blocksThisStage[player] = 0
@var blocksThisStageGlobal[levelNormal] = 0
@bypass effect clear {{player}}
@var totalFalls[player] += 1

# Update leaderboards every once and a while or if below 100
@if totalFalls[player] <= 100 || sessionFalls[player] % Int(math::random(5.0D, 8.0D)) == 0
    @var top100Function(player, 1)
@fi

# Nether star
@if difficultySelection[player] != "soulLink" && difficultySelection[player] != "masterSoulLink" && player.getCurrentChallenge() != "hahahas" && player.getCurrentChallenge() != "hahahahas"
    @var fallTracker(player)
@fi

@if player.getCurrentChallenge() == "hahahas" || player.getCurrentChallenge() == "hahahahas" || difficultySelection[player] == "soulLink" || difficultySelection[player] == "masterSoulLink"
    @for Player partner in partners[player]
        @var fallTracker(partner)
    @done
@fi

# anticheat
@if levelNormal <= 60
    @for Int i in list::range(0, cheatList.length())
        @var anticheat(cheatList[i], player)
    @done
@else
    @for Int i in list::range(0, cheatList.length())
        @var anticheatEnd(cheatList[i], player)
    @done
@fi


# Handles Fail Milestones
# @if failMilestones.contains(totalFalls)
#     @player &#d4d4d4&lYou have fallen a total of &6&l{{formatNumber(String(totalFalls))}} &#d4d4d4&ltimes!
#     @bypass /playsound minecraft:entity.chicken.egg master @s
#     @if totalFalls == 10000
#         @delay 5
#         @var cosmeticsUnlocked[player][6] = 1
#         @player &#d4d4d4----------------------------
#         @player &6&lCosmetic Unlocked!
#         @player &#8591FF&lS&#8E99F8&lc&#98A2F0&lu&#A1AAE9&ll&#ABB3E1&lk &#B4BBDA&lC&#BDC4D2&la&#C7CCCB&lt&#D0D5C3&la&#D9DDBC&ll&#E3E6B4&ly&#ECEEAD&ls&#FFFF9E&lt
#         @player &#d4d4d4----------------------------
