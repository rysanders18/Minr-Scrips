# Boots Chest Script
@fast
@using Harha
@cooldown 20s

@if bootsObtained[player] == false
    @var bootsObtained[player] = true
    @bypass /playsound minecraft:block.chest.open master @s ~ ~ ~ 0.5 1.3
    @bypass /playsound minecraft:block.chest.open master @s ~ ~ ~ 0.5 1.3
    @bypass /playsound minecraft:entity.chicken.egg master @s ~ ~ ~ 0.5 1.3
    @player
    @player &#CCDFEDI found some &#2D66ED&lLeather Boots! &r&#CCDFEDNow I can cross that &#85ABED&lSnowy Gap!
    @player
    @var bootsFunction(player)
    @delay 38
    @bypass /playsound minecraft:entity.chicken.egg master @s ~ ~ ~ 1 1.3
    @player &#CCDFEDI just need to &#ED8142&lfind a way back out of this mansion...
    @player
@else
    @player
    @player &#CCDFEDYou already have some &#2D66ED&lLeather Boots! &r&#CCDFEDNo need to grab another pair.
    @player
    @bypass /playsound minecraft:block.chest.close master @s ~ ~ ~ 0.5 1.3
    @bypass /playsound minecraft:block.note_block.didgeridoo master @s ~ ~ ~ 0.5 0.5
@fi