@define Block buttonBlock = Block(block.getX() + 1, block.getY(), block.getZ(), block.getWorld())
@var player.teleport(guessPositionList[guessBlockList.find(buttonBlock.getBlockType().toLowerCase())])
@delay 1
@bypass playsound minecraft:{{guessSoundList[guessBlockList.find(buttonBlock.getBlockType().toLowerCase())]}} master {{player}}

