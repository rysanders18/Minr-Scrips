    @bypass item replace entity @s armor.head with leather_helmet[custom_name=[{"bold":true,"color":"#47D4D4","italic":false,"shadow_color":-14534341,"text":"H"},{"color":"#50D8D9","shadow_color":-14534341,"text":"a"},{"color":"#58DCDE","shadow_color":-14534341,"text":"r"},{"color":"#61E0E2","shadow_color":-14534341,"text":"d"},{"color":"#69E4E7","shadow_color":-14534341,"text":"e"},{"color":"#72E8EC","shadow_color":-14534341,"text":"r "},{"color":"#7AECF1","shadow_color":-14534341,"text":"H"},{"color":"#83F0F5","shadow_color":-14534341,"text":"a"},{"color":"#94F8FF","shadow_color":-14534341,"text":"t"}],enchantment_glint_override=false,enchantments={"minecraft:respiration":3,"minecraft:binding_curse":1,"minecraft:vanishing_curse":1},tooltip_display={hidden_components:["enchantments","attribute_modifiers"]},attribute_modifiers=[{id:"armor",type:"armor",amount:{{numberCompletions[player] + 1}},operation:"add_value"}],lore=[{"color":"gray","italic":false,"text":"Unbreaking {{numberCompletions[player]}}"}," ",[{"color":"gray","text":"Each "},{"bold":false,"text":"map completion "},"will upgrade the"],[{"color":"gray","text":"hardness "},"of this hat! Good luck!"]]] 1
