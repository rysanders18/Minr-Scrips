    @bypass /title {{player}} title ["",{"text":"H","bold":true,"color":"#2DD2D2"},{"text":"a","bold":true,"color":"#2DD2D2"},{"text":"r","bold":true,"color":"#2DD2D2"},{"text":"d","bold":true,"color":"#2DD2D2"},{"text":"e","bold":true,"color":"#2DD2D2"},{"text":"r","bold":true,"color":"#2DD2D2"},{"text":" ","bold":true,"color":"#2DD2D2"},{"text":"H","bold":true,"color":"#2DD2D2"},{"text":"a","bold":true,"color":"#2DD2D2"},{"text":"t","bold":true,"color":"#24db86"},{"text":"s","bold":true,"color":"#6aed12"}]
    @delay 0
    @bypass /title {{player}} title ["",{"text":"H","bold":true,"color":"#2DD2D2"},{"text":"a","bold":true,"color":"#2DD2D2"},{"text":"r","bold":true,"color":"#2DD2D2"},{"text":"d","bold":true,"color":"#2DD2D2"},{"text":"e","bold":true,"color":"#2DD2D2"},{"text":"r","bold":true,"color":"#2DD2D2"},{"text":" ","bold":true,"color":"#2DD2D2"},{"text":"H","bold":true,"color":"#2DD2D2"},{"text":"a","bold":true,"color":"#2DD2D2"},{"text":"t","bold":true,"color":"#2DD2D2"},{"text":"s","bold":true,"color":"#24db86"}]
    @delay 1
    @bypass /title {{player}} times 0 40 20
    @bypass /title {{player}} title ["",{"text":"Harder Hats","bold":true,"color":"#2DD2D2"}]

@fi


