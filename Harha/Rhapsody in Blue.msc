@for Int i in list::range(0, 1000)
    @if volume10[i] == 0.0F
        @var Harha::delay(instrument10[i])
    @else
        @if panning10[i] == 0.0D
            @bypass /execute as {{player}} at @s run playsound block.note_block.{{instrumentNames[instrument10[i]]}} master @p ~ ~ ~ {{volume10[i]}} {{pitch10[i]}}
        @else
            @bypass /execute as {{player}} at @s run playsound block.note_block.{{instrumentNames[instrument10[i]]}} master @p ~{{ panning10[i] * math::cos(Double(player.getYaw() + 180)) }} ~ ~{{ panning10[i] * math::sin(Double(player.getYaw() + 180)) }} {{volume10[i]}} {{pitch10[i]}}
        @fi
    @fi
@done

