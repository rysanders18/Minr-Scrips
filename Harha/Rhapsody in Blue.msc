@for Int i in list::range(0, 1000)
    @if volume15[i] == 0.0F
        @var Harha::delay(instrument15[i])
    @else
        @if panning15[i] == 0.0D
            @bypass /execute as {{player}} at @s run playsound block.note_block.{{instrumentNames[instrument15[i]]}} master @p ~ ~ ~ {{volume15[i]}} {{pitch15[i]}}
        @else
            @bypass /execute as {{player}} at @s run playsound block.note_block.{{instrumentNames[instrument15[i]]}} master @p ~{{ panning15[i] * math::cos(Double(player.getYaw() + 180)) }} ~ ~{{ panning15[i] * math::sin(Double(player.getYaw() + 180)) }} {{volume15[i]}} {{pitch15[i]}}
        @fi
    @fi
@done

