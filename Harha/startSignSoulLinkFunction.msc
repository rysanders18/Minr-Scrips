# startSignSoulLinkFunction(Player player, Player[] partnersREAL)

@fast
@using Harha
@bypass /gamemode adventure {{player}}



# basic variables
@var blockSelection[player] = blockSelectionStored[player]
@var bootsObtained[player] = false
@var sessionFalls[player] = 0
@var sessionBlocks[player] = 0
@var stage[player] = 0
@var level[player] = 0
@var iceSwapped[player] = false
@var slimeSwapped[player] = false
@var trapdoorSwapped[player] = false
@var targetSwapped[player] = false
@var ummFalls[player] = 5
@var hasTeleported[player] = false


@define String username = player.getName()
@define String uuid = player.getUniqueId()
@define Boolean isUsernameListed = false

# Defines Partners
@var partners[player] = partnersREAL

# @player DEBUG: Partners = {{partners[player]}}


# handles difficulty selection
@if player.getCurrentChallenge() == "hahahaha"
    @var difficultySelection[player] = "master"
@elseif player.getCurrentChallenge() == "hahahahaha"
    @var difficultySelection[player] = "ultraMaster"
@elseif player.getCurrentChallenge() == "hahahas"
    @var difficultySelection[player] = "soulLink"
@elseif player.getCurrentChallenge() == "hahahahas"
    @var difficultySelection[player] = "harderSoulLink"
@fi

@bypass /xp set {{player}} 0 points
@bypass /xp set {{player}} 1 levels

@var player.teleport(Position(-9199.5, 92.0, 9733.5, -180.0, -10.0, "Theta"))

@var ensureBlockSelection(1, player)
@var resetBlocks(player, 64)

# hat stuff
@var hatFunction(player)

# only runs once due to codeGenerated
@if codeGenerated[player] == false
    @var codeGenerated[player] = true
    @var code = String[]
    @for Int i in list::range(0,13)
        @var randomCodeNumber = (math::randomInt() % 62)
        @if randomCodeNumber < 0
            @var randomCodeNumber += 62
        @fi
        @var code.append(codeList[randomCodeNumber])
    @done

    @var totalCode[player] = (code[0] + code[1] + code[2] + code[3] + code[4] + code[5] + code[6] + code[7] + code[8] + code[9] + code[10] + code[11] + code[12])
@fi


# Fancy Titles
@if player.getCurrentChallenge() == "hahahas" || difficultySelection[player] == "soulLink"

    @bypass /title {{player}} times 0 100 40
    @bypass /title {{player}} subtitle ["",{"text":"Soul Link! ","bold":true,"color":"aqua"},{"text":"({{partners[player].length()}} Players)","bold":true,"color":"aqua"}]
    @bypass /title {{player}} times 0 60 20
    @bypass /title {{player}} title ["",{"text":"H","bold":true,"color":"white"},{"text":"a","bold":true,"color":"#2DD2D2"},{"text":"r","bold":true,"color":"#2DD2D2"},{"text":"d","bold":true,"color":"#2DD2D2"},{"text":"e","bold":true,"color":"#2DD2D2"},{"text":"r","bold":true,"color":"#2DD2D2"},{"text":" ","bold":true,"color":"#2DD2D2"},{"text":"H","bold":true,"color":"#2DD2D2"},{"text":"a","bold":true,"color":"#2DD2D2"},{"text":"t","bold":true,"color":"#2DD2D2"},{"text":"s","bold":true,"color":"#2DD2D2"}]
