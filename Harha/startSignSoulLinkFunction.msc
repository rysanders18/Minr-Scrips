# startSignSoulLinkFunction(Player player, Player[] partnersREAL)

@fast
@using Harha
@bypass /gamemode adventure {{player}}



# basic variables
@var blockSelection[player] = blockSelectionStored[player]
@var bootsObtained[player] = false
@var sessionFalls[player] = 0
@var sessionBlocks[player] = 0
@var stage[player] = 0
@var level[player] = 0
@var iceSwapped[player] = false
@var slimeSwapped[player] = false
@var trapdoorSwapped[player] = false
@var targetSwapped[player] = false
@var ummFalls[player] = 5
@var hasTeleported[player] = false


@define String username = player.getName()
@define String uuid = player.getUniqueId()
@define Boolean isUsernameListed = false

# Defines Partners
@var partners[player] = partnersREAL

# @player DEBUG: Partners = {{partners[player]}}


# handles difficulty selection
@if player.getCurrentChallenge() == "hahahaha"
    @var difficultySelection[player] = "master"
@elseif player.getCurrentChallenge() == "hahahahaha"
    @var difficultySelection[player] = "ultraMaster"
@elseif player.getCurrentChallenge() == "hahahas"
    @var difficultySelection[player] = "soulLink"
@elseif player.getCurrentChallenge() == "hahahahas"
    @var difficultySelection[player] = "harderSoulLink"
@fi

@bypass /xp set {{player}} 0 points
@bypass /xp set {{player}} 1 levels

@var player.teleport(Position(-9199.5, 92.0, 9733.5, -180.0, -10.0, "Theta"))

@var ensureBlockSelection(1, player)
@var resetBlocks(player, 64)

# hat stuff
@if numberCompletions == 0
    @bypass item replace entity {{player}} armor.head with leather_helmet[custom_name=[{"bold":true,"color":"#47D4D4","italic":false,"shadow_color":-14534341,"text":"H"},{"color":"#50D8D9","shadow_color":-14534341,"text":"a"},{"color":"#58DCDE","shadow_color":-14534341,"text":"r"},{"color":"#61E0E2","shadow_color":-14534341,"text":"d"},{"color":"#69E4E7","shadow_color":-14534341,"text":"e"},{"color":"#72E8EC","shadow_color":-14534341,"text":"r "},{"color":"#7AECF1","shadow_color":-14534341,"text":"H"},{"color":"#83F0F5","shadow_color":-14534341,"text":"a"},{"color":"#94F8FF","shadow_color":-14534341,"text":"t"}],enchantment_glint_override=false,enchantments={"minecraft:respiration":3,"minecraft:binding_curse":1,"minecraft:vanishing_curse":1},tooltip_display={hidden_components:["enchantments","attribute_modifiers"]},attribute_modifiers=[{id:"armor",type:"armor",amount:{{numberCompletions[player] + 1}},operation:"add_value"}],lore=[{"color":"gray","italic":false,"text":"Unbreaking {{numberCompletions[player]}}"}," ",[{"color":"gray","text":"Each "},{"bold":false,"text":"map completion "},"will upgrade the"],[{"color":"gray","text":"hardness "},"of this hat! Good luck!"]]] 1
@elseif numberCompletions == 1
