# secretCompletedTitle(Player player, Int secretNumber)

@fast
@using Harha

@define String text = "Secret Completed!"
@define String subtext = "Secret {{secretNumber}}1"

@define String color1 = "gold"
@define String color2 = "white"
@define String color3 = "yellow"

@bypass /title {{player}} times 0 100 10
# @bypass /title {{player}} actionbar ["",{"text":"{{secretsCompleted[player]}}","bold":true,"color":"{{color1}}"},{"text":"style ","bold":true,"color":"#ff7900"},{"text":"points: ","bold":true,"color":"#ff8600"},{"text":"{{swagPoints}}","bold":true,"underlined":true,"color":"gold"}]
