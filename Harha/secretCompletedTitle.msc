@bypass /execute at {{player}} run particle minecraft:totem_of_undying ~ ~1 ~ 0.3 0.3 0.3 0.3 100 normal
@bypass execute at {{player}} run particle minecraft:trial_spawner_detection ~ ~ ~ 0.5 0 0.5 00.01 5 normal
@bypass execute at {{player}} run particle minecraft:trial_spawner_detection_ominous ~ ~ ~ 0.5 0 0.5 00.01 5 normal
@bypass /title {{player}} actionbar ["",{"text":"{{secretsCompletedList[player].sum()}} / 25","bold":true,"color":"{{color3}}"},{"text":" Completed!","bold":true,"color":"{{color1}}"}]


@delay 1
@bypass /title {{player}} title ["",{"text":"                    {{text}}                    ","bold":true,"color":"{{color3}}"}]
