@bypass execute at {{player}} run particle minecraft:trial_spawner_detection ~ ~ ~ 0.5 0 0.5 00.01 5 normal
@bypass execute at {{player}} run particle minecraft:trial_spawner_detection_ominous ~ ~ ~ 0.5 0 0.5 00.01 5 normal
@delay 1

@define String titleString = ""

# Text flash code
@for Int i in list::range(0, text.length())
    @if i % 2 == 0
        # @player DEBUG: {{text.substring(0, i)}} {{text.substring(i, i+1)}} {{text.substring(i+1, i + 2 - ((i + 2) / text.length()))}} {{text.substring(i + 2 - ((i + 2) / text.length()), text.length())}}
        @bypass /title {{player}} title ["",{"text":"{{text.substring(0, i)}}","bold":true,"color":"{{color1}}"},{"text":"{{text.substring(i, i+1)}}","bold":true,"color":"{{color3}}"},{"text":"{{text.substring(i+1, i + 2 - ((i + 2) / text.length()))}}","bold":true,"color":"{{color2}}"},{"text":"{{text.substring(i + 2 - ((i + 2) / text.length()), text.length())}}","bold":true,"color":"{{color1}}"}]
        @if i <= subtext.length()
            @bypass /title {{player}} subtitle ["",{"text":"{{subtext.substring(0, i)}}","bold":true,"color":"{{color1}}"},{"text":"{{subtext.substring(i, i+1 - ((i + 1) / subtext.length()))}}","bold":true,"color":"{{color3}}"},{"text":"{{subtext.substring(i+1, i + 2 - ((i + 2) / subtext.length()))}}","bold":true,"color":"{{color2}}"},{"text":"{{subtext.substring(i + 2 - ((i + 2) / subtext.length()), subtext.length())}}","bold":true,"color":"{{color1}}"}]
        @fi
        @player DEBUG: {{subtext.substring(0, i)}} {{subtext.substring(i, i+1 - ((i + 1) / subtext.length()))}} {{subtext.substring(i+1, i + 2 - ((i + 2) / subtext.length()))}} {{subtext.substring(i + 2 - ((i + 2) / subtext.length()), subtext.length())}}
        @bypass execute at {{player}} run particle minecraft:trial_spawner_detection ~ ~ ~ 0.5 0 0.5 00.01 5 normal
        @bypass execute at {{player}} run particle minecraft:trial_spawner_detection_ominous ~ ~ ~ 0.5 0 0.5 00.01 5 normal
        @delay 3
    @fi
@done


