# Donna Blavo the Bee Script
@cooldown 30s

@fast
@using Harha

@if donnaDone
    
    @bypass /playsound minecraft:block.note_block.pling master @s ~ ~ ~ 1 1
    
    @player &#d4d4d4--------------------------------------
    @player &#ffeb35&lH&#FFDB14&lo&#FFDF28&ln&#FFE33C&le&#FFE750&ly &#FFEB64&lB&#FFEF78&ll&#FFF38C&lo&#FFF7A0&lc&#FFFBB4&lk&#FFFFC8&ls
    @player
    @player &#d4d4d4● Good luck beating the map with Honey Blocks!
    @player
    @player &#d4d4d4● Unlocked through sheer mathematical genius.
    @player
    @player &6Block selected!
    @player &#d4d4d4--------------------------------------
    
    @bypass /item replace entity @s armor.chest with golden_chestplate[trim={material:"minecraft:resin",pattern:"minecraft:silence"},custom_name=[{"bold":true,"color":"#FFAD08","italic":true,"text":"D"},{"color":"#FFB108","text":"o"},{"color":"#FEB407","text":"n"},{"color":"#FEB807","text":"n"},{"color":"#FEBC07","text":"a "},{"color":"#FDC006","text":"B"},{"color":"#FDC306","text":"l"},{"color":"#FCC705","text":"a"},{"color":"#FCCB05","text":"v"},{"color":"#FCCF05","text":"o"},{"color":"#FBD204","text":"'"},{"color":"#FBD604","text":"s "},{"color":"#FBDA04","text":"C"},{"color":"#FADD03","text":"h"},{"color":"#FAE103","text":"e"},{"color":"#FAE503","text":"s"},{"color":"#F9E902","text":"t"},{"color":"#F9EC02","text":"p"},{"color":"#F8F001","text":"l"},{"color":"#F8F401","text":"a"},{"color":"#F8F801","text":"t"},{"color":"#F7FF00","text":"e"}],enchantment_glint_override=false,enchantments={"binding_curse":1,"vanishing_curse":1},lore=[{"color":"gray","text":"Earned by completing Donna Blavo's"},{"color":"gray","text":"absurd test of willpower and persistence"}," ",[{"color":"gray","text":"Good job unlocking "},{"bold":true,"color":"#FFAD08","text":"D"},{"bold":true,"color":"#FFB108","text":"o"},{"bold":true,"color":"#FEB407","text":"n"},{"bold":true,"color":"#FEB807","text":"n"},{"bold":true,"color":"#FEBC07","text":"a "},{"bold":true,"color":"#FDC006","text":"B"},{"bold":true,"color":"#FDC306","text":"l"},{"bold":true,"color":"#FCC705","text":"a"},{"bold":true,"color":"#FCCB05","text":"v"},{"bold":true,"color":"#FCCF05","text":"o"},{"bold":true,"color":"#FBD204","text":"'"},{"bold":true,"color":"#FBD604","text":"s "},{"bold":true,"color":"#FBDA04","text":"C"},{"bold":true,"color":"#FADD03","text":"h"},{"bold":true,"color":"#FAE103","text":"e"},{"bold":true,"color":"#FAE503","text":"s"},{"bold":true,"color":"#F9E902","text":"t"},{"bold":true,"color":"#F9EC02","text":"p"},{"bold":true,"color":"#F8F001","text":"l"},{"bold":true,"color":"#F8F401","text":"a"},{"bold":true,"color":"#F8F801","text":"t"},{"bold":true,"color":"#F7FF00","text":"e"}],{"bold":true,"color":"gray","text":"Your determination is commendable."}],tooltip_display={hidden_components:["enchantments","trim"]}] 1

    @var blockSelection[player] = "honey_block"
    @var blockSelectionStored[player] = "honey_block"
    @var copperGrate[player] = false
    @var grateNumber[player] = 0
    @var woolNumber[player] = 0
    @var glassNumber[player] = 0
    @var pumpkinNumber[player] = 0
    @var lastPumpkinNumber[player] = 0
    @var spongeNumber[player] = 0
    @var lastSpongeNumber[player] = 0
    @var obsidianNumber[player] = 0
    @var lastObsidianNumber[player] = 0
    @var oreNumber[player] = 0
    @var lastOreNumber[player] = 0
    @var coolGlassNumber[player] = 0
    @var lastCoolGlassNumber[player] = 0
    @var coralNumber[player] = 0
    @var lastCoralNumber[player] = 0
    @var froglightNumber[player] = 0
    @var coolGlass = false
    
    @var cosmeticSwap[player] = true
    @var cosmeticSwap100[player] = false
    
    @var resetBlocks(player, 64)
    
    @return
@fi

# Hourly cooldown
@if donnaTalk[player] == true
    @if ((system::currentTimeMillis() - beecd) < 3600000)
        @player &#ffeb35&lDonna Blavo&#ffeb35: *bzzz...*
        @bypass /playsound minecraft:entity.bee.hurt master @s ~ ~ ~ 1.0 0.5
        @delay 3s
        @player &#d4d4d4&o(The bee buzzes drowsily, ignoring you. It will be &l{{timer::formatTime(3600000 - (system::currentTimeMillis() - beecd))}}&#d4d4d4&o before &6&oDonna Blavo &#d4d4d4&ofinishes her nap.)
        @return
    @fi
@fi

# Variable sets
@define String beeprompt
@define Int beenum = math::floor(math::random(1D,1002D))

# Set beecd
@var beecd = system::currentTimeMillis()

# First time speaking
@if !donnaTalk
    @var donnaTalk = true
@fi

# Bee Speak
@bypass /playsound minecraft:entity.bee.sting master @s ~ ~ ~ 1.3 1.0

@player &#ffeb35&lDonna Blavo&#ffeb35: *BZZZZZ!*
@delay 3s
@player &#d4d4d4&oWhat a strange bee... its hum carries the weight of a hundred hives. I wonder if it has much to share.
@bypass /playsound minecraft:entity.allay.item_thrown master @s ~ ~ ~ 1.3 0.9
@delay 3s

# Normal @s speaking
@player &6&l&kB &#d4d4d4&lActivating Bee Translation Device . . . &6&l&kB

# Bee Translation Device Effects
@bypass /particle minecraft:wax_off ~ ~ ~ 1 1 1 2 75 normal @s

@bypass /playsound minecraft:item.armor.equip_gold master @s ~ ~ ~ 1.0 1.2
@bypass /playsound minecraft:block.note_block.bell master @s ~ ~ ~ 1.0 0.5
@bypass /playsound minecraft:block.beehive.drip master @s ~ ~ ~ 1.0 0.8
@delay 4
@bypass /playsound minecraft:block.note_block.bell master @s ~ ~ ~ 1.0 1.0
@delay 4
@bypass /playsound minecraft:block.note_block.bell master @s ~ ~ ~ 1.0 1.5
@delay 4
@bypass /playsound minecraft:block.note_block.bell master @s ~ ~ ~ 1.0 2.0

@bypass /particle minecraft:falling_nectar ~ ~1 ~ 1 1 1 0 75 normal @s


@delay 2s

# Bee Speak
@bypass /playsound minecraft:entity.bee.pollinate master @s ~ ~ ~ 1.0 1.5
@delay 2
@bypass /playsound minecraft:entity.bee.hurt master @s ~ ~ ~ 1.0 1.3


@player &#ffeb35&lDonna Blavo&#ffeb35: Bzz. &#d4d4d4&o(Do you know who I am? I am THE Donna Blavo. World renouned lawyer.)
@delay 4s

# Bee Speak
@bypass /playsound minecraft:entity.bee.pollinate master @s ~ ~ ~ 1.0 1.5
@delay 2
@bypass /playsound minecraft:entity.bee.hurt master @s ~ ~ ~ 1.0 1.3

@player &#ffeb35&lDonna Blavo&#ffeb35: Bzzz? &#d4d4d4&o(You dare approach my hive without an appointment? Without even a single flower to offer?)
@delay 4s

# Bee Speak
@bypass /playsound minecraft:entity.bee.pollinate master @s ~ ~ ~ 1.0 1.5
@delay 2
@bypass /playsound minecraft:entity.bee.hurt master @s ~ ~ ~ 1.0 1.3

@player &#ffeb35&lDonna Blavo&#ffeb35: Bzzzzzz. &#d4d4d4&o(However... I sense something in you. You may prove worthy of my reward.)
@delay 4s

# Bee Speak
@bypass /playsound minecraft:entity.bee.pollinate master @s ~ ~ ~ 1.0 1.5
@delay 2
@bypass /playsound minecraft:entity.bee.hurt master @s ~ ~ ~ 1.0 1.3

@player &#ffeb35&lDonna Blavo&#ffeb35: BZZZT! &#d4d4d4&o(I shall test you. I will think of a number, and you will guess it. Simple? HA!)
@delay 4s

# Bee Speak - dramatic pause
@bypass /particle minecraft:landing_honey ~ ~ ~ 1.5 1.5 1.5 1 50 normal @s
@bypass /playsound minecraft:entity.bee.pollinate master @s ~ ~ ~ 1.0 1.5
@delay 2
@bypass /playsound minecraft:entity.bee.hurt master @s ~ ~ ~ 1.0 1.3
@bypass /playsound minecraft:item.trident.thunder master @s ~ ~ ~ 1.0 0.7
@bypass /playsound minecraft:entity.bee.loop master @s ~ ~ ~ 1.0 1.3
@bypass /particle minecraft:white_smoke -9106.50 104.49 9512.25 0 0 0 0.2 30 normal @s
@player &#ffeb35&lDonna Blavo&#ffeb35: Bzzz! &#d4d4d4&o(I will be thinking of a number between &6&l1 and 1,000&#d4d4d4&o. Donna Blavo does not deal in small numbers.)
@delay 4s

# Bee Speak
@bypass /playsound minecraft:entity.bee.pollinate master @s ~ ~ ~ 1.0 1.5
@bypass /playsound minecraft:entity.bee.loop master @s ~ ~ ~ 1.0 1.4
@delay 2
@bypass /playsound minecraft:entity.bee.hurt master @s ~ ~ ~ 1.0 1.3

@player &#ffeb35&lDonna Blavo&#ffeb35: Bzz bzz! &#d4d4d4&o(You have &#d4d4d4&o&l20 seconds&#d4d4d4&o. If you fail, I shall take a nap for exactly one hour because of emotional trauma.)
@delay 4s

# Bee Speak
@bypass /playsound minecraft:entity.bee.pollinate master @s ~ ~ ~ 1.0 2.0
@delay 2
@bypass /playsound minecraft:entity.bee.hurt master @s ~ ~ ~ 1.0 1.8
@bypass /playsound minecraft:entity.elder_guardian.curse master @s ~ ~ ~ 1.0 0.9

@bypass /particle minecraft:falling_nectar ~ ~1 ~ 1 1 1 1 50 normal @s

@player &#ffeb35&lDonna Blavo&#ffeb35: BZZZZZZ?! &#d4d4d4&l(WHAT. NUMBER. AM I. THINKING OF?!)
@player &#d4d4d4[Type your answer in chat]

# Prompt
@prompt 20s beeprompt Donna Blavo has already lost interest...

# If wrong
@if beeprompt != String(beenum)
    
    @player &#ffeb35&lDonna Blavo&#ffeb35: Bz... bzzz... &#d4d4d4&o(Pitiful. Absolutely pitiful. The number was &l{{beenum}}&#d4d4d4&o.)
    
    # Sleepy/Offended Bee
    @bypass /playsound minecraft:entity.bee.hurt master @s ~ ~ ~ 1.0 0.6
    @delay 2
    @bypass /playsound minecraft:entity.bee.hurt master @s ~ ~ ~ 0.8 0.3
    
    @delay 2s

    @player &#ffeb35&lDonna Blavo&#ffeb35: *angry bzzz...* &#d4d4d4&o(I am going to sleep now. You have bored me.)
    
    @bypass /particle minecraft:falling_honey ~ ~ ~ 1 1 1 0.5 30 normal @s
    @bypass /playsound minecraft:entity.bee.death master @s ~ ~ ~ 1.0 0.4
    @delay 3
    @bypass /playsound minecraft:entity.fox.sleep master @s ~ ~ ~ 1.0 0.8

    @delay 2s
    @player &#d4d4d4&oShe's... drifted off. Tucked her head under her wing. I guess I didn't get it right
    @bypass /playsound minecraft:entity.fox.sleep master @s ~ ~ ~ 1.0 0.8
    @bypass /playsound minecraft:ui.toast.out master @s ~ ~ ~ 1.0 0.5

    @return
@fi


# If right
# Bee Speak - SHOCKED
@bypass /playsound minecraft:entity.bee.pollinate master @s ~ ~ ~ 1.2 2.0
@bypass /playsound minecraft:entity.bee.pollinate master @s ~ ~ ~ 1.2 1.5
@delay 1
@bypass /playsound minecraft:entity.bee.hurt master @s ~ ~ ~ 1.2 1.8

@bypass /particle minecraft:falling_honey ~ ~ ~ 3 3 3 1 200 normal @s
@bypass /particle minecraft:falling_nectar ~ ~ ~ 3 3 3 1 200 normal @s
@bypass /particle minecraft:landing_honey ~ ~ ~ 2 0.5 2 1 100 normal @s

@if !donnaDone
    @player &#ffeb35&lDonna Blavo&#ffeb35: BZZZZZZZ?!?!?! &#d4d4d4&o(WHAT?! IMPOSSIBLE! One in a thousand! You... you GUESSED it?!)
    @bypass /playsound minecraft:entity.ender_dragon.death master @s ~ ~ ~ 2 1.7
    

    @delay 3s
    @bypass /particle minecraft:falling_honey ~ ~ ~ 4 4 4 1 300 normal @s
    @bypass /playsound minecraft:entity.bee.pollinate master @s ~ ~ ~ 1.0 1.5
    @delay 1
    @bypass /playsound minecraft:entity.bee.hurt master @s ~ ~ ~ 1.0 1.3
    @bypass /playsound minecraft:entity.bee.loop master @s ~ ~ ~ 1.0 1.3
    
    @player &#ffeb35&lDonna Blavo&#ffeb35: Bzz... bzzz... &#d4d4d4&o(I... I have never... in all my 47 days of life... No one has EVER... I think I need to sit down.)
    @bypass /particle minecraft:falling_honey ~ ~ ~ 4 4 4 1 300 normal @s
    @delay 4s
    
    @bypass /playsound minecraft:entity.bee.pollinate master @s ~ ~ ~ 1.0 1.0
    @delay 1
    @bypass /playsound minecraft:entity.bee.hurt master @s ~ ~ ~ 1.0 1.3
    @bypass /particle minecraft:falling_honey ~ ~ ~ 4 4 4 1 300 normal @s
    @player &#ffeb35&lDonna Blavo&#ffeb35: Bzzz. &#d4d4d4&o(You... are worthy. Take my sweetest reserves. And if ANYONE asks, tell them Donna Blavo sent you.)
    
    @delay 3s
    
    @bypass /particle minecraft:falling_honey ~ ~ ~ 4 4 4 1 300 normal @s
    @bypass /playsound minecraft:block.note_block.pling master @s ~ ~ ~ 1 1
    @bypass /particle minecraft:firework ~ ~ ~ 0 0 0 1 100
    @bypass /playsound minecraft:entity.firework_rocket.launch master @s ~ ~ ~ 1.0 1.0
    
    @player &#d4d4d4--------------------------------------
