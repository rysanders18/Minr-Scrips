# rachelName(Player player)

@fast
@using Harha

@define String name = ""
@var rachelname[player] = "No answer"
@bypass /playsound minecraft:entity.elder_guardian.curse master {{player}} ~ ~ ~ 1 1
@player &e !!! Type name in chat !!! &cYou have 25 seconds!!!

@prompt 25s name &cYou took too long!

@var rachelname[player] = name

@bypass /playsound minecraft:entity.villager.trade master {{player}} ~ ~ ~ 1 1.8
# @player &#CCDFED&k&lRachel&#CCDFED: Hmm... Let me think about this...

@return
