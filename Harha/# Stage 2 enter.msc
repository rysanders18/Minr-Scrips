# Stage 2 enter
# Title, Sound effects, and Splits

@using Harha
@fast

@if player.getGameMode().toLowerCase() != "adventure"
    @return
@fi

@define Long timeThisStage
@define Boolean firstTime = false

@define Boolean speedrunTeleportedRecentlyOld = speedrunTeleportedRecently[player]
@var speedrunTeleportedRecently[player] = false

@if stage[player] == 1
    
    @define String gradient1 = "#FB7100"
    @define String gradient2 = "#FC7B14"
    @define String gradient3 = "#FC8427"
    @define String gradient4 = "#FD8E3B"
    @define String gradient5 = "#FE984E"
    @define String gradient6 = "#FEA162"
    @define String gradient7 = "#FFAB75"
    # #FB7100
    # #FC7B14
    # #FC8427
    # #FD8E3B
    # #FE984E
    # #FEA162
    # #FFAB75
    
    
    @var stage[player] += 1
    @var timeThisStage = (system::currentTimeMillis() - startTime[player])
    @var startTime[player] = system::currentTimeMillis()
    # if this is First time entering stage 2, PB = this time
    @if stage2Entered[player] == false
        @var stage1PB[player] = (timeThisStage)
        @var top100Function(player, 18)
        @if numberCompletions[player] >= 1
            @var stage8PB[player] = stage1PB[player] + stage2PB[player] + stage3PB[player] + stage4PB[player] + stage5PB[player] + stage6PB[player] + stage7PB[player]
            @var top100Function(player, 25)
        @fi
        @var stage2Entered[player] = true
        @var firstTime = true

        @bypass /title @s actionbar ["",{"text":"Stage 1 in ","bold":true,"color":"#d4d4d4"},{"text":"{{timer::formatTime(timeThisStage)}}    ","bold":true,"color":"{{gradient5}}"}]
    @else
        @if (timeThisStage) < stage1PB[player] && speedrunTeleportedRecentlyOld == false
            @player &#ffb4ff&lNew personal best! &d&l{{timer::formatTime(timeThisStage)}} &#ffb4ff&l({{timer::formatTime(stage1PB)}})
            @var stage1PB[player] = (timeThisStage)
            @var top100Function(player, 18)
            @if numberCompletions[player] >= 1
                @var stage8PB[player] = stage1PB[player] + stage2PB[player] + stage3PB[player] + stage4PB[player] + stage5PB[player] + stage6PB[player] + stage7PB[player]
                @var top100Function(player, 25)
            @fi
            
            @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 {{musicNotes[7]}}
            @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 {{musicNotes[11]}}
            @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 {{musicNotes[14]}}
            @delay 2
            @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 {{musicNotes[9]}}
            @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 {{musicNotes[13]}}
            @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 {{musicNotes[16]}}
            @delay 2
            @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 {{musicNotes[11]}}
            @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 {{musicNotes[15]}}
            @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 1 {{musicNotes[18]}}
            
        @fi
        @if speedrunTeleportedRecentlyOld == false
            @bypass /title @s actionbar ["",{"text":"Stage 1 in ","bold":true,"color":"#d4d4d4"},{"text":"{{timer::formatTime(timeThisStage)}}    ","bold":true,"color":"{{gradient5}}"},{"text":"Best in ","bold":false,"color":"#ffb4ff"},{"text":"{{timer::formatTime(stage1PB[player])}}","bold":true,"color":"light_purple"}]
        @else
            @bypass /title @s actionbar ["",{"text":"Speedrun Mode: ","bold":true,"color":"#d4d4d4"},{"text":"Timer Started!","bold":true,"color":"{{gradient5}}"}]
            @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 0.25 1.0
            @bypass /playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 0.25 2.0
        @fi
    @fi
    
    @bypass /title @s times 0 30 20
    
    @bypass /title @s subtitle ["",{"text":"S","color":"#d4d4d4"}]
    @bypass /playsound minecraft:entity.chicken.egg master @s ~ ~ ~ 1 1
    @bypass /title @s title ["",{"text":"S","bold":true,"color":"{{gradient1}}"}]
    @delay 1
    
    @bypass /title @s subtitle ["",{"text":"St","color":"#d4d4d4"}]
    @bypass /playsound minecraft:entity.chicken.egg master @s ~ ~ ~ 1 1.122
    @bypass /title @s title ["",{"text":"S","bold":true,"color":"{{gradient1}}"},{"text":"t","bold":true,"color":"{{gradient2}}"}]
    @delay 1
    
    @bypass /title @s subtitle ["",{"text":"Stac","color":"#d4d4d4"}]
    @bypass /playsound minecraft:entity.chicken.egg master @s ~ ~ ~ 1 1.26
    @bypass /title @s title ["",{"text":"S","bold":true,"color":"{{gradient1}}"},{"text":"t","bold":true,"color":"{{gradient2}}"},{"text":"a","bold":true,"color":"{{gradient3}}"}]
    @delay 1
    
    @bypass /title @s subtitle ["",{"text":"Stacki","color":"#d4d4d4"}]
    @bypass /playsound minecraft:entity.chicken.egg master @s ~ ~ ~ 1 1.498
    @bypass /title @s title ["",{"text":"S","bold":true,"color":"{{gradient1}}"},{"text":"t","bold":true,"color":"{{gradient2}}"},{"text":"a","bold":true,"color":"{{gradient3}}"},{"text":"g","bold":true,"color":"{{gradient4}}"}]
    @delay 1
    
    @bypass /title @s subtitle ["",{"text":"Stackin","color":"#d4d4d4"}]
    @bypass /playsound minecraft:entity.chicken.egg master @s ~ ~ ~ 1 1.682
    @bypass /title @s title ["",{"text":"S","bold":true,"color":"{{gradient1}}"},{"text":"t","bold":true,"color":"{{gradient2}}"},{"text":"a","bold":true,"color":"{{gradient3}}"},{"text":"g","bold":true,"color":"{{gradient4}}"},{"text":"e ","bold":true,"color":"{{gradient5}}"}]
    @delay 1
    
    @bypass /title @s subtitle ["",{"text":"Stacking","color":"#d4d4d4"}]
    @bypass /playsound minecraft:entity.chicken.egg master @s ~ ~ ~ 1 2
    @bypass /title @s title ["",{"text":"S","bold":true,"color":"{{gradient1}}"},{"text":"t","bold":true,"color":"{{gradient2}}"},{"text":"a","bold":true,"color":"{{gradient3}}"},{"text":"g","bold":true,"color":"{{gradient4}}"},{"text":"e ","bold":true,"color":"{{gradient5}}"},{"text":"2","bold":true,"color":"{{gradient6}}"},{"text":":","bold":true,"color":"{{gradient7}}"}]
    
    
    
    @delay 15
    @if firstTime == true
        @bypass /title @s actionbar ["",{"text":"Stage 1 in ","bold":true,"color":"#d4d4d4"},{"text":"{{timer::formatTime(timeThisStage)}}    ","bold":true,"color":"{{gradient5}}"}]
    @else
        @if speedrunTeleportedRecentlyOld == false
            @bypass /title @s actionbar ["",{"text":"Stage 1 in ","bold":true,"color":"#d4d4d4"},{"text":"{{timer::formatTime(timeThisStage)}}    ","bold":true,"color":"{{gradient5}}"},{"text":"Best in ","bold":false,"color":"#ffb4ff"},{"text":"{{timer::formatTime(stage1PB[player])}}","bold":true,"color":"light_purple"}]
        @else
            @bypass /title @s actionbar ["",{"text":"Speedrun Mode: ","bold":true,"color":"#d4d4d4"},{"text":"Timer Started!","bold":true,"color":"{{gradient5}}"}]
        @fi
    @fi
    @delay 20
    @if firstTime == true
        @bypass /title @s actionbar ["",{"text":"Stage 1 in ","bold":true,"color":"#d4d4d4"},{"text":"{{timer::formatTime(timeThisStage)}}    ","bold":true,"color":"{{gradient5}}"}]
    @else
        @if speedrunTeleportedRecentlyOld == false
            @bypass /title @s actionbar ["",{"text":"Stage 1 in ","bold":true,"color":"#d4d4d4"},{"text":"{{timer::formatTime(timeThisStage)}}    ","bold":true,"color":"{{gradient5}}"},{"text":"Best in ","bold":false,"color":"#ffb4ff"},{"text":"{{timer::formatTime(stage1PB[player])}}","bold":true,"color":"light_purple"}]
        @else
            @bypass /title @s actionbar ["",{"text":"Speedrun Mode: ","bold":true,"color":"#d4d4d4"},{"text":"Timer Started!","bold":true,"color":"{{gradient5}}"}]
        @fi
    @fi
    @delay 20
    @if firstTime == true
        @bypass /title @s actionbar ["",{"text":"Stage 1 in ","bold":true,"color":"#d4d4d4"},{"text":"{{timer::formatTime(timeThisStage)}}    ","bold":true,"color":"{{gradient5}}"}]
    @else
        @if speedrunTeleportedRecentlyOld == false
            @bypass /title @s actionbar ["",{"text":"Stage 1 in ","bold":true,"color":"#d4d4d4"},{"text":"{{timer::formatTime(timeThisStage)}}    ","bold":true,"color":"{{gradient5}}"},{"text":"Best in ","bold":false,"color":"#ffb4ff"},{"text":"{{timer::formatTime(stage1PB[player])}}","bold":true,"color":"light_purple"}]
        @else
            @bypass /title @s actionbar ["",{"text":"Speedrun Mode: ","bold":true,"color":"#d4d4d4"},{"text":"Timer Started!","bold":true,"color":"{{gradient5}}"}]
        @fi
    @fi
@fi
