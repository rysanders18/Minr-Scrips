@define String acceptedTextMerge = ""
@define String rejectedTextMerge = ""

@player &e=== NFA MULTI-TEST MODE ===
@player
@player &eSyntax: &n{{syntax}}
@player
@player &6Testing Accept Cases:
@for String testString in acceptStrings
    @if runTest(testString, player, false)
        @chatscript 300s group{{testString}} runTest(testString, player, true)
        @player &aString Accepted: &e{{testString}}
        @var acceptedTextMerge = acceptedTextMerge + ",{\"bold\":true,\"color\":\"green\",\"text\":\"✔ \"},{\"bold\":false,\"color\":\"yellow\",\"text\":\"" + "\\\"" + "{{testString}}" + "\\\"" + " \\n\"}"
    @else
        @chatscript 300s group{{testString}} runTest(testString, player, true)
        @player &cString Rejected: &e{{testString}}
        @var acceptedTextMerge = acceptedTextMerge + ",{\"bold\":true,\"color\":\"red\",\"text\":\"✕ \"},{\"bold\":false,\"color\":\"yellow\",\"text\":\"" + "\\\"" + "{{testString}}" + "\\\"" + " \\n\"}"
        @var allTestsPassed = false
    @fi
@done
@player
@player &6Testing Reject Cases:
@for String testString in rejectStrings
    @if !runTest(testString, player, false)
        @chatscript 300s group{{testString}} runTest(testString, player, true)
        @player &aString Rejected: &e{{testString}}
        @var rejectedTextMerge = rejectedTextMerge + ",{\"bold\":false,\"color\":\"yellow\",\"text\":\"" + "\\\"" + "{{testString}}" + "\\\""+ " \"},{\"bold\":true,\"color\":\"green\",\"text\":\"✔\\n\"}"
    @else
        @chatscript 300s group{{testString}} runTest(testString, player, true)
        @player &cString Accepted: &e{{testString}}
        @var rejectedTextMerge = rejectedTextMerge + ",{\"bold\":false,\"color\":\"yellow\",\"text\":\"" + "\\\"" + "{{testString}}" + "\\\""+ " \"},{\"bold\":true,\"color\":\"red\",\"text\":\"✕\\n\"}"
        @var allTestsPassed = false
    @fi
@done
@player &e * Click on any entry to see a breakdown
@player &e=== TESTING COMPLETE ===

@if allTestsPassed
    @player &a&lAll tests passed successfully!
    @bypass /playsound minecraft:ui.toast.challenge_complete master @s ~ ~ ~ 1 1
@else
    @player &c&lSome tests failed. Please review the results above.
    @bypass /playsound minecraft:entity.villager.no master @s ~ ~ ~ 1 1
@fi


@bypass /data merge entity @e[tag=nfaAccepted1,limit=1] {text:[{"bold":true,"color":"gold","text":"Strings that should be accepted:\n\n"}{{acceptedTextMerge}}]}
@bypass /data merge entity @e[tag=nfaRejected1,limit=1] {text:[{"bold":true,"color":"gold","text":"Strings that should be rejected:\n\n"}{{rejectedTextMerge}}]}



