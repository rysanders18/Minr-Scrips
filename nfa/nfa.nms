# Per-room state accessors. roomIdx = world * 5 + room (0..19). Reads return the
# shared per-room global; writes update both the global and the caller's relative copy.
String[] getBranches(Int roomIdx)
String[] getConnections(Int roomIdx)
appendBranch(Player player, Int roomIdx, String value)
appendConnection(Player player, Int roomIdx, String value)
removeBranch(Player player, Int roomIdx, String value)
removeConnection(Player player, Int roomIdx, String value)
editListOfBlocks(Player player, Int room, Int world, Block block, Int newValue)

clearRoom(Int roomIdx)

allTestsPassedTitle(Player player)

resetEntireRoom(Player player, Int room, Int world)
setupRoom(Player player, Int room, Int world)
loadRoomToRelative(Player player, Int room, Int world)
changePlayersRoomVariables(Player player, Int newRoom)
rejoinRegion(Player player)
placeStateBlock(Int code, Int x, Int y, Int z)

Boolean runTest(String inputString, Player player, Boolean debug)

