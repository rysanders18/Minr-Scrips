# changePlayersRoomVariables(Player player, Int newRoom)

# Moves the player's relative NFA build from their current room to newRoom by translating
# every stored Z coordinate. Adjacent rooms are 100 blocks apart in Z, and moving to a
# HIGHER room number DECREASES Z (see the worked example below and rejoinRegion, the sole
# caller, which teleports the player using the decreasing roomTpCoords). So the shift is
# deltaZ = (oldRoom - newRoom) * 100.
#
# Example, room 0 -> room 1 (deltaZ = -100):
#   branch tag  branch5061.5130.02997.55061.0129.53000.5
#            -> branch5061.5130.02897.55061.0129.52900.5
#   i.e. the two Z components (2997.5 and 3000.5) each drop by 100.
#
# Only coordinate-bearing data moves:
#   - listOfConnections: block coords in parts[1]/parts[2] (the Z field), the two
#     concatenated pos keys parts[4]/parts[5], and the geometry blob parts[6] positions.
#   - listOfBranches: rebuilt from the shifted connections (both orderings, as appendBranch
#     stores them). Branch tags are concatenated floats with no separators, so they can't be
#     parsed in place -- regenerating them from the parseable geometry is exact.
# Transition NORMALS (geo[6..11]) and the point count (geo[12]) are directions/scalars, not
# positions, so they are left untouched. listOfBlocks is a positional grid of type codes
# (no coordinates -- index -> coords is resolved against roomOrigins in setupRoom) so it
# needs no change.

@using nfa
@fast

@define Int oldRoom = room[player]
@var room[player] = newRoom

@if newRoom == oldRoom
    @return
@fi

@define Double deltaZ = Double(oldRoom - newRoom) * 100.0D
@define Int deltaZInt = (oldRoom - newRoom) * 100

@define String[] newConnections = String[]
@define String[] newBranches = String[]

@for String connection in listOfConnections[player]
    @define String[] parts = connection.split(";")
    @if parts.length() >= 7 && parts[0] == "connection"
        @define String[] b1 = parts[1].split(",")
        @define String[] b2 = parts[2].split(",")
        @define String[] geo = parts[6].split(",")

        @define Int b1z = Int(b1[2]) + deltaZInt
        @define Int b2z = Int(b2[2]) + deltaZInt
        @define Double p1z = Double(geo[2]) + deltaZ
        @define Double p2z = Double(geo[5]) + deltaZ

        # Concatenated pos keys (no separators); X/Y kept byte-identical, only Z recomputed.
        @define String pos1Key = "{{geo[0]}}{{geo[1]}}{{p1z}}"
        @define String pos2Key = "{{geo[3]}}{{geo[4]}}{{p2z}}"

        @define String newGeo = "{{geo[0]}},{{geo[1]}},{{p1z}},{{geo[3]}},{{geo[4]}},{{p2z}},{{geo[6]}},{{geo[7]}},{{geo[8]}},{{geo[9]}},{{geo[10]}},{{geo[11]}},{{geo[12]}}"

        @var newConnections.append("connection;{{b1[0]}},{{b1[1]}},{{b1z}};{{b2[0]}},{{b2[1]}},{{b2z}};{{parts[3]}};{{pos1Key}};{{pos2Key}};{{newGeo}}")

        @var newBranches.append("branch{{pos1Key}}{{pos2Key}}")
        @var newBranches.append("branch{{pos2Key}}{{pos1Key}}")
    @else
        @var newConnections.append(connection)
    @fi
@done

@var listOfConnections[player] = newConnections
@var listOfBranches[player] = newBranches
