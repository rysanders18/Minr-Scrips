# appendBranch(Player player, Int roomIdx, String value)

# Appends a branch tag to the shared per-room list AND the caller's relative
# copy (kept in sync). roomIdx = world * 5 + room (0..19).

@using nfa
@fast

@define Player[] playersInRoom = Region(String("rynfa" + String(room) + String(world)), "Theta").getPlayersInside()
@for Player p in playersInRoom
    @var listOfBranches[p].append(value)
@done

@if roomIdx == 0
    @var listOfBranches0.append(value)
@elseif roomIdx == 1
    @var listOfBranches1.append(value)
@elseif roomIdx == 2
    @var listOfBranches2.append(value)
@elseif roomIdx == 3
    @var listOfBranches3.append(value)
@elseif roomIdx == 4
    @var listOfBranches4.append(value)
@elseif roomIdx == 5
    @var listOfBranches5.append(value)
@elseif roomIdx == 6
    @var listOfBranches6.append(value)
@elseif roomIdx == 7
    @var listOfBranches7.append(value)
@elseif roomIdx == 8
    @var listOfBranches8.append(value)
@elseif roomIdx == 9
    @var listOfBranches9.append(value)
@elseif roomIdx == 10
    @var listOfBranches10.append(value)
@elseif roomIdx == 11
    @var listOfBranches11.append(value)
@elseif roomIdx == 12
    @var listOfBranches12.append(value)
@elseif roomIdx == 13
    @var listOfBranches13.append(value)
@elseif roomIdx == 14
    @var listOfBranches14.append(value)
@elseif roomIdx == 15
    @var listOfBranches15.append(value)
@elseif roomIdx == 16
    @var listOfBranches16.append(value)
@elseif roomIdx == 17
    @var listOfBranches17.append(value)
@elseif roomIdx == 18
    @var listOfBranches18.append(value)
@elseif roomIdx == 19
    @var listOfBranches19.append(value)
@else
    @player &cappendBranch: bad roomIdx {{roomIdx}}
@fi
