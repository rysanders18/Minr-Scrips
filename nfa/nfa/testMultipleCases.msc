    @var rejectStrings = String["110", "00011", "011011", "0110000", "00101100", "100100110", "0110001100", "01011100001", "000110110100", "0001000110100", "10001011110011", "0010100111100100", "011101110101110010", "10110101100111011010", "0010000010111010100000", "110000100010001110001011"]
@elseif level == 30
