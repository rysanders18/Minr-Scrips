    @var acceptStrings = String["", "00", "0111", "100111", "0011100", "00000110", "110100001", "0010101110", "00011100000", "110000110001", "1011101001010", "11100110000101", "1101000101011100", "101111110100010011", "10010111110010111110", "1111001011101100101001", "000100011101111000110100"]
    @var rejectStrings = String["010", "01001", "100010", "1001101", "11101101", "011111101", "1001101110", "00010100000", "010000110001", "0011101001010", "11110110000101", "0101000101011100", "001111110100010011", "11010111110010111110", "1011001011101100101001", "001100011101111000110100"]
