@elseif level == 153
    @var syntax = "Contains 111 and 120 and 211, but does not contain 110, 121, or 122"
    @var acceptStrings = String["211120", "21112011", "200211120", "21112000112", "202002111200", "10120102222111", "211120002202012", "21111202020100112", "202000220020211120", "21202100221112000202", "102112002200100011120", "20002002102012021112001", "120210222101202222221112", "10220210021112010022101010", "220021112000120112022022202", "20200221020010221112000101010"]
    @var rejectStrings = String["", "1", "2", "12", "21", "102", "210", "1022", "2001", "10002", "22100", "221001", "222110", "2012002", "02021202211022", "0120022121111201100", "212101102002000220201111", "02211112101010000111121122001"]
@fi

@define String acceptedTextMerge = ""
@define String rejectedTextMerge = ""
@define Int numberOfFailedTests = 0
@define Int numberOfFailedAcceptTests = 0
@define Int numberOfFailedRejectTests = 0

@define Float totalTestcases = Float(acceptStrings.length() + rejectStrings.length())

@player 
@player &e=== &lLEVEL {{level + 1}} &e===
@player
@player &6Should be accepted:
# 1-based index of the current accept case, used for the rising pop pitch below.
@define Int testIndex = 0
@for String testString in acceptStrings
    @var testIndex += 1
    @if runTest(testString, player, false)
        # @chatscript 300s group{{testString}} runTest(testString, player, true)
        # @player &aString Accepted: &e{{testString}}
        @var acceptedTextMerge = acceptedTextMerge + ",{\"bold\":true,\"color\":\"green\",\"text\":\"✔ \"},{\"bold\":false,\"color\":\"yellow\",\"text\":\"" + "\\\"" + "{{testString}}" + "\\\"" + " \\n\"}"
    @else
        @chatscript 300s group{{testString}} visualizeStringLeverChatscript(player, Region(String("rynfa" + String(room) + String(world)), "Theta").getPlayersInside(), testString, block, false)
        @player &c✕ Rejected: &e{{testString}}
        @var acceptedTextMerge = acceptedTextMerge + ",{\"bold\":true,\"color\":\"red\",\"text\":\"✕ \"},{\"bold\":false,\"color\":\"yellow\",\"text\":\"" + "\\\"" + "{{testString}}" + "\\\"" + " \\n\"}"
        @var allTestsPassed = false
        @var numberOfFailedTests += 1
        @var numberOfFailedAcceptTests += 1
        @bypass /playsound minecraft:ui.hud.bubble_pop master @s ~ ~ ~ 1 {{Float(testIndex) / totalTestcases * 1.5 + 0.5}}
        @bypass /particle minecraft:trial_spawner_detection_ominous {{block.getX()}} {{block.getY()}} {{block.getZ()}} 0.2 0 0.2 0.01 2
        @delay 1
    @fi
@done
@if numberOfFailedAcceptTests == 0
    @player &a&l✔ &eAll accept test cases passed!
@fi

# Pad acceptedTextMerge up to 18 rows: one blank line per test case short of 18 (keeps lists aligned).
@for Int padLine in list::range(0, 18 - acceptStrings.length())
    @var acceptedTextMerge = acceptedTextMerge + ",{\"text\":\"\\n\"}"
@done

@player
@player &6Should be rejected:
@for String testString in rejectStrings
    @var testIndex += 1
    @if !runTest(testString, player, false)
        # @chatscript 300s group{{testString}} runTest(testString, player, true)
        # @player &aString Rejected: &e{{testString}}
        @var rejectedTextMerge = rejectedTextMerge + ",{\"bold\":false,\"color\":\"yellow\",\"text\":\"" + "\\\"" + "{{testString}}" + "\\\""+ " \"},{\"bold\":true,\"color\":\"green\",\"text\":\"✔\\n\"}"
    @else
        @chatscript 300s group{{testString}} visualizeStringLeverChatscript(player, Region(String("rynfa" + String(room) + String(world)), "Theta").getPlayersInside(), testString, block, false)
        @player &c✕ Accepted: &e{{testString}}
        @var rejectedTextMerge = rejectedTextMerge + ",{\"bold\":false,\"color\":\"yellow\",\"text\":\"" + "\\\"" + "{{testString}}" + "\\\""+ " \"},{\"bold\":true,\"color\":\"red\",\"text\":\"✕\\n\"}"
        @var allTestsPassed = false
        @var numberOfFailedTests += 1
        @bypass /playsound minecraft:ui.hud.bubble_pop master @s ~ ~ ~ 1 {{Float(testIndex) / totalTestcases * 1.5 + 0.5}}
        @bypass /particle minecraft:trial_spawner_detection_ominous {{block.getX()}} {{block.getY()}} {{block.getZ()}} 0.2 0 0.2 0.01 2
        @delay 1
    @fi
@done
@if numberOfFailedRejectTests == 0
    @player &a&l✔ &eAll reject test cases passed!
@fi

# Pad rejectedTextMerge up to 18 rows: one blank line per test case short of 18 (keeps lists aligned).
@for Int padLine in list::range(0, 18 - rejectStrings.length())
    @var rejectedTextMerge = rejectedTextMerge + ",{\"text\":\"\\n\"}"
@done


@if allTestsPassed
    @define Player[] playersInRoom = Region(String("rynfa" + String(room) + String(world)), "Theta").getPlayersInside()
    @for Player teammate in playersInRoom
        @console /function execute nfa::allTestsPassedTitle(Player("{{teammate.getName()}}"))
        # TODO: LEVEL PROGRESSION STUFF
    @done
    @player &a&lAll tests passed successfully!
    
@else
    @player
    @player &eSyntax: &n{{syntax}}
    @player
    @player &e * Click on any entry to enable visualization
    @player
    @player &c&lTests Failed: {{numberOfFailedTests}}. &c &l Please review the results above.
    @bypass /playsound minecraft:entity.villager.no master @a[distance=..30] ~ ~ ~ 0.75 1.2
    @bypass /particle minecraft:angry_villager {{block.getX()}} {{block.getY()}} {{block.getZ()}} 0.0 0 0.0 0.01 1
@fi

# Script here that adds \ before every " in the syntax strings"
@var syntax = syntax.replace("\"", "\\\"")

@bypass /data merge entity @e[tag=nfaSyntax{{room}}{{world}},limit=1] {text:[{"bold":true,"color":"gold","text":"LEVEL {{level}} Syntax:\n"},{"bold":false,"color":"yellow","text":"{{syntax}}"}]}
@bypass /data merge entity @e[tag=nfaAccepted{{room}}{{world}},limit=1] {text:[{"bold":false,"color":"gold","text":"Strings that should be "},{"bold":true,"color":"gold","text":"accepted:\n\n"}{{acceptedTextMerge}}]}
@bypass /data merge entity @e[tag=nfaRejected{{room}}{{world}},limit=1] {text:[{"bold":false,"color":"gold","text":"Strings that should be "},{"bold":true,"color":"gold","text":"rejected:\n\n"}{{rejectedTextMerge}}]}



