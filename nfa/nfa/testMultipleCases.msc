# testMultipleCases(Player player, Int room, Int world, Block block)

# NFA Debug Script
# Displays detailed step-by-step processing of an input string through the NFA

@using nfa
@fast

@if system::currentTimeMillis() - lastButtonPress[player] < 5000
    @player &cPlease wait before pressing the button again!
    @bypass /playsound minecraft:block.netherite_block.break master @s ~ ~ ~ 0.75 1
    @bypass /particle dust{color:[0.871,0.065,0.100],scale:1} {{block.getX()}} {{block.getY()}} {{block.getZ()}} 0.1 .1 0.1 1 10 normal
    @return
@fi

@var lastButtonPress[player] = system::currentTimeMillis()

@define Boolean allTestsPassed = true

@define String syntax
@define String[] acceptStrings
@define String[] rejectStrings

@if level == 0
    @var syntax = "All strings equal to \"0101\""
    @var acceptStrings = String["0101"]
    @var rejectStrings = String["", "0", "1", "10", "11", "000", "111", "010", "101", "01010", "00101"]
@elseif level == 1
    @var syntax = "All strings with two 0's followed by any number of 1's"
    @var acceptStrings = String["00", "001", "0011", "001111", "0011111111"]
    @var rejectStrings = String["", "0", "1", "01", "101111", "11111", "0001", "0110", "0001111", "0111", "0111111"]
@elseif level == 2
    @var syntax = "Any number of repetitions of \"01\""
    @var acceptStrings = String["", "01", "0101", "010101", "01010101"]
    @var rejectStrings = String["0", "1", "00", "11", "10", "001", "011", "100", "101", "0100", "1010", "111", "000"]
@elseif level == 3
    @var syntax = "All strings that contain the substring \"010\""
    @var acceptStrings = String["010", "1010", "0101", "0001000", "00100101101", "101010101010", "0000101111", "10011010"]
    @var rejectStrings = String["", "0", "1", "00", "11", "000", "111", "1001", "1110", "1011", "0000", "1111", "00011000", "00001111"]
@elseif level == 4
    @var syntax = "Any combination of 000's and 111's"
    @var acceptStrings = String["", "000", "111", "000000", "111111", "000111000", "111000111", "000111000111"]
    @var rejectStrings = String["10", "01", "0001", "1110", "101010", "010101", "00011", "11100", "001100", "110011", "0001111", "1110000111"]
@elseif level == 5
    @var syntax = "Every 1 comes after a 0"
    @var acceptStrings = String["", "0", "00", "00000", "01", "001", "000001", "010101", "001001", "0000101001"]
    @var rejectStrings = String["1", "10", "0110", "100001", "0111110", "01010110", "0000110"]
@elseif level == 6
    @var syntax = "Binary String divisible by 3"
    @var acceptStrings = String["0", "11", "110", "0110", "11011", "100100", "0000011", "11110011", "000001100", "1011011111", "00010000111", "111000010000", "00011111101111", "0001000011001011", "100110010000011000", "10110111111111010101", "1101010010100111100000", "001001011000000100001011"]
    @var rejectStrings = String["1", "10", "100", "1101", "10110", "001011", "1010101", "01010110", "101110010", "0000010001", "011110010100", "00011111111111", "0100011111100001", "000001100011101111", "11010000110011001100", "1010011101000100011001", "001001010110000111100111"]
@elseif level == 7
    @var syntax = "(10)* (11 | 01 | 000)*"
    @var acceptStrings = String["", "10", "1010", "11", "01", "000", "1011", "1001", "10000", "0111", "1101", "00001", "00011", "000000", "110101", "101000001", "101000011", "101011000"]
    @var rejectStrings = String["0", "1", "00", "111", "0011", "101", "100", "010", "110", "0001", "1000", "10001", "10110", "1010101", "0110", "0100", "00010", "001"]
@elseif level == 8
    @var syntax = "The number of 0's is even and the number of 1's is odd"
    @var acceptStrings = String["1", "001", "010", "100", "00001", "00010", "00100", "01000", "10000", "111", "10110", "01101", "10011", "01011", "11010"]
    @var rejectStrings = String["", "0", "00", "11", "01", "10", "000", "1111", "0011", "0101", "1010", "1100", "1001", "11011", "01010"]
@elseif level == 9
    @var syntax = "01 + (101 | 010 | 0110 | 1001)* + (111 | 0*) + 10" 
    @var acceptStrings = String["0110", "01010", "010010", "01000010", "0111110", "0110110", "01101010", "011010010", "0110111110", "0101010", "01010010", "0101011110", "01011010", "0101100010", "01100110", "011001010", "01011010010100010", "01100110010000010"]
    @var rejectStrings = String["", "01", "10", "011", "01100", "00110", "11110", "01110", "010110", "01111010", "0101110", "011010110", "011010", "01111110", "01101010111110", "01100101101110", "01101110", "01010110"]
@elseif level == 10
    @var syntax = "All binary strings with no substring \"01\""
    @var acceptStrings = String["", "0", "00", "000", "1", "11", "111", "10", "110", "1110", "11100", "111000", "1000", "110000", "1111000"]
    @var rejectStrings = String["01", "001", "101", "010", "1001", "1101", "1010", "0001", "0100", "11101", "0010", "1011", "011", "0101", "11001"]
@elseif level == 11
    @var syntax = "All binary strings with no substring \"010\""
    @var acceptStrings = String["", "0", "1", "00", "11", "01", "10", "001", "011", "101", "110", "111", "0000", "1110", "1001", "0011", "0111", "110111000"]
    @var rejectStrings = String["010", "0100", "0101", "0010", "1010", "11010", "01011", "111010", "000101", "01010", "10101", "10010", "0110100", "00101", "110010", "00010"]
@elseif level == 12
    @var syntax = "All binary strings with no substring \"00101101\""
    @var acceptStrings = String["", "0", "1", "00", "11", "0010110", "00101100", "00101111", "00111101", "00000000", "11111111", "01010101", "10101010", "11001100", "00010110", "00101001", "000001010111", "110110110110"]
    @var rejectStrings = String["00101101", "001011010", "100101101", "000101101", "10100101101", "001011011", "1100101101", "0010110101", "000001011010", "1110010110111", "001011010000", "010010110101", "0001001011011", "10101001011010", "000001011010111"]
@elseif level == 13
    @var syntax = "Good Luck!"
    @var acceptStrings = String["010011000111000011110000011111", "101100111000111100001111100000"]
    @var rejectStrings = String["", "0", "1", "01001100011100001111000001111", "0010011000111000011110000011111", "0100110001110000111100000111110", "110011000111000011110000011111", "010011000111000011110000011110", "10110011100011110000111110000", "1011001110001111000011111000000", "001100111000111100001111100000", "101100111000111100001111100001", "111110000011110000111000110010", "000001111100001111000111100110", "010011000111000011110000011111101100111000111100001111100000"]
@elseif level == 14
    @var syntax = "The number of substrings of \"010\" is even"
    @var acceptStrings = String["", "0", "1", "00", "11", "10", "101", "111", "000", "1100", "01010", "001010", "010010", "010101", "101010", "1101010", "0001010", "1110101010100"]
    @var rejectStrings = String["010", "0010", "0100", "0101", "1010", "00010", "00100", "00101", "01000", "01001", "01011", "11010", "10010", "011010", "111010", "01001010", "00101010", "10101010"]
@elseif level == 15
    # Great, very hard
    @var syntax = "All strings with exactly 4 substrings of \"111\" AND the string's length is even"
    @var acceptStrings = String["111111", "00111111", "01111110", "11111100", "11111101", "0111011111", "0111110111", "0111101111", "1111011110", "1111101110", "0101111110", "0001111110", "0111111001", "0111111010", "01110111011110", "1110111011101110"]
    @var rejectStrings = String["", "0", "1", "0101", "111110", "11111110", "1111110", "111101111", "1110111111", "1111110111", "0011111010", "0011111110", "111011101110111", "11111111", "0101111100", "01110111110"]
@elseif level == 16
    @var syntax = "All strings that contain the substring \"01\" AND are even in length"
    @var acceptStrings = String["01", "0101", "0011", "1101", "0100", "1010", "0001", "0110", "1001", "010000", "110011", "001100", "101101", "111001", "01010101", "11011010", "00101100", "11110110"]
    @var rejectStrings = String["", "0", "1", "10", "11", "00", "010", "101", "111", "000", "1100", "1111", "1000", "01000", "10100", "11110", "1010101", "1110111"]
@elseif level == 17
    # FAVORITE, no epsilon
    @var syntax = "All strings that contain the substring \"1011\" but do NOT contain the substring \"010\""
    @var acceptStrings = String["1011", "11011", "10110", "10111", "110111", "1110111", "1111011", "101100", "101110", "101111", "1011000", "1011001", "1011011", "1011110", "10011011", "110110", "11111011", "011011"]
    @var rejectStrings = String["", "0", "1", "010", "01011", "0010111", "1001011", "01011011", "11101011", "10101011", "1111", "1100", "10011", "111000", "0000", "11010", "001011", "00101101"]
@elseif level == 18
    @var syntax = "The length of the string is longer than 2, and shorter than 3 + the substring of the first three digits in binary"
    @var acceptStrings = String["001", "010", "011", "100", "101", "110", "111", "0100", "0111", "1001", "1010", "1101", "1110", "01100", "10011", "10101", "11010", "111010101"]
    @var rejectStrings = String["", "0", "1", "01", "10", "11", "000", "0001", "0010", "01000", "011000", "1000000", "10101010", "11100000000", "00111", "01001", "0111111", "00101"]
@elseif level == 19
    # AMAZING, 15 states
    @var syntax = "All strings where the number of substrings of \"111\" plus the number of substrings of \"010\" is divisible by 3"
    @var acceptStrings = String["", "0", "1", "000", "11111", "0101010", "0101111", "1111010", "00101010", "01010111", "11111111", "01010111111", "10101111111", "01011111110", "01001010", "111110", "00101111", "01010010"]
    @var rejectStrings = String["010", "111", "0111", "0100", "1111", "01010", "010101", "111111", "111010", "010111", "1110111", "0100111", "01111", "001010", "1010111", "1101010", "000010", "010101010"]
@elseif level == 20
    # Good level 8 area
    @var syntax = "The 4th symbol from the end is a 1"
    @var acceptStrings = String["1000", "1111", "1011", "1100", "01000", "11010", "001011", "101000", "01100", "0001110", "1111111", "1101000", "1010101010", "00000001000"]
    @var rejectStrings = String["", "0", "1", "11", "111", "000", "0111", "0000", "0001", "00111", "10111", "10010", "010000", "1100110", "1110111", "0000000"]
@elseif level == 21
    # Great
    @var syntax = "The number of \"01\" substrings equals the number of \"10\" substrings"
    @var acceptStrings = String["", "0", "1", "00", "11", "010", "101", "0110", "1001", "01010", "10101", "000", "111", "0101010", "010010", "00101100", "11011011", "1100110011"]
    @var rejectStrings = String["01", "10", "001", "011", "100", "110", "0001", "1110", "0011", "1100", "0101", "1010", "01011", "10100", "0010111", "1101000"]
@elseif level == 22
    @var syntax = "At every prefix, (number of 0s) minus (number of 1s) stays between -2 and 2"
    @var acceptStrings = String["", "11", "0101", "010110", "1001011", "10001011", "011100110", "0111000111", "01100101110", "011100010110", "0011010111000", "10101010110100", "0101010011110010", "010111010100001110", "01110001110000110100", "1010101100100010110101", "010010101011011100001100"]
    @var rejectStrings = String["000", "11101", "010001", "0010100", "11100100", "011110011", "0101000111", "11100101110", "111100010110", "1011010111000", "11101010110100", "1101010011110010", "110111010100001110", "11110001110000110100", "0010101100100010110101", "110010101011011100001100"]
@elseif level == 23
    @var syntax = "Every maximal run of 0s has length divisible by 3, and every run of 1s has even length"
    @var acceptStrings = String["", "11", "1111", "000000", "1100011", "00000011", "111111000", "1100011000", "00011000000", "111111000000", "1111000000000", "00011000000000", "0000001111000000", "110000001111000000", "11000111100011000000", "0000001100011110001111", "000000111100000011000000"]
    @var rejectStrings = String["1", "101", "11001", "101100", "1011100", "00001111", "011010010", "1010000111", "10011000000", "011111000000", "0111000000000", "10011000000000", "1000001111000000", "010000001111000000", "01000111100011000000", "1000001100011110001111"]
@elseif level == 24
    @var syntax = "Binary value divisible by 7"
    @var acceptStrings = String["", "00", "0000", "000111", "0011100", "11110101", "000101010", "1000001101", "00000111000", "110100111100", "0010101101010", "11011011111101", "1001000110001101", "101110100101011101", "11000000111110101111", "1010011001110001111111", "110011101001011011010101"]
    @var rejectStrings = String["1", "011", "10011", "110010", "1001111", "01011000", "000000001", "0000011101", "10000111000", "010100111100", "1010101101010", "01011011111101", "0001000110001101", "001110100101011101", "01000000111110101111", "0010011001110001111111"]
@elseif level == 25
    @var syntax = "Binary value divisible by 3 AND the number of 1s is even"
    @var acceptStrings = String["", "11", "1111", "100100", "0011110", "00100001", "111100110", "1110110111", "11000001100", "110110111100", "0111111111111", "01000001101110", "0001010101110101", "011000110101101110", "10011000001110000101", "0011110110001001001100", "000110000010001100001101"]
    @var rejectStrings = String["1", "100", "11111", "101111", "1001001", "00111000", "011011100", "1111111101", "01000001100", "010110111100", "1111111111111", "11000001101110", "1001010101110101", "111000110101101110", "00011000001110000101", "1011110110001001001100"]
@elseif level == 26
    @var syntax = "The sum of the (1-indexed) positions of all the 1s is divisible by 3"
    @var acceptStrings = String["", "00", "0101", "001111", "0101101", "10111001", "001000110", "1100001100", "10111001100", "100000010111", "1100010000111", "11000011100111", "0110101101111001", "010111010110100101", "10010101101111000111", "0000110010011010101101", "000011100010100001100010"]
    @var rejectStrings = String["1", "010", "00010", "111010", "1001100", "11110011", "111011010", "1110100110", "00111001100", "000000010111", "0100010000111", "01000011100111", "1110101101111001", "110111010110100101", "00010101101111000111", "1000110010011010101101"]
@elseif level == 27
    @var syntax = "Reading only the bits at even positions (2nd, 4th, 6th, ...) as a binary number, the result is divisible by 3"
    @var acceptStrings = String["", "10", "1101", "000000", "1111101", "01110111", "011000110", "0101111110", "00011000011", "010010011101", "0110101111110", "00111011111001", "0011010001011101", "010111101100010101", "01101110110010001111", "1100101111010010001101", "011101101000100011000110"]
    @var rejectStrings = String["111", "00111", "010101", "1010010", "01110110", "001110110", "1110000011", "01011000011", "000010011101", "0010101111110", "01111011111001", "0111010001011101", "000111101100010101", "00101110110010001111", "1000101111010010001101", "001101101000100011000110"]
@elseif level == 28
