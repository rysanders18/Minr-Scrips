# hotbarFunction(Player player)

@using nfa
@fast

# TODO: make swords unbreakable

# Enchanted if pos1 is set, and about to set pos2
@if hotbarLevel[player] > 2
    @if posMode[player] == true
        @bypass /item replace entity {{player}} hotbar.0 with golden_sword[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"yellow","italic":false,"text":"0 Transition"},lore=[[{"color":"#D4D4D4","text":"Use to create "},{"bold":true,"color":"yellow","text":"0 Transitions "},{"color":"#D4D4D4","text":"between States!"}]],enchantment_glint_override=false] 1
        @bypass /item replace entity {{player}} hotbar.1 with diamond_sword[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"aqua","italic":false,"text":"1 Transition"},lore=[[{"color":"#D4D4D4","text":"Use to create "},{"bold":true,"color":"aqua","text":"1 Transitions "},{"color":"#D4D4D4","text":"between States!"}]],enchantment_glint_override=false] 1
        @bypass /item replace entity {{player}} hotbar.2 with copper_sword[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"#E0734D","italic":false,"text":"2 Transition"},lore=[[{"color":"#D4D4D4","text":"Use to create "},{"bold":true,"color":"#E0734D","text":"2 Transitions "},{"color":"#D4D4D4","text":"between States!"}]],enchantment_glint_override=false] 1
        @bypass /item replace entity {{player}} hotbar.3 with iron_sword[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"white","italic":false,"text":"ε Transition"},lore=[[{"color":"#D4D4D4","text":"Use to create "},{"bold":true,"color":"white","text":"ε Transitions "},{"color":"#D4D4D4","text":"between States!"}]],enchantment_glint_override=false] 1
    @else
        @bypass /item replace entity {{player}} hotbar.0 with golden_sword[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"yellow","italic":false,"text":"0 Transition"},lore=[[{"color":"#D4D4D4","text":"Use to create "},{"bold":true,"color":"yellow","text":"0 Transitions "},{"color":"#D4D4D4","text":"between States!"}]],enchantment_glint_override=true] 1
        @bypass /item replace entity {{player}} hotbar.1 with diamond_sword[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"aqua","italic":false,"text":"1 Transition"},lore=[[{"color":"#D4D4D4","text":"Use to create "},{"bold":true,"color":"aqua","text":"1 Transitions "},{"color":"#D4D4D4","text":"between States!"}]],enchantment_glint_override=true] 1
        @bypass /item replace entity {{player}} hotbar.3 with iron_sword[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"white","italic":false,"text":"ε Transition"},lore=[[{"color":"#D4D4D4","text":"Use to create "},{"bold":true,"color":"white","text":"ε Transitions "},{"color":"#D4D4D4","text":"between States!"}]],enchantment_glint_override=true] 1
        @bypass /item replace entity {{player}} hotbar.2 with copper_sword[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"#E0734D","italic":false,"text":"2 Transition"},lore=[[{"color":"#D4D4D4","text":"Use to create "},{"bold":true,"color":"#E0734D","text":"2 Transitions "},{"color":"#D4D4D4","text":"between States!"}]],enchantment_glint_override=true] 1
    @fi
@else
    @if posMode[player] == true
        @bypass /item replace entity {{player}} hotbar.0 with golden_sword[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"yellow","italic":false,"text":"0 Transition"},lore=[[{"color":"#D4D4D4","text":"Use to create "},{"bold":true,"color":"yellow","text":"0 Transitions "},{"color":"#D4D4D4","text":"between States!"}]],enchantment_glint_override=false] 1
        @bypass /item replace entity {{player}} hotbar.1 with diamond_sword[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"aqua","italic":false,"text":"1 Transition"},lore=[[{"color":"#D4D4D4","text":"Use to create "},{"bold":true,"color":"aqua","text":"1 Transitions "},{"color":"#D4D4D4","text":"between States!"}]],enchantment_glint_override=false] 1
        @bypass /item replace entity {{player}} hotbar.2 with iron_sword[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"white","italic":false,"text":"ε Transition"},lore=[[{"color":"#D4D4D4","text":"Use to create "},{"bold":true,"color":"white","text":"ε Transitions "},{"color":"#D4D4D4","text":"between States!"}]],enchantment_glint_override=false] 1
    @else
        @bypass /item replace entity {{player}} hotbar.0 with golden_sword[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"yellow","italic":false,"text":"0 Transition"},lore=[[{"color":"#D4D4D4","text":"Use to create "},{"bold":true,"color":"yellow","text":"0 Transitions "},{"color":"#D4D4D4","text":"between States!"}]],enchantment_glint_override=true] 1
        @bypass /item replace entity {{player}} hotbar.1 with diamond_sword[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"aqua","italic":false,"text":"1 Transition"},lore=[[{"color":"#D4D4D4","text":"Use to create "},{"bold":true,"color":"aqua","text":"1 Transitions "},{"color":"#D4D4D4","text":"between States!"}]],enchantment_glint_override=true] 1
        @bypass /item replace entity {{player}} hotbar.2 with iron_sword[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"white","italic":false,"text":"ε Transition"},lore=[[{"color":"#D4D4D4","text":"Use to create "},{"bold":true,"color":"white","text":"ε Transitions "},{"color":"#D4D4D4","text":"between States!"}]],enchantment_glint_override=true] 1
    @fi
@fi

@if hotbarLevel[player] > 0
    @bypass /item replace entity @p hotbar.4 with netherite_pickaxe[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"gray","italic":false,"text":"Remove States"},lore=[[{"color":"#D4D4D4","text":"Use to "},{"bold":true,"color":"gray","text":"Remove Any State!"}]],enchantment_glint_override=false,can_break=[{blocks:"netherite_block"},{blocks:"sea_lantern"},{blocks:"emerald_block"}],unbreakable={}] 1
    @bypass /item replace entity @p hotbar.5 with netherite_block[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"dark_gray","italic":false,"text":"Add New State"},lore=[[{"color":"#D4D4D4","text":"Use to add a"},{"bold":true,"color":"dark_gray","text":" New State"},{"bold":false,"color":"#D4D4D4","text":" 3 blocks away in the"}],{"color":"#D4D4D4","text":"direction of the block face you clicked!"}],enchantment_glint_override=false] 1
@fi

@if hotbarLevel[player] > 1
    # @bypass /item replace entity @p hotbar.6 with netherite_ingot[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"#7e7e7e","italic":false,"text":"Convert to Basic State"},lore=[[{"color":"#D4D4D4","text":"Use to convert any state to a "},{"bold":true,"color":"gray","text":"Basic State!"}]],enchantment_glint_override=false] 1
    @bypass /item replace entity @p hotbar.7 with prismarine_crystals[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"dark_aqua","italic":false,"text":"Toggle Initial State"},lore=[[{"color":"#D4D4D4","text":"Use to convert any state to an"},{"bold":true,"color":"dark_aqua","text":" Initial State!"}]],enchantment_glint_override=false] 1
    @bypass /item replace entity @p hotbar.8 with emerald[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"green","italic":false,"text":"Toggle Accepting State"},lore=[[{"color":"#D4D4D4","text":"Use to convert a state to an"},{"bold":true,"color":"green","text":" Accepting State!"}]],enchantment_glint_override=false] 1
@fi

@if hotbarLevel[player] > 3
    @bypass /item replace entity @p hotbar.6 with bamboo_sign[attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:10,operation:"add_value"}],custom_name={"bold":true,"color":"yellow","italic":false,"text":"Write Note to Self"},lore=[[{"color":"#D4D4D4","text":"Click on a state to "},{"bold":true,"color":"dark_purple","text":" Label it!"}]],enchantment_glint_override=false] 1
@fi
        
