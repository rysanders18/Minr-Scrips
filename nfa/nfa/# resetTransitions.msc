# test reset button.msc
@fast
@using nfa

# Gather a list of all players in this level/stage
@define Player[] playersInRoom = Region(String("rynfa" + String(room) + String(world)), "Theta").getPlayersInside()


# Gather a list of all blocks in connections
@define Block[] allBlocks = Block[]
@for String connection in nfa::getConnections(world * 5 + room)
    @define String[] parts = connection.split(";")
    @if parts.length() >= 6 && parts[0] == "connection"
        @var allBlocks.append(Block(Int(parts[1].split(",")[0]), Int(parts[1].split(",")[1]), Int(parts[1].split(",")[2]), "Theta"))
        @var allBlocks.append(Block(Int(parts[2].split(",")[0]), Int(parts[2].split(",")[1]), Int(parts[2].split(",")[2]), "Theta"))
    @fi
@done

# Remove duplicate Blocks
@define String[] uniqueBlockStrings = String[]
@define Block[] uniqueBlocks = Block[]
@for Block block2 in allBlocks
    @define String blockString = block2.getX() + "," + block2.getY() + "," + block2.getZ() + "," + block2.getBlockType()
    @if !uniqueBlockStrings.contains(blockString)
        @var uniqueBlockStrings.append(blockString)
        @var uniqueBlocks.append(block2)
    @fi
@done

# Set all Iron Blocks to Netherite Blocks, keeping the block list in sync (2 -> 1) for
# every player in the room so setupRoom can later rebuild the post-reset state correctly.
@for Block block3 in uniqueBlocks
    @if block3.getBlockType() == "IRON_BLOCK"
        @bypass /setblock {{block3.getX()}} {{block3.getY()}} {{block3.getZ()}} minecraft:netherite_block
        @for Player p in playersInRoom
            @var nfa::editListOfBlocks(p, room, world, block3, 1)
        @done
    @fi
@done

# Kill ONLY this room's branch entities (not @e[tag=nfaBranch], which is every room).
# This room's global branch list holds each branch's tag; kill them before clearRoom.
@for String branchTag in nfa::getBranches(world * 5 + room)
    @bypass /minecraft:kill @e[tag={{branchTag}}]
@done

# Clear the relative copy for every player in the room...
@for Player p in playersInRoom
    @var listOfBranches[p] = String[]
    @var listOfConnections[p] = String[]
@done

# ...and the shared per-room global lists (connections + branches).
@var nfa::clearRoom(world * 5 + room)
@bypass /minecraft:kill @e[tag=nfaBranch{{room}}{{world}},distance=..50]

@bypass /playsound minecraft:entity.player.levelup master {{player}} ~ ~ ~ 0.5 0.8
