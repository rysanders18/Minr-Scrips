# allTestsPassedTitle(Player player)

# Plays a celebratory subtitle animation that spells out "All Tests Passed!"
# one character at a time, one tick apart, each character tinted with a smooth
# rainbow gradient. The title line is kept empty so only the subtitle shows.

@using nfa
@fast

# One glyph per entry, with a matching gradient color (full-rainbow sweep).
@define String[] chars = String["A", "l", "l", " ", "T", "e", "s", "t", "s", " ", "P", "a", "s", "s", "e", "d", "!"]
@define String[] colors = String["#dbfa61", "#d5fa5d", "#d0f959", "#c9f955", "#c3f951", "#bdf84d", "#b6f84a", "#aff846", "#a8f743", "#a0f73f", "#98f63c", "#8ff639", "#86f637", "#7cf534", "#72f532", "#66f430", "#59f42f"]

# Instant fade-in so each new frame snaps in; long stay so the finished line lingers.
@bypass /title {{player}} times 0 70 15

# Accumulated subtitle JSON (grows by one text component each tick).
@define String sub = ""

@bypass /execute at {{player}} run particle minecraft:happy_villager ~ ~ ~ 3 3 3 1 100
@bypass /execute at {{player}} run playsound minecraft:ui.toast.challenge_complete master {{player}} ~ ~ ~ 0.75 1.2

@for Int i in list::range(0, chars.length())
    @if i < chars.length()
        @var sub = sub + ",{\"text\":\"" + chars[i] + "\",\"bold\":true,\"color\":\"" + colors[i] + "\"}"

        # Set the subtitle, then push an empty title to trigger the display.
        @bypass /title {{player}} subtitle [""{{sub}}]
        @bypass /title {{player}} title [""]

        # Rising pitch from 0.5 -> 2.0 across the 17 glyphs.
        @define Double pitch = 0.5 + Double(i) * 0.09375
        @bypass /execute at {{player}} run playsound minecraft:entity.chicken.egg master {{player}} ~ ~ ~ 0.75 {{pitch}}
        @bypass /execute at {{player}} run playsound minecraft:block.small_amethyst_bud.place master {{player}} ~ ~ ~ 1.5 {{math::random(0.9D, 1.1D)}}
        @bypass /execute at {{player}} run particle minecraft:happy_villager ~ ~0.5 ~ 1 1 1 1 3
        @delay 1
    @fi
@done

# Keep the subtitle on screen, but have a two character underline animation from the start of the string to the end, moving 1 character per tick.
# Each frame re-renders the full subtitle, underlining the two glyphs (pos-1, pos) at the sliding window.
# pos runs 0..length inclusive, so the window starts as a single char (only glyph 0) and ends as a single char (only the last glyph).
@for Int pos in list::range(0, chars.length() + 1)
    @if pos < chars.length() + 1
        @define String line = ""
        @for Int j in list::range(0, chars.length())
            @if j < chars.length()
                # MSC won't reliably stringify a Boolean inside concatenation, so build the flag as text.
                @define String und = "false"
                @if j == pos - 1 || j == pos
                    @var und = "true"
                @fi
                @var line = line + ",{\"text\":\"" + chars[j] + "\",\"bold\":true,\"underlined\":" + und + ",\"color\":\"" + colors[j] + "\"}"
            @fi
        @done

        # Set the subtitle, then push an empty title to trigger the display.
        @bypass /title {{player}} subtitle [""{{line}}]
        @bypass /title {{player}} title [""]

        # Tick blip that rises in pitch as the underline sweeps left -> right.
        @define Double pitch = 0.5 + Double(pos) * 0.09375
        @bypass /execute at {{player}} run playsound minecraft:block.note_block.hat master {{player}} ~ ~ ~ 0.6 {{pitch}}
        @delay 1
    @fi
@done

# Restore the plain (non-underlined) subtitle so the finished line lingers cleanly.
@bypass /title {{player}} subtitle [""{{sub}}]
@bypass /title {{player}} title [""]
