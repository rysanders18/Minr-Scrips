# Int squareIndex(String name)
# Converts algebraic notation ("a1".."h8") to a square index 0..63.
# Returns -1 if the input is not a well-formed two-character name.
# Uses lookup tables instead of Int(rankChar) so non-digit input
# fails safely with -1 rather than throwing.

@using rychess
@fast

@if name.length() != 2
    @return -1
@fi

@define String fileChar = name.substring(0, 1)
@define String rankChar = name.substring(1, 2)
@define String[] files = String["a", "b", "c", "d", "e", "f", "g", "h"]
@define String[] ranks = String["1", "2", "3", "4", "5", "6", "7", "8"]

@define Int fileIdx = -1
@for Int fi in list::range(0, 8)
    @if files[fi] == fileChar
        @var fileIdx = fi
    @fi
@done

@define Int rankIdx = -1
@for Int ri in list::range(0, 8)
    @if ranks[ri] == rankChar
        @var rankIdx = ri
    @fi
@done

@if fileIdx < 0 || rankIdx < 0
    @return -1
@fi

@return rankIdx * 8 + fileIdx
