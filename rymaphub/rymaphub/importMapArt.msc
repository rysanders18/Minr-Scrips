# importMapArt(Player player)
# Entry point - bind to the import sign/block at the hub. Collects the
# RYmaphub chat messages produced by the web page, one @prompt per
# message, validates each one as it arrives, and hands the accumulated
# symbol stream to decodeMapArt.
#
# Message 1 carries the header in front of its own payload (protocol v6):
#   "RYMH" + A[P] + A[n-1-nMsgs] + payload + skip(check)
# where n is the alphabet size and P is pixels per plain symbol (1 or 2).
# No message carries nothing but a header, so every run is a line shorter
# and a small image can be a single message. No palette is sent: pixels are
# master colour indices and the radix is the namespace constant `colours`,
# so the header costs 6 characters whatever the image contains.
# nMsgs is written from the top of the alphabet and is the field next to
# the payload, whose symbol values are far lower, so no two adjacent
# characters can be equal; check = (P + nMsgs + sum(payload)) % (n-1).
# Messages 2..nMsgs are A[n-1-index] + payload + skip(check). A bad
# message (wrong index, foreign character, checksum mismatch) is reported
# and re-prompted without losing progress. "cancel" aborts. Displayed
# message numbers are 1-based to match the web page; internal indices are
# 0-based.
#
# Feedback: every accepted message plays a note block pling whose pitch
# climbs from 0.5 to 2.0 across the paste, alongside a progress bar and a
# particle burst that walks the gradient in `colors`, so the run can be
# followed without reading the numbers. Failures play a low didgeridoo.

@using rymaphub

@define String msg = ""
@define String alpha = alphaU
@define String body = ""
@define Int pps = 1
@define Int n = alpha.length()
@define Int nMsgs = 0
@define Int blen = 0
@define Int s = 0
@define Int total = 0
@define Int prev = 0
@define Int c = 0
@define Int got = 0
@define Boolean bad = false
@define Boolean headerOk = false

# A truncated alphabet import shifts every symbol value, so every message
# fails its checksum while looking perfectly intact. Check it up front
# rather than leaving that to be diagnosed the hard way.
@if n != 2980
    @player &c&lRYmaphub is misconfigured.&c The alphabet imported as {{n}} characters, expected 2980.
    @player &cRe-import &frymaphub.nms&c before trying again.
    @bypass playsound minecraft:block.note_block.didgeridoo master {{player}} ~ ~ ~ 1 0.5
    @return
@fi

@define String[] colors = String["[0.988,0.914,0.329]", "[0.973,0.914,0.341]", "[0.957,0.914,0.349]", "[0.945,0.914,0.357]", "[0.929,0.914,0.369]", "[0.914,0.914,0.376]", "[0.898,0.918,0.384]", "[0.882,0.918,0.392]", "[0.867,0.918,0.4]", "[0.851,0.918,0.408]", "[0.835,0.918,0.416]", "[0.82,0.918,0.424]", "[0.804,0.918,0.431]", "[0.788,0.918,0.439]", "[0.769,0.918,0.443]", "[0.753,0.918,0.451]", "[0.737,0.914,0.459]", "[0.718,0.914,0.463]", "[0.702,0.914,0.471]", "[0.682,0.914,0.478]", "[0.663,0.914,0.482]", "[0.647,0.914,0.49]", "[0.627,0.914,0.494]", "[0.608,0.914,0.502]", "[0.584,0.914,0.506]", "[0.565,0.914,0.51]", "[0.545,0.91,0.518]", "[0.522,0.91,0.522]", "[0.498,0.91,0.529]", "[0.475,0.91,0.533]", "[0.451,0.91,0.537]", "[0.424,0.91,0.541]", "[0.392,0.906,0.549]", "[0.365,0.906,0.553]", "[0.329,0.906,0.557]", "[0.29,0.906,0.561]", "[0.247,0.906,0.569]", "[0.196,0.902,0.573]", "[0.118,0.902,0.576]"]

@player
@player &#936be5&lRY's Map Hub
@player &#d4d4d4● Paste the messages from
@player &a&l &f rysanders18.github.io/rymaphub&#d4d4d4 in order.
@player
@player &e&lPaste message 1&e into chat.
@player

@bypass title {{player}} actionbar ["",{"text":"Type ","bold":false,"color":"#a1a1a1"},{"text":"\"Cancel\"","bold":true,"color":"#aa4c4c"},{"text":" at any point to stop!","bold":false,"color":"#a1a1a1"}]
@bypass playsound minecraft:block.note_block.harp master {{player}} ~ ~ ~ 1 1.5

# Message 1: a few attempts, then give up. It carries the header fields, so
# nothing else can be read until it lands.
@for Int attempt in list::range(0, 3)
    @if headerOk == false
        @prompt 90s msg &cTimed out waiting for message 1. Click the sign to start again.
        @if msg.startsWith("RYMH") == false
            @bypass playsound minecraft:block.note_block.didgeridoo master {{player}} ~ ~ ~ 1 0.5
            @player &cThat is not a RYmaphub message. Paste message 1 first, and regenerate it on the website if it is old.
        @else
            @var body = msg.substring(4, msg.length())
            @var blen = body.length()
            @var bad = false
            @if blen < 3
                @var bad = true
            @else
                @var pps = alpha.indexOf(body.substring(0, 1))
                @var nMsgs = n - 1 - alpha.indexOf(body.substring(1, 2))
                @if pps < 1 || pps > 2 || nMsgs < 1
                    @var bad = true
                @else
                    @var total = pps + nMsgs
                    @for Int i in list::range(2, blen - 1)
                        @var s = alpha.indexOf(body.substring(i, i + 1))
                        @if s < 0
                            @var bad = true
                        @else
                            @var total = total + s
                        @fi
                    @done
                    # The checksum skips the value of the character before it.
                    @var prev = alpha.indexOf(body.substring(blen - 2, blen - 1))
                    @var c = alpha.indexOf(body.substring(blen - 1, blen))
                    @var got = c
                    @if c > prev
                        @var got = c - 1
                    @fi
                    @if got != total % (n - 1)
                        @var bad = true
                    @fi
                @fi
            @fi
            @if bad == true
                @bypass playsound minecraft:block.note_block.didgeridoo master {{player}} ~ ~ ~ 1 0.5
                @player &cMessage 1 is damaged. Received {{msg.length()}} characters. Paste it again.
                # @player &8[diag] alphabet {{n}}
            @else
                @var headerOk = true
            @fi
        @fi
    @fi
@done

@if headerOk == false
    @player &cCould not read message 1. Start again from the sign.
    @return
@fi

# Everything between the header fields and the checksum is payload, so the
# stream starts with message 1 rather than empty.
@var mapData[player] = body.substring(2, blen - 1)
@define Int next = 1
@define Int code = 0
@define Int dataTotal = nMsgs - 1
@define Int received = 0
@define Int filled = 0
@define String bar = ""
@define Float pitch = 2.0F

@bypass playsound minecraft:block.note_block.bell master {{player}} ~ ~ ~ 1 1
@if next < nMsgs
    @player &aMessage 1 accepted. &f{{dataTotal}}&a to go.
    @player &e&lPaste message 2.
@fi

# Data messages. No @while in MSC, so loop over an attempt budget and
# stop prompting once every message is in (or the player cancels).
@for Int attempt in list::range(0, nMsgs + 40)
    @if next < nMsgs
        @prompt 90s msg &cTimed out. Click the button to start again.
        @if msg.equalsIgnoreCase("cancel") || msg.equalsIgnoreCase("stop") || msg.equalsIgnoreCase("exit")
            @var next = nMsgs + 1000
        @else
            @var code = checkMessage(alpha, msg, next)
            @if code == 0
                @var mapData[player] = mapData[player] + msg.substring(1, msg.length() - 1)
                @var next = next + 1
                @var received = next - 1

                # Pitch climbs 0.5 -> 2.0 across the whole paste.
                @var pitch = 2.0F
                @if dataTotal > 1
                    @var pitch = 0.5F + 1.5F * Float(received - 1) / Float(dataTotal - 1)
                @fi
                @bypass playsound minecraft:block.note_block.pling master {{player}} ~ ~ ~ 0.5 {{pitch}}
                @bypass playsound minecraft:entity.firework_rocket.twinkle_far master {{player}} ~ ~ ~ 0.3 {{pitch}}
                @bypass particle dust_color_transition{from_color:{{colors[received % colors.length()]}},scale:1,to_color:[1.000,1.000,1.000]} 4096.5 95.5 2054.88 0.05 0.02 0.02 1 10 force @s
                @bypass title {{player}} actionbar ["",{"text":"Type ","bold":false,"color":"#a1a1a1"},{"text":"\"Cancel\"","bold":true,"color":"#aa4c4c"},{"text":" at any point to stop!","bold":false,"color":"#a1a1a1"}]
                
                @if next < nMsgs
                    @var filled = received * 20 / dataTotal
                    @var bar = "&a"
                    @for Int b in list::range(0, 20)
                        @if b == filled
                            @var bar = bar + "&8"
                        @fi
                        @var bar = bar + "|"
                    @done
                    @player &8[{{bar + 1}}&8] &f{{received + 1}}&#d4d4d4/&f{{dataTotal}}&8 - &#d4d4d4paste message &f{{next + 1}}
                @fi
            @else
                @bypass playsound minecraft:block.note_block.didgeridoo master {{player}} ~ ~ ~ 1 0.5
                @bypass title {{player}} actionbar ["",{"text":"Type ","bold":false,"color":"#a1a1a1"},{"text":"\"Cancel\"","bold":true,"color":"#aa4c4c"},{"text":" at any point to stop!","bold":false,"color":"#a1a1a1"}]
                @if code == 2
                    @var got = n - 1 - alpha.indexOf(msg.substring(0, 1))
                    @player &cThat is message {{got + 1}}, but message {{next + 1}} is next.
                @elseif code == 1
                    @player &cMessage {{next + 1}} picked up a character that is not part of the code. Copy and paste it again.
                @elseif code == 3
                    @player &cMessage {{next + 1}} failed its checksum. Copy and paste it again.
                    # @player &8[diag] {{msg.length()}} characters received, alphabet {{n}}
                @else
                    @player &cThat message is too short ({{msg.length()}} characters).
                @fi
            @fi
        @fi
    @fi
@done

@if next == nMsgs
    @var decodeMapArt(player, pps)
@elseif next > nMsgs
    @player &#d4d4d4Import cancelled.
@else
    @player &cToo many failed messages. Start again from the sign.
@fi
