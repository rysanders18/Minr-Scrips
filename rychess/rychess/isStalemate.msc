# Boolean isStalemate(Player player)
# True iff the side-to-move has no legal moves AND is NOT currently
# in check (which would be checkmate instead). Used by the game-
# over checker after each move.

@using rychess
@fast

@define Int[] moves = genLegalMoves(player)
@if moves.length() == 0 && !inCheck(player)
    @return true
@fi
@return false
