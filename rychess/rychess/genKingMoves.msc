# Int[] genKingMoves(Player player, Int sq)
# Returns the pseudo-legal king moves for the king at sq, including
# castling. Castling is generated already-filtered for in-check and
# passing-through-check because the genLegalMoves post-move filter
# only catches the landing-square attack, not the squares the king
# crosses. Conditions enforced here:
#   - matching castling-rights bit is still set
#   - intermediate squares between king and rook are empty
#   - king is not currently in check
#   - the square the king passes over is not attacked
#   - the destination square is not attacked
# Flag values: 4 = kingside castle, 5 = queenside castle.

@using rychess
@fast

@define Int[] moves = Int[]
@define Int piece = board[player][sq]
@define Int myColor = pieceColor(piece)
@define Int srcFile = sq % 8
@define Int srcRank = sq / 8

@define Int[] dx = Int[-1, 0, 1, 1, 1, 0, -1, -1]
@define Int[] dy = Int[-1, -1, -1, 0, 1, 1, 1, 0]

@for Int i in list::range(0, 8)
    @define Int targetFile = srcFile + dx[i]
    @define Int targetRank = srcRank + dy[i]
    @if targetFile >= 0 && targetFile <= 7 && targetRank >= 0 && targetRank <= 7
        @define Int target = targetRank * 8 + targetFile
        @define Int targetPiece = board[player][target]
        @if targetPiece == 0
            @var moves.append(moveEncode(sq, target, 0, 0))
        @elseif pieceColor(targetPiece) != myColor
            @var moves.append(moveEncode(sq, target, 0, 1))
        @fi
    @fi
@done

@if myColor == 0 && sq == 4
    @if (castling[player] % 2) == 1
        @if board[player][5] == 0 && board[player][6] == 0
            @if !isSquareAttacked(player, 4, 1) && !isSquareAttacked(player, 5, 1) && !isSquareAttacked(player, 6, 1)
                @var moves.append(moveEncode(4, 6, 0, 4))
            @fi
        @fi
    @fi
    @if ((castling[player] / 2) % 2) == 1
        @if board[player][1] == 0 && board[player][2] == 0 && board[player][3] == 0
            @if !isSquareAttacked(player, 4, 1) && !isSquareAttacked(player, 3, 1) && !isSquareAttacked(player, 2, 1)
                @var moves.append(moveEncode(4, 2, 0, 5))
            @fi
        @fi
    @fi
@fi

@if myColor == 1 && sq == 60
    @if ((castling[player] / 4) % 2) == 1
        @if board[player][61] == 0 && board[player][62] == 0
            @if !isSquareAttacked(player, 60, 0) && !isSquareAttacked(player, 61, 0) && !isSquareAttacked(player, 62, 0)
                @var moves.append(moveEncode(60, 62, 0, 4))
            @fi
        @fi
    @fi
    @if ((castling[player] / 8) % 2) == 1
        @if board[player][57] == 0 && board[player][58] == 0 && board[player][59] == 0
            @if !isSquareAttacked(player, 60, 0) && !isSquareAttacked(player, 59, 0) && !isSquareAttacked(player, 58, 0)
                @var moves.append(moveEncode(60, 58, 0, 5))
            @fi
        @fi
    @fi
@fi

@return moves
