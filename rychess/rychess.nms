@namespace rychess

# Variables - per-player game state

    relative Int[] board = Int[]
    relative Int sideToMove = 0
    relative Int castling = 15
    relative Int epSquare = -1
    relative Int halfmoveClock = 0
    relative Int fullmove = 1
    relative Int undoPly = 0
    relative Int[] undoStack = Int[]
    relative Int runningScore = 0
    relative Int[] pieceCodeAt = Int[]
    relative Int selectedSquare = -1
    relative Int playerColor = 0
    relative Int[] highlightedSquares = Int[]

# Variables - phase 1 test scratch

    relative Int[] testBoard = Int[]

# Variables - profiling counters (reset at start of chooseMove,
# dumped at end). Track call counts of the hot functions so we
# can localize where compute is actually being spent.

    relative Int profGenLegal = 0
    relative Int profGenOrdered = 0
    relative Int profSearchInner = 0
    relative Int profQsearch = 0
    relative Int profMakeMove = 0
    relative Int profEvaluate = 0
    relative Int profIsAttacked = 0
    relative Int profInCheck = 0

