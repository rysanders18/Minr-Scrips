# Functions - game lifecycle

    newGame(Player player)
    boardStartPos(Player player)
    Int boardGet(Player player, Int sq)
    boardSet(Player player, Int sq, Int piece)

# Functions - move encoding

    Int moveEncode(Int fromSq, Int toSq, Int promo, Int flags)
    Int moveFrom(Int move)
    Int moveTo(Int move)
    Int movePromo(Int move)
    Int moveFlags(Int move)

# Functions - I/O helpers

    String squareName(Int sq)
    Int squareIndex(String name)
    String pieceGlyph(Int piece)
    displayBoard(Player player)
    movePieceVisually(Int pieceCode, Int targetSq)
    sinkPiece(Int pieceCode, Int currentSq)
    applyMoveVisually(Player player, Int move)
    Float[] lookupPieceBase(Int pieceCode)
    applyTransform(Int pieceCode, Int sq, Float[] base, Float yOffset)
    recolorPiece(Int pieceCode, String blockName)

# Functions - phase 1 tests

    Int[] buildList(Int n)
    Int factorial(Int n)
    Int recurseDepth(Int depth, Int target)

    testPlayerKeyedArray(Player player)
    testRecursion(Player player)
    testReturnInLoop(Player player)

# Functions - phase 2 tests

    testMoveCodec(Player player)
    testSquareNames(Player player)
    testStartPosDisplay(Player player)

# Functions - piece classification

    Int pieceColor(Int piece)
    Int pieceType(Int piece)
    Int pieceContrib(Int piece, Int sq)

# Functions - move generation (pseudo-legal, phase 3)

    Int[] genPawnMoves(Player player, Int sq)
    Int[] genKnightMoves(Player player, Int sq)
    Int[] genBishopMoves(Player player, Int sq)
    Int[] genRookMoves(Player player, Int sq)
    Int[] genQueenMoves(Player player, Int sq)
    Int[] genKingMoves(Player player, Int sq)
    Int[] genAllPseudoLegal(Player player)

# Functions - state transitions

    makeMove(Player player, Int move)
    unmakeMove(Player player, Int move)

# Functions - legality (phase 4)

    Int findKing(Player player, Int color)
    Boolean isSquareAttacked(Player player, Int sq, Int byColor)
    Boolean inCheck(Player player)
    Int[] genLegalMoves(Player player)

# Functions - perft

    Int perft(Player player, Int depth)

# Functions - engine (phase 5)

    Int evaluate(Player player)
    Int[] genOrderedLegalMoves(Player player)
    Int qsearch(Player player, Int alpha, Int beta, Int recaptureSq, Int qsDepth)
    Int searchInner(Player player, Int depth, Int alpha, Int beta)
    Int chooseMove(Player player)
    engineMove(Player player)

# Functions - game termination & input (phase 6)

    Boolean isCheckmate(Player player)
    Boolean isStalemate(Player player)
    Boolean checkGameOver(Player player)
    Int parseMove(Player player, String moveStr)
    play(Player player, Int humanColor)
    interactEntity(Player player, Int square)
    Boolean isLightSquare(Int sq)
    highlightMoves(Player player, Int square)
    clearHighlights(Player player)
    resetAllBoardTextures(Player player)
    playSelectSound(Player player)
    playDeselectSound(Player player)
    playMoveSound(Player player)
    playCaptureSound(Player player)
    playCheckSound(Player player)
    playCheckmateSound(Player player)

# Functions - phase 3 tests

    testGenStartPos(Player player)
    testMakeUnmake(Player player)

# Functions - phase 4 tests

    testPerft(Player player)

# Functions - phase 5 tests

    testEngineMove(Player player)

@endnamespace
