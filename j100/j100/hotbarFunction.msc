# hotbarFunction(Player player)

@using j100
@fast

@bypass /clear {{player}}

@bypass /item replace entity {{player}} hotbar.3 with minecraft:stick[item_model="minecraft:ender_pearl",attribute_modifiers=[{id:"block_interaction_range",type:"block_interaction_range",amount:30,operation:"add_value"}],custom_name={"bold":true,"color":"#3D7FB3","italic":false,"text":"TP to Coords"},lore=[[{"color":"#D4D4D4","text":"Use to "},{"bold":true,"color":"#3D7FB3","text":"Teleport "},{"color":"#D4D4D4","text":"to the Coords you set!"}]],enchantment_glint_override=false] 1
@bypass /item replace entity {{player}} hotbar.4 with minecraft:gold_ingot[attribute_modifiers=[{id:"tool_block_range",type:"block_interaction_range",amount:30,operation:"add_value",slot:"mainhand"}],custom_name={"bold":true,"color":"#E5B932","italic":false,"text":"Set Custom Position"},lore=[[{"color":"#D4D4D4","text":"Click to "},{"bold":true,"color":"#E5B932","text":"Set "},{"color":"#D4D4D4","text":"a custom position for this level!"}]],enchantment_glint_override=false] 1
@bypass /item replace entity {{player}} hotbar.5 with minecraft:redstone[attribute_modifiers=[{id:"tool_block_range",type:"block_interaction_range",amount:30,operation:"add_value",slot:"mainhand"}],custom_name={"bold":true,"color":"#C1121C","italic":false,"text":"Remove Custom Position"},lore=[[{"color":"#D4D4D4","text":"Click to "},{"bold":true,"color":"#C1121C","text":"Remove "},{"color":"#D4D4D4","text":"the custom position for this level!"}]],enchantment_glint_override=false] 1
@bypass /item replace entity {{player}} hotbar.7 with minecraft:shield
@bypass /item replace entity {{player}} hotbar.8 with minecraft:barrier[attribute_modifiers=[{id:"tool_block_range",type:"block_interaction_range",amount:30,operation:"add_value",slot:"mainhand"}],custom_name={"bold":true,"color":"#C0392B","italic":false,"text":"Leave Level"},lore=[[{"color":"#D4D4D4","text":"Click to "},{"bold":true,"color":"#C0392B","text":"Leave "},{"color":"#D4D4D4","text":"this level!"}]],enchantment_glint_override=false] 1
