# fallRegion(Player player)
# Runs when a player lands in the catch region under the jumps.
#
# Banks the time spent on the jump they fell out of (see touchLevel), counts
# the fall, and teleports them back to that jump's start.
#
# The fall is only counted if the jump is NOT already beaten. Falls on an
# already-beaten jump are people messing about after the fact, and they used to
# inflate that jump's difficulty stats.

@using j100
@fast

@define Int level

@bypass /effect give @s minecraft:saturation infinite 1 true

@for Int i in list::range(0, 10)
    @for Int j in list::range(0, 10)
        @if player.getX() < (4843.5 - 18.0 * i) && player.getX() > (4827.5 - 18.0 * i) && player.getZ() < (2970.5 - 18.0 * j) && player.getZ() > (2954.5 - 18.0 * j)
            @var level = i * 10 + j
            @var touchLevel(player, level)

            @if levelsCompleted[player][level]
                @player &cYou have already completed this jump!
            @else
                @var levelFalls[player][level] += 1
            @fi

            @var player.teleport(playerLevelPositions[level])
            @return
        @fi
    @done
@done
