    # one-time interact-script mass import - run interactImport1 by hand once.
    # Chains 1 -> 7 automatically. Generated by gen_interact_imports.py from
    # setup1.msc + setup2.msc; removes then puts clickBlock on every block
    # except air, light and plain glass, so re-running is safe.
    interactImport1(Player player)
    interactImport2(Player player)
    interactImport3(Player player)
    interactImport4(Player player)
    interactImport5(Player player)
    interactImport6(Player player)
    interactImport7(Player player)



@endnamespace