# entity_ai::EntityPose(Entity entity)
# Default armor stand pose (vanilla defaults: arms slightly out, legs
# slightly apart). rotation = -1 means merge() leaves Rotation alone.
@using entity_ai

@var this.entity = entity
@var this.rightArm = Vector3(-15D, 0D, 10D)
@var this.leftArm = Vector3(-10D, 0D, -10D)
@var this.rightLeg = Vector3(1D, 0D, 1D)
@var this.leftLeg = Vector3(-1D, 0D, -1D)
@var this.head = Vector3(0D, 0D, 0D)
@var this.body = Vector3(0D, 0D, 0D)
@var this.rotation = -1D
@var this.moveAlignment = true

@return this
