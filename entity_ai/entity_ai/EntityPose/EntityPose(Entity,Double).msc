# entity_ai::EntityPose(Entity entity, Double rotation)
# Default pose plus a body yaw that merge() will write as
# Rotation:[yaw, 0]. Used by watch() so returning to the rest pose keeps
# the stand facing where it last looked.
@using entity_ai

@var this.entity = entity
@var this.rightArm = Vector3(-15D, 0D, 10D)
@var this.leftArm = Vector3(-10D, 0D, -10D)
@var this.rightLeg = Vector3(1D, 0D, 1D)
@var this.leftLeg = Vector3(-1D, 0D, -1D)
@var this.head = Vector3(0D, 0D, 0D)
@var this.body = Vector3(0D, 0D, 0D)
@var this.rotation = rotation
@var this.moveAlignment = true

@return this
