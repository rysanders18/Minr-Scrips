# rotate(Double degrees, Double degreesPerSecond)
# Turns the stand by `degrees` (positive = clockwise) in per-tick steps.
#
# FIX: the original wrote {Rotation:[yawf]} with /data merge. On 1.21.6+
# that one-element list fails the [yaw, pitch] codec and the stand snaps
# to yaw 0 every tick. The merge now always carries [yaw, 0.0f].
# (/data merge rather than /tp: SNBT floats accept exponent notation
# such as 1.2E-5f, Brigadier's /tp yaw argument does not.)
@using entity_ai

@define Double blocksPerTick = degreesPerSecond / 10
@define Int ticks = math::ceil((math::abs(degrees) * 10) / degreesPerSecond)
@define Double finalDirection = (this.helper.getRotation() + degrees + 720) % 360

@if degrees < 0
    @var blocksPerTick *= -1D
@fi

@if this.debugMode
    @player &3&l=== Rotate info ===
    @player &7Entity Coords [X/Z]: &3({{getRoundDouble(this.entity.getX())}}, {{getRoundDouble(this.entity.getZ())}})
    @player &7Start Rotation Position: &3{{getRoundDouble(this.helper.getRotation())}}
    @player
    @player &7Degrees Per Tick: &3{{getRoundDouble(blocksPerTick)}}
    @player &7Ticks Total: &3{{ticks}}
    @player
@fi

# --- Iterate for the requested number of ticks ---
@for Int i in list::range(1, ticks + 1)
    @bypass /data merge entity {{this.entity.getUniqueId()}} {Rotation:[{{(this.helper.getRotation() + blocksPerTick + 720) % 360}}f,0.0f]}
@done

# --- Snap to the exact final direction and remember it for merges ---
@bypass /data merge entity {{this.entity.getUniqueId()}} {Rotation:[{{finalDirection}}f,0.0f]}
@var this.currentPose.rotation = finalDirection

@if this.debugMode
    @player &3&l=== Rotation Final Info ===
    @player &7Destination Rotation Position: &3{{getRoundDouble(this.helper.getRotation())}}
@fi
