    splice(Player player, Int n, Block trigger, Block next1, Block next2)
    scaryTitle(Player player)
    text(Int textNumber, Player player)
    spliceFx(Player player)
    fallFx1(Player player)
    fallFx2(Player player)
    slimeblock(Player player, Block slimeblock, Block[] future)
