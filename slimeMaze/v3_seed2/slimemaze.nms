@namespace slimemaze

# Seamless slime-bounce maze - generate_maze.py (seed 2)
# 10 entries at y=300 merge into 3 tunnels (golden trunk + trunk ports); one line reaches y=-64
# 5598 blocks, 178 forks, 1506 dead ends (184 spliced, 1 merged)
# 1 braids (both fork choices win, rejoining lower) and 175 of 184 teleports land somewhere the player has not been
# fork cadence: no stretch runs more than 20 bounces without a fork (max 29, avg 9.6, 30.6 blocks per fork)
# Bounds: x 4389..4846, z 3154..3605
#

# Variables (hand-added state used by the HAND-TUNED hooks)

    relative Int streak = 0
    relative Long timeOfLastDarkness = 0L
    relative Boolean darkness = false
    relative String lastColor = "LIGHT_BLUE"
    relative Block lastBlock
    relative Int actionbarWord = 8

# Action-bar colour wipe state - see slimemaze/actionbar.msc for what
# each slot means and who writes it. The two colour defaults must match
# the hexColor fallback in slimeblock.msc, so the first bounce of a run
# paints solid instead of wiping green over green.
    relative String barTarget = "#00FF00"
    relative String barOld = "#00FF00"
    relative String barText = ""
    relative String barSound = "minecraft:block.moss.step"
    relative Double barVol = 0.3D
    relative Int barCut = 0
    relative Int barGen = 0
    relative Int barLive = 0

# One BLOCK STEP sound per carpet colour, index-aligned with the
# carpets/hexColors tables in slimeblock.msc - the maze answers a colour
# change by sounding like the block that colour is made of:
#    0 white       snow          8 light_gray  calcite
#    1 orange      copper        9 cyan        sculk
#    2 magenta     nether wart  10 purple      amethyst
#    3 light_blue  powder snow  11 blue        glass
#    4 yellow      sand         12 brown       mud
#    5 lime        SLIME        13 green       moss
#    6 pink        pink petals  14 red         netherrack
#    7 gray        deepslate    15 black       basalt
# Lime gets the slime block: the one colour that sounds like the thing
# the player is actually riding.
# Step sounds are short, dry and land cleanly at one per tick where a
# sustained sound would smear across the wipe. Namespace constant, not a
# local: read on colour changes only, but a local would re-allocate the
# whole list every time.
    String[] barSounds = String["minecraft:block.snow.step", "minecraft:block.copper.step", "minecraft:block.bone_block.step", "minecraft:block.powder_snow.step", "minecraft:block.trial_spawner.step", "minecraft:block.candle.step", "minecraft:block.pink_petals.step", "minecraft:block.sculk_catalyst.step", "minecraft:block.iron.step", "minecraft:block.nether_wood.step", "minecraft:block.amethyst_block.step", "minecraft:block.glass.step", "minecraft:block.iron.step", "minecraft:block.copper_bulb.step", "minecraft:block.netherrack.step", "minecraft:block.basalt.step"]

# Per-colour playsound VOLUME, index-aligned with barSounds (same legend
# as above) - vanilla step sounds are mastered wildly differently, so
# one global volume leaves some barking and some inaudible. 0.3D was the
# old global value; raise the quiet ones / lower the loud ones here.
    Double[] barVolumes = Double[0.30D, 0.21D, 0.15D, 0.13D, 0.14D, 0.3D, 0.16D, 0.20D, 0.18D, 0.09D, 0.20D, 0.20D, 0.20D, 0.18D, 0.15D, 0.20D]

    String[] actionbarWords = String["Voices", "Nightmares", "Mistakes", "Failures", "Horrors", "Regrets", "Wounds", "Doubts", "Choices", "Walls", "Sessions", "Faces", "Screams", "Secrets", "Lies", "Memories", "Losses", "Terrors"]



#
# Build:  /function execute slimemaze::build1(Player("You"))
# Splice: /function execute slimemaze::splice(Player("You"), Int(n), Block(x, y, z, "Epsilon"), Block(...), Block(...))
# Fall:   /function execute slimemaze::fall(Player("You"))
# Grounds: /function execute slimemaze::grounds1(Player("You"))
# Build parts chain automatically; the build chain runs
# grounds1 (splice trigger blankets) then slimegrounds1 (per-
# Importing the namespace wires NOTHING (__init__ is
# documentation only - every trigger import is too many lines) -
# after a re-import, run grounds1 once to re-wire everything.

    actionbar(Player player, String hexColor, Int colorIdx)
    actionbarWipe(Player player)
    build1(Player player)
    build2(Player player)
    slimegrounds1(Player player)
    slimegrounds2(Player player)
    slimegrounds3(Player player)
    slimegrounds4(Player player)
    slimegrounds5(Player player)
