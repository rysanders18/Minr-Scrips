# playAnimCam(Player player)
# Port of a/default/play_anim_cam. Play once and put `player` into
# spectator on the animation camera.
#
# The original stashed the player's gamemode in the gm_cam_client
# scoreboard and marked them with the bde_cam_client tag. Here that
# state lives in MSC variables: the per-player `savedGameMode` /
# `watchingCam` slots and the `camClient` global.
@using project
@fast

@var looping = false
@var paused = false

@bypass execute as @e[tag=project_root,type=block_display] at @s run data modify entity @e[type=minecraft:block_display,tag=project_camera,limit=1,sort=nearest] teleport_duration set value 0

# Remember the player's current gamemode, then spectate the camera.
@var savedGameMode[player] = player.getGameMode()
@var watchingCam[player] = true
@var camClient = player.getName()
@bypass gamemode spectator {{player}}
@bypass execute as @e[tag=project_root,type=block_display] at @s run spectate @e[type=minecraft:block_display,tag=project_camera,limit=1,sort=nearest] {{player}}

@delay 2
@var start()
