@namespace project

# ============================================================
# project - BDEngine block-display animation, ported to MSC
#
# Original: a vanilla datapack exported by BDEngine. The model
# is a tree of block_display / item_display entities tagged
# "project" (root tag "project_root", camera "project_camera",
# parts "project_0".."project_215").
#
# Datapack flow used `schedule function ... 0.1s` chains plus
# entity tags (animation_pause / animation_loop). MSC functions
# cannot be `schedule`d like datapack functions, so the control
# flow is re-implemented here with @delay + function calls and
# the pause/loop/play state is held in the namespace globals
# below. The per-frame transform commands are kept verbatim as
# @bypass dumps inside the keyframeN functions.
# ============================================================

# ---- Animation state (shared room-scoped globals) ----
    Boolean playing = false
    Boolean paused = false
    Boolean looping = false
    Int currentFrame = 0

# lastFrame is the index of the final keyframe.
# The full animation has 283 frames (0..282). This port ships a
# index of the final one.
    Int lastFrame = 282

# ---- Camera-viewer state (replaces the gm_cam_client scoreboard
#      and the bde_cam_client entity tag) ----
# Per-player: the gamemode the player had before entering the cam,
# and whether they are currently watching through it.
    relative String savedGameMode = "survival"
    relative Boolean watchingCam = false
# Name of the single active cam viewer ("" = nobody), so stopAnim()
# can find them without an entity-tag selector.
    String camClient = ""

# ---- Setup ----
    createModel(Player player)

# ---- Entry points ----
    playAnim()
    playAnimLoop()
    playAnimCam(Player player)
    playAnimLoopCam(Player player)
    pause()
    resume()
    stopAnim()
    stopSound()
    deleteModel()

# ---- Internal flow ----
    start()
    runFrame()
    playFrame(Int frame)
# checkLoop() is retained for reference but no longer called: the
# loop/stop decision now lives inside runFrame's pass loop.
    checkLoop()

# ---- Keyframe bodies (verbatim transform dumps; 0..282) ----
    keyframe0()
    keyframe1()
    keyframe2()
    keyframe3()
    keyframe4()
    keyframe5()
    keyframe6()
    keyframe7()
    keyframe8()
    keyframe9()
    keyframe10()
