@using mannequin

@player prerecording0 =
@for Int i in list::range(0, 1000)
    @player Position({{prerecording0[i].getX()}}, {{prerecording0[i].getY()}}, {{prerecording0[i].getZ()}}, {{prerecording0[i].getYaw()}}, {{prerecording0[i].getPitch()}}), 
    @if i % 50 == 0
        @delay 1
    @fi
@done
@player prerecordingSneaking0 = {{prerecordingSneaking0}}

