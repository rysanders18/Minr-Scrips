# spawnMannequin(Player player)
# Summons a custom Minr mannequin entity tagged mannequin_<UUID> at the
# caller's current world position. The mannequin carries a text_display
# passenger as a floating nameplate showing the calling player's name,
# and uses the skin profile from the example template (swap the texture
# value to change appearance). Idempotent: if already spawned, kills the
# old entity first so re-running effectively warps the mannequin to the
# caller. Initialises all per-player cruise state (world coords, zero
# velocity, current yaw from the player).

@using mannequin
@fast

@if isSpawned[player]
    @bypass minecraft:kill @e[tag=mannequinUsername_rychess]
    @bypass minecraft:kill @e[tag=mannequin_rychess]
@fi

@var curX[player] = -9133.0D
@var curY[player] = -61.0D
@var curZ[player] = 9668.75D
@var groundY[player] = -61.0D
@var world[player] = player.getWorld()
@var velX[player] = 0D
@var velY[player] = 0D
@var velZ[player] = 0D
@var curYawDeg[player] = Double(player.getYaw())
@var curPitchDeg[player] = 0D
@var targetX[player] = 0D
@var targetZ[player] = 0D
@var isCruising[player] = false
@var isCoasting[player] = false
@var hasTargetFacing[player] = false
@var cruiseTicks[player] = 0
# Assume spawn-on-ground (caller stands on the same surface). collideY
# corrects this within 1-2 ticks if the mannequin is actually mid-air.
@var onGround[player] = true

# Reset step-sound + fall-sound state so a respawned mannequin starts
# from a clean slate. Without these, a previously-accumulated moveDist
# could fire a step on the first cruise tick after respawn, and a
# previously-airborne wasOnGround would emit a phantom land sound when
# the new spawn's grounded-detection kicks in.
@var moveDist[player] = 0.0F
@var nextStep[player] = 1
@var fallDistance[player] = 0.0F
@var wasOnGround[player] = true

@bypass /summon mannequin -9133.0 -61.0 9668.75 {Invulnerable:1b,pose:"standing",Tags:["mannequin_rychess"],Passengers:[{id:"minecraft:text_display",billboard:"center",Tags:["mannequinUsername_rychess"],teleport_duration:1,shadow:0b,Motion:[0.0,0.3,0.0],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0.3f,0f],scale:[1f,1f,1f]},text:{"color":"green","text":"RYgamer1"}}],profile:{"id":[I;-118533046,-1659876403,-1351387569,742009199],"properties":[{"name":"textures","value":""}]}}

@var isSpawned[player] = true
