# blockTypes0-4 now contain all block types in the region (up to 5000 blocks)
# for example CraftBlock{pos=BlockPos{x=-9060, y=88, z=9823},type=SANDSTONE_WALL,data=Block{minecraft:sandstone_wall}[east=low,north=none,south=low,up=true,waterlogged=false,west=none],fluid=net.minecraft.world.level.material.EmptyFluid@11e7da7} would be 
# /summon block_display -9060.0 88 9823.0 {Tags:["guac","coordsx{{bx}}y{{by}}z{{bz}}"],transformation:{left_rotation:[{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}}],right_rotation:[{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}}],translation:[{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}}],scale:[1f,1f,1f]},block_state:{Name:"minecraft:sandstone_wall",Properties:{north:"none",south:"low",east:"low",west:"none",up:"true",waterlogged:"false"}}}

# Summon block_displays for all stored blocks
# Block string format: CraftBlock{...,data=Block{minecraft:name}[prop=val,...],fluid=...}
# Some blocks have no properties: CraftBlock{...,data=Block{minecraft:name},fluid=...}
@for String b in blockTypes0
    # Parse coordinates from string: CraftBlock{pos=BlockPos{x=-9060, y=88, z=9823},type=...
    @define Int bx = Int(b.split("x=")[1].split(",")[0])
    @define Int by = Int(b.split("y=")[1].split(",")[0])
    @define Int bz = Int(b.split("z=")[1].split("\\}")[0])
    # Parse block type from string: type=SANDSTONE_WALL,data=...
    @define String blockName = "minecraft:" + b.split("type=")[1].split(",")[0].toLowerCase()

    # Check if block has properties (contains "[")
    @if b.contains("[")
        # Extract properties string between [ and ] from block data
        @define String propsSection = b.split("\\[")[1].split("\\]")[0]

        # Convert properties from "key=val,key=val" to JSON format {key:"val",key:"val"}
        @define String[] propPairs = propsSection.split(",")
        @define String propsJson = "{"
        @for Int i in list::range(0, propPairs.length())
            @define String[] keyVal = propPairs[i].split("=")
            @if i > 0
                @var propsJson = propsJson + ","
            @fi
            @var propsJson = propsJson + keyVal[0] + ":\"" + keyVal[1] + "\""
        @done
        @var propsJson = propsJson + "}"

        @bypass /summon minecraft:block_display {{bx}}.0 {{by}} {{bz}}.0 {Tags:["guac","coordsx{{bx}}y{{by}}z{{bz}}"],transformation:{left_rotation:[{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}}],right_rotation:[{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}}],translation:[{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}}],scale:[1f,1f,1f]},block_state:{Name:"{{blockName}}",Properties:{{propsJson}}}}
    @else
        # No properties, summon without Properties field
        @bypass /summon minecraft:block_display {{bx}}.0 {{by}} {{bz}}.0 {Tags:["guac","coordsx{{bx}}y{{by}}z{{bz}}"],transformation:{left_rotation:[{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}}],right_rotation:[{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}}],translation:[{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}}],scale:[1f,1f,1f]},block_state:{Name:"{{blockName}}"}}
    @fi
@done

@for String b in blockTypes1
    @define Int bx = Int(b.split("x=")[1].split(",")[0])
    @define Int by = Int(b.split("y=")[1].split(",")[0])
