#                     @var blockTypes0.append(Block(x, y, z, world).string())
#                 @elseif currentList == 1
#                     @var blockTypes1.append(Block(x, y, z, world).string())
#                 @elseif currentList == 2
#                     @var blockTypes2.append(Block(x, y, z, world).string())
#                 @elseif currentList == 3
#                     @var blockTypes3.append(Block(x, y, z, world).string())
#                 @elseif currentList == 4
