    @define String blockName = "minecraft:" + b.split("type=")[1].split(",")[0].toLowerCase()

    @if b.contains("[")
        @define String propsSection = b.split("\\[")[1].split("\\]")[0]
        @define String[] propPairs = propsSection.split(",")
        @define String propsJson = "{"
        @for Int i in list::range(0, propPairs.length())
