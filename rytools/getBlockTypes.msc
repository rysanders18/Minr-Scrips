        @done
        @var propsJson = propsJson + "}"
        @bypass /summon minecraft:block_display {{bx}}.0 {{by}} {{bz}}.0 {Tags:["guac","coordsx{{bx}}y{{by}}z{{bz}}"],transformation:{left_rotation:[{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}}],right_rotation:[{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}}],translation:[{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}}],scale:[1f,1f,1f]},block_state:{Name:"{{blockName}}",Properties:{{propsJson}}}}
    @else
        @bypass /summon minecraft:block_display {{bx}}.0 {{by}} {{bz}}.0 {Tags:["guac","coordsx{{bx}}y{{by}}z{{bz}}"],transformation:{left_rotation:[{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}}],right_rotation:[{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}}],translation:[{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}},{{math::random(-1D, 1D)}}],scale:[1f,1f,1f]},block_state:{Name:"{{blockName}}"}}
    @fi
@done

