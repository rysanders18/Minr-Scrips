# spiralParticles(String entityUuid)
#
# The colour arriving. Emits one dust_color_transition particle per arm
# per tick for the length of the armour fade, orbiting the armour stand
# on a helix that climbs and falls while it turns, so it wraps the figure
# from feet to head and back over and over.
#
# The whole thing builds. It opens as a single slow strand and finishes
# as four, turning three times as fast:
#
#   ARMS   one more strand at each of spiralArm2/3/4, evenly spaced
#          round the orbit AND through the climb, so they ride at
#          different heights (2 arms = a double helix with one strand at
#          the feet while the other is at the head). The schedule
#          tightens as it goes, so the build accelerates.
#   SPEED  every cycle scales by spiralSpeedEnd on a squared curve —
#          barely moving early, most of it landing in the last third
#          where the extra arms arrive.
#
# Three cycles run at once, on deliberately unequal periods so the path
# never repeats itself inside the cutscene (rates at the opening speed):
#
#   spiralSpin    the orbit, ~40 ticks a revolution
#   spiralRise    feet to head and back, ~80 ticks a cycle
#   spiralWeave   the radius breathing in and out, ~120 ticks a cycle
#
# On top of those the orbit tightens as it goes (spiralDrawIn), so the
# colour starts out circling at arm's length and ends up hugging the
# body — the particles closing in on the child rather than passing by.
#
# COLOUR: spiralColors is the same journey dyeArmourGradient walks, but
# floored in lightness and vibrance so a particle is never a black speck
# on a dark background, and taken from between the chestplate and
# leggings hues. Each particle transitions from the colour at this tick
# to the one spiralLead ticks ahead, which means the motes are always
# carrying the colour the armour is about to turn — the paint arrives in
# the air a moment before it lands on the child.
#
# Run this alongside dyeArmourGradient with the same entity, started on
# the same tick; the two tables are the same length and index in step.
#
# DO NOT hand-edit the table below — it is generated by
# irodori_gradient.py at the repo root alongside the dye tables.
@using irodoriAnimation
@fast

@define String[] spiralColors = String["0.388,0.440,0.807", "0.388,0.440,0.807", "0.388,0.440,0.807", "0.388,0.440,0.807", "0.388,0.440,0.807", "0.388,0.440,0.807", "0.388,0.440,0.807", "0.388,0.440,0.807", "0.388,0.440,0.807", "0.388,0.440,0.807", "0.388,0.440,0.807", "0.388,0.440,0.807", "0.386,0.440,0.807", "0.374,0.444,0.807", "0.350,0.452,0.807", "0.309,0.463,0.807", "0.271,0.479,0.780", "0.282,0.494,0.711", "0.287,0.502,0.669", "0.289,0.507,0.642", "0.291,0.509,0.626", "0.291,0.511,0.618", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.291,0.511,0.615", "0.292,0.512,0.613", "0.292,0.514,0.601", "0.294,0.518,0.575", "0.297,0.526,0.541", "0.319,0.568,0.522", "0.344,0.621,0.461", "0.482,0.651,0.344", "0.645,0.650,0.365", "0.750,0.652,0.383", "0.824,0.651,0.396", "0.869,0.649,0.404", "0.886,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.647,0.406", "0.888,0.645,0.406", "0.894,0.635,0.408", "0.891,0.617,0.440", "0.887,0.586,0.480", "0.881,0.544,0.529", "0.875,0.491,0.596", "0.869,0.419,0.703", "0.809,0.385,0.824", "0.697,0.434,0.841", "0.636,0.453,0.844", "0.612,0.455,0.851", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.609,0.456,0.852", "0.596,0.468,0.848", "0.555,0.502,0.837", "0.489,0.546,0.841", "0.384,0.600,0.847", "0.375,0.649,0.760", "0.393,0.685,0.696", "0.408,0.719,0.625", "0.415,0.753,0.500", "0.501,0.761,0.347", "0.583,0.750,0.317", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.603,0.747,0.308", "0.601,0.747,0.309", "0.581,0.751,0.315", "0.530,0.761,0.328", "0.411,0.781,0.343", "0.379,0.770,0.493", "0.375,0.755,0.588", "0.355,0.745,0.647", "0.323,0.738,0.690", "0.286,0.734,0.723", "0.255,0.731,0.745", "0.241,0.730,0.754", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.239,0.730,0.755", "0.240,0.730,0.754", "0.258,0.733,0.741", "0.300,0.739,0.707", "0.355,0.750,0.648", "0.406,0.769,0.538", "0.584,0.758,0.407", "0.745,0.725,0.414", "0.863,0.695,0.391", "0.941,0.670,0.445", "0.965,0.663,0.533", "0.981,0.659,0.579", "0.988,0.656,0.597", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.989,0.656,0.600", "0.988,0.652,0.598", "0.986,0.639,0.593", "0.983,0.617,0.585", "0.980,0.586,0.576", "0.979,0.545,0.567", "0.981,0.499,0.561", "0.985,0.449,0.559", "0.991,0.401,0.562", "0.996,0.364,0.565", "0.999,0.344,0.568", "1.000,0.340,0.568", "1.000,0.340,0.568", "1.000,0.340,0.568", "1.000,0.340,0.568", "1.000,0.340,0.568", "1.000,0.340,0.568", "1.000,0.340,0.568", "1.000,0.340,0.568", "1.000,0.340,0.568", "1.000,0.340,0.568", "1.000,0.340,0.568", "1.000,0.340,0.568"]

@define Int frames = spiralColors.length()
@define Int toFrame = 0
@define Int arms = 1

@define Double progress = 0D
@define Double speed = 1D
@define Double spinPhase = 0D
@define Double risePhase = 0D
@define Double weavePhase = 0D
@define Double radius = 0D
@define Double drawIn = 0D
@define Double armAngle = 0D
@define Double armHeight = 0D
@define Double armSpacing = 0D

@for Int i in list::range(0, frames)
    @var progress = Double(i) / Double(frames - 1)

    @var toFrame = i + spiralLead
    @if toFrame >= frames
        @var toFrame = frames - 1
    @fi

    # Arms come in on a tightening schedule, so the build accelerates
    # rather than adding a strand at an even beat.
    @var arms = 1
    @if progress >= spiralArm2
        @var arms = 2
    @fi
    @if progress >= spiralArm3
        @var arms = 3
    @fi
    @if progress >= spiralArm4
        @var arms = 4
    @fi
    @var armSpacing = 360D / Double(arms)

    # Rate rises on progress squared: barely moves early, most of the
    # acceleration lands in the last third alongside the extra arms.
    @var speed = 1D + (spiralSpeedEnd - 1D) * progress * progress

    # The phases ACCUMULATE. Writing spinPhase = i * spin * speed would
    # be wrong once speed varies: the angle has to be the integral of the
    # rate, and that product runs ahead of it (d/di of i*speed(i) is
    # speed + i*speed'(i), not speed), which over-rotates the helix.
    @var spinPhase = spinPhase + spiralSpin * speed
    @var risePhase = risePhase + spiralRise * speed
    @var weavePhase = weavePhase + spiralWeave * speed

    # Orbit tightens from full radius at the start to (1 - spiralDrawIn)
    # of it by the last tick.
    @var drawIn = 1D - spiralDrawIn * progress
    @var radius = (spiralRadius + spiralWeaveAmp * math::sin(weavePhase)) * drawIn

    @for Int a in list::range(0, arms)
        # Each arm is offset by the same fraction of a turn in BOTH the
        # orbit and the climb, which is what makes them a real multi-start
        # helix rather than copies of one strand. Two arms end up exactly
        # antiphase — one at the feet while the other is at the head, on
        # opposite sides — and four spread evenly through the climb, so at
        # any instant the strands cover the whole figure.
        @var armAngle = spinPhase + Double(a) * armSpacing
        # Starts at the feet: -cos rises from 0 rather than mid-body.
        @var armHeight = spiralHeightMid - spiralHeightAmp * math::cos(risePhase + Double(a) * armSpacing * spiralArmRiseSpread)
        @bypass /execute in {{animWorld}} as {{entityUuid}} at @s run particle dust_color_transition{from_color:[{{spiralColors[i]}}],to_color:[{{spiralColors[toFrame]}}],scale:{{sparkScale}}} ~{{radius * math::cos(armAngle)}} ~{{armHeight}} ~{{radius * math::sin(armAngle)}} 0 0 0 0 1 force
    @done

    @delay 1
@done
