@define String[] blockColors = String["red_concrete", "red_terracotta", "orange_terracotta", "smooth_red_sandstone", "orange_concrete", "orange_wool", "honeycomb_block", "raw_gold_block", "horn_coral_block", "yellow_wool", "yellow_concrete", "sponge", "stripped_bamboo_block", "bamboo_block", "melon", "lime_terracotta", "moss_block", "green_wool", "green_concrete", "waxed_weathered_copper_bulb", "waxed_weathered_copper", "stripped_warped_hyphae", "cyan_concrete_powder", "cyan_wool", "lapis_ore", "light_blue_terracotta", "deepslate_lapis_ore", "blue_concrete_powder", "blue_wool", "purple_glazed_terracotta", "purple_wool", "purple_concrete", "stripped_crimson_hyphae", "fire_coral_block", "red_concrete_powder"]

# ONE TIME SUMMON
# @for Int i in list::range(0, blockColors.length())
#     @bypass /summon block_display -1126.55 187.2 604.45 {Tags:["iro{{i}}"],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[0.1f,0.1f,0.1f]},block_state:{Name:"minecraft:{{blockColors[i]}}"}}
#     @delay 1
# @done

@define Double angle = 0D
@for Int i in list::range(0, blockColors.length())
    @var angle = math::random(0D, 360D)
    @bypass /data merge entity @e[limit=1,tag=iro{{i}}] {interpolation_duration:0,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[{{math::random(-3.14D, 3.14D)}}f, 0f, {{math::random(-3.14D, 3.14D)}}f, {{math::random(-3.14D, 3.14D)}}f],translation:[{{2 * math::cos(angle)}}f,{{math::random(-1.14D, 1.14D)}}f,{{2 * math::sin(angle)}}f],scale:[0.0f,0.0f,0.0f]}}
@done

@console function execute irodori::moveBlockDisplays() 

@delay 36

@for Int i in list::range(0, blockColors.length())
    @var angle = math::random(0D, 360D)
    @bypass /data merge entity @e[limit=1,tag=iro{{i}}] {interpolation_duration:0,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[{{math::random(-3.14D, 3.14D)}}f, 0f, {{math::random(-3.14D, 3.14D)}}f, {{math::random(-3.14D, 3.14D)}}f],translation:[{{2 * math::cos(angle)}}f,{{math::random(-1.14D, 1.14D)}}f,{{2 * math::sin(angle)}}f],scale:[0.0f,0.0f,0.0f]}}
    @delay 2

    @if i == 18
        @console function execute irodori::moveBlockDisplays() 
    @fi
@done

# @delay 10

@for Int i in list::range(0, blockColors.length())
    @var angle = math::random(0D, 360D)
    @bypass /data merge entity @e[limit=1,tag=iro{{i}}] {interpolation_duration:0,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[{{math::random(-3.14D, 3.14D)}}f, 0f, {{math::random(-3.14D, 3.14D)}}f, {{math::random(-3.14D, 3.14D)}}f],translation:[{{2 * math::cos(angle)}}f,{{math::random(-1.14D, 1.14D)}}f,{{2 * math::sin(angle)}}f],scale:[0.0f,0.0f,0.0f]}}
    @delay 2

    @if i == 18
        @console function execute irodori::moveBlockDisplays() 
    @fi
@done



